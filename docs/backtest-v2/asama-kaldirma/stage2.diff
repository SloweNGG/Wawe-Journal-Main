+-- ============================================================
+-- WAWE JOURNAL - Backtest v2 / Migration 01: eski backtest_trades tablosunu kaldır
+-- Migration: 202610180001_drop_legacy_backtest_trades.sql
+-- Geri alma: supabase/rollbacks/202610180001_drop_legacy_backtest_trades.down.sql
+--
+-- Sorun: Eski /backtest sayfası kaldırıldı (Aşama 2). Tablosu public.backtest_trades artık kullanılmıyor:
+--   2026-10-18 denetimi: 0 satır, 0 kullanıcı; hiçbir view, FK, publication veya kullanıcı trigger'ı ona bağlı değil.
+--   Veritabanında ona değinen tek nesne reset_user_data() (to_regclass korumalı DELETE).
+--
+-- Çözüm:
+--   0. Koruma: tabloda satır varsa hiçbir şey değiştirmeden durur (önbellekteki eski sayfa yazmış olabilir).
+--   1. reset_user_data(): CANLI gövde (pg_get_functiondef, 2026-10-18) birebir; yalnızca backtest_trades DELETE bloğu
+--      çıktı ve "1. Trades & Backtest" yorumu "1. Trades" oldu. Adım 2-6 aynen (6 = cTrader imleç sıfırlama).
+--      202610030001 sürümünden kurmayın: 6. adım onda yok.
+--   2. DROP TABLE (RESTRICT): 4 politika, 4 indeks, PK/FK, iç RI trigger'ları ve haklar tabloyla birlikte gider.
+--   Yeni tablolar (backtest_accounts, backtest_account_trades) Migration 02'de gelir. backtest_trades adı yeniden
+--   KULLANILMAZ: 202608190001 (satır 93, 142-151) ve 202609200001 (satır 43-53) bu adı hedefliyor.
+--
+-- Sıra: (1) Aşama 2 istemcisi yayında ve sw.js CACHE_VERSION artırılmış; (2) HEMEN ÖNCE tam veritabanı yedeği alındı
+--   ve yeri sahibe bildirildi; (3) bu dosya Supabase SQL Editor'da tek seferde çalıştırılır. "supabase db push"
+--   KULLANILMAZ (schema_migrations boş, tüm dosyaları bekleyen sayar). Tekrar çalıştırmak zararsızdır.
+-- ============================================================
+
+BEGIN;
+
+-- 0. Koruma
+DO $$
+DECLARE
+  v_rows bigint;
+BEGIN
+  IF to_regclass('public.backtest_trades') IS NOT NULL THEN
+    EXECUTE 'LOCK TABLE public.backtest_trades IN ACCESS EXCLUSIVE MODE';
+    EXECUTE 'SELECT count(*) FROM public.backtest_trades' INTO v_rows;
+    IF v_rows > 0 THEN
+      RAISE EXCEPTION 'M01 durduruldu: public.backtest_trades tablosunda % satır var. Hiçbir şey değişmedi; sahibe danışın.', v_rows;
+    END IF;
+  END IF;
+END
+$$;
+
+-- 1. reset_user_data: canlı gövde, backtest_trades bloğu olmadan
+CREATE OR REPLACE FUNCTION public.reset_user_data()
+ RETURNS void
+ LANGUAGE plpgsql
+ SECURITY DEFINER
+ SET search_path TO 'public'
+AS $function$
+DECLARE
+  v_uid UUID := auth.uid();
+  v_default_jid UUID;
+BEGIN
+  IF v_uid IS NULL THEN
+    RAISE EXCEPTION 'Not authenticated';
+  END IF;
+
+  -- 1. Trades
+  DELETE FROM public.trades WHERE user_id = v_uid;
+
+  -- 2. Stratejiler
+  IF to_regclass('public.strategies') IS NOT NULL THEN
+    DELETE FROM public.strategies WHERE user_id = v_uid;
+  END IF;
+
+  -- 3. Bildirimler
+  IF to_regclass('public.notifications') IS NOT NULL THEN
+    DELETE FROM public.notifications WHERE user_id = v_uid;
+  END IF;
+
+  -- 4. User Onboarding
+  IF to_regclass('public.user_onboarding') IS NOT NULL THEN
+    DELETE FROM public.user_onboarding WHERE user_id = v_uid;
+  END IF;
+
+  -- 5. Defterler (Journals)
+  -- Özel defterleri sil, varsayılan defteri temizle/oluştur
+  IF to_regclass('public.journals') IS NOT NULL THEN
+    DELETE FROM public.journals WHERE user_id = v_uid AND is_default = false;
+
+    SELECT id INTO v_default_jid FROM public.journals WHERE user_id = v_uid AND is_default = true LIMIT 1;
+    IF v_default_jid IS NULL THEN
+      INSERT INTO public.journals (user_id, name, description, color, icon, is_default, is_active)
+      VALUES (v_uid, 'Ana Hesap', 'Varsayılan işlem günlüğü', '#7c6dfa', 'folder', true, true);
+    ELSE
+      UPDATE public.journals
+      SET name = 'Ana Hesap', description = 'Varsayılan işlem günlüğü', color = '#7c6dfa', icon = 'folder', is_active = true
+      WHERE id = v_default_jid;
+    END IF;
+  END IF;
+
+  -- 6. cTrader senkron imleci: işlemler silindiği için bir sonraki senkron tüm geçmişi (en fazla 90 gün) yeniden
+  --    getirsin (eskiden imleç korunuyor ve yalnızca son 2 gün geri geliyordu).
+  IF to_regclass('public.ctrader_accounts') IS NOT NULL THEN
+    UPDATE public.ctrader_accounts
+    SET last_deal_timestamp = NULL, last_error = NULL, updated_at = now()
+    WHERE user_id = v_uid;
+  END IF;
+END;
+$function$;
+
+-- Canlı ACL: postgres, authenticated, service_role (anon ve PUBLIC yok). CREATE OR REPLACE mevcut ACL'yi korur;
+-- fonksiyon hiç yoksa (yalnızca repodan kurulmuş bir veritabanı) varsayılan haklar anon dahil verilir, aynı hale getir.
+REVOKE ALL ON FUNCTION public.reset_user_data() FROM PUBLIC;
+REVOKE ALL ON FUNCTION public.reset_user_data() FROM anon;
+GRANT EXECUTE ON FUNCTION public.reset_user_data() TO authenticated, service_role;
+
+-- 2. Eski tabloyu sil (RESTRICT: beklenmeyen bir bağımlı varsa tüm işlem geri alınır)
+DROP TABLE IF EXISTS public.backtest_trades;
+
+-- PostgREST şema önbelleği (pgrst_drop_watch event trigger'ı zaten yeniler; zararsız ek güvence)
+NOTIFY pgrst, 'reload schema';
+
+COMMIT;
+
+-- ============================================================
+-- KONTROL (salt okunur; COMMIT'ten sonra ayrı ayrı çalıştırın)
+-- ============================================================
+-- SELECT to_regclass('public.backtest_trades');                                               -- beklenen: NULL
+-- SELECT count(*) FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
+--  WHERE n.nspname NOT IN ('pg_catalog', 'information_schema') AND p.prosrc ILIKE '%backtest_trades%';   -- beklenen: 0
+-- SELECT pg_get_functiondef('public.reset_user_data()'::regprocedure) ILIKE '%backtest%';       -- beklenen: false
+-- SELECT pg_get_functiondef('public.reset_user_data()'::regprocedure) ILIKE '%ctrader_accounts%'; -- beklenen: true (6. adım duruyor)
+-- SELECT p.prosecdef, p.proconfig, p.proacl FROM pg_proc p WHERE p.oid = 'public.reset_user_data()'::regprocedure;
+--   -- beklenen: true | {search_path=public} | postgres, authenticated, service_role için X (anon ve PUBLIC yok)
