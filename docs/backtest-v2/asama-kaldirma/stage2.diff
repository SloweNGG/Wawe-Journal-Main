+-- ============================================================
+-- WAWE JOURNAL - GERİ ALMA: Backtest v2 / Migration 01
+-- Rollback for: supabase/migrations/202610180001_drop_legacy_backtest_trades.sql
+--
+-- public.backtest_trades tablosunu 2026-10-18 canlı katalogdaki haliyle (sütunlar, PK, FK ON DELETE NO ACTION, 4 indeks,
+-- RLS + 4 canlı politika, Supabase varsayılan hakları) yeniden kurar ve reset_user_data() fonksiyonunu M01 ÖNCESİ canlı
+-- gövdesine döndürür. Veri geri gelmez (M01 yalnızca tablo boşken çalışır; gerekirse yedekten alınır).
+--
+-- Yalnızca 202610180001 en son uygulanan migration ise çalıştırın. Sonraki migration'lar (02+) uygulandıysa önce
+-- onların geri alma dosyalarını TERS sırayla çalıştırın: Migration 02 reset_user_data'yı yeniden tanımlar ve bu dosya
+-- o tanımı ezer. Supabase SQL Editor'da tek seferde çalıştırın; tekrar çalıştırmak zararsızdır.
+-- ============================================================
+
+BEGIN;
+
+-- 1. Tablo (canlı tanım; ensure_rls event trigger'ı RLS'i zaten açar, aşağıda yine de açılıyor)
+CREATE TABLE IF NOT EXISTS public.backtest_trades (
+  id          uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  user_id     uuid NOT NULL REFERENCES auth.users(id),
+  symbol      text NOT NULL,
+  asset_class text,
+  "interval"  text,
+  side        text NOT NULL,
+  entry_price numeric NOT NULL,
+  exit_price  numeric NOT NULL,
+  entry_time  timestamptz NOT NULL,
+  exit_time   timestamptz NOT NULL,
+  tp_pct      numeric,
+  sl_pct      numeric,
+  pnl_pct     numeric NOT NULL,
+  exit_reason text NOT NULL,
+  created_at  timestamptz DEFAULT now()
+);
+
+CREATE INDEX IF NOT EXISTS idx_backtest_trades_user_id    ON public.backtest_trades USING btree (user_id);
+CREATE INDEX IF NOT EXISTS idx_backtest_trades_created_at ON public.backtest_trades USING btree (created_at DESC);
+CREATE INDEX IF NOT EXISTS idx_backtest_trades_user_time  ON public.backtest_trades USING btree (user_id, entry_time DESC);
+
+ALTER TABLE public.backtest_trades ENABLE ROW LEVEL SECURITY;
+
+-- Canlı politikalar (rol: public, is_admin() yok, UPDATE'te WITH CHECK yok) - birebir
+DROP POLICY IF EXISTS "users select own backtest trades" ON public.backtest_trades;
+CREATE POLICY "users select own backtest trades" ON public.backtest_trades
+  FOR SELECT USING (auth.uid() = user_id);
+DROP POLICY IF EXISTS "users insert own backtest trades" ON public.backtest_trades;
+CREATE POLICY "users insert own backtest trades" ON public.backtest_trades
+  FOR INSERT WITH CHECK (auth.uid() = user_id);
+DROP POLICY IF EXISTS "users update own backtest trades" ON public.backtest_trades;
+CREATE POLICY "users update own backtest trades" ON public.backtest_trades
+  FOR UPDATE USING (auth.uid() = user_id);
+DROP POLICY IF EXISTS "users delete own backtest trades" ON public.backtest_trades;
+CREATE POLICY "users delete own backtest trades" ON public.backtest_trades
+  FOR DELETE USING (auth.uid() = user_id);
+
+-- Canlı haklar (Supabase varsayılanı: 7 yetki; PG17'nin MAINTAIN yetkisi canlıda yoktu)
+GRANT SELECT, INSERT, UPDATE, DELETE, TRUNCATE, REFERENCES, TRIGGER ON public.backtest_trades TO anon, authenticated, service_role;
+
+-- 2. reset_user_data: M01 öncesi canlı gövde (birebir)
+CREATE OR REPLACE FUNCTION public.reset_user_data()
+ RETURNS void
+ LANGUAGE plpgsql
+ SECURITY DEFINER
+ SET search_path TO 'public'
+AS $function$
+DECLARE
+  v_uid UUID := auth.uid();
+  v_default_jid UUID;
+BEGIN
+  IF v_uid IS NULL THEN
+    RAISE EXCEPTION 'Not authenticated';
+  END IF;
+
+  -- 1. Trades & Backtest
+  DELETE FROM public.trades WHERE user_id = v_uid;
+
+  IF to_regclass('public.backtest_trades') IS NOT NULL THEN
+    DELETE FROM public.backtest_trades WHERE user_id = v_uid;
+  END IF;
+
+  -- 2. Stratejiler
+  IF to_regclass('public.strategies') IS NOT NULL THEN
+    DELETE FROM public.strategies WHERE user_id = v_uid;
+  END IF;
+
+  -- 3. Bildirimler
+  IF to_regclass('public.notifications') IS NOT NULL THEN
+    DELETE FROM public.notifications WHERE user_id = v_uid;
+  END IF;
+
+  -- 4. User Onboarding
+  IF to_regclass('public.user_onboarding') IS NOT NULL THEN
+    DELETE FROM public.user_onboarding WHERE user_id = v_uid;
+  END IF;
+
+  -- 5. Defterler (Journals)
+  -- Özel defterleri sil, varsayılan defteri temizle/oluştur
+  IF to_regclass('public.journals') IS NOT NULL THEN
+    DELETE FROM public.journals WHERE user_id = v_uid AND is_default = false;
+
+    SELECT id INTO v_default_jid FROM public.journals WHERE user_id = v_uid AND is_default = true LIMIT 1;
+    IF v_default_jid IS NULL THEN
+      INSERT INTO public.journals (user_id, name, description, color, icon, is_default, is_active)
+      VALUES (v_uid, 'Ana Hesap', 'Varsayılan işlem günlüğü', '#7c6dfa', 'folder', true, true);
+    ELSE
+      UPDATE public.journals
+      SET name = 'Ana Hesap', description = 'Varsayılan işlem günlüğü', color = '#7c6dfa', icon = 'folder', is_active = true
+      WHERE id = v_default_jid;
+    END IF;
+  END IF;
+
+  -- 6. cTrader senkron imleci: işlemler silindiği için bir sonraki senkron tüm geçmişi (en fazla 90 gün) yeniden
+  --    getirsin (eskiden imleç korunuyor ve yalnızca son 2 gün geri geliyordu).
+  IF to_regclass('public.ctrader_accounts') IS NOT NULL THEN
+    UPDATE public.ctrader_accounts
+    SET last_deal_timestamp = NULL, last_error = NULL, updated_at = now()
+    WHERE user_id = v_uid;
+  END IF;
+END;
+$function$;
+
+REVOKE ALL ON FUNCTION public.reset_user_data() FROM PUBLIC;
+REVOKE ALL ON FUNCTION public.reset_user_data() FROM anon;
+GRANT EXECUTE ON FUNCTION public.reset_user_data() TO authenticated, service_role;
+
+NOTIFY pgrst, 'reload schema';
+
+COMMIT;
+
