# Cloudflare Pages cache kontrolü - SW ile birlikte çalışacak
/*
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# HTML - KESİNLİKLE CACHE YOK
*.html
  Cache-Control: no-cache, no-store, must-revalidate

# CSS/JS - Kısa süreli cache (SW yönetir)
*.css
  Cache-Control: public, max-age=3600
*.js
  Cache-Control: public, max-age=3600

# Görseller
*.svg
  Cache-Control: public, max-age=86400
*.png
  Cache-Control: public, max-age=86400
*.jpg
  Cache-Control: public, max-age=86400
*.jpeg
  Cache-Control: public, max-age=86400
*.ico
  Cache-Control: public, max-age=86400

# Astro derlenmiş ve hash'lenmiş statik varlıklar (Asla değişmez)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Web Fonts
*.woff2
  Cache-Control: public, max-age=31536000, immutable
*.woff
  Cache-Control: public, max-age=31536000, immutable