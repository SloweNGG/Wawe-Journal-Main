    .dir-btn.long.active {
      background: rgba(34,197,94,0.1);
      border-color: #22c55e;
      color: #22c55e;
    }
    .dir-btn.short.active {
      background: rgba(239,68,68,0.1);
      border-color: #ef4444;
      color: #ef4444;
    }
    #direction-hidden { display: none; }

    /* ============================================================
       STRATEJİ KUTUCUKLARI - YENİ TASARIM
       ============================================================ */
    .strategy-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 8px;
      margin-top: 4px;
    }
    .strategy-chip {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border: 1px solid var(--border);
      border-radius: 20px;
      background: var(--surface2);
      color: var(--muted);
      font-size: 12px;
      font-family: 'DM Sans', sans-serif;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s ease;
      position: relative;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .strategy-chip:hover {
      border-color: var(--accent);
      color: var(--text);
      background: rgba(139,92,246,0.04);
      transform: translateY(-1px);
    }
    .strategy-chip.active {
      border-color: var(--accent);
      background: rgba(139,92,246,0.12);
      color: var(--accent2);
      box-shadow: 0 0 0 2px rgba(139,92,246,0.15);
    }
    .strategy-chip .chip-color {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      flex-shrink: 0;
      border: 1px solid rgba(255,255,255,0.1);
    }
    .strategy-chip .chip-check {
      margin-left: auto;
      font-size: 12px;
      opacity: 0;
      transition: opacity 0.2s;
    }
    .strategy-chip.active .chip-check {
      opacity: 1;
      color: var(--accent);
    }
    .strategy-chip .chip-name {
      flex: 1;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .strategy-chip-empty {
      grid-column: 1 / -1;
      text-align: center;
      color: var(--muted);
      font-size: 12px;
      padding: 0.5rem;
      font-family: 'DM Sans', sans-serif;
    }
    .strategy-chip-empty a {
      color: var(--accent);
      text-decoration: none;
    }
    .strategy-chip-empty a:hover { text-decoration: underline; }

    .strategy-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.5rem;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .strategy-header .s-label {
      font-size: 11px;
      color: var(--muted);
      font-family: 'DM Mono', monospace;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }
    .strategy-actions {
      display: flex;
      gap: 4px;
    }
    .strategy-actions button {
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 3px 8px;
      font-size: 10px;
      color: var(--muted);
      cursor: pointer;
      transition: all 0.2s;
      font-family: 'DM Sans', sans-serif;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .strategy-actions button:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
    .strategy-actions button svg { width: 12px; height: 12px; }

    #strategy-id-hidden { display: none; }

    .preview-bar {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      flex-wrap: wrap;
      padding: 1rem 1.5rem;
      background: rgba(139,92,246,0.04);
      border-top: 1px solid var(--border);
    }
    .preview-item {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }
    .preview-item .p-label {
      font-size: 10px;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-family: 'DM Mono', monospace;
    }
    .preview-item .p-val {
      font-size: 1.1rem;
      font-weight: 600;
      font-family: 'Inter', sans-serif;
      color: var(--text);
    }
    .preview-item .p-val.pos { color: var(--green); }
    .preview-item .p-val.neg { color: var(--red); }
    .preview-item .p-val.accent { color: var(--accent); }
    .preview-divider {
      width: 1px;
      height: 36px;
      background: var(--border);
    }

    .save-btn-wrap {
      padding: 1.25rem 1.5rem;
    }
    .save-btn {
      width: 100%;
      padding: 0.8rem;
      justify-content: center;
    }

    .import-log {
      display: none;
      margin-top: 0.75rem;
      font-size: 11px;
      color: var(--muted);
      max-height: 150px;
      overflow-y: auto;
      background: rgba(0,0,0,0.15);
      padding: 0.5rem;
      border-radius: 6px;
      font-family: 'DM Mono', monospace;
    }
    .error-msg {
      display: none;
      font-size: 12px;
      color: var(--red);
      margin-top: 0.5rem;
    }

    @media (max-width: 599px) {
      main { padding: 1rem !important; }
      .grid-2, .grid-3 { grid-template-columns: 1fr; }
      .form-section { padding: 1rem; }
      .preview-bar { gap: 1rem; }
      .strategy-grid { grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); }
    }

    /* Loading overlay for bulk import */
    .bulk-import-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.7);
      backdrop-filter: blur(4px);
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 1rem;
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s ease;
    }
    .bulk-import-overlay.active {
      opacity: 1;
      visibility: visible;
    }
    .bulk-import-overlay .bulk-box {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 2rem;
      max-width: 500px;
      width: 90%;
      max-height: 80vh;
      overflow-y: auto;
    }
    .bulk-import-overlay .bulk-box h3 {
      font-family: 'Syne', sans-serif;
      font-size: 1.1rem;
      margin-bottom: 0.5rem;
      color: var(--text);
    }
    .bulk-import-overlay .bulk-box p {
      color: var(--muted);
      font-size: 13px;
      margin-bottom: 1rem;
    }
    .bulk-import-overlay .bulk-box textarea {
      width: 100%;
      min-height: 200px;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.7rem;
      color: var(--text);
      font-family: 'DM Mono', monospace;
      font-size: 12px;
      resize: vertical;
      outline: none;
    }
    .bulk-import-overlay .bulk-box textarea:focus {
      border-color: var(--accent);
    }
    .bulk-import-overlay .bulk-box .bulk-actions {
      display: flex;
      gap: 0.5rem;
      margin-top: 0.75rem;
      justify-content: flex-end;
    }
    .bulk-import-overlay .bulk-box .bulk-actions button {
      padding: 0.5rem 1.2rem;
    }
    .bulk-import-overlay .bulk-box .bulk-progress {
      margin-top: 0.75rem;
      font-size: 12px;
      color: var(--muted);
      font-family: 'DM Sans', sans-serif;
    }
    .bulk-import-overlay .bulk-box .bulk-progress .bulk-bar {
      width: 100%;
      height: 4px;
      background: var(--border);
      border-radius: 99px;
      overflow: hidden;
      margin-top: 4px;
    }
    .bulk-import-overlay .bulk-box .bulk-progress .bulk-bar .bulk-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--accent), var(--accent2));
      border-radius: 99px;
      width: 0%;
      transition: width 0.3s ease;
    }
  </style>
</head>
