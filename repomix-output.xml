  <script type="module" src="/src/script.js"></script>


  <script>
    // showToast zaten script.js'den window'a atanıyor
    // isValidEmail zaten script.js'den window'a atanıyor

    function hasTurkishChars(str) {
      return /[ığüşöçİĞÜŞÖÇ]/.test(str);
    }

    async function signInWithGoogle() {
      const btn = document.getElementById('google-login-btn');
      btn.disabled = true;
      btn.innerHTML = `
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:20px;height:20px;flex-shrink:0;animation:spin 1s linear infinite;">
          <circle cx="12" cy="12" r="10" stroke="#7c6dfa" stroke-width="2" stroke-dasharray="31.4 31.4" fill="none"/>
        </svg>
        Redirecting to Google...
      `;

      try {
        const { data, error } = await sb.auth.signInWithOAuth({
          provider: 'google',
          options: {
            redirectTo: window.location.origin + '/dashboard.html',
            queryParams: {
              access_type: 'offline',
              prompt: 'consent',
            }
          }
        });

        if (error) {
          console.error('Google login error:', error);
          window.showToast('Google login failed. Please try again.', 'error');
          btn.disabled = false;
          btn.innerHTML = `
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:20px;height:20px;flex-shrink:0;">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#7c6dfa"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#7c6dfa"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#7c6dfa"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#7c6dfa"/>
            </svg>
            Continue with Google
          `;
        }
      } catch (err) {
        console.error('Unexpected error:', err);
        window.showToast('An unexpected error occurred. Please try again.', 'error');
        btn.disabled = false;
        btn.innerHTML = `
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:20px;height:20px;flex-shrink:0;">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#7c6dfa"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#7c6dfa"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#7c6dfa"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#7c6dfa"/>
          </svg>
          Continue with Google
        `;
      }
    }

    document.getElementById('google-login-btn').addEventListener('click', signInWithGoogle);

    (async () => {
      const { data: { session } } = await sb.auth.getSession();
      if (session) window.location.href = 'dashboard.html';
    })();

    document.getElementById('login-btn').addEventListener('click', async () => {
      let email = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;

      email = email.toLowerCase();

      if (!email || !password) {
        window.showToast('Email and password are required.', 'error');
        return;
      }

      if (hasTurkishChars(email)) {
        window.showToast('Email cannot contain Turkish characters.', 'error');
        return;
      }

      if (!window.isValidEmail(email)) {
        window.showToast('Please enter a valid email address.', 'error');
        return;
      }

      const btn = document.getElementById('login-btn');
      btn.disabled = true;
      btn.textContent = 'Logging in…';

      const { data, error } = await sb.auth.signInWithPassword({ email, password });

      if (error) {
        window.showToast('Invalid email or password.', 'error');
        btn.disabled = false;
        btn.textContent = 'Login';
        return;
      }

      const { data: profile, error: profileError } = await sb
        .from('user_profiles')
        .select('is_active')
        .eq('id', data.user.id)
        .single();

      if (profileError || !profile || profile.is_active === false) {
        await sb.auth.signOut();
        window.showToast('Your account has been deactivated.', 'error');
        btn.disabled = false;
        btn.textContent = 'Login';
        return;
      }

      window.showToast('Welcome back! 🎉', 'success');
      setTimeout(() => window.location.href = 'dashboard.html', 800);
    });

    document.addEventListener('keydown', e => {
      if (e.key === 'Enter') document.getElementById('login-btn').click();
    });
  </script>
</body>
