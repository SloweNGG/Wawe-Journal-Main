<script>
  (function() {
    // ⭐ window.notificationManager zaten src/features/notifications.js'den gelir

    function getTimeAgoSimple(timestamp) {
      const diff = Date.now() - timestamp;
      const seconds = Math.floor(diff / 1000);
      const minutes = Math.floor(seconds / 60);
      const hours = Math.floor(minutes / 60);
      const days = Math.floor(hours / 24);

      if (days > 0) return days + ' gün önce';
      if (hours > 0) return hours + ' saat önce';
      if (minutes > 0) return minutes + ' dakika önce';
      return 'az önce';
    }

    function updateNotificationUI() {
      const badge = document.getElementById('notifBadge');
      const bell = document.getElementById('notifBell');
      const body = document.getElementById('notifBody');

      if (!badge || !bell) return;

      // ⭐ window.notificationManager kullan (src/features/notifications.js'den)
      const nm = window.notificationManager;
      if (!nm) {
        console.warn('⚠️ notificationManager bulunamadı');
        return;
      }

      const count = nm.getUnreadCount();

      if (count > 0) {
        badge.textContent = count > 99 ? '99+' : count;
        badge.classList.remove('hidden');
        bell.classList.add('has-notif');
      } else {
        badge.classList.add('hidden');
        bell.classList.remove('has-notif');
      }

      if (body) {
        const notifications = nm.getAll();
        if (notifications.length === 0) {
          const emptyText = (typeof i18n !== 'undefined' && i18n.t && i18n.t('nav.no_notifications')) || 'Henüz bildirim yok.';
          body.innerHTML = `
            <div class="notif-empty">
              <span class="empty-icon">📭</span>
              ${emptyText}
            </div>
          `;
        } else {
          body.innerHTML = notifications.map(n => {
            const isRead = n.read ? '' : 'style="background:rgba(139,92,246,0.04);"';
            const timeAgo = getTimeAgoSimple(n.timestamp);
            const iconClass = n.type === 'overtrade_critical' ? 'danger' :
                              n.type === 'overtrade_warning' ? 'warning' :
                              n.type === 'premium_expired' ? 'danger' :
                              n.type === 'premium_upgraded' ? 'success' : 'info';

            return `
              <div class="notif-item" data-id="${n.id}" ${isRead}>
                <div class="notif-icon ${iconClass}">${n.icon || 'ℹ️'}</div>
                <div class="notif-content">
                  <div class="notif-title">${n.title || 'Bildirim'}</div>
                  <div class="notif-desc">${n.description || ''}</div>
                  <span class="notif-time">${timeAgo}</span>
                </div>
                <button class="notif-close" onclick="window.dismissNotification('${n.id}')">✕</button>
              </div>
            `;
          }).join('');
        }
      }
    }

    // ⭐ Event listener'lar
    document.addEventListener('DOMContentLoaded', function() {
      const bell = document.getElementById('notifBell');
      if (bell) {
        bell.addEventListener('click', function(e) {
          e.stopPropagation();
          const panel = document.getElementById('notifPanel');
          if (panel) {
            panel.classList.toggle('open');
            if (panel.classList.contains('open') && window.notificationManager) {
              window.notificationManager.markAllAsRead();
              updateNotificationUI();
            }
          }
        });
      }

      document.addEventListener('click', function(e) {
        const panel = document.getElementById('notifPanel');
        const bell = document.getElementById('notifBell');
        if (panel && panel.classList.contains('open')) {
          if (!panel.contains(e.target) && !bell.contains(e.target)) {
            panel.classList.remove('open');
          }
        }
      });

      const clearBtn = document.getElementById('notifClearAll');
      if (clearBtn) {
        clearBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          const confirmText = (typeof i18n !== 'undefined' && i18n.t && i18n.t('nav.confirm_clear_all')) || 'Tüm bildirimleri temizlemek istediğinize emin misiniz?';
          if (confirm(confirmText) && window.notificationManager) {
            window.notificationManager.clearAll();
            updateNotificationUI();
          }
        });
      }

      // ⭐ i18n değişiminde UI'ı güncelle
      if (typeof i18n !== 'undefined' && i18n.onChange) {
        i18n.onChange(function() {
          updateNotificationUI();
        });
      }

      setTimeout(updateNotificationUI, 500);

      // ⭐ notificationManager değişikliklerini dinle
      if (window.notificationManager) {
        window.notificationManager.onUpdate(function() {
          updateNotificationUI();
        });
      }
    });

    // ⭐ Global export
    window.updateNotificationUI = updateNotificationUI;

    console.log('✅ Notification bell loaded! (modüler uyumlu)');
  })();
</script>
</file>

