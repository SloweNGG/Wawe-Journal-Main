<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign Up – Wawe Journal</title>
  <link rel="icon" type="image/svg+xml" href="resim.svg">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="styles.css" />
  <style>
    /* ═══════════════════════════════════════════════════════════════
       RENK DEĞİŞKENLERİ
       ═══════════════════════════════════════════════════════════════ */
    :root {
      --bg: #0a0a0f;
      --bg2: #0f0f17;
      --surface: #111118;
      --surface2: #1a1a24;
      --border: #1e1e2e;
      --text: #e8e8f0;
      --text2: #b8b8c8;
      --muted: #6b6b80;
      --accent: #7c6dfa;
      --accent2: #9b8bfa;
      --accent-glow: rgba(124,109,250,0.15);
      --green: #22c55e;
      --green-bg: rgba(34,197,94,0.12);
      --red: #ef4444;
      --red-bg: rgba(239,68,68,0.12);
      --radius: 14px;
      --radius-sm: 8px;
      --shadow: 0 4px 24px rgba(0,0,0,0.3);
      --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      --font: 'DM Sans', sans-serif;
      --font-mono: 'DM Mono', monospace;
      --font-display: 'Syne', sans-serif;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      height: 100%;
    }

    body {
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font);
      background: var(--bg);
      padding: 1.5rem;
      min-height: 100vh;
      color-scheme: dark;
    }

    /* ═══════════════════════════════════════════════════════════════
       ARKA PLAN - MOR SÜZME
       ═══════════════════════════════════════════════════════════════ */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      z-index: -1;
      background:
        radial-gradient(ellipse 80% 60% at 20% 80%, rgba(124, 109, 250, 0.12), transparent 60%),
        radial-gradient(ellipse 70% 50% at 80% 20%, rgba(124, 109, 250, 0.08), transparent 50%),
        radial-gradient(ellipse 60% 40% at 50% 50%, rgba(155, 139, 250, 0.04), transparent 50%),
        var(--bg);
      animation: breath 8s ease-in-out infinite alternate;
    }

    @keyframes breath {
      0% { opacity: 0.7; transform: scale(1); }
      100% { opacity: 1; transform: scale(1.04); }
    }

    body::after {
      content: '';
      position: fixed;
      inset: 0;
      z-index: -1;
      background:
        radial-gradient(ellipse 40% 30% at 30% 30%, rgba(124, 109, 250, 0.06), transparent 50%),
        radial-gradient(ellipse 40% 30% at 70% 70%, rgba(155, 139, 250, 0.04), transparent 50%);
      pointer-events: none;
      animation: pulseGlow 12s ease-in-out infinite alternate;
    }

    @keyframes pulseGlow {
      0% { opacity: 0.4; }
      100% { opacity: 1; }
    }

    /* ═══════════════════════════════════════════════════════════════
       LOGO
       ═══════════════════════════════════════════════════════════════ */
    .brand-logo {
      position: fixed;
      top: 1.5rem;
      left: 1.5rem;
      z-index: 10;
      display: flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      transition: transform 0.3s ease;
    }

    .brand-logo:hover {
      transform: scale(1.04);
    }

    .brand-logo .logo-icon {
      width: 34px;
      height: 34px;
      background: rgba(124, 109, 250, 0.08);
      border: 1px solid rgba(124, 109, 250, 0.12);
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: var(--transition);
    }

    .brand-logo:hover .logo-icon {
      border-color: var(--accent);
      background: rgba(124, 109, 250, 0.15);
      box-shadow: 0 0 40px rgba(124, 109, 250, 0.08);
    }

    .brand-logo .logo-icon svg {
      width: 17px;
      height: 17px;
      stroke: var(--accent);
      transition: stroke 0.3s ease;
    }

    .brand-logo:hover .logo-icon svg {
      stroke: var(--accent2);
    }

    /* ═══════════════════════════════════════════════════════════════
       FORM
       ═══════════════════════════════════════════════════════════════ */
    .auth-wrap {
      width: 100%;
      max-width: 400px;
      margin: 0 auto;
      animation: formIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }

    @keyframes formIn {
      from { opacity: 0; transform: translateY(20px) scale(0.96); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .auth-box {
      background: var(--surface);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 2.25rem 2rem;
      box-shadow:
        0 24px 80px rgba(0, 0, 0, 0.5),
        0 0 0 1px rgba(124, 109, 250, 0.04) inset,
        0 0 60px rgba(124, 109, 250, 0.02);
      transition: var(--transition);
    }

    .auth-box:hover {
      border-color: rgba(124, 109, 250, 0.12);
      box-shadow:
        0 32px 100px rgba(0, 0, 0, 0.6),
        0 0 0 1px rgba(124, 109, 250, 0.06) inset,
        0 0 80px rgba(124, 109, 250, 0.03);
    }

    /* ═══════════════════════════════════════════════════════════════
       BAŞLIK
       ═══════════════════════════════════════════════════════════════ */
    .auth-title {
      font-family: var(--font-display);
      font-size: 1.7rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 0.2rem;
      letter-spacing: -0.03em;
    }

    .auth-sub {
      color: var(--text2);
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
      font-family: var(--font);
      opacity: 0.8;
    }

    .auth-sub a {
      color: var(--accent2);
      text-decoration: none;
      font-weight: 600;
      transition: color 0.2s;
    }

    .auth-sub a:hover {
      color: var(--accent);
    }

    /* ═══════════════════════════════════════════════════════════════
       DIVIDER - BEYAZ
       ═══════════════════════════════════════════════════════════════ */
    .divider {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin: 1.25rem 0;
      color: var(--text2);
      font-size: 12px;
      font-family: var(--font);
      opacity: 0.6;
    }

    .divider::before,
    .divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border);
    }

    /* ═══════════════════════════════════════════════════════════════
       GOOGLE BUTONU
       ═══════════════════════════════════════════════════════════════ */
    .btn-google {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      padding: 0.75rem 1rem;
      border-radius: 40px;
      border: 1px solid var(--border);
      background: var(--surface2);
      color: var(--text);
      font-family: var(--font);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: var(--transition);
    }

    .btn-google:hover {
      border-color: var(--accent);
      background: rgba(124, 109, 250, 0.06);
      transform: translateY(-2px);
      box-shadow: 0 8px 32px rgba(124, 109, 250, 0.08);
    }

    .btn-google:active {
      transform: scale(0.97);
    }

    .btn-google svg {
      width: 20px;
      height: 20px;
      flex-shrink: 0;
    }

    .btn-google svg path {
      fill: var(--accent) !important;
    }

    .btn-google:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none !important;
      box-shadow: none !important;
    }

    /* ═══════════════════════════════════════════════════════════════
       FORM ALANLARI - BEYAZ YAZI
       ═══════════════════════════════════════════════════════════════ */
    .field {
      margin-bottom: 1rem;
    }

    .field label {
      display: block;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text2);
      margin-bottom: 0.35rem;
      font-family: var(--font-mono);
      opacity: 0.8;
    }

    .field input {
      width: 100%;
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 0.7rem 0.9rem;
      color: var(--text);
      font-family: var(--font);
      font-size: 14px;
      outline: none;
      transition: var(--transition);
    }

    .field input::placeholder {
      color: var(--muted);
      opacity: 0.4;
    }

    .field input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 4px var(--accent-glow), 0 0 0 1px var(--accent);
      background: var(--surface);
    }

    .field input:hover {
      border-color: rgba(124, 109, 250, 0.2);
    }

    /* ═══════════════════════════════════════════════════════════════
       SIGN UP BUTONU
       ═══════════════════════════════════════════════════════════════ */
    .btn-primary {
      width: 100%;
      padding: 0.8rem 1rem;
      border: none;
      border-radius: 40px;
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      color: #fff;
      font-family: var(--font);
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      transition: var(--transition);
      box-shadow: 0 4px 28px rgba(124, 109, 250, 0.25);
      letter-spacing: 0.03em;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 40px rgba(124, 109, 250, 0.35);
      background: linear-gradient(135deg, #8b7cfa, var(--accent));
    }

    .btn-primary:active {
      transform: scale(0.97);
    }

    .btn-primary:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none !important;
      box-shadow: none !important;
    }

    /* ═══════════════════════════════════════════════════════════════
       TERMS TEXT
       ═══════════════════════════════════════════════════════════════ */
    .terms-text {
      color: var(--text2);
      font-size: 12px;
      text-align: center;
      margin-top: 1rem;
      font-family: var(--font);
      opacity: 0.6;
    }

    .terms-text a {
      color: var(--accent2);
      text-decoration: none;
      font-weight: 500;
      transition: color 0.2s;
    }

    .terms-text a:hover {
      color: var(--accent);
    }

    /* ═══════════════════════════════════════════════════════════════
       TOAST - SAĞ ALT
       ═══════════════════════════════════════════════════════════════ */
    .toast-container {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      max-width: 360px;
      width: 100%;
      pointer-events: none;
    }

    .toast {
      pointer-events: all;
      padding: 0.8rem 1.2rem;
      border-radius: var(--radius-sm);
      font-family: var(--font);
      font-size: 13px;
      font-weight: 500;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 10px;
      box-shadow: 0 8px 40px rgba(0, 0, 0, 0.4);
      animation: toastIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both;
      border: 1px solid rgba(255, 255, 255, 0.06);
      backdrop-filter: blur(16px);
    }

    .toast.error {
      background: rgba(239, 68, 68, 0.92);
      border-color: rgba(239, 68, 68, 0.2);
    }

    .toast.success {
      background: rgba(34, 197, 94, 0.92);
      border-color: rgba(34, 197, 94, 0.2);
    }

    .toast.info {
      background: rgba(124, 109, 250, 0.92);
      border-color: rgba(124, 109, 250, 0.2);
    }

    .toast .toast-icon {
      font-size: 17px;
      flex-shrink: 0;
    }

    .toast .toast-close {
      background: none;
      border: none;
      color: rgba(255, 255, 255, 0.4);
      cursor: pointer;
      font-size: 15px;
      padding: 0 4px;
      margin-left: auto;
      transition: color 0.2s;
    }

    .toast .toast-close:hover {
      color: #fff;
    }

    @keyframes toastIn {
      from { opacity: 0; transform: translateX(30px) scale(0.95); }
      to { opacity: 1; transform: translateX(0) scale(1); }
    }

    .toast.hide {
      animation: toastOut 0.3s ease both;
    }

    @keyframes toastOut {
      from { opacity: 1; transform: translateX(0) scale(1); }
      to { opacity: 0; transform: translateX(30px) scale(0.95); }
    }

    /* ═══════════════════════════════════════════════════════════════
       RESPONSIVE
       ═══════════════════════════════════════════════════════════════ */
    @media (max-width: 600px) {
      body {
        padding: 1rem;
      }

      .auth-box {
        padding: 1.75rem 1.5rem;
      }

      .auth-title {
        font-size: 1.4rem;
      }

      .auth-sub {
        font-size: 0.85rem;
      }

      .brand-logo {
        top: 1rem;
        left: 1rem;
      }

      .brand-logo .logo-icon {
        width: 30px;
        height: 30px;
      }

      .brand-logo .logo-icon svg {
        width: 15px;
        height: 15px;
      }

      .auth-wrap {
        max-width: 100%;
      }

      .field input {
        padding: 0.65rem 0.85rem;
        font-size: 13px;
      }

      .btn-google {
        padding: 0.65rem 0.9rem;
        font-size: 13px;
      }

      .btn-primary {
        padding: 0.7rem 0.9rem;
        font-size: 14px;
      }

      .toast-container {
        bottom: 1rem;
        right: 1rem;
        max-width: calc(100% - 2rem);
      }
    }

    @media (max-width: 400px) {
      .auth-box {
        padding: 1.5rem 1.15rem;
      }

      .auth-title {
        font-size: 1.2rem;
      }

      .btn-google {
        font-size: 12px;
        padding: 0.6rem 0.8rem;
      }

      .btn-primary {
        font-size: 13px;
        padding: 0.65rem 0.8rem;
      }

      .brand-logo {
        top: 0.75rem;
        left: 0.75rem;
      }

      .brand-logo .logo-icon {
        width: 26px;
        height: 26px;
      }

      .brand-logo .logo-icon svg {
        width: 13px;
        height: 13px;
      }
    }

    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
  </style>
</head>
<body>

  <!-- ═══════════════════════════════════════════════════════════════
       LOGO
       ═══════════════════════════════════════════════════════════════ -->
  <a href="index.html" class="brand-logo">
    <div class="logo-icon">
      <svg width="17" height="17" viewBox="0 0 22 22" fill="none">
        <polyline points="2,16 7,9 12,13 19,4" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  </a>

  <!-- ═══════════════════════════════════════════════════════════════
       FORM
       ═══════════════════════════════════════════════════════════════ -->
  <div class="auth-wrap">
    <div class="auth-box">
      <h1 class="auth-title">Create Account</h1>
      <p class="auth-sub">Already have an account? <a href="login.html">Login</a></p>

      <!-- Google -->
      <button class="btn-google" id="google-register-btn">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#7c6dfa"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#7c6dfa"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#7c6dfa"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#7c6dfa"/>
        </svg>
        Sign up with Google
      </button>

      <div class="divider">or sign up with email</div>

      <div class="field">
        <label>Username *</label>
        <input type="text" id="username" placeholder="e.g., traderjohn" autocomplete="username" />
      </div>

      <div class="field">
        <label>Email</label>
        <input type="email" id="email" placeholder="trader@example.com" autocomplete="email" />
      </div>

      <div class="field">
        <label>Password</label>
        <input type="password" id="password" placeholder="At least 6 characters" autocomplete="new-password" />
      </div>

      <div class="field">
        <label>Confirm Password</label>
        <input type="password" id="password2" placeholder="Re-enter password" autocomplete="new-password" />
      </div>

      <button class="btn-primary" id="register-btn">Sign Up</button>

      <p class="terms-text">
        By signing up, you agree to our <a href="terms.html">Terms of Use</a>.
      </p>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════
       TOAST
       ═══════════════════════════════════════════════════════════════ -->
  <div class="toast-container" id="toast-container"></div>

  <!-- ============================================================
       ⭐ SCRIPTS - GÜNCELLENDİ
       ============================================================ -->

  <!-- 1. ÜÇÜNCÜ PARTY KÜTÜPHANELER -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <!-- 2. CORE KONFİG (ES5) -->
  <script src="config.js"></script>

  <!-- 3. ⭐ ANA MODÜL SCRIPT (ES Module) -->
  <script type="module" src="/src/script.js"></script>

  <!-- 4. ⭐ SAYFA BAŞLATICI -->
  <script>
    // showToast ve isValidEmail zaten script.js'den window'a atanıyor

    function hasTurkishChars(str) {
      return /[ığüşöçİĞÜŞÖÇ]/.test(str);
    }

    async function signUpWithGoogle() {
      const btn = document.getElementById('google-register-btn');
      btn.disabled = true;
      btn.innerHTML = `
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:20px;height:20px;flex-shrink:0;animation:spin 1s linear infinite;">
          <circle cx="12" cy="12" r="10" stroke="#7c6dfa" stroke-width="2" stroke-dasharray="31.4 31.4" fill="none"/>
        </svg>
        Redirecting to Google...
      `;

      try {
        const { data, error } = await sb.auth.signInWithOAuth({
          provider: 'google',
          options: {
            redirectTo: window.location.origin + '/dashboard.html',
            queryParams: {
              access_type: 'offline',
              prompt: 'consent',
            }
          }
        });

        if (error) {
          console.error('Google sign up error:', error);
          window.showToast('Google sign up failed. Please try again.', 'error');
          btn.disabled = false;
          btn.innerHTML = `
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:20px;height:20px;flex-shrink:0;">
              <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#7c6dfa"/>
              <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#7c6dfa"/>
              <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#7c6dfa"/>
              <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#7c6dfa"/>
            </svg>
            Sign up with Google
          `;
        }
      } catch (err) {
        console.error('Unexpected error:', err);
        window.showToast('An unexpected error occurred. Please try again.', 'error');
        btn.disabled = false;
        btn.innerHTML = `
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:20px;height:20px;flex-shrink:0;">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#7c6dfa"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#7c6dfa"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#7c6dfa"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#7c6dfa"/>
          </svg>
          Sign up with Google
        `;
      }
    }

    document.getElementById('google-register-btn').addEventListener('click', signUpWithGoogle);

    document.getElementById('register-btn').addEventListener('click', async () => {
      const username = document.getElementById('username').value.trim();
      let email = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;
      const pass2 = document.getElementById('password2').value;

      email = email.toLowerCase();

      if (!username) {
        window.showToast('Username is required.', 'error');
        return;
      }

      if (username.length < 3) {
        window.showToast('Username must be at least 3 characters.', 'error');
        return;
      }

      if (!email || !password) {
        window.showToast('Email and password are required.', 'error');
        return;
      }

      if (hasTurkishChars(email)) {
        window.showToast('Email cannot contain Turkish characters.', 'error');
        return;
      }

      if (!window.isValidEmail(email)) {
        window.showToast('Please enter a valid email address.', 'error');
        return;
      }

      if (password.length < 6) {
        window.showToast('Password must be at least 6 characters.', 'error');
        return;
      }

      if (password !== pass2) {
        window.showToast('Passwords do not match.', 'error');
        return;
      }

      const btn = document.getElementById('register-btn');
      btn.disabled = true;
      btn.textContent = 'Signing up…';

      const { data, error } = await sb.auth.signUp({
        email,
        password,
        options: {
          data: { username: username }
        }
      });

      if (error) {
        window.showToast(error.message, 'error');
        btn.disabled = false;
        btn.textContent = 'Sign Up';
        return;
      }

      window.showToast('Registration successful! You can now log in. 🎉', 'success');
      setTimeout(() => window.location.href = 'login.html', 1500);
    });

    document.addEventListener('keydown', e => {
      if (e.key === 'Enter') document.getElementById('register-btn').click();
    });
  </script>
</body>
</html>
