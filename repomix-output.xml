<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Update Password – Wawe Journal</title>
  <link rel="icon" type="image/svg+xml" href="resim.svg">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="styles.css" />
  <style>
    :root {
      --bg: #0a0a0f;
      --bg2: #0f0f17;
      --surface: #111118;
      --surface2: #1a1a24;
      --border: #1e1e2e;
      --text: #e8e8f0;
      --text2: #b8b8c8;
      --muted: #6b6b80;
      --accent: #7c6dfa;
      --accent2: #9b8bfa;
      --accent-glow: rgba(124,109,250,0.15);
      --green: #22c55e;
      --green-bg: rgba(34,197,94,0.12);
      --red: #ef4444;
      --red-bg: rgba(239,68,68,0.12);
      --radius: 14px;
      --radius-sm: 8px;
      --shadow: 0 4px 24px rgba(0,0,0,0.3);
      --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      --font: 'DM Sans', sans-serif;
      --font-mono: 'DM Mono', monospace;
      --font-display: 'Syne', sans-serif;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      height: 100%;
    }

    body {
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font);
      background: var(--bg);
      padding: 1.5rem;
      min-height: 100vh;
      color-scheme: dark;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      z-index: -1;
      background:
        radial-gradient(ellipse 80% 60% at 20% 80%, rgba(124, 109, 250, 0.12), transparent 60%),
        radial-gradient(ellipse 70% 50% at 80% 20%, rgba(124, 109, 250, 0.08), transparent 50%),
        radial-gradient(ellipse 60% 40% at 50% 50%, rgba(155, 139, 250, 0.04), transparent 50%),
        var(--bg);
      animation: breath 8s ease-in-out infinite alternate;
    }

    @keyframes breath {
      0% { opacity: 0.7; transform: scale(1); }
      100% { opacity: 1; transform: scale(1.04); }
    }

    body::after {
      content: '';
      position: fixed;
      inset: 0;
      z-index: -1;
      background:
        radial-gradient(ellipse 40% 30% at 30% 30%, rgba(124, 109, 250, 0.06), transparent 50%),
        radial-gradient(ellipse 40% 30% at 70% 70%, rgba(155, 139, 250, 0.04), transparent 50%);
      pointer-events: none;
      animation: pulseGlow 12s ease-in-out infinite alternate;
    }

    @keyframes pulseGlow {
      0% { opacity: 0.4; }
      100% { opacity: 1; }
    }

    .brand-logo {
      position: fixed;
      top: 1.5rem;
      left: 1.5rem;
      z-index: 10;
      display: flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      transition: transform 0.3s ease;
    }

    .brand-logo:hover {
      transform: scale(1.04);
    }

    .brand-logo .logo-icon {
      width: 34px;
      height: 34px;
      background: rgba(124, 109, 250, 0.08);
      border: 1px solid rgba(124, 109, 250, 0.12);
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: var(--transition);
    }

    .brand-logo:hover .logo-icon {
      border-color: var(--accent);
      background: rgba(124, 109, 250, 0.15);
      box-shadow: 0 0 40px rgba(124, 109, 250, 0.08);
    }

    .brand-logo .logo-icon svg {
      width: 17px;
      height: 17px;
      stroke: var(--accent);
      transition: stroke 0.3s ease;
    }

    .brand-logo:hover .logo-icon svg {
      stroke: var(--accent2);
    }

    .auth-wrap {
      width: 100%;
      max-width: 400px;
      margin: 0 auto;
      animation: formIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }

    @keyframes formIn {
      from { opacity: 0; transform: translateY(20px) scale(0.96); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .auth-box {
      background: var(--surface);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 2.25rem 2rem;
      box-shadow:
        0 24px 80px rgba(0, 0, 0, 0.5),
        0 0 0 1px rgba(124, 109, 250, 0.04) inset,
        0 0 60px rgba(124, 109, 250, 0.02);
      transition: var(--transition);
    }

    .auth-box:hover {
      border-color: rgba(124, 109, 250, 0.12);
      box-shadow:
        0 32px 100px rgba(0, 0, 0, 0.6),
        0 0 0 1px rgba(124, 109, 250, 0.06) inset,
        0 0 80px rgba(124, 109, 250, 0.03);
    }

    .auth-title {
      font-family: var(--font-display);
      font-size: 1.7rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 0.2rem;
      letter-spacing: -0.03em;
    }

    .auth-sub {
      color: var(--text2);
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
      font-family: var(--font);
      opacity: 0.8;
    }

    .auth-sub a {
      color: var(--accent2);
      text-decoration: none;
      font-weight: 600;
      transition: color 0.2s;
    }

    .auth-sub a:hover {
      color: var(--accent);
    }

    .field {
      margin-bottom: 1rem;
    }

    .field label {
      display: block;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text2);
      margin-bottom: 0.35rem;
      font-family: var(--font-mono);
      opacity: 0.8;
    }

    .field input {
      width: 100%;
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 0.7rem 0.9rem;
      color: var(--text);
      font-family: var(--font);
      font-size: 14px;
      outline: none;
      transition: var(--transition);
    }

    .field input::placeholder {
      color: var(--muted);
      opacity: 0.4;
    }

    .field input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 4px var(--accent-glow), 0 0 0 1px var(--accent);
      background: var(--surface);
    }

    .field input:hover {
      border-color: rgba(124, 109, 250, 0.2);
    }

    .pw-strength {
      display: flex;
      gap: 3px;
      margin-top: 0.35rem;
      height: 3px;
    }

    .pw-strength-bar {
      flex: 1;
      border-radius: 99px;
      background: var(--border);
    }

    .pw-strength-bar.weak { background: var(--red); }
    .pw-strength-bar.medium { background: #facc15; }
    .pw-strength-bar.strong { background: var(--green); }

    .pw-strength-label {
      font-family: var(--font-mono);
      font-size: 9px;
      color: var(--muted);
      margin-top: 0.25rem;
    }

    .btn-primary {
      width: 100%;
      padding: 0.8rem 1rem;
      border: none;
      border-radius: 40px;
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      color: #fff;
      font-family: var(--font);
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      transition: var(--transition);
      box-shadow: 0 4px 28px rgba(124, 109, 250, 0.25);
      letter-spacing: 0.03em;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 40px rgba(124, 109, 250, 0.35);
      background: linear-gradient(135deg, #8b7cfa, var(--accent));
    }

    .btn-primary:active {
      transform: scale(0.97);
    }

    .btn-primary:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none !important;
      box-shadow: none !important;
    }

    .back-link {
      display: block;
      text-align: center;
      margin-top: 1rem;
      color: var(--text2);
      font-size: 13px;
      font-family: var(--font);
      text-decoration: none;
      transition: var(--transition);
      opacity: 0.6;
    }

    .back-link:hover {
      opacity: 1;
      color: var(--accent2);
    }

    .error-msg {
      display: none;
      color: var(--red);
      background: var(--red-bg);
      border: 1px solid rgba(239,68,68,0.2);
      padding: 0.7rem 1rem;
      border-radius: var(--radius-sm);
      font-size: 13px;
      margin-top: 0.75rem;
      font-family: var(--font);
    }

    .error-msg.show {
      display: block;
    }

    .success-msg {
      display: none;
      color: var(--green);
      background: var(--green-bg);
      border: 1px solid rgba(34,197,94,0.2);
      padding: 0.7rem 1rem;
      border-radius: var(--radius-sm);
      font-size: 13px;
      margin-top: 0.75rem;
      font-family: var(--font);
    }

    .success-msg.show {
      display: block;
    }

    .toast-container {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      max-width: 360px;
      width: 100%;
      pointer-events: none;
    }

    .toast {
      pointer-events: all;
      padding: 0.8rem 1.2rem;
      border-radius: var(--radius-sm);
      font-family: var(--font);
      font-size: 13px;
      font-weight: 500;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 10px;
      box-shadow: 0 8px 40px rgba(0, 0, 0, 0.4);
      animation: toastIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both;
      border: 1px solid rgba(255, 255, 255, 0.06);
      backdrop-filter: blur(16px);
    }

    .toast.error {
      background: rgba(239, 68, 68, 0.92);
      border-color: rgba(239, 68, 68, 0.2);
    }

    .toast.success {
      background: rgba(34, 197, 94, 0.92);
      border-color: rgba(34, 197, 94, 0.2);
    }

    .toast.info {
      background: rgba(124, 109, 250, 0.92);
      border-color: rgba(124, 109, 250, 0.2);
    }

    .toast .toast-icon {
      font-size: 17px;
      flex-shrink: 0;
    }

    .toast .toast-close {
      background: none;
      border: none;
      color: rgba(255, 255, 255, 0.4);
      cursor: pointer;
      font-size: 15px;
      padding: 0 4px;
      margin-left: auto;
      transition: color 0.2s;
    }

    .toast .toast-close:hover {
      color: #fff;
    }

    @keyframes toastIn {
      from { opacity: 0; transform: translateX(30px) scale(0.95); }
      to { opacity: 1; transform: translateX(0) scale(1); }
    }

    .toast.hide {
      animation: toastOut 0.3s ease both;
    }

    @keyframes toastOut {
      from { opacity: 1; transform: translateX(0) scale(1); }
      to { opacity: 0; transform: translateX(30px) scale(0.95); }
    }

    #loading-state {
      text-align: center;
      padding: 1rem;
      color: var(--muted);
    }

    #loading-state .spinner {
      width: 28px;
      height: 28px;
