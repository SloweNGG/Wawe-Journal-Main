  <style>
    /* ─── RESET & BASE ─── */
    * {
      box-sizing: border-box;
    }
    html, body {
      max-width: 100%;
      overflow-x: hidden;
    }
    img, svg, canvas {
      max-width: 100%;
    }

    /* ─── PSYCHOLOGY SECTION ─── */
    .psych-section {
      text-align: center;
      max-width: 800px;
      margin: 0 auto;
      padding: 1rem 1rem;
    }
    .psych-quote {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.5rem;
      line-height: 1.5;
      color: var(--text);
      margin-bottom: 1rem;
      font-weight: 500;
      letter-spacing: -0.3px;
    }
    .psych-quote::before {
      content: '"';
      font-size: 2rem;
      color: var(--accent);
      opacity: 0.4;
      margin-right: 4px;
    }
    .psych-quote::after {
      content: '"';
      font-size: 2rem;
      color: var(--accent);
      opacity: 0.4;
      margin-left: 4px;
      vertical-align: top;
    }
    .psych-author {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.85rem;
      color: var(--accent);
      letter-spacing: 1px;
    }

    /* ─── LANGUAGE SELECTOR ─── */
    .lang-selector {
      position: relative;
      margin-left: 0.5rem;
    }
    .lang-current {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border);
      border-radius: 40px;
      padding: 0.4rem 0.8rem;
      cursor: pointer;
      transition: all 0.2s ease;
      backdrop-filter: blur(4px);
    }
    .lang-current:hover {
      background: var(--accent-glow);
      border-color: var(--accent);
    }
    .lang-current-flag {
      font-size: 1rem;
    }
    .lang-current-text {
      font-family: 'DM Sans', sans-serif;
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--text);
    }
    .lang-current-arrow {
      font-size: 0.6rem;
      color: var(--muted);
      transition: transform 0.2s;
    }
    .lang-dropdown {
      position: absolute;
      top: 48px;
      right: 0;
      background: var(--surface2);
      backdrop-filter: blur(12px);
      border: 1px solid var(--border);
      border-radius: 14px;
      min-width: 130px;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition: all 0.2s ease;
      z-index: 300;
      box-shadow: 0 10px 25px rgba(0,0,0,0.3);
      overflow: hidden;
    }
    .lang-dropdown.show {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    .lang-option {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.6rem 1rem;
      cursor: pointer;
      transition: background 0.15s;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--text);
    }
    .lang-option:hover {
      background: var(--accent-glow);
    }
    .lang-option.active {
      background: rgba(139,92,246,0.15);
      color: var(--accent);
    }
    .lang-option-flag {
      font-size: 1rem;
    }
    .lang-option-name {
      flex: 1;
    }
    .lang-option-check {
      font-size: 0.7rem;
      color: var(--accent);
    }

    /* ─── PLANS SECTION ─── */
    .plans-section {
      padding: 4rem 2rem;
      max-width: 1200px;
      margin: 0 auto;
    }
    .plans-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      margin-top: 2rem;
      align-items: stretch;
    }

    .plan-card-home {
      display: flex;
      flex-direction: column;
      background: rgba(255, 255, 255, 0.02);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 1.5rem 1.5rem 1.5rem;
      text-align: center;
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                  border-color 0.35s ease,
                  box-shadow 0.35s ease,
                  background 0.35s ease;
      position: relative;
      overflow: hidden;
      isolation: isolate;
      cursor: pointer;
    }
    .plan-card-home::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 50% 0%, var(--accent-glow), transparent 70%);
      opacity: 0;
      transition: opacity 0.4s ease;
      pointer-events: none;
      z-index: -1;
    }
    .plan-card-home:hover {
      transform: translateY(-4px);
      border-color: var(--accent-glow);
      box-shadow: 0 16px 48px rgba(0,0,0,0.25), 0 0 0 1px var(--accent-glow) inset;
      background: rgba(255, 255, 255, 0.04);
    }
    .plan-card-home:hover::before {
      opacity: 1;
    }
    .plan-card-home.premium {
      border-color: rgba(139,92,246,0.18);
      background: rgba(139,92,246,0.04);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      transform: scale(1.02);
    }
    .plan-card-home.premium::before {
      background: radial-gradient(circle at 50% 0%, rgba(139,92,246,0.1), transparent 70%);
      opacity: 1;
    }
    .plan-card-home.premium:hover {
      transform: scale(1.02) translateY(-4px);
      border-color: rgba(139,92,246,0.35);
      box-shadow: 0 16px 48px var(--accent-glow), 0 0 0 1px rgba(139,92,246,0.1) inset;
    }
    .plan-card-home.premium::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--accent), var(--accent2), var(--accent), transparent);
      background-size: 300% 100%;
      animation: shimmerLine 4s ease-in-out infinite;
      border-radius: 20px 20px 0 0;
    }
    @keyframes shimmerLine {
      0% { background-position: 0% 0%; }
      50% { background-position: 100% 0%; }
      100% { background-position: 0% 0%; }
    }

    .plan-card-home .plan-badge {
      position: absolute;
      top: 10px;
      right: 10px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 7px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.2rem 0.6rem;
      border-radius: 20px;
      background: rgba(139,92,246,0.08);
      color: var(--accent2);
      border: 1px solid var(--border);
    }
    .plan-card-home .plan-badge.popular {
      background: var(--accent);
      color: #fff;
      border: none;
      box-shadow: 0 4px 16px var(--accent-glow);
      animation: pulseBadge 2s ease-in-out infinite;
    }
    @keyframes pulseBadge {
