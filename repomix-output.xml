  <a href="index.html" class="brand-logo">
    <div class="logo-icon">
      <svg width="17" height="17" viewBox="0 0 22 22" fill="none">
        <polyline points="2,16 7,9 12,13 19,4" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  </a>

  <div class="auth-wrap">
    <div class="auth-box">
      <h1 class="auth-title">Reset Password</h1>
      <p class="auth-sub">Enter your email and we'll send you a link to reset your password.</p>

      <div class="field">
        <label>Email</label>
        <input type="email" id="email" placeholder="trader@example.com" autocomplete="email" />
      </div>

      <p class="error-msg" id="err"></p>
      <div class="success-msg" id="success-msg">
        ✅ Password reset link sent! Check your email.
      </div>

      <button class="btn-primary" id="reset-btn">Send Reset Link</button>

      <a href="login.html" class="back-link">← Back to Login</a>
    </div>
  </div>

  <div class="toast-container" id="toast-container"></div>






  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>


  <script src="config.js"></script>


  <script type="module" src="/src/script.js"></script>


  <script>
    // showToast ve isValidEmail zaten script.js'den window'a atanıyor

    function hasTurkishChars(str) {
      return /[ığüşöçİĞÜŞÖÇ]/.test(str);
    }

    const resetBtn = document.getElementById('reset-btn');
    const emailInput = document.getElementById('email');
    const errEl = document.getElementById('err');
    const successEl = document.getElementById('success-msg');

    resetBtn.addEventListener('click', async () => {
      let email = emailInput.value.trim();
      errEl.classList.remove('show');
      successEl.classList.remove('show');

      email = email.toLowerCase();

      if (!email) {
        errEl.textContent = 'Email is required.';
        errEl.classList.add('show');
        return;
      }

      if (hasTurkishChars(email)) {
        errEl.textContent = 'Email cannot contain Turkish characters.';
        errEl.classList.add('show');
        return;
      }

      if (!window.isValidEmail(email)) {
        errEl.textContent = 'Please enter a valid email address.';
        errEl.classList.add('show');
        return;
      }

      resetBtn.disabled = true;
      resetBtn.textContent = 'Sending...';

      try {
        const { data, error } = await sb.auth.resetPasswordForEmail(email, {
          redirectTo: window.location.origin + '/update-password.html',
        });

        if (error) {
          errEl.textContent = error.message;
          errEl.classList.add('show');
          resetBtn.disabled = false;
          resetBtn.textContent = 'Send Reset Link';
          return;
        }

        successEl.classList.add('show');
        emailInput.value = '';
        resetBtn.disabled = false;
        resetBtn.textContent = 'Send Reset Link';

        setTimeout(() => {
          successEl.classList.remove('show');
        }, 8000);

      } catch (err) {
        errEl.textContent = 'An unexpected error occurred. Please try again.';
        errEl.classList.add('show');
        resetBtn.disabled = false;
        resetBtn.textContent = 'Send Reset Link';
      }
    });

    document.addEventListener('keydown', e => {
      if (e.key === 'Enter') resetBtn.click();
    });
  </script>
</body>
