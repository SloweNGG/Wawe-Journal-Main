  <script>
    console.log('🚀 Admin başlatılıyor...');

    // ⭐ Her script'in yüklendiğini kontrol et
    console.log('📦 script.js loaded:', typeof sb !== 'undefined' ? '✅' : '❌');
    console.log('📦 navbar.js loaded:', typeof loadNavbar !== 'undefined' ? '✅' : '❌');
    console.log('📦 admin-core.js loaded:', typeof adminState !== 'undefined' ? '✅' : '❌');
    console.log('📦 initAdmin loaded:', typeof initAdmin !== 'undefined' ? '✅' : '❌');
    console.log('📦 admin-data.js loaded:', typeof loadUsers !== 'undefined' ? '✅' : '❌');
    console.log('📦 admin-dashboard.js loaded:', typeof loadAnalyticsData !== 'undefined' ? '✅' : '❌');

    document.addEventListener('DOMContentLoaded', function() {
      console.log('📄 DOM yüklendi!');

      // Navbar
      if (typeof loadNavbar === 'function') {
        try {
          loadNavbar('navbar-container');
          console.log('✅ Navbar yüklendi!');
        } catch(e) {
          console.warn('⚠️ Navbar hatası:', e);
        }
      }

      // Lucide
      if (typeof lucide !== 'undefined') {
        try {
          lucide.createIcons();
          console.log('✅ Lucide icons initialized!');
        } catch(e) {
          console.warn('⚠️ Lucide hatası:', e);
        }
      }

      // ⭐ Admin - initAdmin kontrolü
      if (typeof initAdmin === 'function') {
        console.log('⏳ initAdmin başlatılıyor...');
        setTimeout(function() {
          try {
            initAdmin();
          } catch(e) {
            console.error('❌ Admin panel hatası:', e);
            alert('Admin panel hatası: ' + e.message);
          }
        }, 500);
      } else {
        console.error('❌ initAdmin fonksiyonu bulunamadı!');
        console.log('💡 admin-core.js dosyasının yolu: /js/admin/admin-core.js');
        console.log('💡 Dosyanın var olduğundan emin ol!');
        alert('admin-core.js yüklenemedi! Dosya yolunu kontrol et.');
      }
    });
  </script>
</body>
