<file path="public/backtest.html">
<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Backtest — Wawe Journal</title>
<link rel="stylesheet" href="styles.css">
<style>
  /* ============================================================
     BACKTEST SAYFASI - EK STİLLER
     styles.css içindeki değişkenleri ve bileşenleri kullanır
     ============================================================ */

  .bt-toolbar {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: end;
    margin-bottom: 1rem;
  }

  .bt-chart-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem;
    margin-bottom: 1.5rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .bt-chart-card:hover {
    border-color: rgba(139,92,246,0.3);
    box-shadow: 0 4px 16px rgba(139,92,246,0.08);
  }
  #bt-chart { width: 100%; height: 380px; }

  .bt-controls-row {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  .bt-controls-row .bt-divider {
    width: 1px;
    height: 22px;
    background: var(--border2);
  }
  .bt-speed {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-size: 11px;
    font-family: 'DM Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .bt-speed input[type="range"] {
    width: 100px;
    accent-color: var(--accent);
  }

  .bt-trade-panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: end;
  }

  .btn-buy, .btn-sell {
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    font-weight: 600;
    padding: 0.6rem 1.2rem;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 38px;
    color: #fff;
  }
  .btn-buy:hover:not(:disabled), .btn-sell:hover:not(:disabled) {
    transform: translateY(-1px);
    opacity: 0.92;
  }
  .btn-buy:active:not(:disabled), .btn-sell:active:not(:disabled) { transform: scale(0.97); }
  .btn-buy {
    background: linear-gradient(135deg, var(--green), #16a34a);
    box-shadow: 0 4px 12px var(--green-glow);
  }
  .btn-sell {
    background: linear-gradient(135deg, var(--red), #dc2626);
    box-shadow: 0 4px 12px var(--red-glow);
  }
  .btn-buy:disabled, .btn-sell:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
  }

  .bt-field-inline {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .bt-field-inline label {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    font-family: 'DM Mono', monospace;
  }
  .bt-field-inline input {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-family: 'DM Mono', monospace;
    font-size: 13px;
    padding: 0.55rem 0.7rem;
    width: 72px;
