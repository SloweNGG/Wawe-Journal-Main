  <div class="glow-line"></div>

  <!-- ═══ 01 DASHBOARD OVERVIEW ═══ -->
  <div class="section reveal">
    <div class="nsection reverse">
      <div class="ntext">
        <div class="ntag" data-i18n="dash.tag">01 — Trading Journal Dashboard</div>
        <h2 class="section-title" data-i18n="dash.title">Your complete performance edge on one clean screen.</h2>
        <p class="section-desc" data-i18n="dash.desc">Cumulative P&L curve, win rate, profit factor, daily breakdown, and best/worst trade analytics — all tracked in real time.</p>
      </div>
      <div class="nmock-video-frame">
        <div class="nmock-video-glow"></div>
        <div class="nmock nmock-image-wrap">
          <video
            src="https://odasapyhtdopbnlfhwde.supabase.co/storage/v1/object/public/landing-assets/Video%20Project%208.mp4"
            class="nmock-video"
            autoplay
            loop
            muted
            playsinline
            preload="auto"
          ></video>
        </div>
      </div>
    </div>
  </div>

  <div class="glow-line"></div>

  <!-- ═══ 02 STRATEGY ANALYTICS ═══ -->
  <div class="section reveal">
    <div class="nsection">
      <div class="ntext">
        <div class="ntag" data-i18n="strategy.tag">02 — Strategy Analytics</div>
        <h2 class="section-title" data-i18n="strategy.title">See which strategy is actually making money.</h2>
        <p class="section-desc" data-i18n="strategy.desc">Tag every trade with setups like ICT, SMT or Breakout. Compare win rate, P&L curves, and volume side by side.</p>
      </div>
      <div class="nmock nmock-strat-showcase">
        <div class="strat-cards-grid">
          <!-- Card 1: ICT (Losing setup) -->
          <div class="strat-card-model strat-card-ict">
            <div class="sc-top">
              <div class="sc-header">
                <div class="sc-name-row">
                  <div class="sc-color-bar" style="background:#22c55e;"></div>
                  <div>
                    <div class="sc-name">ICT</div>
                    <div class="sc-desc" data-i18n="strategy.no_desc">No Description</div>
                  </div>
                </div>
                <span class="sc-wr-dot neg" title="Win Rate: 0%"></span>
              </div>

              <div class="sc-stats">
                <div class="sc-stat">
                  <div class="sc-stat-lbl" data-i18n="strategy.trades">Trades</div>
                  <div class="sc-stat-val">2</div>
                </div>
                <div class="sc-stat">
                  <div class="sc-stat-lbl" data-i18n="strategy.win_rate">Win Rate</div>
                  <div class="sc-stat-val neg">0%</div>
                </div>
                <div class="sc-stat">
                  <div class="sc-stat-lbl" data-i18n="strategy.pnl">P&L</div>
                  <div class="sc-stat-val neg">-$685,00</div>
                </div>
              </div>

              <div class="sc-instrument-tag">
                <span class="sc-instrument-left">
                  <svg class="tag-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/>
                    <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
                    <path d="M4 22h16"/>
                    <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/>
                    <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/>
                    <path d="M18 2H6v7a6 6 0 0 0 12 0V2z"/>
                  </svg>
                  <span class="tag-name">forex EURUSD</span>
                </span>
                <span class="tag-pnl neg">-$685,00</span>
              </div>

              <div class="sc-spark-chart">
                <svg viewBox="0 0 240 44" preserveAspectRatio="none" class="sc-spark-svg" aria-hidden="true">
                  <defs>
                    <linearGradient id="ict-spark-grad" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="#ef4444" stop-opacity="0.32"/>
                      <stop offset="100%" stop-color="#ef4444" stop-opacity="0.0"/>
                    </linearGradient>
                  </defs>
                  <path d="M 0,16 C 50,16 90,20 140,28 C 180,34 210,38 240,40 L 240,44 L 0,44 Z" fill="url(#ict-spark-grad)"/>
                  <path d="M 0,16 C 50,16 90,20 140,28 C 180,34 210,38 240,40" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </div>
            </div>

            <div class="sc-footer">
              <div class="dir-pills">
                <span class="dp dp-long">
                  <svg class="dp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
                    <polyline points="16 7 22 7 22 13"/>
                  </svg>
                  Long 2
                </span>
              </div>
              <div class="sc-actions">
                <span class="sc-mock-btn" title="Edit">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
