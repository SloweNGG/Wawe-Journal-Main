---
import Layout from '../layouts/Layout.astro';
import LegalDisclosures from '../components/LegalDisclosures.astro';
---
<Layout
  lang="en"
  showNavbar={false}
  title="Wawe Journal - Trading Journal with Built-in Backtest Replay"
  description="Log every trade, find your mistakes and test your strategy. Trading journal, analytics and candle-by-candle backtest replay with cTrader sync and prop firm tracking."
  canonical="https://wawejournal.com/"
>
<Fragment slot="head">
  <meta name="theme-color" content="#000000" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Wawe Journal" />
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" />
  <link rel="stylesheet" href="/landing-glass.css?v=3" />

  <!-- Google Site Name, Brand Entity & WebSite Schema -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "https://wawejournal.com/#website",
        "url": "https://wawejournal.com/",
        "name": "Wawe Journal",
        "alternateName": ["WaweJournal", "Wawe Journal Trading"],
        "publisher": { "@id": "https://wawejournal.com/#organization" }
      },
      {
        "@type": "Organization",
        "@id": "https://wawejournal.com/#organization",
        "name": "Wawe Journal",
        "alternateName": ["WaweJournal"],
        "url": "https://wawejournal.com/",
        "logo": "https://wawejournal.com/images/brand/logo-512.png",
        "sameAs": [
          "https://www.instagram.com/wawejournal/"
        ]
      },
      {
        "@type": "SoftwareApplication",
        "@id": "https://wawejournal.com/#app",
        "name": "Wawe Journal",
        "alternateName": ["WaweJournal"],
        "description": "Wawe Journal is a trading journal with performance analytics and built-in candle-by-candle backtest replay, cTrader sync and prop firm rule tracking.",
        "applicationCategory": "FinanceApplication",
        "operatingSystem": "Web",
        "url": "https://wawejournal.com/",
        "author": { "@id": "https://wawejournal.com/#organization" },
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        }
      }
    ]
  }
  </script>

  <style is:global>
    * { box-sizing: border-box; }
    html {
      overflow-y: auto !important;
      overflow-x: hidden !important;
      height: auto !important;
      scroll-behavior: smooth;
    }
    /* clip (not hidden) so body does not become a scroll container and the sticky navbar keeps working */
    body {
      overflow-y: visible !important;
      overflow-x: clip !important;
      height: auto !important;
      min-height: 100vh !important;
      max-width: 100%;
    }
    #navbar-container { display: none !important; }
    /* landing page: app-scroll-container normal flow (scroll on html/body, not container) */
    #app-scroll-container {
      overflow: visible !important;
      height: auto !important;
      min-height: 100vh !important;
      display: block !important;
      width: 100% !important;
    }
  </style>

  <link rel="preload" href="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.117.3" as="script" />
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.117.3" is:inline defer></script>
  <script src="/config.js?v=8" is:inline defer></script>
  <script src="/index-i18n.js?v=9" is:inline defer></script>
  <script type="module" src="/src/bundle.js?v=8" is:inline defer></script>
</Fragment>

<div class="lp">
  <!-- ambient glows so the glass has something to blur -->
  <div class="glows" aria-hidden="true">
  <div class="glow drift d1"></div>
  <div class="glow drift d2"></div>
  <div class="glow drift d3"></div>
  <div class="glow drift d4"></div>
  <div class="glow drift d5"></div>
  </div>

  <!-- NAV: floating glass pill -->
  <header class="lp-head">
    <div class="g navbar" id="navbar">
      <a href="index.html" class="brand" aria-label="Wawe Journal home">
        <img class="logo-glow" src="/images/brand/logo-mark.png" srcset="/images/brand/logo-mark.png 1x, /images/brand/logo-mark@2x.png 2x" alt="" width="30" height="20" />
        <span class="navword">Wawe <span class="brand-accent">Journal</span></span>
      </a>
      <nav class="navlinks" aria-label="Primary">
        <a href="#journal" data-i18n="lp.nav.journal">Journal</a>
        <a href="#analytics" data-i18n="lp.nav.analytics">Analytics</a>
        <a href="#backtest" data-i18n="lp.nav.backtest">Backtest</a>
        <a href="#pricing" data-i18n="lp.nav.pricing">Pricing</a>
        <a href="#faq" data-i18n="lp.nav.faq">FAQ</a>
      </nav>
      <div class="grow"></div>
      <div class="lang-selector" id="lang-selector">
        <div class="lang-current mono" id="lang-current" role="button" tabindex="0" aria-label="Language"><span class="lang-current-flag">EN</span><span class="lang-current-arrow" aria-hidden="true">▾</span></div>
        <div class="g lang-dropdown" id="lang-dropdown">
          <div class="lang-option" data-lang="en" data-flag="EN"><span>English</span><span class="mono lang-code">EN</span></div>
          <div class="lang-option" data-lang="tr" data-flag="TR"><span>Türkçe</span><span class="mono lang-code">TR</span></div>
          <div class="lang-option" data-lang="de" data-flag="DE"><span>Deutsch</span><span class="mono lang-code">DE</span></div>
        </div>
      </div>
      <a href="login.html" class="navsignin" data-i18n="lp.nav.signin">Sign in</a>
      <a href="register.html" class="b bp bs" data-i18n="lp.nav.start">Start for free</a>
    </div>
  </header>

  <main id="top">

    <!-- HERO -->
    <section class="hero-scene" aria-label="Introduction">
      <div class="hero-copy">
        <a href="#backtest" class="g hero-badge">
          <span class="mono tag-new" data-i18n="lp.hero.new">NEW</span>
          <span data-i18n="lp.hero.new_text">Backtest is live →</span>
        </a>
        <h1 data-i18n-html="lp.hero.title_h">The trading journal<br>with built-in <span class="shine">backtest replay.</span></h1>
        <p class="hero-sub" data-i18n="lp.hero.sub">Log every trade, find your mistakes and test your strategy.</p>
        <div class="hero-actions">
          <a href="register.html" class="b bp b-lg" data-i18n="lp.hero.start">Start for free</a>
          <a href="login.html" class="b b-lg" data-i18n="lp.hero.signin">Sign in</a>
        </div>
      </div>
    </section>

    <!-- PLATFORMS -->
    <section class="platforms">
      <div class="g platforms-box">
        <div class="mono eyebrow" data-i18n="lp.plat.label">IMPORT FROM YOUR BROKER OR PLATFORM</div>
        <div class="chips">
          <span class="chip">MetaTrader 5</span><span class="chip">MetaTrader 4</span><span class="chip">cTrader</span><span class="chip">TradingView</span><span class="chip">Binance</span><span class="chip">Bybit</span><span class="chip">Interactive Brokers</span><span class="chip">XTB</span><span class="chip">OANDA</span><span class="chip">CSV &amp; Excel</span>
        </div>
      </div>
    </section>

    <!-- JOURNAL -->
    <section id="journal" class="sec">
      <div class="sec-in">
        <div class="sec-head">
          <h2 data-i18n-html="lp.j.title_h">An easy way to journal your trades. <span class="dim">Import a statement or connect cTrader and you're done.</span></h2>
          <a href="register.html" class="b" data-i18n="lp.j.cta">Try for free</a>
        </div>
        <div class="journal-grid">
          <div class="g shot-card">
            <div class="shot-copy">
              <div class="mono tag" data-i18n="lp.j.dash_tag">DASHBOARD</div>
              <h3 data-i18n="lp.j.dash_t">Your whole trading month on one screen.</h3>
              <p data-i18n="lp.j.dash_d">Total P&amp;L, win rate, cumulative curve, best and worst trades, and your monthly goal.</p>
            </div>
            <img src="/images/landing/dashboard.webp" alt="Wawe Journal dashboard with total P&amp;L, win rate, cumulative P&amp;L curve and performance edge" width="1600" height="1059" loading="lazy" decoding="async" />
          </div>
          <div class="g sync-card">
            <div class="mono tag" data-i18n="lp.j.ct_tag">CTRADER SYNC</div>
            <div class="sync-status"><span class="dot-live"></span><span data-i18n="lp.j.ct_status">Connected · read-only</span></div>
            <p data-i18n="lp.j.ct_d">Closed positions land in your journal automatically. We never place or close orders.</p>
          </div>
        </div>
        <div class="cards4">
          <div class="g card18"><div class="card-t" data-i18n="lp.j.c1_t">Tags &amp; strategies</div><div class="card-d" data-i18n="lp.j.c1_d">Label every trade with your setup, session and mistakes.</div></div>
          <div class="g card18"><div class="card-t" data-i18n="lp.j.c2_t">Screenshots &amp; notes</div><div class="card-d" data-i18n="lp.j.c2_d">Keep the chart and the reasoning next to the result.</div></div>
          <div class="g card18"><div class="card-t" data-i18n="lp.j.c3_t">Overtrade alerts</div><div class="card-d" data-i18n="lp.j.c3_d">Daily trade and loss limits that warn you the moment you cross them.</div></div>
          <div class="g card18"><div class="card-t" data-i18n="lp.j.c4_t">Multiple journals</div><div class="card-d" data-i18n="lp.j.c4_d">Separate live, prop and practice accounts cleanly.</div></div>
        </div>
      </div>
    </section>

    <!-- ANALYTICS -->
    <section id="analytics" class="sec">
      <div class="sec-in">
        <div class="sec-head">
          <h2 data-i18n-html="lp.a.title_h">Analytics to understand what works. <span class="dim">And to drop what only feels right.</span></h2>
          <a href="register.html" class="b" data-i18n="lp.a.cta">View all metrics</a>
        </div>
        <div class="g frame frame-lg"><div class="frame-in"><img src="/images/landing/analytics.webp" alt="Performance analytics with profit factor, Sharpe ratio, insights, cumulative P&amp;L and strategy comparison" width="1600" height="783" loading="lazy" decoding="async" /></div></div>
        <div class="analytics-row">
          <div class="g frame frame-md"><div class="frame-in"><img src="/images/landing/strategies.webp" alt="Strategy panel comparing win rate and P&amp;L of ICT, Scalping, Smart Money and SMT" width="1600" height="1059" loading="lazy" decoding="async" /></div></div>
          <div class="metrics">
            <div class="g metric"><div class="metric-k" data-i18n="lp.a.m1">Win rate</div><div class="mono metric-v">68.7%</div></div>
            <div class="g metric"><div class="metric-k" data-i18n="lp.a.m2">Profit factor</div><div class="mono metric-v">8.71</div></div>
            <div class="g metric"><div class="metric-k" data-i18n="lp.a.m3">Payoff ratio</div><div class="mono metric-v">3.98x</div></div>
            <div class="g metric"><div class="metric-k" data-i18n="lp.a.m4">Avg win</div><div class="mono metric-v">+$302.99</div></div>
            <div class="g metric"><div class="metric-k" data-i18n="lp.a.m5">Max drawdown</div><div class="mono metric-v">−$609.04</div></div>
            <div class="g metric"><div class="metric-k" data-i18n="lp.a.m6">Expectancy</div><div class="mono metric-v">+$184.15</div></div>
          </div>
        </div>
        <div class="cards4">
          <div class="g card18"><div class="card-t" data-i18n="lp.a.c1_t">Cumulative P&amp;L</div><div class="card-d" data-i18n="lp.a.c1_d">Your equity curve, filtered by any tag, symbol or period.</div></div>
          <div class="g card18"><div class="card-t" data-i18n="lp.a.c2_t">Strategy comparison</div><div class="card-d" data-i18n="lp.a.c2_d">Win rate and P&amp;L curves of each setup side by side.</div></div>
          <div class="g card18"><div class="card-t" data-i18n="lp.a.c3_t">Day &amp; session breakdown</div><div class="card-d" data-i18n="lp.a.c3_d">Find the hours and days that cost you money.</div></div>
          <div class="g card18"><div class="card-t" data-i18n="lp.a.c4_t">Best &amp; worst trades</div><div class="card-d" data-i18n="lp.a.c4_d">Learn from the outliers instead of forgetting them.</div></div>
        </div>
      </div>
    </section>

    <!-- BACKTEST -->
    <section id="backtest" class="sec">
      <div class="sec-in">
        <div class="sec-head">
          <h2 class="wide" data-i18n-html="lp.b.title_h">Go back in time, candle by candle. <span class="dim">Practice on synthetic data or replay your own cTrader charts.</span></h2>
          <a href="register.html" class="b bp" data-i18n="lp.b.cta">Try a backtest</a>
        </div>
        <div class="g frame frame-lg"><div class="frame-in"><img src="/images/landing/backtest.webp" alt="Wawe backtest workspace replaying EURUSD H1 candles from cTrader with balance, equity and buy/sell panel" width="1600" height="1059" loading="lazy" decoding="async" /></div></div>
        <div class="steps">
          <div class="g stepcard"><span class="mono num">01</span><div class="step-t" data-i18n="lp.b.s1_t">Pick your data</div><div class="step-d" data-i18n="lp.b.s1_d">Start instantly on Wawe’s synthetic data, or connect cTrader for real candles up to the previous day.</div></div>
          <div class="g stepcard"><span class="mono num">02</span><div class="step-t" data-i18n="lp.b.s2_t">Replay and trade</div><div class="step-d" data-i18n="lp.b.s2_d">Step candle by candle or play at up to 10×. Place simulated buy and sell orders with lot size, stop loss and take profit. Nothing is sent to your broker.</div></div>
          <div class="g stepcard"><span class="mono num">03</span><div class="step-t" data-i18n="lp.b.s3_t">Review in your journal</div><div class="step-d" data-i18n="lp.b.s3_d">Every trade is saved to the linked journal. See its stats separately or combined with live trading.</div></div>
        </div>
      </div>
    </section>

    <!-- PROP FIRMS -->
    <section class="sec">
      <div class="sec-in prop">
        <div class="prop-copy">
          <h2 data-i18n-html="lp.p.title_h">Pass the challenge. <span class="dim">Watch every prop firm rule in real time.</span></h2>
          <p class="soft-p" data-i18n="lp.p.d">Daily loss, max drawdown and profit target, tracked against your firm's rule set. Overtrade alerts stop the spiral before it starts.</p>
          <div class="props">
            <span class="g prop-chip">FTMO</span><span class="g prop-chip">FundedNext</span><span class="g prop-chip">Topstep</span><span class="g prop-chip">Funding Pips</span><span class="g prop-chip">The 5%ers</span><span class="g prop-chip">E8 Markets</span><span class="g prop-chip">Apex Trader</span><span class="g prop-chip">Alpha Capital</span>
          </div>
        </div>
        <div class="g rules">
          <div class="rules-head"><span class="rules-title">FTMO · 2-Step · $100K</span><span class="mono rules-ex" data-i18n="lp.p.example">example</span></div>
          <div class="rule"><div class="rule-row"><span data-i18n="lp.p.r1">Daily loss limit</span><span class="mono">1.8% / 5%</span></div><div class="bar"><div class="bar-fill" style="width:36%;background:#8b5cf6;box-shadow:0 0 12px #8b5cf6"></div></div></div>
          <div class="rule"><div class="rule-row"><span data-i18n="lp.p.r2">Max drawdown</span><span class="mono">7.6% / 10%</span></div><div class="bar"><div class="bar-fill" style="width:76%;background:#f59e0b;box-shadow:0 0 12px #f59e0b"></div></div></div>
          <div class="rule"><div class="rule-row"><span data-i18n="lp.p.r3">Profit target</span><span class="mono">6.2% / 10%</span></div><div class="bar"><div class="bar-fill" style="width:62%;background:#22c55e;box-shadow:0 0 12px #22c55e"></div></div></div>
          <div class="rule-warn" data-i18n="lp.p.warn">Max drawdown at 76% of limit. 2.4% left.</div>
        </div>
      </div>
    </section>

    <!-- WHY + PRIVACY -->
    <section class="sec">
      <div class="sec-in stack32">
        <h2 class="center" data-i18n="lp.w.title">Why traders journal and backtest</h2>
        <div class="why">
          <div class="g stepcard"><span class="mono num">01</span><div class="step-t" data-i18n="lp.w.c1_t">Memory lies, data doesn’t</div><div class="step-d" data-i18n="lp.w.c1_d">A journal shows which setups actually pay, not the ones that feel good.</div></div>
          <div class="g stepcard"><span class="mono num">02</span><div class="step-t" data-i18n="lp.w.c2_t">Practice is cheaper than losses</div><div class="step-d" data-i18n="lp.w.c2_d">Backtest replay lets you rehearse a setup a hundred times before risking money.</div></div>
          <div class="g stepcard"><span class="mono num">03</span><div class="step-t" data-i18n="lp.w.c3_t">Rules protect funded accounts</div><div class="step-d" data-i18n="lp.w.c3_d">Tracking drawdown and daily loss keeps a bad day from ending a challenge.</div></div>
        </div>
        <div class="g privacy">
          <div class="privacy-copy">
            <div class="mono eyebrow accent" data-i18n="lp.w.priv_tag">YOUR DATA, YOUR RULES</div>
            <div class="privacy-t" data-i18n="lp.w.priv_t">Your trading data stays yours.</div>
            <div class="privacy-d" data-i18n="lp.w.priv_d">We never share your data with third parties. Wawe is not a broker and never trades on your accounts. Your trades are stored only on the secure infrastructure we run Wawe on.</div>
          </div>
          <a href="privacy.html" class="b">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
            <span data-i18n="lp.w.priv_btn">Privacy policy</span></a>
        </div>
      </div>
    </section>

    <!-- PRICING -->
    <section id="pricing" class="sec" data-period="monthly">
      <div class="sec-in pricing">
        <h2 class="center mid" data-i18n-html="lp.pr.title_h">Fair pricing. <span class="dim">Backtest, prop tracking and cTrader sync on every plan.</span></h2>
        <div role="group" aria-label="Billing period" class="g toggle">
          <button type="button" class="seg on" id="pick-monthly" aria-pressed="true" data-i18n="lp.pr.monthly">Monthly</button>
          <button type="button" class="seg" id="pick-yearly" aria-pressed="false" data-i18n="lp.pr.yearly">Yearly · save 31%</button>
        </div>
        <div class="plans">
          <div class="g plan">
            <div><div class="plan-top"><span class="mono plan-name" data-i18n="lp.pr.free_name">STARTER</span></div><div class="plan-price">$0</div><div class="plan-note" data-i18n="lp.pr.free_d">Everything you need to start journaling.</div></div>
            <div class="feats">
              <div class="feat"><span class="tick" aria-hidden="true">✓</span><span data-i18n="lp.pr.f1">Unlimited trade logging &amp; calendar</span></div>
              <div class="feat"><span class="tick" aria-hidden="true">✓</span><span data-i18n="lp.pr.f2">CSV &amp; broker import</span></div>
              <div class="feat"><span class="tick" aria-hidden="true">✓</span><span data-i18n="lp.pr.f3">Core analytics</span></div>
              <div class="feat"><span class="tick" aria-hidden="true">✓</span><span data-i18n="lp.pr.f4">1 backtest account</span></div>
              <div class="feat"><span class="tick" aria-hidden="true">✓</span><span data-i18n="lp.pr.f5">1 prop firm rule tracker</span></div>
              <div class="feat"><span class="tick" aria-hidden="true">✓</span><span data-i18n="lp.pr.f6">cTrader auto-sync</span></div>
            </div>
            <a href="register.html" class="b" data-i18n="lp.pr.free_btn">Start for free</a>
          </div>
          <div class="g plan plan-pro">
            <div>
              <div class="plan-top"><span class="mono plan-name pro" data-i18n="lp.pr.pro_name">PRO</span><span class="plan-badge" data-i18n="lp.pr.badge">Most popular</span></div>
              <div class="plan-price">$<span class="pm"><span id="monthly-price-value">12</span></span><span class="py"><span id="yearly-price-value">99</span></span><span class="per"><span class="pm" data-i18n="lp.pr.per_m"> / month</span><span class="py" data-i18n="lp.pr.per_y"> / year</span></span></div>
              <div class="plan-note soft"><span class="pm" data-i18n="lp.pr.note_m">For traders running several accounts and strategies.</span><span class="py" data-i18n="lp.pr.note_y">About $8.25 a month, 2 months free.</span></div>
            </div>
            <div class="feats">
              <div class="feat"><span class="tick" aria-hidden="true">✓</span><span data-i18n="lp.pr.p1">Everything in Starter</span></div>
              <div class="feat"><span class="tick" aria-hidden="true">✓</span><span data-i18n="lp.pr.p2">Up to 10 backtest accounts</span></div>
              <div class="feat"><span class="tick" aria-hidden="true">✓</span><span data-i18n="lp.pr.p3">Up to 10 prop firm rule trackers</span></div>
              <div class="feat"><span class="tick" aria-hidden="true">✓</span><span data-i18n="lp.pr.p4">Strategy comparison &amp; advanced analytics</span></div>
              <div class="feat"><span class="tick" aria-hidden="true">✓</span><span data-i18n="lp.pr.p5">Overtrade &amp; daily loss alerts</span></div>
              <div class="feat"><span class="tick" aria-hidden="true">✓</span><span data-i18n="lp.pr.p6">Customizable dashboard charts</span></div>
            </div>
            <a href="#" class="b bp" id="upgrade-pro-home" data-i18n="lp.pr.pro_btn">Go Pro</a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="sec">
      <div class="sec-in faq-wrap">
        <h2 class="center" data-i18n="lp.f.title">Frequently asked questions</h2>
        <div class="faq-list">
          <details class="g faq"><summary><span data-i18n="lp.f.q1">Is Wawe Journal free?</span><span class="plus" aria-hidden="true">+</span></summary><div class="faq-a"><span data-i18n="lp.f.a1">Yes. The free Starter plan covers everything beginner and intermediate traders need to journal and review their trades. When you’re ready to go deeper, Pro adds more backtest and prop firm accounts plus advanced analytics.</span></div></details>
          <details class="g faq"><summary><span data-i18n="lp.f.q2">Where does backtest data come from?</span><span class="plus" aria-hidden="true">+</span></summary><div class="faq-a"><span data-i18n="lp.f.a2">You have two options. Wawe’s own synthetic data set lets you start practicing instantly. If you want real market data, connect your cTrader broker and practice on real candles that are up to date to the previous day (1-day delay).</span></div></details>
          <details class="g faq"><summary><span data-i18n="lp.f.q3">Do backtest trades affect my real stats?</span><span class="plus" aria-hidden="true">+</span></summary><div class="faq-a"><span data-i18n="lp.f.a3">Only if you want them to. Backtest trades are saved to the journal you link, and you decide how to view them: as a separate journal with its own stats, or combined with your live trading.</span></div></details>
          <details class="g faq"><summary><span data-i18n="lp.f.q4">Can Wawe trade on my account?</span><span class="plus" aria-hidden="true">+</span></summary><div class="faq-a"><span data-i18n="lp.f.a4">No. Wawe is not a broker, so it never places trades on your real accounts. The only orders you place in Wawe are simulated ones in backtest practice accounts. Connect your real broker accounts to import your history, and use Sync to pull in your latest trades in seconds.</span></div></details>
          <details class="g faq"><summary><span data-i18n="lp.f.q5">Which brokers and platforms are supported?</span><span class="plus" aria-hidden="true">+</span></summary><div class="faq-a"><span data-i18n="lp.f.a5">Automatic sync is live for cTrader today.
You can also import statements from MetaTrader 4/5, TradingView, Binance, Bybit, Interactive Brokers, XTB, OANDA or any CSV/Excel file.
Auto-sync for NinjaTrader, the MetaTrader series and more is on the way. We add each integration only once it is error-free, because in trading there is no room for wrong numbers.</span></div></details>
          <details class="g faq"><summary><span data-i18n="lp.f.q6">Is my data private?</span><span class="plus" aria-hidden="true">+</span></summary><div class="faq-a"><span data-i18n="lp.f.a6">Yes. We never share your data with third parties. Your trades, broker connections and account data are stored only with the secure infrastructure providers we run Wawe on.</span> <a href="privacy.html" data-i18n="lp.f.a6_link">Read our privacy policy →</a></div></details>
        </div>
