---
import Layout from '../layouts/Layout.astro';
---
<Layout lang="en">
<Fragment slot="head">
  <!-- LANDING PAGE FONTS -->
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />


  <!-- ============================================================
  SEO - TEMEL
  ============================================================ -->
  <title>Wawe Journal - Professional Trading Journal for Traders</title>
  <meta name="description" content="Every great trader has a story. Wawe Journal helps you write yours. Log your trades, visualize your performance, and discover the strategies that actually work. Your trading destiny is in your hands...." />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://wawejournal.com/" />

  <!-- ============================================================
  OPEN GRAPH - Social Media
  ============================================================ -->
  <meta property="og:title" content="Wawe Journal - Professional Trading Journal" />
  <meta property="og:description" content="Track your trades, analyze your performance, and build discipline. Free trading journal with premium features." />
  <meta property="og:url" content="https://wawejournal.com/" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://wawejournal.com/og-image.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="Wawe Journal" />

  <!-- ============================================================
  TWITTER CARD
  ============================================================ -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Wawe Journal - Professional Trading Journal" />
  <meta name="twitter:description" content="Track your trades, analyze your performance, and build discipline. Free trading journal with premium features." />
  <meta name="twitter:image" content="https://wawejournal.com/og-image.jpg" />
  <meta name="twitter:site" content="@wawejournal" />

  <!-- ============================================================
  THEME & PWA
  ============================================================ -->
  <meta name="theme-color" content="#7c6dfa" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Wawe Journal" />

  <!-- ============================================================
  FAVICON & MANIFEST
  ============================================================ -->
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- ============================================================
  FONTS
  ============================================================ -->

  <!-- ============================================================
  ⭐ STYLES - SIRALAMA ÖNEMLİ
  ============================================================ -->
  <!-- 1. ÖNCE styles.css (TÜM değişkenleri içerir) -->
  <!-- 2. SONRA index.css (Landing'e özel stiller) -->
  <link rel="stylesheet" href="/index.css" />

  <!-- ============================================================
  JSON-LD Structured Data
  ============================================================ -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Wawe Journal",
    "description": "Professional Trading Journal for Traders. Track trades, analyze performance, and build discipline.",
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Web",
    "url": "https://wawejournal.com",
    "author": {
      "@type": "Organization",
      "name": "WaweDev Inc"
    },
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  }
  </script>

  <!-- ============================================================
  EXTRA STYLES (Sadece gerekli olanlar)
  ⭐ Plan kartı stilleri index.css'e taşındı.
  ============================================================ -->
  <style>
    /* ─── RESET & BASE ─── */
    * {
      box-sizing: border-box;
    }
    html, body {
      max-width: 100%;
      overflow-x: hidden;
    }
    img, svg, canvas {
      max-width: 100%;
    }

    /* ─── PSYCHOLOGY SECTION ─── */
    .psych-section {
      text-align: center;
      max-width: 800px;
      margin: 0 auto;
      padding: 1rem 1rem;
    }
    .psych-quote {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.5rem;
      line-height: 1.5;
      color: var(--text);
      margin-bottom: 1rem;
      font-weight: 500;
      letter-spacing: -0.3px;
    }
    .psych-quote::before {
      content: '"';
      font-size: 2rem;
      color: var(--accent);
      opacity: 0.4;
      margin-right: 4px;
    }
    .psych-quote::after {
      content: '"';
      font-size: 2rem;
      color: var(--accent);
      opacity: 0.4;
      margin-left: 4px;
      vertical-align: top;
    }
    .psych-author {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.85rem;
      color: var(--accent);
      letter-spacing: 1px;
    }

    /* ─── LANGUAGE SELECTOR ─── */
    .lang-selector {
      position: relative;
      margin-left: 0.5rem;
    }
    .lang-current {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border);
      border-radius: 40px;
      padding: 0.4rem 0.8rem;
      cursor: pointer;
      transition: all 0.2s ease;
      backdrop-filter: blur(4px);
    }
    .lang-current:hover {
      background: var(--accent-glow);
      border-color: var(--accent);
    }
    .lang-current-flag {
      font-size: 1rem;
    }
    .lang-current-text {
      font-family: 'DM Sans', sans-serif;
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--text);
    }
    .lang-current-arrow {
      font-size: 0.6rem;
      color: var(--muted);
      transition: transform 0.2s;
    }
    .lang-dropdown {
      position: absolute;
      top: 48px;
      right: 0;
      background: var(--surface2);
      backdrop-filter: blur(12px);
      border: 1px solid var(--border);
      border-radius: 14px;
      min-width: 130px;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      transition: all 0.2s ease;
      z-index: 300;
      box-shadow: 0 10px 25px rgba(0,0,0,0.3);
      overflow: hidden;
    }
    .lang-dropdown.show {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    .lang-option {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.6rem 1rem;
      cursor: pointer;
      transition: background 0.15s;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--text);
    }
    .lang-option:hover {
      background: var(--accent-glow);
    }
    .lang-option.active {
      background: rgba(139,92,246,0.15);
      color: var(--accent);
    }
    .lang-option-flag {
      font-size: 1rem;
    }
    .lang-option-name {
      flex: 1;
    }
    .lang-option-check {
      font-size: 0.7rem;
      color: var(--accent);
    }

    /* ─── NAV ─── */
    .nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
    }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-left: auto;
      margin-right: 0.5rem;
    }

    /* ─── RESPONSIVE ─── */
    @media (max-width: 768px) {
      .nav-links .btn-login,
      .nav-links .btn-register {
        display: none;
      }
      .lang-current-text {
        display: none;
      }
      .lang-current {
        padding: 0.4rem 0.6rem;
      }
      .psych-quote {
        font-size: 1.15rem;
      }
      .psych-author {
        font-size: 0.75rem;
      }
    }
    @media (min-width: 769px) {
      .lang-current-text {
        display: inline;
      }
    }
    @media (max-width: 600px) {
      .section-desc {
        padding: 0 0.5rem;
      }
      .psych-section {
        padding: 1rem 0.75rem;
      }
      .psych-quote {
        font-size: 1rem;
        line-height: 1.45;
      }
      .lang-selector {
        margin-left: 0.25rem;
      }
      .lang-current {
        padding: 0.35rem 0.5rem;
      }
      .nav {
        padding: 0.75rem 1rem;
      }
      #payment-methods-note {
        padding: 0 0.5rem;
        line-height: 1.5;
      }
    }
    @media (max-width: 400px) {
      .psych-quote {
        font-size: 0.9rem;
      }
    }
  </style>
</Fragment>
  <!-- ⭐ STARS BACKGROUND -->
  <canvas id="stars-canvas"></canvas>

  <!-- ⭐ NAVIGATION -->
  <nav class="nav">
    <a href="index.html" class="nav-logo">
      <div class="logo-icon">
        <svg width="16" height="16" viewBox="0 0 22 22" fill="none">
          <polyline points="2,16 7,9 12,13 19,4" stroke="var(--accent)" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      Wawe<span>Journal</span>
    </a>

    <div class="nav-links">
      <a href="login.html" class="btn-login" data-i18n="nav.login">Login</a>
      <a href="register.html" class="btn-register" data-i18n="nav.register">Sign Up →</a>
    </div>

    <div class="lang-selector" id="lang-selector">
      <div class="lang-current" id="lang-current">
        <span class="lang-current-flag">🇬🇧</span>
        <span class="lang-current-text">English</span>
        <span class="lang-current-arrow">▼</span>
      </div>
      <div class="lang-dropdown" id="lang-dropdown">
        <div class="lang-option" data-lang="tr" data-flag="🇹🇷" data-name="Türkçe">
          <span class="lang-option-flag">🇹🇷</span>
          <span class="lang-option-name">Türkçe</span>
          <span class="lang-option-check"></span>
        </div>
        <div class="lang-option" data-lang="en" data-flag="🇬🇧" data-name="English">
          <span class="lang-option-flag">🇬🇧</span>
          <span class="lang-option-name">English</span>
          <span class="lang-option-check">✓</span>
        </div>
        <div class="lang-option" data-lang="de" data-flag="🇩🇪" data-name="Deutsch">
          <span class="lang-option-flag">🇩🇪</span>
          <span class="lang-option-name">Deutsch</span>
          <span class="lang-option-check"></span>
        </div>
      </div>
    </div>

    <button class="hamburger" id="hamburger">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </nav>

  <!-- ⭐ MOBILE MENU -->
  <div class="mobile-menu" id="mobile-menu">
    <a href="strategies.html" data-i18n="nav.strategies">Strategies</a>
    <a href="login.html" data-i18n="nav.login">Login</a>
    <a href="register.html" class="btn-register-mobile" data-i18n="nav.register">Sign Up →</a>
  </div>
  <div class="menu-overlay" id="menu-overlay"></div>

  <!-- ⭐ HERO SECTION -->
  <section class="hero">
    <div class="hero-left">
      <div class="hero-badge">
        <div class="badge-dot"></div>
        <span data-i18n="hero.badge">More than just a journal.</span>
      </div>

      <h1>
        <span class="l1" data-i18n="hero.line1">DISCIPLINED</span>
        <span class="l2" data-i18n="hero.line2">TRADE.</span>
        <span class="l3" data-i18n="hero.line3">WIN. GROW.</span>
      </h1>

      <p class="hero-sub" data-i18n="hero.subtitle">
        Wawe Journal is the professional trading journal where you log every trade, track your performance, and build discipline.
      </p>

      <div class="hero-actions">
        <a href="register.html" class="btn-primary" data-i18n="hero.start_free">Start Free →</a>
        <a href="login.html" class="btn-ghost" data-i18n="hero.login">Login</a>
      </div>
    </div>

    <div class="hero-chart-wrap">
      <canvas id="hero-chart-canvas"></canvas>
      <div class="hero-float-card hfc-top">
        <div class="hfc-label" data-i18n="hero.win_rate">WIN RATE</div>
        <div class="hfc-value hfc-green">83.4%</div>
      </div>
      <div class="hero-float-card hfc-mid">
        <div class="hfc-label" data-i18n="hero.total_pnl">TOTAL P&L</div>
        <div class="hfc-value hfc-green">+$4,820</div>
      </div>
      <div class="hero-float-card hfc-bot">
        <div class="hfc-label" data-i18n="hero.current_price">XAUUSD</div>
        <div class="hfc-value">2341.80 <span class="hfc-green">↑</span></div>
      </div>
    </div>

    <div class="hero-stats">
      <div class="hstat">
        <div class="hstat-val" id="stat-total-users">—</div>
        <div class="hstat-label" data-i18n="stats.total_users">Total Users</div>
      </div>
      <div class="hstat">
        <div class="hstat-val" id="stat-total-trades">—</div>
        <div class="hstat-label" data-i18n="stats.total_trades">Trades Logged</div>
      </div>
      <div class="hstat">
        <div class="hstat-val" id="stat-today-users">—</div>
        <div class="hstat-label" data-i18n="stats.today_users">New Today</div>
      </div>
      <div class="hstat">
        <div class="hstat-val" id="stat-today-trades">—</div>
        <div class="hstat-label" data-i18n="stats.today_trades">Trades Today</div>
      </div>
    </div>
  </section>

  <!-- ⭐ DASHBOARD MOCKUP SHOWCASE (macOS window) -->
  <div class="mockup-section reveal">
    <div class="mockup-section-inner">
      <div class="mockup-glow"></div>
      <div class="macos-mockup">
        <div class="macos-mockup-bar">
          <div class="macos-dots">
            <span class="dot dot-red"></span>
            <span class="dot dot-yellow"></span>
            <span class="dot dot-green"></span>
          </div>
          <div class="macos-url-bar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            <span class="url-text">app.wawejournal.com/dashboard</span>
          </div>
        </div>
        <div class="macos-mockup-screen">
          <div class="mockup-skeleton" id="mockup-skeleton">
            <div class="spinner"></div>
          </div>
          <img id="dashboard-mockup-img" alt="Wawe Journal Dashboard" style="display:none;" />
        </div>
      </div>
    </div>
  </div>

  <div class="glow-line"></div>

  <!-- ⭐ PSYCHOLOGY QUOTE -->
  <div class="section reveal" style="padding: 3rem 2rem;">
    <div class="psych-section">
      <div class="psych-quote" id="quote-text"></div>
      <div class="psych-author" id="quote-author"></div>
    </div>
  </div>

  <div class="glow-line"></div>

  <!-- ⭐ FEATURES -->
  <div class="section reveal">
    <div class="section-tag" data-i18n="features.tag">Features</div>
    <h2 class="section-title" data-i18n-html="features.title">The <em>Trader's</em> Edge</h2>
    <p class="section-desc" data-i18n="features.desc">Designed not just to log — but to understand, improve, and outperform.</p>

    <div class="features-grid">
      <div class="feat-card">
        <div class="feat-num">01</div>
        <div class="feat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
          </svg>
        </div>
        <h3 data-i18n="feature.trade_log.title">Trade Log</h3>
        <p data-i18n="feature.trade_log.desc">Document the full story of every trade in seconds.</p>
      </div>
      <div class="feat-card">
        <div class="feat-num">02</div>
        <div class="feat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="20" x2="18" y2="10"/>
            <line x1="12" y1="20" x2="12" y2="4"/>
            <line x1="6" y1="20" x2="6" y2="14"/>
          </svg>
        </div>
        <h3 data-i18n="feature.dashboard.title">Live Dashboard</h3>
        <p data-i18n="feature.dashboard.desc">Win rate, average R, and drawdown at a glance.</p>
      </div>
      <div class="feat-card">
        <div class="feat-num">03</div>
        <div class="feat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="13 2 13 7 18 7"/>
            <path d="M3 8v13a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8"/>
            <path d="M3 8h18"/>
          </svg>
        </div>
        <h3 data-i18n="feature.fast.title">Fast & Professional</h3>
        <p data-i18n="feature.fast.desc">Just you and your trades. Focus, log, analyze.</p>
      </div>
      <div class="feat-card">
        <div class="feat-num">04</div>
        <div class="feat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
            <polyline points="3.29 7 12 12 20.71 7"/>
            <line x1="12" y1="22" x2="12" y2="12"/>
          </svg>
        </div>
        <h3 data-i18n="feature.strategy.title">Strategy Analytics</h3>
        <p data-i18n="feature.strategy.desc">See which strategies are most profitable at a glance.</p>
      </div>
    </div>
  </div>

  <div class="glow-line"></div>

  <!-- ⭐ PRICING -->
  <div class="section reveal plans-section">
    <div class="section-tag" data-i18n="plans.tag">💎 Pricing</div>
    <h2 class="section-title" data-i18n-html="plans.title">A Plan for <em>Everyone</em></h2>
    <p class="section-desc" data-i18n="plans.desc">Whether you're just starting out or a professional trader — choose the plan that fits you.</p>

    <div class="plans-grid" id="plans-grid">

      <!-- FREE -->
      <div class="plan-card-home" onclick="toggleFeatures(this)">
        <div class="plan-badge" data-i18n="plans.free_badge">FREE</div>
        <div class="plan-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2L2 7l10 5 10-5-10-5z"/>
            <path d="M2 17l10 5 10-5"/>
            <path d="M2 12l10 5 10-5"/>
          </svg>
        </div>
        <div class="plan-name" data-i18n="plans.free_name">Starter</div>
        <div class="plan-price">$0.00 <span data-i18n="plans.free_period">/ month</span></div>
        <p class="plan-desc" data-i18n="plans.free_desc">Start with the essentials.</p>

        <div class="plan-features-wrapper">
          <div class="plan-features-toggle">
            <span data-i18n="plans.show_features">Show Features</span>
            <span class="arrow">▼</span>
          </div>
          <ul class="plan-features-list">
            <li><span class="check">✓</span> <span data-i18n="plans.free_feature1">Unlimited Trades</span></li>
            <li><span class="check">✓</span> <span data-i18n="plans.free_feature2">Unlimited Strategies</span></li>
            <li><span class="check">✓</span> <span data-i18n="plans.free_feature3">Calendar View</span></li>
            <li><span class="check">✓</span> <span data-i18n="plans.free_feature4">Monthly Goal Tracking</span></li>
            <li><span class="check">✓</span> <span data-i18n="plans.free_feature5">Strategy Comparison</span></li>
            <li><span class="check">✓</span> <span data-i18n="plans.free_feature6">CSV Import/Export</span></li>
            <li><span class="check">✓</span> <span data-i18n="plans.free_feature7">Standard PDF Reports</span></li>
            <li class="is-disabled"><span class="cross">✕</span> <span data-i18n="plans.free_feature9">Premium Dashboard</span> <span class="premium-only">Premium</span></li>
            <li class="is-disabled"><span class="cross">✕</span> <span data-i18n="plans.free_feature10">Advanced Charts</span> <span class="premium-only">Premium</span></li>
            <li class="is-disabled"><span class="cross">✕</span> <span data-i18n="plans.free_feature11">Theme Customization</span> <span class="premium-only">Premium</span></li>
          </ul>
        </div>

        <a href="register.html" class="btn-plan free" data-i18n="plans.free_btn">Start Free →</a>
      </div>

      <!-- MONTHLY PREMIUM -->
      <div class="plan-card-home premium featured" onclick="toggleFeatures(this)">
        <div class="plan-badge popular" data-i18n="plans.popular">🔥 POPULAR</div>
        <div class="plan-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
        </div>
        <div class="plan-name" data-i18n="plans.premium_name">Premium Monthly</div>
        <div class="plan-price" id="price-monthly-home">$<span id="monthly-price-value">9.00</span> <span data-i18n="plans.premium_monthly_period">/ month</span></div>
        <p class="plan-desc" data-i18n="plans.premium_desc">Unlock all features.</p>

        <div class="plan-features-wrapper">
          <div class="plan-features-toggle">
            <span data-i18n="plans.show_features">Show Features</span>
            <span class="arrow">▼</span>
          </div>
          <ul class="plan-features-list">
            <li><span class="check">✓</span> <span data-i18n="plans.premium_feature1">All Free Features</span></li>
            <li><span class="check">✓</span> <span data-i18n="plans.premium_feature2">Premium Dashboard</span></li>
            <li><span class="check">✓</span> <span data-i18n="plans.premium_feature3">Drag & Drop Panels</span></li>
            <li><span class="check">✓</span> <span data-i18n="plans.premium_feature4">Advanced Charts</span></li>
