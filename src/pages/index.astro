---
import Layout from '../layouts/Layout.astro';
import LegalDisclosures from '../components/LegalDisclosures.astro';
---
<Layout
  lang="en"
  showNavbar={false}
  title="Wawe Journal – Free Trading Journal & Backtesting App"
  description="Wawe Journal is a free trading journal for forex, crypto and prop firm traders. Log every trade, ask an AI coach what works and replay the market candle by candle."
  canonical="https://wawejournal.com/"
>
<Fragment slot="head">
  <meta name="theme-color" content="#000000" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Wawe Journal" />
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="stylesheet" href="/landing-glass.css" />

  <!-- Google Site Name, Brand Entity & WebSite Schema -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "https://wawejournal.com/#website",
        "url": "https://wawejournal.com/",
        "name": "Wawe Journal",
        "alternateName": ["WaweJournal", "wawejournal", "wawejournal.com", "Wawe Journal Trading"],
        "publisher": { "@id": "https://wawejournal.com/#organization" }
      },
      {
        "@type": "Organization",
        "@id": "https://wawejournal.com/#organization",
        "name": "Wawe Journal",
        "alternateName": ["WaweJournal", "wawejournal"],
        "url": "https://wawejournal.com/",
        "logo": "https://wawejournal.com/images/brand/logo-512.png",
        "email": "support@wawejournal.com",
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "customer support",
          "email": "support@wawejournal.com",
          "availableLanguage": ["English", "Turkish", "German"]
        },
        "sameAs": [
          "https://www.instagram.com/wawejournal/"
        ]
      },
      {
        "@type": "SoftwareApplication",
        "@id": "https://wawejournal.com/#app",
        "name": "Wawe Journal",
        "alternateName": ["WaweJournal", "wawejournal"],
        "description": "Wawe Journal is a trading journal with performance analytics, an AI coach that answers from your own trades, built-in candle-by-candle backtest replay, cTrader sync and prop firm rule tracking.",
        "applicationCategory": "FinanceApplication",
        "operatingSystem": "Web",
        "url": "https://wawejournal.com/",
        "author": { "@id": "https://wawejournal.com/#organization" },
        "inLanguage": ["en", "tr", "de"],
        "featureList": [
          "Trade journal with tags, strategies, screenshots and notes",
          "Performance analytics: win rate, profit factor, expectancy, drawdown",
          "AI trading coach that answers from your own journal, with live alerts, a trading plan and weekly reviews",
          "Candle-by-candle backtest replay on synthetic or cTrader data",
          "cTrader auto-sync (read-only)",
          "Import from MetaTrader 4/5, TradingView, Binance, Bybit, Interactive Brokers, XTB, OANDA, CSV and Excel",
          "Prop firm rule tracking: daily loss, max drawdown, profit target",
          "Overtrade and daily loss alerts",
          "Multiple journals for live, prop and practice accounts"
        ],
        "offers": [
          {
            "@type": "Offer",
            "name": "Starter",
            "price": "0",
            "priceCurrency": "USD",
            "url": "https://wawejournal.com/#pricing"
          },
          {
            "@type": "Offer",
            "name": "Pro (monthly)",
            "price": "12",
            "priceCurrency": "USD",
            "url": "https://wawejournal.com/#pricing",
            "priceSpecification": {
              "@type": "UnitPriceSpecification",
              "price": "12",
              "priceCurrency": "USD",
              "billingDuration": "P1M"
            }
          },
          {
            "@type": "Offer",
            "name": "Pro (yearly)",
            "price": "99",
            "priceCurrency": "USD",
            "url": "https://wawejournal.com/#pricing",
            "priceSpecification": {
              "@type": "UnitPriceSpecification",
              "price": "99",
              "priceCurrency": "USD",
              "billingDuration": "P1Y"
            }
          }
        ]
      }
    ]
  }
  </script>

  <style is:global>
    * { box-sizing: border-box; }
    html {
      overflow-y: auto !important;
      overflow-x: hidden !important;
      height: auto !important;
      scroll-behavior: smooth;
    }
    /* clip (not hidden) so body does not become a scroll container and the sticky navbar keeps working */
    body {
      overflow-y: visible !important;
      overflow-x: clip !important;
      height: auto !important;
      min-height: 100vh !important;
      max-width: 100%;
    }
    #navbar-container { display: none !important; }
    /* landing page: app-scroll-container normal flow (scroll on html/body, not container) */
    #app-scroll-container {
      overflow: visible !important;
      height: auto !important;
      min-height: 100vh !important;
      display: block !important;
      width: 100% !important;
    }
  </style>

  <!-- LCP = hero arka planı (CSS'te geç keşfedilir): erken ve yüksek öncelikle iner. Mobil/masaüstü ayrımı
       landing-glass.css'teki @media (max-width: 900px) kuralıyla AYNI olmalı, yoksa iki görsel birden iner.
       Supabase SDK'sı burada preload EDİLMEZ: ilk ekran için gerekmiyor ve LCP görseliyle bant genişliği yarışıyordu. -->
  <link rel="preload" as="image" href="/images/brand/hero-peak.webp" media="(min-width: 901px)" fetchpriority="high" />
  <link rel="preload" as="image" href="/images/brand/hero-peak-m.webp" media="(max-width: 900px)" fetchpriority="high" />
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.117.3" is:inline defer></script>
  <script src="/config.js" is:inline defer></script>
  <script src="/index-i18n.js" is:inline defer></script>
  <script type="module" src="/src/bundle.js" is:inline defer></script>
  <script src="/landing-coach.js" is:inline defer></script>
</Fragment>

<div class="lp">
  <!-- ambient glows so the glass has something to blur -->
  <div class="glows" aria-hidden="true">
  <div class="glow drift d1"></div>
  <div class="glow drift d2"></div>
  <div class="glow drift d3"></div>
  <div class="glow drift d4"></div>
  <div class="glow drift d5"></div>
  </div>

  <!-- NAV: floating glass pill -->
  <header class="lp-head">
    <div class="g navbar" id="navbar">
      <a href="/" class="brand" aria-label="Wawe Journal home">
        <img class="logo-glow" src="/images/brand/logo-mark-48.webp" srcset="/images/brand/logo-mark-48.webp 1x, /images/brand/logo-mark-96.webp 2x" alt="" width="30" height="20" />
        <span class="navword">Wawe <span class="brand-accent">Journal</span></span>
      </a>
      <nav class="navlinks" aria-label="Primary">
        <a href="#journal" data-i18n="lp.nav.journal">Journal</a>
        <a href="#analytics" data-i18n="lp.nav.analytics">Analytics</a>
        <a href="#coach" data-i18n="lp.nav.coach">AI Coach</a>
        <a href="#backtest" data-i18n="lp.nav.backtest">Backtest</a>
        <a href="#pricing" data-i18n="lp.nav.pricing">Pricing</a>
        <a href="#faq" data-i18n="lp.nav.faq">FAQ</a>
      </nav>
      <div class="grow"></div>
      <div class="lang-selector" id="lang-selector">
        <div class="lang-current mono" id="lang-current" role="button" tabindex="0" aria-label="Language"><span class="lang-current-flag">EN</span><span class="lang-current-arrow" aria-hidden="true">▾</span></div>
        <div class="g lang-dropdown" id="lang-dropdown">
          <div class="lang-option" data-lang="en" data-flag="EN"><span>English</span><span class="mono lang-code">EN</span></div>
          <div class="lang-option" data-lang="tr" data-flag="TR"><span>Türkçe</span><span class="mono lang-code">TR</span></div>
          <div class="lang-option" data-lang="de" data-flag="DE"><span>Deutsch</span><span class="mono lang-code">DE</span></div>
        </div>
      </div>
      <a href="/login" class="navsignin" data-i18n="lp.nav.signin">Sign in</a>
      <a href="/register" class="b bp bs" data-i18n="lp.nav.start">Start for free</a>
    </div>
  </header>

  <main id="top">

    <!-- HERO -->
    <section class="hero-scene" aria-label="Introduction">
      <div class="hero-copy">
        <a href="#coach" class="g hero-badge">
          <span class="mono tag-new" data-i18n="lp.hero.new">NEW</span>
          <span data-i18n="lp.hero.new_text">Meet your AI coach →</span>
        </a>
        <h1 data-i18n-html="lp.hero.title_h">Never make the same<br><span class="shine">mistake twice.</span></h1>
        <p class="hero-sub" data-i18n="lp.hero.sub">Wawe Journal is a free trading journal with analytics, an AI coach, prop firm tracking and backtest replay. All in one place.</p>
        <div class="hero-actions">
          <a href="/register" class="b bp b-lg" data-i18n="lp.hero.start">Start for free</a>
          <a href="/login" class="b b-lg" data-i18n="lp.hero.signin">Sign in</a>
        </div>
      </div>

    </section>

    <!-- SHOWCASE: laptop mockup; lid opens on scroll, then the app screens change as you keep scrolling -->
    <section class="showcase" aria-label="Product preview">
      <div class="showcase-pin">
        <div class="showcase-copy">
          <div class="sc-caps">
            <h2 class="sc-cap is-on" data-i18n-html="lp.sc.cap_dashboard">Your whole account <span class="dim">at a glance.</span></h2>
            <h2 class="sc-cap" data-i18n-html="lp.sc.cap_trades">Every trade, <span class="dim">logged and sorted.</span></h2>
            <h2 class="sc-cap" data-i18n-html="lp.sc.cap_strategies">See which strategy <span class="dim">actually pays.</span></h2>
            <h2 class="sc-cap" data-i18n-html="lp.sc.cap_calendar">Your month, <span class="dim">day by day.</span></h2>
            <h2 class="sc-cap" data-i18n-html="lp.sc.cap_backtest">Replay the market, <span class="dim">candle by candle.</span></h2>
            <h2 class="sc-cap" data-i18n-html="lp.sc.cap_analytics">Know your edge, <span class="dim">in numbers.</span></h2>
          </div>
          <p data-i18n="lp.sc.sub">Journal, analytics, strategies and backtest in one app.</p>
        </div>
        <div class="hero-device">
          <div class="mbp">
            <div class="mbp-lid">
              <div class="mbp-screen">
                <div class="br" aria-hidden="true">
                  <div class="br-tabs">
                    <span class="br-dots"><i></i><i></i><i></i></span>
                    <span class="br-tab"><svg viewBox="0 0 24 24"><path d="M3 17l6-6 4 4 8-8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>Wawe Journal<b>×</b></span>
                    <span class="br-plus">+</span>
                  </div>
                  <div class="br-bar">
                    <span class="br-nav">‹&nbsp;&nbsp;›&nbsp;&nbsp;↻</span>
                    <span class="br-url"><svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2" fill="currentColor"/><path d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="2.4"/></svg><span><span class="br-host">wawejournal.com</span><span class="br-path">/dashboard</span></span></span>
                  </div>
                </div>
                <div class="sc-view">
                  <img class="sc-shot is-on" data-path="/dashboard" src="/images/landing/screen-dashboard.webp" alt="Wawe Journal Dashboard screen" width="1800" height="947" decoding="async" />
                  <img class="sc-shot" data-path="/trades" src="/images/landing/screen-trades.webp" alt="Wawe Journal Trades screen" width="1800" height="947" loading="lazy" decoding="async" />
                  <img class="sc-shot" data-path="/strategies" src="/images/landing/screen-strategies.webp" alt="Wawe Journal Strategies screen" width="1800" height="947" loading="lazy" decoding="async" />
                  <img class="sc-shot" data-path="/calendar" src="/images/landing/screen-calendar.webp" alt="Wawe Journal Calendar screen" width="1800" height="947" loading="lazy" decoding="async" />
                  <img class="sc-shot" data-path="/backtest" src="/images/landing/screen-backtest.webp" alt="Wawe Journal Backtest screen" width="1800" height="947" loading="lazy" decoding="async" />
                  <img class="sc-shot" data-path="/analytics" src="/images/landing/screen-analytics.webp" alt="Wawe Journal Analytics screen" width="1800" height="947" loading="lazy" decoding="async" />
                </div>
              </div>
              <img class="mbp-frame" src="/images/landing/mba-lid.webp" alt="" width="2080" height="1192" aria-hidden="true" loading="lazy" decoding="async" />
            </div>
            <img class="mbp-base" src="/images/landing/mba-base.webp" alt="" width="2080" height="63" aria-hidden="true" loading="lazy" decoding="async" />
          </div>
        </div>
        <div class="sc-tabs" role="tablist" aria-label="App screens">
          <button type="button" class="sc-tab is-on" data-i="0" data-i18n="lp.sc.tab_dashboard">Dashboard</button>
          <button type="button" class="sc-tab" data-i="1" data-i18n="lp.sc.tab_trades">Trades</button>
          <button type="button" class="sc-tab" data-i="2" data-i18n="lp.sc.tab_strategies">Strategies</button>
          <button type="button" class="sc-tab" data-i="3" data-i18n="lp.sc.tab_calendar">Calendar</button>
          <button type="button" class="sc-tab" data-i="4" data-i18n="lp.sc.tab_backtest">Backtest</button>
          <button type="button" class="sc-tab" data-i="5" data-i18n="lp.sc.tab_analytics">Analytics</button>
        </div>
      </div>
    </section>

    <!-- PLATFORMS -->
    <section class="platforms">
      <div class="g platforms-box">
        <div class="mono eyebrow" data-i18n="lp.plat.label">IMPORT FROM YOUR BROKER OR PLATFORM</div>
        <div class="chips">
          <span class="chip chip-soon">MetaTrader 4/5 <span class="mono chip-tag" data-i18n="lp.plat.soon">AUTO-SYNC SOON</span></span><span class="chip chip-live"><span class="dot-live" aria-hidden="true"></span>cTrader <span class="mono chip-tag" data-i18n="lp.plat.auto">AUTO-SYNC</span></span><span class="chip">Binance</span><span class="chip">Bybit</span><span class="chip">Interactive Brokers</span><span class="chip">XTB</span><span class="chip">OANDA</span><span class="chip">CSV &amp; Excel</span>
        </div>
        <p class="platforms-note" data-i18n="lp.plat.note">cTrader syncs automatically. For the others, import a statement or CSV.</p>
        <a href="/integrations" class="more-link" data-i18n="lp.plat.more">See every integration →</a>
      </div>
    </section>

    <!-- JOURNAL -->
    <section id="journal" class="sec">
      <div class="sec-in">
        <div class="sec-head">
          <h2 data-i18n-html="lp.j.title_h">An easy way to journal your trades. <span class="dim">Import a statement or connect cTrader and you're done.</span></h2>
          <a href="/register" class="b" data-i18n="lp.j.cta">Try for free</a>
        </div>
        <div class="journal-grid">
          <div class="g shot-card">
            <div class="shot-copy">
              <div class="mono tag" data-i18n="lp.j.dash_tag">DASHBOARD</div>
              <h3 data-i18n="lp.j.dash_t">Your whole trading month on one screen.</h3>
              <p data-i18n="lp.j.dash_d">Total P&amp;L, win rate, cumulative curve, best and worst trades, and your monthly goal.</p>
            </div>
            <img src="/images/landing/screen-dashboard.webp" alt="Wawe Journal dashboard with total P&amp;L, win rate, cumulative P&amp;L curve and performance edge" width="1800" height="947" loading="lazy" decoding="async" />
          </div>
          <div class="g sync-card">
            <div class="mono tag" data-i18n="lp.j.ct_tag">CTRADER SYNC</div>
            <div class="sync-status"><span class="dot-live"></span><span data-i18n="lp.j.ct_status">Connected · read-only</span></div>
            <p data-i18n="lp.j.ct_d">Closed positions land in your journal automatically. We never place or close orders.</p>
            <a href="/ctrader-trading-journal" class="more-link" data-i18n="lp.j.ct_more">How cTrader sync works →</a>
          </div>
        </div>
        <div class="cards4">
          <div class="g card18"><div class="card-t" data-i18n="lp.j.c1_t">Tags &amp; strategies</div><div class="card-d" data-i18n="lp.j.c1_d">Label every trade with your setup, session and mistakes.</div></div>
          <div class="g card18"><div class="card-t" data-i18n="lp.j.c2_t">Screenshots &amp; notes</div><div class="card-d" data-i18n="lp.j.c2_d">Keep the chart and the reasoning next to the result.</div></div>
          <div class="g card18"><div class="card-t" data-i18n="lp.j.c3_t">Overtrade alerts</div><div class="card-d" data-i18n="lp.j.c3_d">Daily trade and loss limits that warn you the moment you cross them.</div></div>
          <div class="g card18"><div class="card-t" data-i18n="lp.j.c4_t">Multiple journals</div><div class="card-d" data-i18n="lp.j.c4_d">Separate live, prop and practice accounts cleanly.</div></div>
        </div>
      </div>
    </section>

    <!-- ANALYTICS -->
    <section id="analytics" class="sec">
      <div class="sec-in">
        <div class="sec-head">
          <h2 data-i18n-html="lp.a.title_h">Analytics to understand what works. <span class="dim">And to drop what only feels right.</span></h2>
          <a href="/register" class="b" data-i18n="lp.a.cta">View all metrics</a>
        </div>
        <div class="g frame frame-lg"><div class="frame-in"><img src="/images/landing/screen-analytics.webp" alt="Performance analytics with profit factor, Sharpe ratio, prop firm rules, insights and cumulative P&amp;L" width="1800" height="947" loading="lazy" decoding="async" /></div></div>
        <div class="analytics-row">
          <div class="g frame frame-md"><div class="frame-in"><img src="/images/landing/screen-strategies.webp" alt="Strategy panel comparing win rate and P&amp;L of ICT, Pullback Trading, SMT and Support-Resistance" width="1800" height="947" loading="lazy" decoding="async" /></div></div>
          <div class="metrics">
            <div class="g metric"><div class="metric-k" data-i18n="lp.a.m1">Win rate</div><div class="mono metric-v">68.7%</div></div>
            <div class="g metric"><div class="metric-k" data-i18n="lp.a.m2">Profit factor</div><div class="mono metric-v">8.71</div></div>
            <div class="g metric"><div class="metric-k" data-i18n="lp.a.m3">Payoff ratio</div><div class="mono metric-v">3.98x</div></div>
            <div class="g metric"><div class="metric-k" data-i18n="lp.a.m4">Avg win</div><div class="mono metric-v">+$302.99</div></div>
            <div class="g metric"><div class="metric-k" data-i18n="lp.a.m5">Max drawdown</div><div class="mono metric-v">−$609.04</div></div>
            <div class="g metric"><div class="metric-k" data-i18n="lp.a.m6">Expectancy</div><div class="mono metric-v">+$184.15</div></div>
          </div>
        </div>
        <div class="cards4">
          <div class="g card18"><div class="card-t" data-i18n="lp.a.c1_t">Cumulative P&amp;L</div><div class="card-d" data-i18n="lp.a.c1_d">Your equity curve, filtered by any tag, symbol or period.</div></div>
          <div class="g card18"><div class="card-t" data-i18n="lp.a.c2_t">Strategy comparison</div><div class="card-d" data-i18n="lp.a.c2_d">Win rate and P&amp;L curves of each setup side by side.</div></div>
          <div class="g card18"><div class="card-t" data-i18n="lp.a.c3_t">Day &amp; session breakdown</div><div class="card-d" data-i18n="lp.a.c3_d">Find the hours and days that cost you money.</div></div>
          <div class="g card18"><div class="card-t" data-i18n="lp.a.c4_t">Best &amp; worst trades</div><div class="card-d" data-i18n="lp.a.c4_d">Learn from the outliers instead of forgetting them.</div></div>
        </div>
      </div>
    </section>

    <!-- AI COACH: the chat on the right cycles through the five coaches (public/landing-coach.js); without JS Kai stays -->
    <section id="coach" class="sec">
      <div class="sec-in">
        <div class="coach">
          <div class="coach-copy">
            <div class="mono eyebrow accent" data-i18n="lp.c.tag">NEW · AI COACH</div>
            <h2 data-i18n-html="lp.c.title_h">An AI coach that knows your trades. <span class="dim">Not just the market.</span></h2>
            <p class="soft-p" data-i18n="lp.c.d">Ask anything about your trading. The coach answers from your own journal: your trades, strategies, notes, prop challenges and backtests. Type, speak or drop in a chart screenshot.</p>
            <div class="coach-pick">
              <div class="mono coach-pick-h" data-i18n="lp.c.pick">PICK THE COACH FOR WHAT HOLDS YOU BACK</div>
              <div class="personas">
                <button type="button" class="g persona is-on" data-coach="kai" aria-pressed="true"><span class="wwc-av wwc-av-kai" style="--av:26px" aria-hidden="true"><span class="wwc-av-eyes"><i></i><i></i></span></span><b>Kai</b><span data-i18n="lp.c.kai">All-round</span><span class="persona-bar" aria-hidden="true"></span></button>
                <button type="button" class="g persona" data-coach="mira" aria-pressed="false"><span class="wwc-av wwc-av-mira" style="--av:26px" aria-hidden="true"><span class="wwc-av-eyes"><i></i><i></i></span></span><b>Mira</b><span data-i18n="lp.c.mira">Psychology</span><span class="persona-bar" aria-hidden="true"></span></button>
                <button type="button" class="g persona" data-coach="rex" aria-pressed="false"><span class="wwc-av wwc-av-rex" style="--av:26px" aria-hidden="true"><span class="wwc-av-eyes"><i></i><i></i></span></span><b>Rex</b><span data-i18n="lp.c.rex">Overtrading</span><span class="persona-bar" aria-hidden="true"></span></button>
                <button type="button" class="g persona" data-coach="atlas" aria-pressed="false"><span class="wwc-av wwc-av-atlas" style="--av:26px" aria-hidden="true"><span class="wwc-av-eyes"><i></i><i></i></span></span><b>Atlas</b><span data-i18n="lp.c.atlas">Discipline</span><span class="persona-bar" aria-hidden="true"></span></button>
                <button type="button" class="g persona" data-coach="nova" aria-pressed="false"><span class="wwc-av wwc-av-nova" style="--av:26px" aria-hidden="true"><span class="wwc-av-eyes"><i></i><i></i></span></span><b>Nova</b><span data-i18n="lp.c.nova">Risk</span><span class="persona-bar" aria-hidden="true"></span></button>
              </div>
            </div>
            <div><a href="/register" class="b bp" data-i18n="lp.c.cta">Meet your coach</a></div>
          </div>
          <div class="g chat" data-coach="kai">
            <div class="chat-orb" aria-hidden="true"></div>
            <div class="convos">
              <div class="convo is-on" data-coach="kai">
                <div class="chat-head">
                  <span class="chat-face"><span class="wwc-av wwc-av-kai" style="--av:40px" aria-hidden="true"><span class="wwc-av-eyes"><i></i><i></i></span></span></span>
                  <span class="chat-who"><span class="chat-name">Kai <span class="dim">· <span data-i18n="lp.c.role">AI Coach</span></span></span><span class="chat-focus" data-i18n="lp.c.kai">All-round</span></span>
