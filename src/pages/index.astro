        <div class="footer-col"><h4 data-i18n="footer.links">Links</h4><ul>
          <li><a href="index.html" data-i18n="nav.home">Home</a></li><li><a href="strategies.html" data-i18n="nav.strategies">Strategies</a></li><li><a href="login.html" data-i18n="nav.login">Login</a></li><li><a href="register.html" data-i18n="nav.register">Sign Up</a></li></ul></div>
