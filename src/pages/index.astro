---
import Layout from '../layouts/Layout.astro';
---
<Layout
  lang="en"
  showNavbar={false}
  title="Wawe Journal - Professional Trading Journal for Traders"
  description="Every great trader has a story. Wawe Journal helps you write yours. Track trades, analyze metrics, and build discipline."
  canonical="https://wawejournal.com/"
>
<Fragment slot="head">
  <meta name="theme-color" content="#050505" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Wawe Journal" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" />
  <link rel="stylesheet" href="/vendor/devices.css" />
  <link rel="stylesheet" href="/landing-preview.css?v=4" />

  <!-- Google Site Name, Brand Entity & WebSite Schema -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "https://wawejournal.com/#website",
        "url": "https://wawejournal.com/",
        "name": "Wawe Journal",
        "alternateName": ["WaweJournal", "Wawe Journal Trading"],
        "publisher": { "@id": "https://wawejournal.com/#organization" }
      },
      {
        "@type": "Organization",
        "@id": "https://wawejournal.com/#organization",
        "name": "Wawe Journal",
        "alternateName": ["WaweJournal"],
        "url": "https://wawejournal.com/",
        "logo": "https://wawejournal.com/og-image.jpg",
        "sameAs": [
          "https://x.com/wawejournal",
          "https://twitter.com/wawejournal",
          "https://www.instagram.com/wawejournal/",
          "https://youtube.com/@wawedev"
        ]
      },
      {
        "@type": "SoftwareApplication",
        "@id": "https://wawejournal.com/#app",
        "name": "Wawe Journal",
        "alternateName": ["WaweJournal"],
        "description": "Wawe Journal is an advanced crypto, forex, and stock trading journal and performance analytics platform for disciplined traders.",
        "applicationCategory": "FinanceApplication",
        "operatingSystem": "Web",
        "url": "https://wawejournal.com/",
        "author": { "@id": "https://wawejournal.com/#organization" },
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        }
      }
    ]
  }
  </script>

  <style is:global>
    * { box-sizing: border-box; }
    html {
      overflow-y: auto !important;
      overflow-x: hidden !important;
      height: auto !important;
      scroll-behavior: smooth;
    }
    body {
      overflow-y: auto !important;
      overflow-x: hidden !important;
      height: auto !important;
      min-height: 100vh !important;
      max-width: 100%;
    }
    #navbar-container { display: none !important; }
    /* landing page: app-scroll-container normal flow (scroll on html/body, not container) */
    #app-scroll-container {
      overflow: visible !important;
      height: auto !important;
      min-height: 100vh !important;
      display: block !important;
      width: 100% !important;
    }
  </style>

  <link rel="preload" href="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.117.3" as="script" />
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.117.3" is:inline defer></script>
  <script src="/config.js?v=8" is:inline defer></script>
  <script src="/index-i18n.js?v=8" is:inline defer></script>
  <script type="module" src="/src/bundle.js?v=8" is:inline defer></script>
</Fragment>

  <header class="nav">
    <div class="wrap nav-inner">
      <a href="index.html" class="nav-logo" aria-label="Wawe Journal">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true"><polyline points="2,16 7,9 12,13 19,4" stroke="currentColor" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>Wawe <span class="logo-accent">Journal</span></span>
      </a>
      <span class="nav-spacer"></span>
      <a href="#pricing" class="nav-link" data-i18n="nav.pricing">Pricing</a>
      <div class="nav-actions">
        <a href="login.html" class="btn btn-line" data-i18n="nav.login">Login</a>
        <a href="register.html" class="btn btn-solid" data-i18n="nav.register">Sign Up →</a>
      </div>
      <div class="lang-selector" id="lang-selector">
        <div class="lang-current" id="lang-current" role="button" tabindex="0" aria-label="Language"><span class="lang-current-flag">EN</span><span class="lang-current-arrow">▼</span></div>
        <div class="lang-dropdown" id="lang-dropdown">
          <div class="lang-option" data-lang="tr" data-flag="TR"><span>Türkçe</span><span class="lang-option-check"></span></div>
          <div class="lang-option active" data-lang="en" data-flag="EN"><span>English</span><span class="lang-option-check">✓</span></div>
          <div class="lang-option" data-lang="de" data-flag="DE"><span>Deutsch</span><span class="lang-option-check"></span></div>
        </div>
      </div>
      <button class="hamburger" id="hamburger" aria-label="Menu"><span></span><span></span><span></span></button>
    </div>
  </header>
  <div class="mobile-menu" id="mobile-menu">
    <a href="#pricing" data-i18n="nav.pricing">Pricing</a>
    <a href="login.html" data-i18n="nav.login">Login</a>
    <a href="register.html" class="btn btn-accent" data-i18n="nav.register">Sign Up →</a>
  </div>
  <div class="menu-overlay" id="menu-overlay"></div>

  <main>
  <section class="hero">
    <div class="wrap">
      <span class="pill anim" style="--d:.05s"><b data-i18n="hero.beta">BETA</b></span>
      <h1><span class="l1" data-i18n="hero.title">Stop guessing which trades work.</span></h1>
      <p class="hero-sub anim" style="--d:1.15s" data-i18n="hero.subtitle">Log every trade, see your real edge, and drop the strategies that only feel right. Your data, your discipline.</p>
      <div class="hero-actions anim" style="--d:1.3s">
        <a href="register.html" class="btn btn-accent btn-lg" data-i18n="hero.start_free">Start Free →</a>
        <a href="login.html" class="btn btn-line btn-lg" data-i18n="hero.login">Login</a>
      </div>
      <div class="hero-shot">
        <div class="mbp-wrap" id="mbp-wrap" role="img" aria-label="Wawe Journal dashboard on a laptop">
          <div class="device device-macbook-pro-2018 device-spacegray mbp">
            <div class="device-frame">
              <div class="device-screen"><video src="https://odasapyhtdopbnlfhwde.supabase.co/storage/v1/object/public/landing-assets/dashboardlong.mp4" autoplay loop muted playsinline preload="auto"></video></div>
            </div>
            <div class="device-power"></div>
          </div>
        </div>
        <div class="stats reveal">
          <div class="stat"><div class="stat-val" id="stat-total-users">—</div><div class="stat-label" data-i18n="stats.total_users">Total Users</div></div>
          <div class="stat"><div class="stat-val" id="stat-total-trades">—</div><div class="stat-label" data-i18n="stats.total_trades">Trades Logged</div></div>
          <div class="stat"><div class="stat-val" id="stat-today-users">—</div><div class="stat-label" data-i18n="stats.today_users">New Today</div></div>
          <div class="stat"><div class="stat-val" id="stat-today-trades">—</div><div class="stat-label" data-i18n="stats.today_trades">Trades Today</div></div>
        </div>
      </div>
    </div>
  </section>

  <section class="strip reveal">
    <div class="wrap">
      <div class="strip-label" data-i18n="platforms.label">SUPPORTED PLATFORMS & BROKERS</div>
      <div class="strip-marquee">
        <div class="strip-track">
          <div class="strip-set">
        <span class="strip-item"><img src="/images/platforms/mt5.png" alt="" width="20" height="20" loading="lazy" />MetaTrader 5</span>
        <span class="strip-item"><img src="/images/platforms/mt4.png" alt="" width="20" height="20" loading="lazy" />MetaTrader 4</span>
        <span class="strip-item"><img src="/images/platforms/ctrader_icon.png" alt="" width="20" height="20" loading="lazy" />cTrader</span>
        <span class="strip-item"><img src="/images/platforms/tradingview.svg" alt="" width="20" height="20" loading="lazy" />TradingView</span>
        <span class="strip-item"><img src="/images/platforms/binance.svg" alt="" width="20" height="20" loading="lazy" />Binance</span>
        <span class="strip-item"><img src="/images/platforms/bybit_icon.png" alt="" width="20" height="20" loading="lazy" />Bybit</span>
        <span class="strip-item"><img src="/images/platforms/ibkr_icon.png" alt="" width="20" height="20" loading="lazy" />Interactive Brokers</span>
        <span class="strip-item"><img src="/images/platforms/xtb_icon.png" alt="" width="20" height="20" loading="lazy" />XTB</span>
        <span class="strip-item"><img src="/images/platforms/oanda_icon.png" alt="" width="20" height="20" loading="lazy" />OANDA</span>
        <span class="strip-item"><img src="/images/platforms/excel.svg" alt="" width="20" height="20" loading="lazy" />CSV & Excel</span>
          </div>
          <div class="strip-set" aria-hidden="true">
        <span class="strip-item"><img src="/images/platforms/mt5.png" alt="" width="20" height="20" loading="lazy" />MetaTrader 5</span>
        <span class="strip-item"><img src="/images/platforms/mt4.png" alt="" width="20" height="20" loading="lazy" />MetaTrader 4</span>
        <span class="strip-item"><img src="/images/platforms/ctrader_icon.png" alt="" width="20" height="20" loading="lazy" />cTrader</span>
        <span class="strip-item"><img src="/images/platforms/tradingview.svg" alt="" width="20" height="20" loading="lazy" />TradingView</span>
        <span class="strip-item"><img src="/images/platforms/binance.svg" alt="" width="20" height="20" loading="lazy" />Binance</span>
        <span class="strip-item"><img src="/images/platforms/bybit_icon.png" alt="" width="20" height="20" loading="lazy" />Bybit</span>
        <span class="strip-item"><img src="/images/platforms/ibkr_icon.png" alt="" width="20" height="20" loading="lazy" />Interactive Brokers</span>
        <span class="strip-item"><img src="/images/platforms/xtb_icon.png" alt="" width="20" height="20" loading="lazy" />XTB</span>
        <span class="strip-item"><img src="/images/platforms/oanda_icon.png" alt="" width="20" height="20" loading="lazy" />OANDA</span>
        <span class="strip-item"><img src="/images/platforms/excel.svg" alt="" width="20" height="20" loading="lazy" />CSV & Excel</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="features-detail">
    <div class="wrap">
      <div class="bento">
        <article class="card wide reveal">
          <div class="card-media"><img src="/images/premium-dashboard-preview.png" alt="Performance analytics dashboard" width="1024" height="446" loading="lazy" /></div>
          <div class="card-body"><h3 class="card-title" data-i18n="dash.title">Your complete performance edge on one clean screen.</h3><p class="card-desc" data-i18n="dash.desc">Cumulative P&L curve, win rate, profit factor, daily breakdown, and best/worst trade analytics — all tracked in real time.</p></div>
        </article>

        <article class="card reveal">
          <div class="card-media"><img src="/images/features/strategy-panel.png" alt="Strategy panel" width="1024" height="475" loading="lazy" /></div>
          <div class="card-body"><h3 class="card-title" data-i18n="strategy.title">See which strategy is actually making money.</h3><p class="card-desc" data-i18n="strategy.desc">Tag every trade with setups like ICT, SMT or Breakout. Compare win rate, P&L curves, and volume side by side.</p></div>
        </article>

        <article class="card reveal">
          <div class="card-media"><img src="/images/features/calendar-preview.png" alt="Calendar and consistency view" width="1024" height="502" loading="lazy" /></div>
          <div class="card-body"><h3 class="card-title" data-i18n="cal.title">Discipline shows up as a pattern, not a mood.</h3><p class="card-desc" data-i18n="cal.desc">A month at a glance — win days, loss days, net P&L, and trading consistency.</p></div>
        </article>

        <article class="card reveal">
          <div class="card-media crop"><img src="/images/features/overtrade-notifications.png" alt="Over-trade risk notifications" width="472" height="565" loading="lazy" style="max-width:472px;margin:0 auto" /></div>
          <div class="card-body"><h3 class="card-title" data-i18n="ot.title">Stop emotional trading. Protect your capital.</h3><p class="card-desc" data-i18n="ot.desc">Instant visual alerts and limit counters trigger the moment you exceed your daily trade quota or maximum loss threshold.</p></div>
        </article>

        <article class="card list reveal">
          <div class="feat"><h3 class="feat-title" data-i18n="features.f_csv_title">Akıllı CSV & Broker Ekleme</h3><p class="feat-desc" data-i18n="features.f_csv_desc">MetaTrader 4/5, cTrader, TradingView, Bybit, Binance veya Excel dosyanızı sürükleyin; semboller, yön ve komisyonlar saniyeler içinde otomatik algılansın.</p></div>
          <div class="feat"><h3 class="feat-title" data-i18n="features.f_prop_title">Prop Firm Simülasyonu</h3><p class="feat-desc" data-i18n="features.f_prop_desc">FTMO, FundedNext, Topstep gibi fon şirketlerinin günlük zarar ve maksimum drawdown kurallarını canlı simüle edin; ihlal riski olmadan fon kazanın.</p></div>
          <div class="feat"><h3 class="feat-title" data-i18n="features.f_chart_title">Gelişmiş Grafikler</h3><p class="feat-desc" data-i18n="features.f_chart_desc">Kümülatif K/Z eğrileri, Sharpe oranı, kâr faktörü, gün ve seans bazlı derin matematiksel analizlerle gerçek performansınızı görün.</p></div>
          <div class="feat"><h3 class="feat-title" data-i18n="features.f_design_title">Sezgisel Tasarım ve Özelleştirme</h3><p class="feat-desc" data-i18n="features.f_design_desc">Karanlık ve aydınlık tema seçenekleri, esnek panel görünümleri ve dikkatinizi dağıtmayan akıcı kullanıcı deneyimiyle tam kontrol sizde.</p></div>
          <div class="feat"><h3 class="feat-title" data-i18n="features.f_privacy_title">Gizlilik Odaklı</h3><p class="feat-desc" data-i18n="features.f_privacy_desc">İşlem stratejileriniz ve verileriniz tamamen size özeldir. Üçüncü taraflarla asla paylaşılmaz; şifrelenmiş güvenli altyapı.</p></div>
        </article>
      </div>

      <div class="props-label" data-i18n="features.orbit_badge">Desteklenen Prop Firmaları & Broker Ekosistemi</div>
      <div class="strip-marquee props-marquee">
        <div class="strip-track">
          <div class="strip-set">
        <div class="props-cell"><img src="/images/props/real-ftmo.png" alt="" width="28" height="28" loading="lazy" />FTMO</div>
        <div class="props-cell"><img src="/images/props/real-fundednext.png" alt="" width="28" height="28" loading="lazy" />FundedNext</div>
        <div class="props-cell"><img src="/images/props/real-topstep.png" alt="" width="28" height="28" loading="lazy" />Topstep</div>
        <div class="props-cell"><img src="/images/props/real-fundingpips.png" alt="" width="28" height="28" loading="lazy" />Funding Pips</div>
        <div class="props-cell"><img src="/images/props/real-the5ers.png" alt="" width="28" height="28" loading="lazy" />The 5%ers</div>
        <div class="props-cell"><img src="/images/props/real-e8.png" alt="" width="28" height="28" loading="lazy" />E8 Markets</div>
        <div class="props-cell"><img src="/images/props/real-apex.png" alt="" width="28" height="28" loading="lazy" />Apex Trader</div>
        <div class="props-cell"><img src="/images/props/real-alpha.png" alt="" width="28" height="28" loading="lazy" />Alpha Capital</div>
          </div>
          <div class="strip-set" aria-hidden="true">
        <div class="props-cell"><img src="/images/props/real-ftmo.png" alt="" width="28" height="28" loading="lazy" />FTMO</div>
        <div class="props-cell"><img src="/images/props/real-fundednext.png" alt="" width="28" height="28" loading="lazy" />FundedNext</div>
        <div class="props-cell"><img src="/images/props/real-topstep.png" alt="" width="28" height="28" loading="lazy" />Topstep</div>
        <div class="props-cell"><img src="/images/props/real-fundingpips.png" alt="" width="28" height="28" loading="lazy" />Funding Pips</div>
        <div class="props-cell"><img src="/images/props/real-the5ers.png" alt="" width="28" height="28" loading="lazy" />The 5%ers</div>
        <div class="props-cell"><img src="/images/props/real-e8.png" alt="" width="28" height="28" loading="lazy" />E8 Markets</div>
        <div class="props-cell"><img src="/images/props/real-apex.png" alt="" width="28" height="28" loading="lazy" />Apex Trader</div>
        <div class="props-cell"><img src="/images/props/real-alpha.png" alt="" width="28" height="28" loading="lazy" />Alpha Capital</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section plans-section" id="pricing">
    <div class="wrap">
      <div class="sec-head center reveal">
        <h2 class="sec-title" data-i18n-html="plans.title">A Plan for <em>Everyone</em></h2>
        <p class="sec-desc" data-i18n="plans.desc">Choose the plan that fits you.</p>
      </div>
      <div class="plans reveal">
        <div class="plan">
          <div class="plan-tag" data-i18n="plans.free_tag">free</div>
          <div class="plan-name" data-i18n="plans.free_name">Starter</div>
          <div class="plan-price">$0<span data-i18n="plans.free_period"> / mo</span></div>
          <p class="plan-desc" data-i18n="plans.free_desc">Start with the essentials.</p>
          <ul class="plan-feats"><li data-i18n="plans.free_f1">Trade logging</li><li data-i18n="plans.free_f2">Calendar view</li><li data-i18n="plans.free_f3">CSV / PDF import</li><li data-i18n="plans.free_f4">Basic charts</li></ul>
          <a href="register.html" class="btn btn-line" data-i18n="plans.free_btn">Start free</a>
        </div>
        <div class="plan featured">
          <div class="plan-tag" data-i18n="plans.monthly_tag">most used</div>
          <div class="plan-name" data-i18n="plans.monthly_name">Premium monthly</div>
          <div class="plan-price">$<span id="monthly-price-value">12</span><span data-i18n="plans.monthly_period"> / mo</span></div>
          <p class="plan-desc" data-i18n="plans.monthly_desc">Unlock everything.</p>
          <ul class="plan-feats"><li data-i18n="plans.monthly_f1">All features</li><li data-i18n="plans.monthly_f2">Advanced customizable charts</li><li data-i18n="plans.monthly_f3">Theme settings</li><li data-i18n="plans.monthly_f4">Over trade notifications</li><li data-i18n="plans.monthly_f5">Advanced strategy analytics</li><li data-i18n="plans.monthly_f7">Customize Wawe journal</li><li data-i18n="plans.monthly_f8">Movable charts</li></ul>
          <a href="#" class="btn btn-accent" id="upgrade-monthly-home"><span data-i18n="plans.monthly_btn">Go premium</span></a>
        </div>
        <div class="plan">
          <div class="plan-tag" data-i18n="plans.yearly_tag">best value</div>
          <div class="plan-name" data-i18n="plans.yearly_name">Premium yearly</div>
          <div class="plan-price">$<span id="yearly-price-value">99</span><span data-i18n="plans.yearly_period"> / yr</span></div>
          <p class="plan-desc" data-i18n="plans.yearly_desc">Save 31% annually.</p>
          <ul class="plan-feats"><li data-i18n="plans.yearly_f1">All premium features</li><li data-i18n="plans.yearly_f2">2 months free</li></ul>
          <a href="#" class="btn btn-line" id="upgrade-yearly-home"><span data-i18n="plans.yearly_btn">Buy yearly</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="sec-head center reveal">
        <h2 class="sec-title" data-i18n-html="refs.title">Names We <em>Trust</em></h2>
        <p class="sec-desc" data-i18n="refs.desc">Experienced traders and content creators we work with.</p>
      </div>
      <div class="references-grid reveal" id="references-grid"><div class="loading-spinner"><div class="spinner"></div></div></div>

      <div class="cta reveal">
        <h2 data-i18n="cta.title">READY?</h2>
        <p data-i18n="cta.desc">Keeping a trading journal is a common habit of profitable traders. Start today and feel the difference.</p>
        <a href="register.html" class="btn btn-accent btn-lg" data-i18n="cta.button">Create Free Account →</a>
      </div>
    </div>
  </section>
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-top">
        <div class="footer-col">
          <div class="footer-logo"><svg width="20" height="20" viewBox="0 0 22 22" fill="none" aria-hidden="true"><polyline points="2,16 7,9 12,13 19,4" stroke="currentColor" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Wawe Journal</span></div>
