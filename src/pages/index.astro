---
import Layout from '../layouts/Layout.astro';
---
<Layout lang="en" showNavbar={false}>
<Fragment slot="head">
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <title>Wawe Journal (Wave Journal) - Professional Trading Journal for Traders</title>
  <meta name="description" content="Every great trader has a story. Wawe Journal helps you write yours." />
  <meta name="keywords" content="wawe journal, wave journal, wave trading journal, trading journal, wawejournal, crypto trading journal, forex journal" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://wawejournal.com/" />
  <meta property="og:title" content="Wawe Journal (Wave Journal) - Professional Trading Journal" />
  <meta property="og:description" content="Track your trades, analyze your performance, and build discipline." />
  <meta property="og:url" content="https://wawejournal.com/" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://wawejournal.com/og-image.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="Wawe Journal" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Wawe Journal - Professional Trading Journal" />
  <meta name="twitter:description" content="Track your trades, analyze your performance, and build discipline." />
  <meta name="twitter:image" content="https://wawejournal.com/og-image.jpg" />
  <meta name="twitter:site" content="@wawejournal" />
  <meta name="theme-color" content="#7c6dfa" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Wawe Journal" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="stylesheet" href="/index.css" />

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Wawe Journal",
    "alternateName": ["Wave Journal", "WaveJournal", "WaweJournal", "Wave Trading Journal"],
    "description": "Wawe Journal (also known as Wave Journal) is a modern trading journal and trade performance analytics platform for crypto, forex, and stock traders.",
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Web",
    "url": "https://wawejournal.com",
    "author": { "@type": "Organization", "name": "WaweDev Inc" },
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>

  <style>
    * { box-sizing: border-box; }
    html, body { max-width: 100%; overflow-x: hidden; }
    #navbar-container { display: none !important; }
    /* landing page: app-scroll-container normal flow (scroll on html/body, not container) */
    #app-scroll-container {
      overflow: unset !important;
      height: auto !important;
      display: block !important;
    }
    html { overflow-y: auto !important; }
  </style>
</Fragment>

  <!-- ═══ NAV ═══ -->
  <nav class="nav">
    <a href="index.html" class="nav-logo">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
        <polyline points="2,16 7,9 12,13 19,4" stroke="#8b5cf6" stroke-width="2.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>Wawe<span class="logo-accent">Journal</span></span>
    </a>

    <div class="nav-links">
      <a href="#pricing" class="nav-link" data-i18n="nav.pricing">Pricing</a>
      <a href="login.html" class="btn-login" data-i18n="nav.login">Login</a>
      <a href="register.html" class="btn-register" data-i18n="nav.register">Sign Up →</a>
    </div>

    <div class="lang-selector" id="lang-selector">
      <div class="lang-current" id="lang-current">
        <span class="lang-current-flag">🇬🇧</span>
        <span class="lang-current-arrow">▼</span>
      </div>
      <div class="lang-dropdown" id="lang-dropdown">
        <div class="lang-option" data-lang="tr" data-flag="🇹🇷">
          <span class="lang-option-flag">🇹🇷</span><span class="lang-option-check"></span>
        </div>
        <div class="lang-option active" data-lang="en" data-flag="🇬🇧">
          <span class="lang-option-flag">🇬🇧</span><span class="lang-option-check">✓</span>
        </div>
        <div class="lang-option" data-lang="de" data-flag="🇩🇪">
          <span class="lang-option-flag">🇩🇪</span><span class="lang-option-check"></span>
        </div>
      </div>
    </div>

    <button class="hamburger" id="hamburger"><span></span><span></span><span></span></button>
  </nav>

  <div class="mobile-menu" id="mobile-menu">
    <a href="#pricing" data-i18n="nav.pricing">Pricing</a>
    <a href="login.html" data-i18n="nav.login">Login</a>
    <a href="register.html" class="btn-register-mobile" data-i18n="nav.register">Sign Up →</a>
  </div>
  <div class="menu-overlay" id="menu-overlay"></div>

  <!-- ═══ HERO ═══ -->
  <section class="hero">
    <div class="hero-left">
      <div class="hero-beta-badge">
        <span class="beta-dot"></span>
        <span data-i18n="hero.beta">BETA</span>
      </div>

      <h1>
        <span class="l1" data-i18n="hero.title">Stop guessing which trades work.</span>
      </h1>

      <p class="hero-sub" data-i18n="hero.subtitle">
        Log every trade, see your real edge, and drop the strategies that only feel right. Your data, your discipline.
      </p>

      <div class="hero-actions">
        <a href="register.html" class="btn-primary" data-i18n="hero.start_free">Start Free →</a>
        <a href="login.html" class="btn-ghost" data-i18n="hero.login">Login</a>
      </div>

      <div class="hero-note" data-i18n="hero.note">Analyze beyond the standards.</div>
    </div>

    <div class="hero-chart-wrap">
      <canvas id="hero-chart-canvas"></canvas>
      <div class="hero-float-card hfc-top">
        <div class="hfc-label" data-i18n="hero.win_rate">WIN RATE</div>
        <div class="hfc-value hfc-green">83.4%</div>
      </div>
      <div class="hero-float-card hfc-mid">
        <div class="hfc-label" data-i18n="hero.total_pnl">TOTAL P&L</div>
        <div class="hfc-value hfc-green">+$4,820</div>
      </div>
      <div class="hero-float-card hfc-bot">
        <div class="hfc-label" data-i18n="hero.current_price">XAUUSD</div>
        <div class="hfc-value">2341.80 <span class="hfc-green">↑</span></div>
      </div>
    </div>

    <div class="hero-stats">
      <div class="hstat"><div class="hstat-val" id="stat-total-users">—</div><div class="hstat-label" data-i18n="stats.total_users">Total Users</div></div>
      <div class="hstat"><div class="hstat-val" id="stat-total-trades">—</div><div class="hstat-label" data-i18n="stats.total_trades">Trades Logged</div></div>
      <div class="hstat"><div class="hstat-val" id="stat-today-users">—</div><div class="hstat-label" data-i18n="stats.today_users">New Today</div></div>
      <div class="hstat"><div class="hstat-val" id="stat-today-trades">—</div><div class="hstat-label" data-i18n="stats.today_trades">Trades Today</div></div>
    </div>
  </section>

  <div class="glow-line"></div>

  <!-- ═══ 01 AI ═══ -->
  <div class="section reveal">
    <div class="nsection">
      <div class="ntext">
        <div class="ntag" data-i18n="ai.tag">01 — AI-powered analysis</div>
        <h2 class="section-title" data-i18n="ai.title">It reads your journal so you don't have to.</h2>
        <p class="section-desc" data-i18n="ai.desc">Wawe scans your logged trades and surfaces the patterns you'd otherwise miss.</p>
      </div>
      <div class="nmock">
        <div class="ai-msg"><div class="ai-dot">AI</div><div class="ai-text" data-i18n="ai.msg1">Your Thursday short trades close at a loss 71% of the time.</div></div>
        <div class="ai-msg"><div class="ai-dot">AI</div><div class="ai-text" data-i18n="ai.msg2">Your breakout strategy has been your most consistent setup over the last 30 days.</div></div>
        <div class="ai-msg"><div class="ai-dot">AI</div><div class="ai-text" data-i18n="ai.msg3">When a position stays open over 2 hours, your win rate drops by 18%.</div></div>
        <div class="ai-soon"><span class="ai-soon-dot"></span><span data-i18n="ai.coming">Wawe AI chatbot — Coming soon</span></div>
      </div>
    </div>
  </div>

  <div class="glow-line"></div>

  <!-- ═══ 02 STRATEGY ═══ -->
  <div class="section reveal">
    <div class="nsection reverse">
      <div class="ntext">
        <div class="ntag" data-i18n="strategy.tag">02 — Strategy analytics</div>
        <h2 class="section-title" data-i18n="strategy.title">See which strategy is actually making money.</h2>
        <p class="section-desc" data-i18n="strategy.desc">Tag every trade with its strategy, then compare win rate, R-multiple and volume side by side.</p>
      </div>
      <div class="nmock">
        <div class="sa-wrap">
          <div class="sa-donut"></div>
          <div class="sa-bars">
            <div class="sa-row"><span class="name">breakout</span><div class="sa-track"><div class="sa-fill" style="width:82%;background:var(--accent)"></div></div><span class="sa-pct">82%</span></div>
            <div class="sa-row"><span class="name">pullback</span><div class="sa-track"><div class="sa-fill" style="width:61%;background:var(--accent2)"></div></div><span class="sa-pct">61%</span></div>
            <div class="sa-row"><span class="name">news-fade</span><div class="sa-track"><div class="sa-fill" style="width:34%;background:var(--border)"></div></div><span class="sa-pct">34%</span></div>
          </div>
        </div>
        <div class="sa-legend">
          <span><i style="background:var(--accent)"></i><span data-i18n="strategy.breakout">Breakout</span> · 46%</span>
          <span><i style="background:var(--accent2)"></i><span data-i18n="strategy.pullback">Pullback</span> · 32%</span>
          <span><i style="background:var(--border)"></i><span data-i18n="strategy.news_fade">News-fade</span> · 22%</span>
        </div>
      </div>
    </div>
  </div>

  <div class="glow-line"></div>

  <!-- ═══ 03 CALENDAR ═══ -->
  <div class="section reveal">
    <div class="nsection">
      <div class="ntext">
        <div class="ntag" data-i18n="cal.tag">03 — Calendar & consistency</div>
        <h2 class="section-title" data-i18n="cal.title">Discipline shows up as a pattern, not a mood.</h2>
        <p class="section-desc" data-i18n="cal.desc">A week at a glance — win days, loss days, and the days you didn't trade at all.</p>
      </div>
      <div class="nmock">
        <div class="mock-cal">
          <div class="mock-cal-day win"><div class="n" data-i18n="cal.mon">Mon</div><div class="p">+2.1%</div></div>
          <div class="mock-cal-day loss"><div class="n" data-i18n="cal.tue">Tue</div><div class="p">−0.6%</div></div>
          <div class="mock-cal-day win"><div class="n" data-i18n="cal.wed">Wed</div><div class="p">+1.4%</div></div>
          <div class="mock-cal-day win"><div class="n" data-i18n="cal.thu">Thu</div><div class="p">+0.9%</div></div>
          <div class="mock-cal-day loss"><div class="n" data-i18n="cal.fri">Fri</div><div class="p">−1.1%</div></div>
          <div class="mock-cal-day"><div class="n" data-i18n="cal.sat">Sat</div><div class="p">—</div></div>
          <div class="mock-cal-day"><div class="n" data-i18n="cal.sun">Sun</div><div class="p">—</div></div>
        </div>
      </div>
    </div>
  </div>

  <div class="glow-line"></div>

  <!-- ═══ COMPARISON ═══ -->
  <div class="section reveal">
    <div class="section-tag" data-i18n="cmp.tag">Comparison</div>
    <h2 class="section-title" data-i18n="cmp.title">How Wawe Journal compares</h2>
    <p class="section-desc" data-i18n="cmp.desc">Public pricing and feature info as of 2026 — verify before deciding.</p>
    <div class="cmp-grid">
      <div class="cmp-card us">
        <div class="cmp-name" data-i18n="cmp.us.name">Wawe Journal</div>
        <div class="cmp-sub" data-i18n="cmp.us.sub">Premium</div>
        <div class="cmp-price us">$9<span>/mo</span></div>
        <ul class="cmp-rows">
          <li><span class="k" data-i18n="cmp.rows.trades">Trade limit</span><span class="v">1,000 / journal</span></li>
          <li><span class="k" data-i18n="cmp.rows.strategies">Strategy tagging</span><span class="v pos" data-i18n="cmp.rows.unlimited">Unlimited</span></li>
          <li><span class="k" data-i18n="cmp.rows.charts">Advanced charts</span><span class="v pos">Yes · 20 charts</span></li>
          <li><span class="k" data-i18n="cmp.rows.ai">AI-powered analysis</span><span class="v mid" data-i18n="cmp.rows.coming">Yes (Coming soon)</span></li>
          <li><span class="k" data-i18n="cmp.rows.chat">AI chat assistant</span><span class="v mid" data-i18n="cmp.rows.coming">Yes (Coming soon)</span></li>
        </ul>
      </div>
      <div class="cmp-card">
        <div class="cmp-name" data-i18n="cmp.tz.name">TradeZella</div>
        <div class="cmp-sub" data-i18n="cmp.tz.sub">Essential</div>
        <div class="cmp-price">$35<span>/mo</span></div>
        <ul class="cmp-rows">
          <li><span class="k" data-i18n="cmp.rows.trades">Trade limit</span><span class="v neg" data-i18n="cmp.rows.unlimited">Unlimited</span></li>
          <li><span class="k" data-i18n="cmp.rows.strategies">Strategy tagging</span><span class="v pos" data-i18n="cmp.rows.yes">Yes</span></li>
          <li><span class="k" data-i18n="cmp.rows.charts">Advanced charts</span><span class="v pos">Yes · 300+ reports</span></li>
          <li><span class="k" data-i18n="cmp.rows.ai">AI-powered analysis</span><span class="v pos">Yes (Zella AI)</span></li>
          <li><span class="k" data-i18n="cmp.rows.chat">AI chat assistant</span><span class="v neg" data-i18n="cmp.rows.pro_only">Pro plan only</span></li>
        </ul>
      </div>
      <div class="cmp-card">
        <div class="cmp-name" data-i18n="cmp.ew.name">Edgewonk</div>
        <div class="cmp-sub" data-i18n="cmp.ew.sub">Single plan</div>
        <div class="cmp-price">~$16<span>/mo</span></div>
        <ul class="cmp-rows">
          <li><span class="k" data-i18n="cmp.rows.trades">Trade limit</span><span class="v neg" data-i18n="cmp.rows.unlimited">Unlimited</span></li>
          <li><span class="k" data-i18n="cmp.rows.strategies">Strategy tagging</span><span class="v pos">Yes (Checklist)</span></li>
          <li><span class="k" data-i18n="cmp.rows.charts">Advanced charts</span><span class="v pos">Yes · 17 charts</span></li>
          <li><span class="k" data-i18n="cmp.rows.ai">AI-powered analysis</span><span class="v neg" data-i18n="cmp.rows.partial">Partial</span></li>
          <li><span class="k" data-i18n="cmp.rows.chat">AI chat assistant</span><span class="v neg" data-i18n="cmp.rows.no">No</span></li>
        </ul>
      </div>
      <div class="cmp-card">
        <div class="cmp-name" data-i18n="cmp.ts.name">TraderSync</div>
        <div class="cmp-sub" data-i18n="cmp.ts.sub">Pro</div>
        <div class="cmp-price">$29.95<span>/mo</span></div>
        <ul class="cmp-rows">
          <li><span class="k" data-i18n="cmp.rows.trades">Trade limit</span><span class="v neg" data-i18n="cmp.rows.unlimited">Unlimited</span></li>
          <li><span class="k" data-i18n="cmp.rows.strategies">Strategy tagging</span><span class="v pos" data-i18n="cmp.rows.yes">Yes</span></li>
          <li><span class="k" data-i18n="cmp.rows.charts">Advanced charts</span><span class="v pos" data-i18n="cmp.rows.yes">Yes</span></li>
          <li><span class="k" data-i18n="cmp.rows.ai">AI-powered analysis</span><span class="v neg" data-i18n="cmp.rows.limited">Limited · 5 msgs/day</span></li>
          <li><span class="k" data-i18n="cmp.rows.chat">AI chat assistant</span><span class="v pos" data-i18n="cmp.rows.yes">Yes</span></li>
        </ul>
      </div>
    </div>
    <p class="cmp-foot" data-i18n="cmp.foot">Source: providers' public pricing pages, 2026. Prices and content may change.</p>
  </div>

  <div class="glow-line"></div>

  <!-- ═══ FEATURES ═══ -->
  <div class="section reveal" id="features-detail">
    <div class="section-tag" data-i18n="features.tag">Features</div>
    <h2 class="section-title" data-i18n-html="features.title">Built around one <em>habit</em>: writing it down.</h2>
    <p class="section-desc" data-i18n="features.desc">Spend less time reconstructing what happened and more time recognizing what works.</p>

    <div class="bgrid">
      <div class="bcell"><div class="bnum">01</div><h3 data-i18n="features.c1.t">Fast trade entry</h3><p data-i18n="features.c1.d">Log trades in detail, fast.</p></div>
      <div class="bcell"><div class="bnum">02</div><h3 data-i18n="features.c2.t">Advanced metrics</h3><p data-i18n="features.c2.d">Sharpe ratio, profit factor, and deeper stats.</p></div>
      <div class="bcell"><div class="bnum">03</div><h3 data-i18n="features.c3.t">Find winning strategies</h3><p data-i18n="features.c3.d">Let charts tell you which strategy makes money.</p></div>
      <div class="bcell"><div class="bnum">04</div><h3 data-i18n="features.c4.t">Build streaks, stop over-trading</h3><p data-i18n="features.c4.d">Over-trade alerts keep you from breaking your rules.</p></div>
    </div>
  </div>

  <div class="glow-line"></div>

  <!-- ═══ PRICING ═══ -->
  <div class="section reveal plans-section" id="pricing">
    <div class="section-tag" data-i18n="plans.tag">💎 Pricing</div>
    <h2 class="section-title" data-i18n-html="plans.title">A Plan for <em>Everyone</em></h2>
    <p class="section-desc" data-i18n="plans.desc">Choose the plan that fits you.</p>

    <div class="plans">

      <!-- FREE -->
      <div class="plan">
        <div class="plan-tag" data-i18n="plans.free_tag">free</div>
        <div class="plan-name" data-i18n="plans.free_name">Starter</div>
        <div class="plan-price">$0<span data-i18n="plans.free_period"> / mo</span></div>
        <p class="plan-desc" data-i18n="plans.free_desc">Start with the essentials.</p>
        <ul class="plan-feats">
          <li data-i18n="plans.free_f1">Trade logging</li>
          <li data-i18n="plans.free_f2">Calendar view</li>
          <li data-i18n="plans.free_f3">CSV / PDF import</li>
          <li data-i18n="plans.free_f4">Basic charts</li>
          <li data-i18n="plans.free_f5">Limited AI analysis</li>
        </ul>
        <a href="register.html" class="btn-plan ghost" data-i18n="plans.free_btn">Start free</a>
      </div>

      <!-- MONTHLY -->
      <div class="plan featured">
        <div class="plan-tag" data-i18n="plans.monthly_tag">most used</div>
        <div class="plan-name" data-i18n="plans.monthly_name">Premium monthly</div>
        <div class="plan-price">$<span id="monthly-price-value">9</span><span data-i18n="plans.monthly_period"> / mo</span></div>
        <p class="plan-desc" data-i18n="plans.monthly_desc">Unlock everything.</p>
        <ul class="plan-feats">
          <li data-i18n="plans.monthly_f1">All features</li>
          <li data-i18n="plans.monthly_f2">Advanced customizable charts</li>
          <li data-i18n="plans.monthly_f3">Theme settings</li>
          <li data-i18n="plans.monthly_f4">Over trade notifications</li>
          <li data-i18n="plans.monthly_f5">Advanced strategy analytics</li>
          <li data-i18n="plans.monthly_f6">AI analysis / Wawe AI chat bot</li>
          <li data-i18n="plans.monthly_f7">Customize Wawe journal</li>
          <li data-i18n="plans.monthly_f8">Movable charts</li>
        </ul>
        <a href="#" class="btn-plan solid" id="upgrade-monthly-home"><span data-i18n="plans.monthly_btn">Go premium</span></a>
      </div>

      <!-- YEARLY -->
      <div class="plan">
        <div class="plan-tag" data-i18n="plans.yearly_tag">best value</div>
        <div class="plan-name" data-i18n="plans.yearly_name">Premium yearly</div>
        <div class="plan-price">$<span id="yearly-price-value">79</span><span data-i18n="plans.yearly_period"> / yr</span></div>
        <p class="plan-desc" data-i18n="plans.yearly_desc">Save 67% annually.</p>
        <ul class="plan-feats">
          <li data-i18n="plans.yearly_f1">All premium features</li>
          <li data-i18n="plans.yearly_f2">2 months free</li>
        </ul>
        <a href="#" class="btn-plan ghost" id="upgrade-yearly-home"><span data-i18n="plans.yearly_btn">Buy yearly</span></a>
      </div>

    </div>
  </div>

  <div class="glow-line"></div>

  <!-- ═══ REFERENCES ═══ -->
  <div class="section reveal">
    <div class="section-tag" data-i18n="refs.tag">Trusted By</div>
    <h2 class="section-title" data-i18n-html="refs.title">Names We <em>Trust</em></h2>
    <p class="section-desc" data-i18n="refs.desc">Experienced traders and content creators we work with.</p>
    <div class="references-grid" id="references-grid">
      <div class="loading-spinner"><div class="spinner"></div></div>
    </div>
  </div>

  <!-- ═══ CTA ═══ -->
  <div class="cta-wrap reveal">
    <div class="cta-banner">
      <h2 data-i18n="cta.title">READY?</h2>
      <p data-i18n="cta.desc">Keeping a trading journal is a common habit of profitable traders. Start today and feel the difference.</p>
      <a href="register.html" class="btn-primary" style="font-size:1rem;padding:15px 38px;" data-i18n="cta.button">Create Free Account →</a>
    </div>
  </div>

  <!-- ═══ FOOTER ═══ -->
  <footer class="site-footer">
    <div class="footer-container">
      <div class="footer-col">
        <div class="footer-logo">
          <svg width="20" height="20" viewBox="0 0 22 22" fill="none" aria-hidden="true">
            <polyline points="2,16 7,9 12,13 19,4" stroke="#8b5cf6" stroke-width="2.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Wawe<span class="logo-accent">Journal</span></span>
        </div>
        <p class="footer-desc" data-i18n="footer.desc">A modern trading journal built for professional traders.</p>
      </div>
      <div class="footer-col">
