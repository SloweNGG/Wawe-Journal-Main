---
import Layout from '../layouts/Layout.astro';
---
<Layout lang="en" showNavbar={false}>
<Fragment slot="head">
  <title>Wawe Journal - Professional Trading Journal for Traders</title>
  <meta name="description" content="Every great trader has a story. Wawe Journal helps you write yours. Track trades, analyze metrics, and build discipline." />
  <meta name="keywords" content="wawe journal, wawejournal, trading journal, crypto trading journal, forex journal, stock trading log, trading analytics" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="https://wawejournal.com/" />
  <meta property="og:title" content="Wawe Journal - Professional Trading Journal" />
  <meta property="og:description" content="Track your trades, analyze your performance, and build discipline." />
  <meta property="og:url" content="https://wawejournal.com/" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://wawejournal.com/og-image.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="Wawe Journal" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Wawe Journal - Professional Trading Journal" />
  <meta name="twitter:description" content="Track your trades, analyze your performance, and build discipline." />
  <meta name="twitter:image" content="https://wawejournal.com/og-image.jpg" />
  <meta name="twitter:site" content="@wawejournal" />
  <meta name="theme-color" content="#7c6dfa" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Wawe Journal" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="stylesheet" href="/index.css" />

  <!-- Google Site Name, Brand Entity & WebSite Schema -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "https://wawejournal.com/#website",
        "url": "https://wawejournal.com/",
        "name": "Wawe Journal",
        "alternateName": ["WaweJournal", "Wawe Journal Trading"],
        "publisher": { "@id": "https://wawejournal.com/#organization" }
      },
      {
        "@type": "Organization",
        "@id": "https://wawejournal.com/#organization",
        "name": "Wawe Journal",
        "alternateName": ["WaweJournal"],
        "url": "https://wawejournal.com/",
        "logo": "https://wawejournal.com/og-image.jpg",
        "sameAs": [
          "https://x.com/wawejournal",
          "https://twitter.com/wawejournal",
          "https://www.instagram.com/wawejournal/",
          "https://youtube.com/@wawedev"
        ]
      },
      {
        "@type": "SoftwareApplication",
        "@id": "https://wawejournal.com/#app",
        "name": "Wawe Journal",
        "alternateName": ["WaweJournal"],
        "description": "Wawe Journal is an advanced crypto, forex, and stock trading journal and performance analytics platform for disciplined traders.",
        "applicationCategory": "FinanceApplication",
        "operatingSystem": "Web",
        "url": "https://wawejournal.com/",
        "author": { "@id": "https://wawejournal.com/#organization" },
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        }
      }
    ]
  }
  </script>

  <style is:global>
    * { box-sizing: border-box; }
    html {
      overflow-y: auto !important;
      overflow-x: hidden !important;
      height: auto !important;
      scroll-behavior: smooth;
    }
    body {
      overflow-y: auto !important;
      overflow-x: hidden !important;
      height: auto !important;
      min-height: 100vh !important;
      max-width: 100%;
    }
    #navbar-container { display: none !important; }
    /* landing page: app-scroll-container normal flow (scroll on html/body, not container) */
    #app-scroll-container {
      overflow: visible !important;
      height: auto !important;
      min-height: 100vh !important;
      display: block !important;
      width: 100% !important;
    }
  </style>

  <link rel="preload" href="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" as="script" />
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" is:inline defer></script>
  <script src="/config.js?v=8" is:inline defer></script>
  <script src="/index-i18n.js?v=8" is:inline defer></script>
  <script type="module" src="/src/bundle.js?v=8" is:inline defer></script>
</Fragment>

  <!-- ═══ NAV ═══ -->
  <nav class="nav">
    <a href="index.html" class="nav-logo">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
        <polyline points="2,16 7,9 12,13 19,4" stroke="#8b5cf6" stroke-width="2.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>Wawe<span class="logo-accent">Journal</span></span>
    </a>

    <div class="nav-links">
      <a href="login.html" class="btn-login" data-i18n="nav.login">Login</a>
      <a href="register.html" class="btn-register" data-i18n="nav.register">Sign Up →</a>
    </div>

    <div class="lang-selector" id="lang-selector">
      <div class="lang-current" id="lang-current">
        <span class="lang-current-flag">🇬🇧</span>
        <span class="lang-current-arrow">▼</span>
      </div>
      <div class="lang-dropdown" id="lang-dropdown">
        <div class="lang-option" data-lang="tr" data-flag="🇹🇷">
          <span class="lang-option-flag">🇹🇷</span><span class="lang-option-check"></span>
        </div>
        <div class="lang-option active" data-lang="en" data-flag="🇬🇧">
          <span class="lang-option-flag">🇬🇧</span><span class="lang-option-check">✓</span>
        </div>
        <div class="lang-option" data-lang="de" data-flag="🇩🇪">
          <span class="lang-option-flag">🇩🇪</span><span class="lang-option-check"></span>
        </div>
      </div>
    </div>

    <button class="hamburger" id="hamburger"><span></span><span></span><span></span></button>
  </nav>

  <div class="mobile-menu" id="mobile-menu">
    <a href="login.html" data-i18n="nav.login">Login</a>
    <a href="register.html" class="btn-register-mobile" data-i18n="nav.register">Sign Up →</a>
  </div>
  <div class="menu-overlay" id="menu-overlay"></div>

  <!-- ═══ HERO ═══ -->
  <div class="hero-ambient-wrap">
    <div class="hero-video-backdrop" aria-hidden="true">
      <video
        src="https://odasapyhtdopbnlfhwde.supabase.co/storage/v1/object/public/landing-assets/dashboardlong.mp4"
        class="hero-bg-video"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
      ></video>
      <div class="hero-video-overlay"></div>
      <div class="hero-video-glow"></div>
    </div>

    <section class="hero">
      <div class="hero-left">
        <div class="hero-beta-badge">
          <span class="beta-dot"></span>
          <span data-i18n="hero.beta">BETA</span>
        </div>

        <h1>
          <span class="l1" data-i18n="hero.title">Stop guessing which trades work.</span>
          <span class="hero-destiny-wrap">
            <span class="hero-destiny" data-i18n="hero.destiny">Rewrite your destiny.</span>
          </span>
        </h1>

        <p class="hero-sub" data-i18n="hero.subtitle">
          Log every trade, see your real edge, and drop the strategies that only feel right. Your data, your discipline.
        </p>

        <div class="hero-actions">
          <a href="register.html" class="btn-primary" data-i18n="hero.start_free">Start Free →</a>
          <a href="login.html" class="btn-ghost" data-i18n="hero.login">Login</a>
        </div>

        <div class="hero-note" data-i18n="hero.note">Analyze beyond the standards.</div>
      </div>

      <div class="hero-chart-wrap">
        <canvas id="hero-chart-canvas"></canvas>
        <div class="hero-float-card hfc-top">
          <div class="hfc-label" data-i18n="hero.win_rate">WIN RATE</div>
          <div class="hfc-value hfc-green">83.4%</div>
        </div>
        <div class="hero-float-card hfc-mid">
          <div class="hfc-label" data-i18n="hero.total_pnl">TOTAL P&L</div>
          <div class="hfc-value hfc-green">+$4,820</div>
        </div>
        <div class="hero-float-card hfc-bot">
          <div class="hfc-label" data-i18n="hero.current_price">XAUUSD</div>
          <div class="hfc-value">2341.80 <span class="hfc-green">↑</span></div>
        </div>
      </div>

      <div class="hero-stats">
        <div class="hstat"><div class="hstat-val" id="stat-total-users">—</div><div class="hstat-label" data-i18n="stats.total_users">Total Users</div></div>
        <div class="hstat"><div class="hstat-val" id="stat-total-trades">—</div><div class="hstat-label" data-i18n="stats.total_trades">Trades Logged</div></div>
        <div class="hstat"><div class="hstat-val" id="stat-today-users">—</div><div class="hstat-label" data-i18n="stats.today_users">New Today</div></div>
        <div class="hstat"><div class="hstat-val" id="stat-today-trades">—</div><div class="hstat-label" data-i18n="stats.today_trades">Trades Today</div></div>
      </div>
    </section>
  </div>

