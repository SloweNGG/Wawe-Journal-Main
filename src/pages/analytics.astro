---
import Layout from '../layouts/Layout.astro';
---
<Layout lang="en" showQuickAdd={true} spa={true}>
<Fragment slot="head">
  <title data-i18n="analytics_dash.title">Analiz</title>
  
  <!-- PRO DASHBOARD CSS -->
  <link rel="stylesheet" href="/interface/analytics/css/analytics.css?v=5" />
  <link rel="stylesheet" href="/interface/dashboard/css/prop-banner.css" />
  
  <!-- ⭐ QUICK ADD MODAL CSS -->
  <link rel="stylesheet" href="/interface/quick-add/css/quick-add.css" />
  
  
  <!-- SORTABLEJS -->
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js" is:inline defer></script>
  
  <!-- APEXCHARTS -->
  <script src="https://cdn.jsdelivr.net/npm/apexcharts@8.2.0" is:inline defer></script>
  
  <!-- LIGHTWEIGHT CHARTS -->
  <script src="https://cdn.jsdelivr.net/npm/lightweight-charts@4.1.3/dist/lightweight-charts.standalone.production.js" is:inline defer></script>

  <script is:inline>
    (function() {
      var savedTheme = localStorage.getItem('ww_theme');
      var isLight = savedTheme === 'light';
      document.documentElement.classList.toggle('light-theme-pending', isLight);
      document.addEventListener('DOMContentLoaded', function() {
        if (isLight) {
          document.body.classList.add('light-theme');
        } else {
          document.body.classList.remove('light-theme');
        }
        document.documentElement.classList.remove('light-theme-pending');
      });
    })();
  </script>

  <script is:inline>
    (function() {
      var savedLang = localStorage.getItem('ww_language');
      if (savedLang && ['en', 'tr', 'de'].includes(savedLang)) {
        document.documentElement.setAttribute('data-lang', savedLang);
        document.documentElement.lang = savedLang;
        wwLog.log('[Preload] Dil geri yüklendi:', savedLang);
      } else {
        localStorage.setItem('ww_language', 'en');
        document.documentElement.setAttribute('data-lang', 'en');
        document.documentElement.lang = 'en';
        wwLog.log('[Preload] Varsayılan dil ayarlandı: en');
      }
    })();
  </script>

  <style>
    html.light-theme-pending body {
      background: #f4f4f9;
    }
  </style>
</Fragment>
  <!-- NAVBAR CONTAINER -->

  <!-- QUICK ADD MODAL CONTAINER -->
  <div id="quick-add-container"></div>

  <!-- PROP FIRM ADVANCE PHASE MODAL -->
  <div id="pro-advance-phase-modal" class="prop-modal-backdrop" style="display:none;">
    <div class="prop-modal-box">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;border-bottom:1px solid rgba(255,255,255,0.06);padding-bottom:0.75rem;">
        <h3 style="margin:0;font-size:1.05rem;font-weight:700;" data-i18n="prop.advance_modal_title">
          <span>Sonraki Faza Geç</span>
        </h3>
        <button id="close-pro-advance-modal" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:1.4rem;line-height:1;">&times;</button>
      </div>
      <p style="font-size:0.85rem;color:var(--muted);margin-bottom:1.2rem;line-height:1.45;" data-i18n="prop.advance_modal_desc">
        Yeni faza geçtiğinizde başlangıç tarihi güncellenir ve eski işlemler bu faza dahil edilmez.
      </p>
      <div style="margin-bottom:1rem;">
        <label style="display:block;font-size:0.8rem;font-weight:600;margin-bottom:4px;" data-i18n="prop.advance_start_date_label">Yeni Faz Başlangıç Tarihi</label>
        <input type="date" id="pro-advance-start-date" class="journal-prop-input" style="width:100%;padding:0.6rem;border-radius:8px;border:1px solid var(--border);background:var(--bg2,#0d0d14);color:var(--text);box-sizing:border-box;" />
      </div>

      <!-- İşlem Çakışması Uyarısı (Yeni start_date'te işlem varsa) -->
      <div id="pro-advance-trades-warning" style="display:none;margin-bottom:1rem;padding:0.75rem;background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.3);border-radius:8px;font-size:0.8rem;color:#f59e0b;">
        <div>
          <span id="pro-advance-trades-warning-text">Bu tarihte işlemler var, yeni faza dahil edilecek.</span>
          <div style="margin-top:6px;">
            <button type="button" id="pro-advance-bump-date-btn" style="background:#f59e0b;color:#000;border:none;border-radius:4px;padding:3px 8px;font-size:0.75rem;font-weight:600;cursor:pointer;" data-i18n="prop.advance_bump_date">
              Başlangıç tarihini ertesi güne al
            </button>
          </div>
        </div>
      </div>

      <!-- Özelleştirilmiş Kuralları Koruma Seçeneği -->
      <div id="pro-advance-custom-rules-choice" style="display:none;margin-bottom:1rem;padding:0.75rem;background:rgba(255,255,255,0.03);border:1px solid var(--border);border-radius:8px;font-size:0.8rem;">
        <div style="font-weight:600;margin-bottom:6px;" data-i18n="prop.advance_rules_title">Kural Ayarları</div>
        <label style="display:flex;align-items:center;gap:6px;margin-bottom:6px;cursor:pointer;">
          <input type="radio" name="pro-advance-rules-mode" value="keep" id="pro-advance-rules-keep" checked />
          <span data-i18n="prop.advance_rules_keep">Özelleştirilmiş kurallarımı koru</span>
        </label>
        <label style="display:flex;align-items:center;gap:6px;cursor:pointer;">
          <input type="radio" name="pro-advance-rules-mode" value="template" id="pro-advance-rules-template" />
          <span data-i18n="prop.advance_rules_template">Yeni faz varsayılanlarını kullan</span>
        </label>
      </div>

      <div style="margin-bottom:1.25rem;">
        <label style="display:block;font-size:0.8rem;font-weight:600;margin-bottom:4px;" data-i18n="prop.advance_balance_label">Yeni Başlangıç Bakiyesi ($)</label>
        <input type="number" id="pro-advance-starting-balance" class="journal-prop-input" style="width:100%;padding:0.6rem;border-radius:8px;border:1px solid var(--border);background:var(--bg2,#0d0d14);color:var(--text);box-sizing:border-box;" min="1" step="100" />
      </div>
      <div style="display:flex;justify-content:flex-end;gap:0.75rem;">
        <button id="cancel-pro-advance-modal" class="journal-btn-cancel" style="padding:0.5rem 1rem;border-radius:8px;border:1px solid var(--border);background:transparent;color:var(--text);cursor:pointer;" data-i18n="journal.cancel">İptal</button>
        <button id="confirm-pro-advance-modal" class="journal-btn-save" style="padding:0.5rem 1.25rem;border-radius:8px;border:none;background:var(--accent);color:#fff;font-weight:600;cursor:pointer;" data-i18n="prop.advance_confirm_btn">Faza Geç</button>
      </div>
    </div>
  </div>

  <!-- PROP NOTICES / RULES MODAL -->
  <div id="pro-prop-notices-modal" class="prop-modal-backdrop" style="display:none;">
    <div class="prop-notices-modal-content">
      <div class="prop-notices-modal-header">
        <h3 class="prop-notices-modal-title">
          <span id="pro-prop-notices-title" data-i18n="prop.rule_notices_modal_title">Kurallar ve Bildirimler</span>
        </h3>
        <button id="close-pro-prop-notices" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:1.4rem;line-height:1;">&times;</button>
      </div>
      <div id="pro-prop-notices-body" class="prop-notices-list"></div>
      <div id="pro-prop-notices-disclaimer" class="prop-native-disclaimer" style="margin-top:0.5rem;padding-top:0.5rem;border-top:1px solid rgba(255,255,255,0.06);"></div>
    </div>
  </div>

  <main class="pro-main" id="main-content">
    <div style="display:flex;justify-content:center;align-items:center;min-height:60vh;flex-direction:column;gap:1rem;">
      <div class="spinner"></div>
      <p style="color:var(--muted);font-size:13px;font-family:'DM Sans',sans-serif;" data-i18n="analytics_dash.loading">Analiz yükleniyor...</p>
    </div>
  </main>

  <!-- ============================================================
       ⭐ SCRIPTS - SIRALI YÜKLEME (MODÜLER)
       ============================================================ -->

  <!-- 1. ÜÇÜNCÜ PARTY KÜTÜPHANELER -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.117.3" is:inline defer></script>

  <!-- 2. CORE KONFİG VE İ18N (ES5) -->
  <script src="/config.js" is:inline defer></script>
  <script src="/i18n.js" is:inline defer></script>

  <!-- 3. ⭐ ANA MODÜL SCRIPT (Bundle) -->
  <script type="module" src="/src/bundle.js" is:inline defer></script>

  <!-- 5. QUICK ADD (ES5) -->
  <!-- ⭐ ParserV2 -->
  <script src="/interface/quick-add/js/broker-dictionary.js" is:inline defer></script>
  <script src="/interface/quick-add/js/broker-detector.js" is:inline defer></script>
  <script src="/interface/quick-add/js/fill-pairing.js" is:inline defer></script>
  <script src="/interface/quick-add/js/parser-v2.js" is:inline defer></script>
  <script src="/interface/quick-add/js/quick-modal-i18n.js" is:inline defer></script>
  <script src="/interface/quick-add/js/quick-add.js?v=1792300000" is:inline defer></script>

  <!-- 6. ⭐ PRO DASHBOARD - MODÜLER JS (ES Module) -->
  <script type="module" src="/interface/analytics/js/analytics.js?v=1792300000" is:inline defer></script>

  <!-- 7. ⭐ QUICK ADD MANUEL BAŞLATICI (dashboard.html'den alındı) -->
  <script is:inline>
    (function() {
      function createManualFAB() {
        if (document.getElementById('quick-add-fab')) return;
        var fab = document.createElement('button');
        fab.id = 'quick-add-fab';
        fab.className = 'quick-add-fab';
        var ariaLabel = (typeof window !== 'undefined' && window.i18n && typeof window.i18n.t === 'function')
          ? window.i18n.t('nav.quick_add')
          : 'Hızlı İşlem Ekle';
        fab.setAttribute('aria-label', ariaLabel);
        fab.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>';
        fab.style.cssText = 'position:fixed;bottom:2rem;right:2rem;z-index:999;width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,#8b5cf6,#a78bfa);border:none;color:#fff;cursor:pointer;box-shadow:0 4px 20px rgba(139,92,246,0.4);display:flex;align-items:center;justify-content:center;transition:all 0.3s cubic-bezier(0.34,1.56,0.64,1);';
        fab.addEventListener('click', function() {
          if (typeof quickAddOpen === 'function') {
            quickAddOpen();
          } else {
            var errMsg = (typeof window !== 'undefined' && window.i18n && typeof window.i18n.t === 'function')
              ? window.i18n.t('analytics_dash.quick_add_error')
              : 'Quick Add yüklenemedi. Sayfayı yenileyin.';
            alert(errMsg);
          }
        });
        document.body.appendChild(fab);
        wwLog.log('[FAB] Manuel FAB oluşturuldu');
      }
      
      if (document.readyState === 'complete' || document.readyState === 'interactive') {
        setTimeout(function() {
          if (typeof quickAddOpen === 'undefined') createManualFAB();
        }, 1500);
      } else {
        document.addEventListener('DOMContentLoaded', function() {
          setTimeout(function() {
            if (typeof quickAddOpen === 'undefined') createManualFAB();
          }, 1500);
        });
      }
    })();
  </script>

  <!-- 8. LUCIDE ICONS INIT (EN SON) -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
        wwLog.log('[Lucide] Icons initialized on pro dashboard');
      }
    });
  </script>

  <!-- 9. NAVBAR YÜKLE -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      if (typeof loadNavbar === 'function') {
        loadNavbar('navbar-container');
        wwLog.log('[Navbar] Yüklendi');
      } else {
        wwLog.warn('[Navbar] loadNavbar fonksiyonu bulunamadı');
      }
    });
  </script>
  <!-- 10. ⭐ PROP FIRM DURUMU
       Prop hesabının kural durumunu hesaplar ve window.__wwPropState olarak yayınlar
       ('ww:prop-state' olayı). Kartlar ve başlık analytics modülünde çizilir
       (prop-widgets.js); bu betik uyarılar ve faz geçiş pencerelerini yönetir. -->
  <script is:inline>
    // SPA: bu script'in global dinleyicileri sayfadan çıkınca kaldırılır (BaseHead.astro → wwPage)
    var PRO_BANNER_PAGE = window.wwPage.current();

    function escapeHtml(str) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    var _currentProPropSync = null;
    var _proPropNextPhaseIdx = 1;

    function publishPropState(state, activeId) {
      window.__wwPropState = state;
      if (activeId) {
        try { sessionStorage.setItem('ww_is_prop_' + activeId, state && state.active ? '1' : '0'); } catch (e) {}
        // Son bilinen durum: bir sonraki açılışta kart beklemeden çizilir (prop-widgets.js)
        try {
          if (state && state.active) localStorage.setItem('ww_prop_state_' + activeId, JSON.stringify(state));
          else localStorage.removeItem('ww_prop_state_' + activeId);
        } catch (e) {}
      }
      window.dispatchEvent(new CustomEvent('ww:prop-state'));
    }

    // İşlemler henüz önbellekte yoksa panonun kendi çekimi beklenir (aynı veri iki kez indirilmesin)
    function waitForProTrades(timeoutMs) {
      return new Promise(function(resolve) {
        var done = false;
        function finish() {
          if (done) return;
          done = true;
          window.removeEventListener('ww:pro-trades', finish);
          resolve();
        }
        window.addEventListener('ww:pro-trades', finish);
        setTimeout(finish, timeoutMs);
      });
    }

    // Servisler ve aktif defter hazır olana kadar kısa süre beklenir (eskiden sabit 700 ms bekleniyordu)
    function waitForPropDeps(timeoutMs) {
      var start = Date.now();
      return new Promise(function(resolve) {
        (function check() {
          var ready = window.PropService && window.journal && typeof window.journal.getActiveJournalId === 'function' &&
                      window.journal.getActiveJournalId();
          if (ready || Date.now() - start > timeoutMs || !PRO_BANNER_PAGE.alive) return resolve();
          setTimeout(check, 50);
        })();
      });
    }

    async function refreshProPropBanner() {
      if (!PRO_BANNER_PAGE.alive) return;
      await waitForPropDeps(3000);
      if (!PRO_BANNER_PAGE.alive) return;
      if (!window.PropService || !window.journal) return;

      var activeId = window.journal.getActiveJournalId();
      if (!activeId) {
        window._isProPropActive = false;
        publishPropState({ active: false }, null);
        return;
      }

      try {
        // Cache-first trade retrieval
        var uId = (window.currentUser && window.currentUser.id) ||
                  (window.__wwUserProfile && window.__wwUserProfile.id) || null;
        var propCols = ['id', 'trade_date', 'pnl', 'entry_price', 'exit_price', 'lot', 'direction', 'instrument', 'multiplier'];
        var readCachedTrades = function() {
          if (!window.wwCache || !uId || !activeId) return null;
          return window.wwCache.get('trades_dashboard', uId, activeId, propCols) ||
                 window.wwCache.get('trades_pro', uId, activeId, propCols) ||
                 window.wwCache.get('trades', uId, activeId, propCols);
        };
        var cachedTrades = readCachedTrades();
        if (!cachedTrades) {
          await waitForProTrades(4000);
          if (!PRO_BANNER_PAGE.alive) return;
          cachedTrades = readCachedTrades();
        }

        var syncRes = await window.PropService.syncPropAccountStatus(activeId, cachedTrades);
        if (!PRO_BANNER_PAGE.alive) return;
        if (!syncRes || !syncRes.account || !syncRes.status) {
          window._isProPropActive = false;
          publishPropState({ active: false }, activeId);
          return;
        }

        window._isProPropActive = true;
        _currentProPropSync = syncRes;
        var account = syncRes.account;
        var status = syncRes.status;
        var tmplKey = account.template_key;
        var tmpl = window.PropTemplates ? window.PropTemplates.getPropTemplate(tmplKey) : null;
        var firmName = tmpl ? tmpl.firm : (account.rules?.firm || 'Prop');
        var phaseNum = (account.phase_index !== undefined ? account.phase_index + 1 : 1);
        var t = function (key, params) {
          return (window.i18n && typeof window.i18n.t === 'function') ? window.i18n.t(key, params) : key;
        };
        var curLang = (window.i18n && window.i18n.currentLang) || 'tr';

        function localizePhaseName(rawPhase) {
          if (!rawPhase) return '';
          if (curLang === 'tr') {
            return String(rawPhase)
              .replace(/Phase 1 \(Challenge\)/i, 'Faz 1 (Challenge)')
              .replace(/Phase 1 \(Evaluation\)/i, 'Faz 1 (Değerlendirme)')
              .replace(/Phase 1 \(Single Phase\)/i, 'Faz 1 (Tek Aşama)')
              .replace(/Phase 2 \(Verification\)/i, 'Faz 2 (Doğrulama)')
              .replace(/Phase 2/i, 'Faz 2')
              .replace(/Phase 1/i, 'Faz 1')
              .replace(/Funded \((.*?)\)/i, 'Fonlandı ($1)')
              .replace(/^Funded$/i, 'Fonlandı (Canlı)');
          } else if (curLang === 'de') {
            return String(rawPhase)
              .replace(/Phase 1 \(Challenge\)/i, 'Phase 1 (Challenge)')
              .replace(/Phase 1 \(Evaluation\)/i, 'Phase 1 (Bewertung)')
              .replace(/Phase 1 \(Single Phase\)/i, 'Phase 1 (Einzelschritt)')
              .replace(/Phase 2 \(Verification\)/i, 'Phase 2 (Verifizierung)')
              .replace(/Funded \((.*?)\)/i, 'Gefördert ($1)')
              .replace(/^Funded$/i, 'Gefördert (Live)');
          }
          return rawPhase;
        }

        var rawPhaseName = account.rules?.phase_name || t('prop.phase_num', { n: phaseNum });
        var phaseName = localizePhaseName(rawPhaseName);

        // Firma markası
        var firmResolver = (window.PropTemplates && window.PropTemplates.getPropFirmInfo)
          ? window.PropTemplates.getPropFirmInfo
          : (window.getPropFirmInfo || null);
        var firmInfo = firmResolver ? firmResolver(firmName || tmplKey) : null;
        var firm = {
          name: (firmInfo && firmInfo.name) || firmName || 'Prop Firm',
          logo: (firmInfo && (firmInfo.logo || firmInfo.symbolLogo)) || '/images/props/custom-symbol.svg',
          color: (firmInfo && firmInfo.accentColor) || '#00d2ff'
        };

        // Kurallar geçersizse yalnızca hata durumu yayınlanır
        if (status.overall_status === 'invalid_rules') {
          publishPropState({
            active: true,
            invalid: true,
            errorCode: status.error_code || 'INVALID_RULES',
            firm: firm,
            phaseName: phaseName
          }, activeId);
          return;
        }

        var warningsList = (status.warnings || []).slice();
        if (account.rules && account.rules.verified === false) {
          warningsList.unshift('UNVERIFIED_PHASE_RULES');
        }

        var currentPhaseIdx = account.phase_index !== undefined ? account.phase_index : 0;
        _proPropNextPhaseIdx = currentPhaseIdx + 1;
        var hasNextPhase = Boolean(tmpl && tmpl.phases && tmpl.phases.length > _proPropNextPhaseIdx);

        // Kart hesapları (eski kokpit bandıyla aynı)
        var dailyRem = Number(status.daily_loss.remaining_margin) || 0;
        var dailyLimit = Number(status.daily_loss.limit_amount) || 0;
        var consumedAmt = Math.max(0, dailyLimit - dailyRem);
        var consumedPct = dailyLimit > 0 ? Math.min(100, Math.round((consumedAmt / dailyLimit) * 100)) : 0;
        var maxDist = Number(status.max_loss.distance_to_stop) || 0;
        var maxDistPct = Number(status.max_loss.distance_to_stop_pct) || 0;
        var targetAmount = Number(status.profit_target.target_amount) || 0;
        var targetRem = Number(status.profit_target.remaining_amount) || 0;
        var dayCount = Number(status.trading_days.count) || 0;
        var dayMin = Number(status.trading_days.min_required) || 0;

        var st = status.overall_status || 'in_progress';
        var health = 'safe';
        if (st === 'failed') health = 'failed';
        else if (st !== 'passed' && (warningsList.length > 0 || consumedPct > 75 || (maxDistPct > 0 && maxDistPct <= 25))) health = 'warning';

        prepareNoticesModal(account, tmpl, warningsList);

        publishPropState({
          active: true,
          invalid: false,
          firm: firm,
          phaseName: phaseName,
          status: st,
          health: health,
          warningsCount: warningsList.length,
          hasNextPhase: hasNextPhase,
          startBalance: Number(status.account.starting_balance) || 0,
          currentBalance: Number(status.current_balance) || 0,
          daily: {
            remaining: dailyRem,
            limit: dailyLimit,
            todayPnl: Number(status.daily_loss.today_pnl) || 0,
            consumedPct: consumedPct,
            remainingPct: Math.max(0, 100 - consumedPct)
          },
          maxLoss: {
            stop: Number(status.max_loss.hard_stop_level) || 0,
            distance: maxDist,
            distancePct: maxDistPct
          },
          target: {
            amount: targetAmount,
            remaining: targetRem,
            pct: Number(status.profit_target.progress_pct) || 0,
            earned: targetAmount > 0 ? Math.max(0, targetAmount - targetRem) : 0
          },
          days: {
            count: dayCount,
            min: dayMin,
            pct: dayMin > 0 ? Math.min(100, Math.round((dayCount / dayMin) * 100)) : 100
          }
        }, activeId);
      } catch (err) {
        if (window.wwLog) window.wwLog.error('refreshProPropBanner err:', err);
      }
    }

    // Uyarılar penceresinin içeriği (butonu modül başlıkta çizer, wwPropOpenNotices ile açar)
    function prepareNoticesModal(account, tmpl, warningsList) {
      var t = function (key, params) {
        return (window.i18n && typeof window.i18n.t === 'function') ? window.i18n.t(key, params) : key;
      };
      var noticesBodyEl = document.getElementById('pro-prop-notices-body');
      var noticesDiscEl = document.getElementById('pro-prop-notices-disclaimer');
      if (noticesBodyEl) {
        var itemsHtml = '';
        (warningsList || []).forEach(function(w) {
          var msg = '';
          if (w === 'UNVERIFIED_PHASE_RULES') msg = t('prop.unverified_warning');
          else if (w === 'EQUITY_BASED_ESTIMATED') msg = t('prop.warn_equity_estimated');
          else if (w === 'INTRADAY_BREACH_POSSIBLE') msg = t('prop.warn_intraday_breach');
          else if (w === 'INTRADAY_ORDER_UNKNOWN') msg = t('prop.warn_intraday_order');
          else if (w === 'CONSISTENCY_NOT_MET') msg = t('prop.warn_consistency');
          else msg = w;
          itemsHtml += `
            <div class="prop-notice-item">
              <span>${escapeHtml(msg)}</span>
            </div>
          `;
        });
        noticesBodyEl.innerHTML = itemsHtml || `<div style="font-size:0.85rem;color:var(--muted);padding:0.5rem 0;">${escapeHtml(t('prop.no_warnings') || 'Aktif kural uyarısı bulunmuyor.')}</div>`;
      }
      if (noticesDiscEl) {
        noticesDiscEl.innerHTML = `
          <span>${escapeHtml(t('prop.disclaimer', { last_verified: (account.rules && account.rules.last_verified) || (tmpl && tmpl.last_verified) || '2026-10-04' }))}</span>
        `;
      }
    }

    function openProPropNotices() {
      var modal = document.getElementById('pro-prop-notices-modal');
      if (modal) {
        modal.style.display = 'flex';
        modal.classList.add('active');
      }
    }

    function openProAdvanceFromHeader() {
      if (!_currentProPropSync || !_currentProPropSync.account) return;
      var account = _currentProPropSync.account;
      var tmpl = window.PropTemplates ? window.PropTemplates.getPropTemplate(account.template_key) : null;
      openProAdvancePhaseModal(account, tmpl, _proPropNextPhaseIdx);
    }

    // Modül başlığındaki prop butonları bu fonksiyonları çağırır
    PRO_BANNER_PAGE.expose('wwPropOpenNotices', openProPropNotices);
    PRO_BANNER_PAGE.expose('wwPropOpenAdvance', openProAdvanceFromHeader);

    function updateProTradesOnDateWarning(dateVal) {
      var warnBox = document.getElementById('pro-advance-trades-warning');
      var warnText = document.getElementById('pro-advance-trades-warning-text');
      var bumpBtn = document.getElementById('pro-advance-bump-date-btn');
      if (!warnBox || !warnText || !dateVal) return;

      var tradesList = [];
      if (_currentProPropSync && _currentProPropSync.trades && Array.isArray(_currentProPropSync.trades)) {
        tradesList = _currentProPropSync.trades;
      } else if (window.wwCache && window.currentUser) {
        var jid = window.journal ? window.journal.getActiveJournalId() : null;
        tradesList = window.wwCache.get('trades_dashboard', window.currentUser.id, jid, ['trade_date']) ||
                     window.wwCache.get('trades_pro', window.currentUser.id, jid, ['trade_date']) || [];
      }

      var count = 0;
      for (var i = 0; i < tradesList.length; i++) {
        var td = String(tradesList[i].trade_date || '').slice(0, 10);
        if (td === dateVal) count++;
      }

      if (count > 0) {
        // Ertesi gün: takvim günü aritmetiği (eskiden yerel gece yarısı UTC'ye çevrilince UTC+ bölgelerde aynı gün çıkıyordu)
        var tomorrowStr = window.WwTime.addDays(dateVal, 1);
        var tFn = function(k, p) { return (window.i18n && window.i18n.t) ? window.i18n.t(k, p) : k; };
        warnText.textContent = tFn('prop.advance_trades_on_date_warn', { n: count, tomorrow: tomorrowStr }) || ('Bu tarihte ' + count + ' işlem var, yeni faza dahil edilecek. Başlangıç tarihini ertesi güne (' + tomorrowStr + ') almak ister misin?');
        if (bumpBtn) {
          bumpBtn.onclick = function() {
            var dateInput = document.getElementById('pro-advance-start-date');
            if (dateInput) {
              dateInput.value = tomorrowStr;
              updateProTradesOnDateWarning(tomorrowStr);
            }
          };
        }
        warnBox.style.display = 'block';
      } else {
        warnBox.style.display = 'none';
      }
    }

    function openProAdvancePhaseModal(account, tmpl, nextPhaseIdx) {
      var modal = document.getElementById('pro-advance-phase-modal');
      var dateInput = document.getElementById('pro-advance-start-date');
      var balInput = document.getElementById('pro-advance-starting-balance');
      var customChoice = document.getElementById('pro-advance-custom-rules-choice');
      if (!modal || !dateInput || !balInput) return;

      // Başlangıç tarihi varsayılanı: prop hesabının sıfırlama saat dilimindeki bugün
      var todayStr;
      try { todayStr = new Intl.DateTimeFormat('en-CA', { timeZone: account.reset_tz || window.WwTime.getTz() }).format(new Date()); }
      catch (e) { todayStr = window.WwTime.todayKey(); }
      dateInput.value = todayStr;
      balInput.value = account.starting_balance || 100000;

      if (customChoice) {
        var isCust = Boolean(account.rules && account.rules.is_customized);
        customChoice.style.display = isCust ? 'block' : 'none';
        var keepRadio = document.getElementById('pro-advance-rules-keep');
        if (keepRadio) keepRadio.checked = true;
      }

      updateProTradesOnDateWarning(todayStr);
      dateInput.onchange = function() { updateProTradesOnDateWarning(dateInput.value); };
      dateInput.oninput = function() { updateProTradesOnDateWarning(dateInput.value); };

      modal.style.display = 'flex';
      modal.classList.add('active');
    }

    function closeProAdvancePhaseModal() {
      var modal = document.getElementById('pro-advance-phase-modal');
      if (modal) {
        modal.style.display = 'none';
        modal.classList.remove('active');
      }
    }

    document.addEventListener('DOMContentLoaded', function() {
      var closeBtn = document.getElementById('close-pro-advance-modal');
      var cancelBtn = document.getElementById('cancel-pro-advance-modal');
      var confirmBtn = document.getElementById('confirm-pro-advance-modal');
      if (closeBtn) closeBtn.onclick = closeProAdvancePhaseModal;
      if (cancelBtn) cancelBtn.onclick = closeProAdvancePhaseModal;

      var closeNoticesBtn = document.getElementById('close-pro-prop-notices');
      if (closeNoticesBtn) {
        closeNoticesBtn.onclick = function() {
          var modal = document.getElementById('pro-prop-notices-modal');
          if (modal) {
            modal.style.display = 'none';
            modal.classList.remove('active');
          }
        };
      }

      var advModal = document.getElementById('pro-advance-phase-modal');
      if (advModal) {
        advModal.addEventListener('click', function(e) {
          if (e.target === advModal) closeProAdvancePhaseModal();
        });
      }
      var noticesModal = document.getElementById('pro-prop-notices-modal');
      if (noticesModal) {
        noticesModal.addEventListener('click', function(e) {
          if (e.target === noticesModal) {
            noticesModal.style.display = 'none';
            noticesModal.classList.remove('active');
          }
        });
      }

      if (confirmBtn) {
        confirmBtn.onclick = async function() {
          if (!_currentProPropSync || !_currentProPropSync.account) return;
          var account = _currentProPropSync.account;
          var nextPhaseIdx = (account.phase_index !== undefined ? account.phase_index + 1 : 1);
          var startDate = document.getElementById('pro-advance-start-date').value;
          var balance = Number(document.getElementById('pro-advance-starting-balance').value);
          var keepCustomRules = document.getElementById('pro-advance-rules-keep') ? document.getElementById('pro-advance-rules-keep').checked : false;
          var t = function (key) {
            return (window.i18n && typeof window.i18n.t === 'function') ? window.i18n.t(key) : key;
          };

          if (!startDate) {
            if (window.showToast) window.showToast(t('prop.err_select_start_date'), 'error');
            return;
          }
          if (isNaN(balance) || balance <= 0) {
            if (window.showToast) window.showToast(t('prop.err_invalid_balance'), 'error');
            return;
          }

          try {
            confirmBtn.disabled = true;
            await window.PropService.advancePhase(account.id, {
              newPhaseIndex: nextPhaseIdx,
              startDate: startDate,
              startingBalance: balance,
              keepCustomRules: keepCustomRules
            });
            if (window.showToast) window.showToast(t('prop.advance_success'), 'success');
            closeProAdvancePhaseModal();
            refreshProPropBanner();
          } catch (err) {
            if (window.showToast) window.showToast(err.message, 'error');
          } finally {
            confirmBtn.disabled = false;
          }
        };
      }

      refreshProPropBanner();
    });

    PRO_BANNER_PAGE.on(window, 'journal-changed', function() {
      setTimeout(refreshProPropBanner, 300);
    });
    PRO_BANNER_PAGE.on(window, 'trade-saved', function() {
      setTimeout(refreshProPropBanner, 300);
    });
    PRO_BANNER_PAGE.on(window, 'trade-deleted', function() {
      setTimeout(refreshProPropBanner, 300);
    });
    if (window.i18n && typeof window.i18n.onChange === 'function') {
      PRO_BANNER_PAGE.onI18nChange(function() {
        refreshProPropBanner();
      });
    }
  </script>
</Layout>
