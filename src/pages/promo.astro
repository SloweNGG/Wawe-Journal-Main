---
// src/pages/promo.astro - Wawe Journal Sinematik Tanıtım & Video Kayıt Sayfası
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Wawe Journal — Promo Video Studio</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      user-select: none;
    }

    body {
      background-color: #07090e;
      color: #f1f5f9;
      font-family: 'Plus Jakarta Sans', sans-serif;
      overflow: hidden;
      width: 100vw;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      perspective: 1400px;
    }

    /* Ambient Background Effects */
    .bg-grid {
      position: absolute;
      inset: 0;
      background-image: 
        linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
      background-size: 50px 50px;
      pointer-events: none;
      z-index: 1;
    }

    .bg-glow-1 {
      position: absolute;
      width: 600px;
      height: 600px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(56, 189, 248, 0.15) 0%, transparent 70%);
      top: -150px;
      left: 15%;
      filter: blur(80px);
      pointer-events: none;
      z-index: 1;
    }

    .bg-glow-2 {
      position: absolute;
      width: 700px;
      height: 700px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(16, 185, 129, 0.12) 0%, transparent 70%);
      bottom: -200px;
      right: 10%;
      filter: blur(100px);
      pointer-events: none;
      z-index: 1;
    }

    /* Stage Area & 3D Canvas */
    .viewport {
      position: relative;
      width: 1280px;
      height: 760px;
      max-width: 95vw;
      max-height: 90vh;
      z-index: 10;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
      transform-style: preserve-3d;
    }

    .viewport.isometric {
      transform: rotateX(18deg) rotateY(-14deg) rotateZ(3deg) scale(0.92);
    }

    /* Cinematic Big Text Overlay */
    .kinetic-text-layer {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 50;
      pointer-events: none;
    }

    .kinetic-title {
      font-size: 4.8rem;
      font-weight: 900;
      letter-spacing: -2px;
      text-transform: uppercase;
      text-align: center;
      line-height: 1;
      opacity: 0;
      transform: scale(0.85) translateY(30px);
      transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
      background: linear-gradient(135deg, #ffffff 40%, #94a3b8 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-shadow: 0 20px 50px rgba(0,0,0,0.8);
    }

    .kinetic-title.active {
      opacity: 1;
      transform: scale(1) translateY(0);
    }

    .kinetic-title.highlight {
      background: linear-gradient(135deg, #38bdf8 0%, #10b981 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .kinetic-sub {
      font-size: 1.4rem;
      letter-spacing: 6px;
      font-weight: 700;
      text-transform: uppercase;
      color: #64748b;
      margin-top: 14px;
      opacity: 0;
      transform: translateY(15px);
      transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.1s;
    }

    .kinetic-sub.active {
      opacity: 1;
      transform: translateY(0);
    }

    /* Main Dashboard Interface Container */
    .dashboard-window {
      width: 100%;
      height: 100%;
      background: rgba(13, 17, 26, 0.75);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 20px;
      backdrop-filter: blur(30px);
      box-shadow: 
        0 40px 100px -20px rgba(0, 0, 0, 0.9),
        0 0 0 1px rgba(255, 255, 255, 0.05),
        inset 0 1px 0 rgba(255, 255, 255, 0.15);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      opacity: 0;
      transform: scale(0.9) translateY(40px);
      transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .dashboard-window.visible {
      opacity: 1;
      transform: scale(1) translateY(0);
    }

    /* Window Header */
    .window-header {
      height: 52px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 24px;
      background: rgba(255, 255, 255, 0.015);
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .window-dots {
      display: flex;
      gap: 7px;
    }

    .dot {
      width: 11px;
      height: 11px;
      border-radius: 50%;
    }
    .dot-red { background: #ef4444; }
    .dot-yellow { background: #f59e0b; }
    .dot-green { background: #10b981; }

    .brand-tag {
      display: flex;
      align-items: center;
      gap: 9px;
      font-weight: 800;
      font-size: 14px;
      letter-spacing: -0.3px;
    }

    .brand-icon {
      width: 24px;
      height: 24px;
      background: linear-gradient(135deg, #0284c7, #2563eb);
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
    }

    .status-pill {
      font-size: 11px;
      font-weight: 700;
      background: rgba(16, 185, 129, 0.15);
      color: #34d399;
      padding: 4px 10px;
      border-radius: 99px;
      border: 1px solid rgba(16, 185, 129, 0.3);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .pulse-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #10b981;
      box-shadow: 0 0 10px #10b981;
      animation: pulse 1.8s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.8); }
    }

    /* Window Main Grid */
    .window-body {
      flex: 1;
      padding: 24px;
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 20px;
      overflow: hidden;
    }

    /* Left Main Analytics Panel */
    .main-analytics {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .kpi-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .kpi-card {
      background: rgba(255, 255, 255, 0.025);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 14px;
      padding: 18px 20px;
      position: relative;
      overflow: hidden;
      transform: translateY(20px);
      opacity: 0;
      transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .kpi-card.animated {
      transform: translateY(0);
      opacity: 1;
    }

    .kpi-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, rgba(56, 189, 248, 0.5), transparent);
    }

    .kpi-label {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      color: #94a3b8;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .kpi-value {
      font-size: 28px;
      font-weight: 800;
      margin-top: 8px;
      font-family: 'JetBrains Mono', monospace;
      letter-spacing: -1px;
    }

    .kpi-sub {
      font-size: 12px;
      color: #64748b;
      margin-top: 4px;
      font-weight: 500;
    }

    .text-emerald {
      color: #10b981;
      text-shadow: 0 0 25px rgba(16, 185, 129, 0.4);
    }

    .text-blue {
      color: #38bdf8;
      text-shadow: 0 0 25px rgba(56, 189, 248, 0.4);
    }

    /* Chart Section */
    .chart-container {
      flex: 1;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 16px;
      padding: 22px;
      display: flex;
      flex-direction: column;
      position: relative;
      overflow: hidden;
    }

    .chart-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
    }

    .chart-title {
      font-size: 14px;
      font-weight: 700;
      color: #cbd5e1;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .badge-live {
      background: rgba(56, 189, 248, 0.15);
      color: #38bdf8;
      font-size: 10px;
      padding: 2px 8px;
      border-radius: 6px;
      font-weight: 700;
    }

    .svg-chart {
      width: 100%;
      height: 240px;
      overflow: visible;
    }

    .chart-path {
      stroke-dasharray: 1200;
      stroke-dashoffset: 1200;
      transition: stroke-dashoffset 2.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .chart-path.drawn {
      stroke-dashoffset: 0;
    }

    .chart-fill {
      opacity: 0;
      transition: opacity 1.5s ease 0.8s;
    }

    .chart-fill.drawn {
      opacity: 0.25;
    }

    /* Right Sidebar Widgets */
    .side-widgets {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .widget-card {
      background: rgba(255, 255, 255, 0.025);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 14px;
      padding: 18px;
      transform: translateX(30px);
      opacity: 0;
      transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .widget-card.animated {
      transform: translateX(0);
      opacity: 1;
    }

    .widget-title {
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #94a3b8;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .calc-row {
      display: flex;
      justify-content: space-between;
      font-size: 13px;
      padding: 6px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    }

    .calc-row:last-child {
      border-bottom: none;
      padding-top: 10px;
      font-weight: 700;
      font-size: 14px;
    }

    .partner-notification {
      background: rgba(30, 41, 59, 0.6);
      border: 1px solid rgba(56, 189, 248, 0.3);
      box-shadow: 0 10px 25px -5px rgba(2, 132, 199, 0.25);
    }

    .partner-header {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .partner-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: linear-gradient(135deg, #f59e0b, #ef4444);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 12px;
    }

    .partner-msg {
      font-size: 12px;
      color: #cbd5e1;
      margin-top: 8px;
      line-height: 1.4;
      background: rgba(0, 0, 0, 0.2);
      padding: 8px 10px;
      border-radius: 8px;
      border-left: 2px solid #38bdf8;
    }

    /* Control Panel (Can be hidden during screen recording) */
    .director-controls {
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(15, 23, 42, 0.9);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 100px;
      padding: 8px 18px;
      display: flex;
      align-items: center;
      gap: 12px;
      z-index: 1000;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(20px);
      transition: opacity 0.3s ease, transform 0.3s ease;
    }

    .director-controls.hidden {
      opacity: 0;
      pointer-events: none;
      transform: translateX(-50%) translateY(40px);
    }

    .btn {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.1);
      color: #f1f5f9;
      font-family: inherit;
      font-size: 13px;
      font-weight: 600;
      padding: 8px 16px;
      border-radius: 99px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
    }

    .btn:hover {
      background: rgba(255, 255, 255, 0.15);
      border-color: rgba(255, 255, 255, 0.25);
    }

    .btn-primary {
      background: linear-gradient(135deg, #0284c7, #2563eb);
      border: none;
      color: white;
      box-shadow: 0 4px 15px rgba(37, 99, 235, 0.4);
    }

    .btn-primary:hover {
      background: linear-gradient(135deg, #0369a1, #1d4ed8);
      transform: translateY(-1px);
    }

    .countdown-overlay {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 2000;
      font-size: 120px;
      font-weight: 900;
      color: #38bdf8;
      text-shadow: 0 0 60px rgba(56, 189, 248, 0.6);
      pointer-events: none;
      opacity: 0;
      transform: scale(0.6);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .countdown-overlay.show {
      opacity: 1;
      transform: scale(1);
    }
  </style>
</head>
<body>

  <div class="bg-grid"></div>
  <div class="bg-glow-1"></div>
  <div class="bg-glow-2"></div>

  <!-- Countdown Indicator -->
  <div class="countdown-overlay" id="countdownOverlay">3</div>

  <!-- Kinetic Typography Overlay -->
  <div class="kinetic-text-layer" id="textLayer">
    <div class="kinetic-title" id="mainTitle">REWRITE YOUR DESTINY.</div>
    <div class="kinetic-sub" id="subTitle">WAWE JOURNAL — THE TRADING STANDARD</div>
  </div>

  <!-- 3D Stage / Viewport -->
  <div class="viewport isometric" id="viewport">
    <div class="dashboard-window" id="dashWindow">
      
      <!-- Window Bar -->
      <div class="window-header">
        <div class="header-left">
          <div class="window-dots">
            <div class="dot dot-red"></div>
            <div class="dot dot-yellow"></div>
            <div class="dot dot-green"></div>
          </div>
          <div class="brand-tag">
            <div class="brand-icon">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M2 12c4-8 8 8 12 0s6 8 8 0"/>
              </svg>
            </div>
            Wawe Journal
          </div>
        </div>

        <div class="status-pill">
          <span class="pulse-dot"></span>
          LIVE ANALYTICS ENGINE
        </div>
      </div>

      <!-- Window Body -->
      <div class="window-body">
        
        <!-- Main Column -->
        <div class="main-analytics">
          
          <!-- KPI Cards -->
          <div class="kpi-row">
            <div class="kpi-card" id="kpi1">
              <div class="kpi-label">
                NET CUMULATIVE PnL
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2">
                  <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                  <polyline points="17 6 23 6 23 12"></polyline>
                </svg>
              </div>
              <div class="kpi-value text-emerald" id="pnlCounter">+$0.00</div>
              <div class="kpi-sub">+184.2% Return (This Month)</div>
            </div>

            <div class="kpi-card" id="kpi2">
              <div class="kpi-label">WIN RATE & ACCURACY</div>
              <div class="kpi-value text-blue" id="winRateCounter">0%</div>
              <div class="kpi-sub">38 Wins / 14 Losses</div>
            </div>

            <div class="kpi-card" id="kpi3">
              <div class="kpi-label">PROFIT FACTOR</div>
              <div class="kpi-value" id="pfCounter" style="color: #f8fafc;">0.00</div>
              <div class="kpi-sub">Avg R:R 1:2.85</div>
            </div>
          </div>

          <!-- Chart Area -->
          <div class="chart-container">
            <div class="chart-header">
              <div class="chart-title">
                <span>Equity Growth Curve</span>
                <span class="badge-live">VERIFIED REAL-TIME</span>
              </div>
              <div style="font-size: 12px; color: #64748b; font-family: 'JetBrains Mono', monospace;">
                ALL PAIRS • FEB - OCT 2026
              </div>
            </div>

            <svg class="svg-chart" viewBox="0 0 800 240" fill="none">
              <defs>
                <linearGradient id="chartGradient" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#10b981" stop-opacity="0.5"/>
                  <stop offset="100%" stop-color="#10b981" stop-opacity="0"/>
                </linearGradient>
                <linearGradient id="lineGrad" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0%" stop-color="#38bdf8"/>
                  <stop offset="50%" stop-color="#34d399"/>
                  <stop offset="100%" stop-color="#10b981"/>
                </linearGradient>
              </defs>

              <!-- Grid Horizontal Lines -->
              <line x1="0" y1="60" x2="800" y2="60" stroke="rgba(255,255,255,0.04)" stroke-dasharray="4 4" />
              <line x1="0" y1="120" x2="800" y2="120" stroke="rgba(255,255,255,0.04)" stroke-dasharray="4 4" />
              <line x1="0" y1="180" x2="800" y2="180" stroke="rgba(255,255,255,0.04)" stroke-dasharray="4 4" />

              <!-- Area Fill -->
              <path class="chart-fill" id="chartFill" d="M 0 220 Q 120 200, 220 160 T 400 120 T 560 65 T 720 30 L 780 18 L 780 240 L 0 240 Z" fill="url(#chartGradient)" />

              <!-- Curve Stroke -->
              <path class="chart-path" id="chartPath" d="M 0 220 Q 120 200, 220 160 T 400 120 T 560 65 T 720 30 L 780 18" stroke="url(#lineGrad)" stroke-width="4" stroke-linecap="round" />
            </svg>
          </div>

        </div>

        <!-- Sidebar Widgets -->
        <div class="side-widgets">
          
          <!-- Gross vs Net Deduction Widget -->
          <div class="widget-card" id="widgetCalc">
            <div class="widget-title">
              <span>Real Net Breakdown</span>
              <span style="color: #38bdf8; font-size: 10px;">PRO ENGINE</span>
            </div>
            <div class="calc-row">
              <span style="color: #94a3b8;">Gross Profit</span>
              <span style="color: #f1f5f9; font-family: 'JetBrains Mono';">+$15,820.00</span>
            </div>
            <div class="calc-row">
              <span style="color: #94a3b8;">Commissions</span>
              <span style="color: #f87171; font-family: 'JetBrains Mono';">-$340.50</span>
            </div>
            <div class="calc-row">
              <span style="color: #94a3b8;">Overnight Swaps</span>
              <span style="color: #f87171; font-family: 'JetBrains Mono';">-$49.50</span>
            </div>
            <div class="calc-row">
              <span style="color: #34d399;">Clean Net PnL</span>
              <span style="color: #34d399; font-family: 'JetBrains Mono';" id="cleanNetValue">+$15,430.00</span>
            </div>
          </div>

          <!-- Discipline & Habit Score -->
          <div class="widget-card" id="widgetDiscipline">
            <div class="widget-title">
              <span>Discipline Score</span>
              <span style="color: #10b981; font-weight: 800;">GRADE A+</span>
            </div>
            <div style="display: flex; align-items: baseline; justify-content: space-between;">
              <span style="font-size: 32px; font-weight: 900; color: #f8fafc; font-family: 'JetBrains Mono';" id="scoreCounter">0%</span>
              <span style="font-size: 12px; color: #10b981; font-weight: 600;">0 FOMO Trades</span>
            </div>
            <div style="background: rgba(255,255,255,0.06); height: 6px; border-radius: 99px; margin-top: 10px; overflow: hidden;">
              <div id="scoreBar" style="background: linear-gradient(90deg, #38bdf8, #10b981); width: 0%; height: 100%; transition: width 1.5s ease;"></div>
            </div>
          </div>

          <!-- Partner Review Notification Widget -->
          <div class="widget-card partner-notification" id="widgetPartner">
            <div class="partner-header">
              <div class="partner-avatar">MD</div>
              <div>
                <div style="font-size: 13px; font-weight: 700; color: #f1f5f9;">Partner Review Received</div>
                <div style="font-size: 11px; color: #94a3b8;">From Senior Trader Mark</div>
              </div>
            </div>
            <div class="partner-msg">
              "Great discipline waiting for the liquidity sweep on EUR/USD. Flawless execution! 🔥"
            </div>
          </div>

        </div>

      </div>

    </div>
  </div>

  <!-- Director / Recording Toolbar -->
  <div class="director-controls" id="directorControls">
    <button class="btn btn-primary" id="btnRecord">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
        <polygon points="5 3 19 12 5 21 5 3"></polygon>
      </svg>
      Start Promo Sequence
    </button>
    <button class="btn" id="btnTilt">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
      </svg>
      3D Tilt: <span id="tiltState">ON</span>
    </button>
    <button class="btn" id="btnReset">Reset</button>
    <div style="font-size: 11px; color: #64748b; margin-left: 6px;">
      Press <kbd style="background: rgba(255,255,255,0.1); padding: 2px 5px; border-radius: 4px; color: #fff;">H</kbd> to hide toolbar
    </div>
  </div>

  <script>
    // State & Elements
    const viewport = document.getElementById('viewport');
    const dashWindow = document.getElementById('dashWindow');
    const mainTitle = document.getElementById('mainTitle');
    const subTitle = document.getElementById('subTitle');
    const pnlCounter = document.getElementById('pnlCounter');
    const winRateCounter = document.getElementById('winRateCounter');
    const pfCounter = document.getElementById('pfCounter');
    const chartPath = document.getElementById('chartPath');
    const chartFill = document.getElementById('chartFill');
    const scoreCounter = document.getElementById('scoreCounter');
    const scoreBar = document.getElementById('scoreBar');
    const countdownOverlay = document.getElementById('countdownOverlay');
    const directorControls = document.getElementById('directorControls');
    const tiltState = document.getElementById('tiltState');

    const kpi1 = document.getElementById('kpi1');
    const kpi2 = document.getElementById('kpi2');
    const kpi3 = document.getElementById('kpi3');
    const widgetCalc = document.getElementById('widgetCalc');
    const widgetDiscipline = document.getElementById('widgetDiscipline');
    const widgetPartner = document.getElementById('widgetPartner');

    let is3D = true;

    // Toggle 3D Tilt
    document.getElementById('btnTilt').addEventListener('click', () => {
      is3D = !is3D;
      viewport.classList.toggle('isometric', is3D);
      tiltState.innerText = is3D ? 'ON' : 'OFF';
    });

    // Toggle Toolbar with H key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'h' || e.key === 'H') {
        directorControls.classList.toggle('hidden');
      }
      if (e.code === 'Space') {
        startSequence();
      }
    });

    // Reset Scene
    function resetScene() {
      dashWindow.classList.remove('visible');
      mainTitle.classList.remove('active', 'highlight');
      subTitle.classList.remove('active');
      chartPath.classList.remove('drawn');
      chartFill.classList.remove('drawn');
      [kpi1, kpi2, kpi3, widgetCalc, widgetDiscipline, widgetPartner].forEach(el => el.classList.remove('animated'));
      
      pnlCounter.innerText = '+$0.00';
      winRateCounter.innerText = '0%';
      pfCounter.innerText = '0.00';
      scoreCounter.innerText = '0%';
      scoreBar.style.width = '0%';
    }

    document.getElementById('btnReset').addEventListener('click', resetScene);

    // Number Counting Animations
    function animateCounter(el, start, end, prefix = '', suffix = '', decimals = 0, duration = 1600) {
      let startTime = null;
      function step(timestamp) {
        if (!startTime) startTime = timestamp;
        const progress = Math.min((timestamp - startTime) / duration, 1);
        const easeOut = 1 - Math.pow(1 - progress, 3);
        const current = start + (end - start) * easeOut;
        el.innerText = `${prefix}${current.toLocaleString('en-US', { minimumFractionDigits: decimals, maximumFractionDigits: decimals })}${suffix}`;
        if (progress < 1) {
          requestAnimationFrame(step);
        }
      }
      requestAnimationFrame(step);
    }

    // Sequence Director
    function startSequence() {
      resetScene();
      directorControls.classList.add('hidden');

      // 3-2-1 Countdown
      let count = 3;
      countdownOverlay.innerText = count;
      countdownOverlay.classList.add('show');

      const countInterval = setInterval(() => {
        count--;
        if (count > 0) {
          countdownOverlay.innerText = count;
        } else {
          clearInterval(countInterval);
          countdownOverlay.classList.remove('show');
          executeTimeline();
        }
      }, 700);
    }

    document.getElementById('btnRecord').addEventListener('click', startSequence);

    // Timeline Choreography
    function executeTimeline() {
      // 0.0s - Title 1: BAD LUCK OR NO DATA?
      mainTitle.innerText = "IS IT BAD LUCK?";
      subTitle.innerText = "OR JUST A LACK OF DATA?";
      mainTitle.classList.add('active');
      subTitle.classList.add('active');

      // 2.0s - Title 2: REWRITE YOUR DESTINY
      setTimeout(() => {
        mainTitle.classList.remove('active');
        subTitle.classList.remove('active');

        setTimeout(() => {
          mainTitle.innerText = "REWRITE YOUR DESTINY.";
          subTitle.innerText = "THE NEW STANDARD FOR SERIOUS TRADERS.";
          mainTitle.classList.add('active', 'highlight');
          subTitle.classList.add('active');
        }, 300);
      }, 2000);

      // 4.0s - Dashboard Reveal & Snap
      setTimeout(() => {
        mainTitle.classList.remove('active');
        subTitle.classList.remove('active');

        dashWindow.classList.add('visible');
      }, 3800);

      // 4.6s - KPIs & Chart animate
      setTimeout(() => {
        kpi1.classList.add('animated');
        animateCounter(pnlCounter, 0, 15430, '+$', '', 2, 1800);
      }, 4400);

      setTimeout(() => {
        kpi2.classList.add('animated');
        animateCounter(winRateCounter, 0, 74.2, '', '%', 1, 1500);

        kpi3.classList.add('animated');
        animateCounter(pfCounter, 0, 3.42, '', '', 2, 1500);

        // Chart curve draw
        chartPath.classList.add('drawn');
        chartFill.classList.add('drawn');
      }, 4800);

      // 5.5s - Side widgets animate
      setTimeout(() => {
        widgetCalc.classList.add('animated');
      }, 5400);

      setTimeout(() => {
        widgetDiscipline.classList.add('animated');
        animateCounter(scoreCounter, 0, 96, '', '%', 0, 1200);
        scoreBar.style.width = '96%';
      }, 5900);

      setTimeout(() => {
        widgetPartner.classList.add('animated');
      }, 6400);

      // 8.5s - Sequence finished, bring back toolbar
      setTimeout(() => {
        directorControls.classList.remove('hidden');
      }, 9500);
    }
  </script>
</body>
</html>
