---
import Layout from '../layouts/Layout.astro';
---
<Layout lang="en" showNavbar={false} noIndex={true}>
<Fragment slot="head">
  <title>Sign Up – Wawe Journal</title>
  <meta name="theme-color" content="#000000" />

  <!-- Preconnect & Prefetch for Speed -->
  <link rel="preconnect" href="https://challenges.cloudflare.com" crossorigin />
  <link rel="dns-prefetch" href="https://challenges.cloudflare.com" />
  <link rel="prefetch" href="dashboard.html" />

  <!-- Turnstile Callbacks (Global Scope) -->
  <script is:inline>
    window.latestTurnstileToken = '';
    window.onTurnstileSuccess = function(token) {
      window.latestTurnstileToken = token || '';
    };
    window.onTurnstileExpired = function() {
      window.latestTurnstileToken = '';
    };
    window.onTurnstileError = function() {
      window.latestTurnstileToken = '';
    };
  </script>
  <!-- Cloudflare Turnstile (Official Auto-Render) -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>

  <style is:global>
    /* ═══════════════════════════════════════════════════════════════
       WAWE JOURNAL — AUTH (Login / Sign Up) · siyah + mor, iki sütun
       ═══════════════════════════════════════════════════════════════ */
    :root {
      --bg: #000000;
      --border: rgba(255, 255, 255, 0.09);
      --border2: rgba(255, 255, 255, 0.18);
      --text: #f1f1f5;
      --text2: #9494a8;
      --label: #d4d4e0;
      --muted: #8e8ea0;
      --accent: #8b5cf6;
      --accent2: #c084fc;
      --accent-deep: #6d28d9;
      --accent-glow: rgba(139, 92, 246, 0.22);
      --radius: 22px;
      --radius-sm: 10px;
      --transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      --font: 'Geist', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      --font-display: 'Syne', 'Geist', system-ui, sans-serif;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body {
      width: 100%;
      min-height: 100vh;
      min-height: 100dvh;
      margin: 0;
      padding: 0;
      background: var(--bg);
      color: var(--text);
      font-family: var(--font);
      overflow-x: hidden;
      color-scheme: dark;
    }

    #navbar-container { display: none !important; }

    #app-scroll-container {
      min-height: 100vh !important;
      min-height: 100dvh !important;
      height: 100% !important;
      width: 100% !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: center !important;
      align-items: center !important;
      padding: clamp(1rem, 4vh, 2.5rem) 1.25rem !important;
      box-sizing: border-box !important;
      overflow-y: auto !important;
      overflow-x: hidden !important;
      position: relative !important;
    }

    .wj-ambient-backdrop,
    body::before,
    body::after {
      display: none !important;
    }

    /* Çerçeve: solda form, sağda dağ görseli */
    .auth-shell {
      width: 100%;
      max-width: 1120px;
      min-height: min(740px, calc(100dvh - 2rem));
      margin: auto !important;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      box-shadow: 0 30px 100px rgba(0, 0, 0, 0.7), 0 0 80px rgba(139, 92, 246, 0.06);
    }

    .auth-side {
      display: flex;
      flex-direction: column;
      padding: 1.75rem 2rem 2rem;
      min-width: 0;
    }

    .brand-logo {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      align-self: flex-start;
      text-decoration: none;
      transition: transform 0.25s ease;
    }
    .brand-logo:hover { transform: translateY(-1px); }
    .brand-logo .brand-mark {
      display: block;
      width: 36px;
      height: 24px;
      object-fit: contain;
    }

    .auth-form {
      width: 100%;
      max-width: 360px;
      margin: auto;
      padding: 2rem 0 0.5rem;
    }

    .auth-title {
      font-size: 1.75rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      color: var(--text);
      margin-bottom: 0.35rem;
    }
    .auth-sub {
      font-size: 0.875rem;
      color: var(--text2);
      margin-bottom: 1.5rem;
    }

    .field { margin-bottom: 1rem; }
    .field-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 0.45rem;
    }
    .field label {
      display: block;
      font-size: 13px;
      font-weight: 500;
      color: var(--label);
      margin-bottom: 0.45rem;
    }
    .field-head label { margin-bottom: 0; }
    .field input {
      width: 100%;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 0.68rem 0.9rem;
      color: var(--text);
      font-family: var(--font);
      font-size: 14px;
      outline: none;
      transition: var(--transition);
    }
    .field input::placeholder { color: var(--muted); opacity: 0.55; }
    .field input:hover { border-color: var(--border2); }
    .field input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-glow);
    }

    .input-wrap { position: relative; }
    .input-wrap input { padding-right: 2.75rem; }
    .pw-toggle {
      position: absolute;
      top: 50%;
      right: 6px;
      transform: translateY(-50%);
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: none;
      border-radius: 7px;
      background: transparent;
      color: var(--text2);
      cursor: pointer;
      transition: var(--transition);
    }
    .pw-toggle:hover { color: var(--accent2); }
    .pw-toggle svg { width: 17px; height: 17px; }
    .pw-toggle .eye-off { display: none; }
    .pw-toggle[aria-pressed="true"] .eye-on { display: none; }
    .pw-toggle[aria-pressed="true"] .eye-off { display: block; }

    .forgot-link {
      color: var(--accent2);
      font-size: 12px;
      font-weight: 500;
      text-decoration: underline;
      text-underline-offset: 3px;
      text-decoration-color: rgba(192, 132, 252, 0.4);
      transition: color 0.2s;
    }
    .forgot-link:hover { color: #fff; }

    .turnstile-wrap {
      display: flex;
      justify-content: center;
      margin: 0.25rem 0 0.75rem;
      min-height: 65px;
    }
    .turnstile-wrap[data-skip="1"] {
      display: none;
      min-height: 0;
      margin: 0;
    }

    /* buttons.css .btn-primary'yi siyah hap butona zorluyor; auth butonu kendi sınıfında */
    .btn-auth {
      width: 100%;
      padding: 0.75rem 1rem;
      border: 1px solid rgba(192, 132, 252, 0.35);
      border-radius: var(--radius-sm);
      background: linear-gradient(180deg, var(--accent) 0%, var(--accent-deep) 100%);
      color: #fff;
      font-family: var(--font);
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: var(--transition);
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.18) inset,
        0 6px 20px rgba(139, 92, 246, 0.3);
    }
    .btn-auth:hover {
      filter: brightness(1.1);
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.22) inset,
        0 8px 28px rgba(139, 92, 246, 0.45);
    }
    .btn-auth:active { transform: scale(0.99); }
    .btn-auth:disabled {
      opacity: 0.55;
      cursor: not-allowed;
      filter: none;
      transform: none !important;
      box-shadow: none !important;
    }

    .divider {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      margin: 1.1rem 0;
      color: var(--muted);
      font-size: 10.5px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .divider::before,
    .divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border);
    }

    .btn-google {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      padding: 0.68rem 1rem;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border);
      background: var(--bg);
      color: var(--text);
      font-family: var(--font);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: var(--transition);
    }
    .btn-google:hover { border-color: rgba(139, 92, 246, 0.55); }
    .btn-google:active { transform: scale(0.99); }
    .btn-google svg { width: 17px; height: 17px; flex-shrink: 0; }
    .btn-google:disabled {
      opacity: 0.55;
      cursor: not-allowed;
      transform: none !important;
    }

    .terms-text {
      text-align: center;
      font-size: 12px;
      color: var(--text2);
      margin-top: 1rem;
    }
    .terms-text a {
      color: var(--accent2);
      text-decoration: none;
      font-weight: 500;
      transition: color 0.2s;
    }
    .terms-text a:hover { color: #fff; }

    .auth-switch {
      margin-top: 1.25rem;
      text-align: center;
      font-size: 13px;
      color: var(--text2);
    }
    .auth-switch a {
      margin-left: 4px;
      color: var(--accent2);
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 3px;
      text-decoration-color: rgba(192, 132, 252, 0.4);
      transition: color 0.2s;
    }
    .auth-switch a:hover { color: #fff; }

    /* Sağ panel: dağ görseli + kısa mesaj */
    .auth-visual {
      position: relative;
      overflow: hidden;
      border-left: 1px solid var(--border);
      background:
        linear-gradient(180deg, #000 0%, rgba(0, 0, 0, 0) 38%),
        linear-gradient(0deg, #000 0%, rgba(0, 0, 0, 0) 14%),
        url("/images/brand/hero-peak.webp") 50% 100% / auto 74% no-repeat,
        #000;
    }
    .auth-visual::after {
      content: '';
      position: absolute;
      left: 50%;
      bottom: 18%;
      width: 520px;
      height: 360px;
      transform: translateX(-50%);
      background: radial-gradient(ellipse, rgba(139, 92, 246, 0.16) 0%, transparent 70%);
      pointer-events: none;
    }
    .auth-visual-copy {
      position: relative;
      z-index: 1;
      padding: clamp(3rem, 9vh, 5.5rem) 2.5rem 0;
      text-align: center;
    }
    .auth-visual-copy h2 {
      font-size: clamp(1.6rem, 2.6vw, 2.25rem);
      font-weight: 600;
      line-height: 1.18;
      letter-spacing: -0.025em;
      color: var(--text);
    }
    .auth-visual-copy h2 .vl2 {
      display: block;
      background: linear-gradient(90deg, #8e8ea0 0%, var(--accent2) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .auth-points {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
      margin-top: 1.4rem;
    }
    .auth-points li {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 11px;
      border: 1px solid rgba(139, 92, 246, 0.3);
      border-radius: 999px;
      background: rgba(0, 0, 0, 0.6);
      color: var(--label);
      font-size: 12px;
      font-weight: 500;
    }
    .auth-points li::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 8px var(--accent);
    }

    .toast-container {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      z-index: 999999;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      max-width: 380px;
      width: 100%;
      pointer-events: none;
    }
    .toast {
      pointer-events: all;
      padding: 0.85rem 1.25rem;
      border-radius: var(--radius-sm);
      font-family: var(--font);
      font-size: 13.5px;
      font-weight: 500;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 12px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
      animation: toastIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) both;
      border: 1px solid rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
    }
    .toast.error { background: rgba(239, 68, 68, 0.95); border-color: rgba(239, 68, 68, 0.35); }
    .toast.success { background: rgba(34, 197, 94, 0.95); border-color: rgba(34, 197, 94, 0.35); }
    .toast.info { background: rgba(139, 92, 246, 0.95); border-color: rgba(139, 92, 246, 0.35); }
    .toast .toast-icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .toast .toast-message { flex: 1; line-height: 1.4; word-break: break-word; }
    .toast .toast-close {
      background: none;
      border: none;
      color: rgba(255, 255, 255, 0.6);
      cursor: pointer;
      font-size: 18px;
      line-height: 1;
      padding: 0 4px;
      margin-left: 6px;
      transition: color 0.2s;
    }
    .toast .toast-close:hover { color: #fff; }
    @keyframes toastIn {
      from { opacity: 0; transform: translateY(12px) scale(0.95); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .toast.hide { animation: toastOut 0.3s ease both; }
    @keyframes toastOut {
      from { opacity: 1; transform: translateY(0) scale(1); }
      to { opacity: 0; transform: translateY(12px) scale(0.95); }
    }

    /* Fallback if ww-toast is triggered */
    .ww-toast {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      z-index: 999999;
      padding: 0.85rem 1.25rem;
      border-radius: var(--radius-sm);
      font-family: var(--font);
      font-size: 13.5px;
      font-weight: 500;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 12px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
      background: #000;
      border: 1px solid var(--border2);
      backdrop-filter: blur(20px);
      opacity: 1 !important;
      transform: none !important;
      transition: all 0.3s ease;
    }
    .ww-toast--error { background: rgba(239, 68, 68, 0.95) !important; border-color: rgba(239, 68, 68, 0.35) !important; }
    .ww-toast--success { background: rgba(34, 197, 94, 0.95) !important; border-color: rgba(34, 197, 94, 0.35) !important; }

    /* Tablet ve altı: tek sütun, görsel gizli */
    @media (max-width: 900px) {
      #app-scroll-container { padding: 0 !important; justify-content: flex-start !important; }
      .auth-shell {
        grid-template-columns: 1fr;
        min-height: 100dvh;
        border: none;
        border-radius: 0;
        box-shadow: none;
      }
      .auth-visual { display: none; }
      .auth-side { padding: 1.25rem 1.25rem 2rem; }
      .auth-form { padding-top: 2.5rem; margin: 0 auto; }
    }
    @media (max-width: 600px) {
      .brand-logo .brand-mark { width: 30px; height: 20px; }
      .auth-title { font-size: 1.5rem; }
      .field input {
        padding: 0.75rem 0.9rem;
        font-size: 16px !important; /* iOS safari auto-zoom onleme */
      }
      .input-wrap input { padding-right: 2.75rem; }
      .btn-google,
      .btn-auth { min-height: 44px; }
      .turnstile-wrap { max-width: 100%; overflow: hidden; }
      .toast-container {
        bottom: 1rem;
        right: 1rem;
        left: 1rem;
        max-width: calc(100% - 2rem);
      }
    }
    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
</style>

  <link rel="preload" href="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.117.3" as="script" />
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.117.3" is:inline defer></script>
  <script src="/config.js" is:inline defer></script>
  <script src="/auth-i18n.js?v=1" is:inline></script>
  <script src="/auth-spa.js?v=1" is:inline defer></script>
</Fragment>

  <div class="auth-shell">
    <section class="auth-side" data-at-title="register.doc_title">
      <a href="/" class="brand-logo" aria-label="Wawe Journal Home" data-at-aria="common.home_aria">
        <img class="brand-mark" src="/images/brand/logo-mark.png" srcset="/images/brand/logo-mark.png 1x, /images/brand/logo-mark@2x.png 2x" alt="" width="36" height="24" />
      </a>

      <div class="auth-form">
        <h1 class="auth-title" data-at="register.title">Create your account</h1>
        <p class="auth-sub" data-at="register.sub">Start journaling your trades in minutes.</p>

        <button type="button" class="btn-google" id="google-register-btn">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="currentColor"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="currentColor"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="currentColor"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="currentColor"/>
          </svg>
          <span data-at="common.continue_google">Continue with Google</span>
        </button>

        <div class="divider" data-at="common.or">or</div>

        <form id="register-form" onsubmit="return false;">
          <div class="field">
            <label for="username" data-at="register.username_label">Username</label>
            <input type="text" id="username" placeholder="e.g., traderjohn" data-at-ph="register.username_ph" autocomplete="username" />
          </div>

          <div class="field">
            <label for="email" data-at="common.email_label">Email address</label>
            <input type="email" id="email" placeholder="Enter your email address" data-at-ph="common.email_ph" autocomplete="email" />
          </div>

          <div class="field">
            <label for="password" data-at="common.password_label">Password</label>
            <div class="input-wrap">
              <input type="password" id="password" placeholder="At least 6 characters" data-at-ph="register.password_ph" autocomplete="new-password" />
              <button type="button" class="pw-toggle" data-pw-toggle="password" aria-label="Show password" data-at-aria="common.show_pw" aria-pressed="false">
                <svg class="eye-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg class="eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
              </button>
            </div>
          </div>

          <div class="field">
            <label for="password2" data-at="register.confirm_label">Confirm password</label>
            <div class="input-wrap">
              <input type="password" id="password2" placeholder="Re-enter password" data-at-ph="register.confirm_ph" autocomplete="new-password" />
              <button type="button" class="pw-toggle" data-pw-toggle="password2" aria-label="Show password" data-at-aria="common.show_pw" aria-pressed="false">
                <svg class="eye-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg class="eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
              </button>
            </div>
          </div>

          <!-- Turnstile widget (Official Auto-Render) -->
          <div class="turnstile-wrap">
            <div
              class="cf-turnstile"
              id="turnstile-container"
              data-sitekey="0x4AAAAAAEzAoR2XhUtPTxV7"
              data-theme="dark"
              data-size="flexible"
              data-callback="onTurnstileSuccess"
              data-expired-callback="onTurnstileExpired"
              data-error-callback="onTurnstileError"
            ></div>
          </div>

          <button type="submit" class="btn-auth" id="register-btn" data-at="register.submit">Sign Up</button>
        </form>

        <p class="terms-text" data-at-html="register.terms_html">
          By signing up, you agree to our <a href="terms.html">Terms of Use</a>.
        </p>

        <p class="auth-switch"><span data-at="register.have_account">Already have an account?</span><a href="login.html" data-at="register.login">Log in</a></p>
      </div>
    </section>

    <aside class="auth-visual" aria-hidden="true">
      <div class="auth-visual-copy">
        <h2><span data-at="common.visual_1">Track every trade.</span><span class="vl2" data-at="common.visual_2">Master your discipline.</span></h2>
        <ul class="auth-points">
          <li data-at="common.pt_journal">Trade journal</li>
          <li data-at="common.pt_analytics">Analytics</li>
          <li data-at="common.pt_backtest">Backtesting</li>
        </ul>
      </div>
    </aside>
  </div>

  <div class="toast-container" id="toast-container"></div>

  <script is:inline data-auth-script>
    // Metinleri seçili dile çevir (markup'tan hemen sonra, ilk boyamadan önce)
    wwAuthI18n.apply();

    // Şifre göster / gizle
    document.querySelectorAll('[data-pw-toggle]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var input = document.getElementById(btn.getAttribute('data-pw-toggle'));
        if (!input) return;
        var show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        btn.setAttribute('aria-pressed', show ? 'true' : 'false');
        btn.setAttribute('aria-label', show ? authT('common.hide_pw') : authT('common.show_pw'));
      });
    });
  </script>

  <script is:inline data-auth-script>
    // ⭐ URL'den gelen hata veya OAuth parametrelerini işle
    (function handleUrlParams() {
      if (typeof window === 'undefined') return;
      var searchParams = new URLSearchParams(window.location.search);
      var hashParams = new URLSearchParams(window.location.hash.replace(/^#/, ''));
      var authErr = searchParams.get('auth_error') || 
                    searchParams.get('error_description') || 
                    searchParams.get('error') || 
                    hashParams.get('error_description') || 
                    hashParams.get('error');

      if (authErr) {
        var cleanMsg = decodeURIComponent(authErr).replace(/\+/g, ' ');
        if (cleanMsg.includes('Database error saving new user')) {
          cleanMsg = authT('err.google_db');
        }
        window.addEventListener('DOMContentLoaded', function() {
          setTimeout(function() {
            toast(cleanMsg, 'error');
          }, 300);
        });
        if (window.history && window.history.replaceState) {
          window.history.replaceState(null, '', window.location.pathname);
        }
      } else if (window.location.hash.includes('access_token') || window.location.search.includes('code=')) {
        window.location.replace('dashboard.html' + window.location.search + window.location.hash);
      }
    })();

    // ─── Güvenli Yardımcılar ─────────────────────────────────
    function getSupabase() {
      if (typeof window.sb !== 'undefined' && window.sb) return window.sb;
      if (typeof window.supabase !== 'undefined' && window.supabase.createClient) {
        var url = (window.WW_CONFIG && window.WW_CONFIG.SUPABASE_URL) || window.SUPABASE_URL || 'https://odasapyhtdopbnlfhwde.supabase.co';
        var key = (window.WW_CONFIG && window.WW_CONFIG.SUPABASE_ANON_KEY) || window.SUPABASE_ANON_KEY || 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9kYXNhcHlodGRvcGJubGZod2RlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzg0NDk0NjgsImV4cCI6MjA5NDAyNTQ2OH0.AH7V9i61pFWj33sCy51khdYHZn34BNitXY9exJySmWg';
        window.sb = window.supabase.createClient(url, key);
        return window.sb;
      }
      return null;
    }

    function toast(msg, type) {
      type = type || 'info';
      var container = document.getElementById('toast-container');
      if (!container) {
        container = document.createElement('div');
        container.id = 'toast-container';
        container.className = 'toast-container';
        document.body.appendChild(container);
      }

      var iconSvg = '';
      if (type === 'success') {
        iconSvg = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><polyline points="20 6 9 17 4 12"></polyline></svg>';
      } else if (type === 'error') {
        iconSvg = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>';
      } else {
        iconSvg = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>';
      }

      var cleanMsg = String(msg || '').replace(/[\u{1F300}-\u{1F9FF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}\u{1F1E0}-\u{1F1FF}\u{1F600}-\u{1F64F}\u{1F680}-\u{1F6FF}\u{2300}-\u{23FF}\u{2B50}\u{2B55}\u{200D}\u{FE0F}]/gu, '').trim();
      var el = document.createElement('div');
      el.className = 'toast ' + type;
      el.innerHTML = `
        <span class="toast-icon">${iconSvg}</span>
        <span class="toast-message">${escapeHtml(cleanMsg)}</span>
        <button type="button" class="toast-close" aria-label="${authT('common.close')}">&times;</button>
      `;

      var closeBtn = el.querySelector('.toast-close');
      if (closeBtn) {
        closeBtn.onclick = function() {
          el.classList.add('hide');
          setTimeout(function() { el.remove(); }, 300);
        };
      }

      container.appendChild(el);

      setTimeout(function() {
        if (el.parentNode) {
          el.classList.add('hide');
          setTimeout(function() { el.remove(); }, 300);
        }
      }, 4000);
    }

    // Force window.showToast to use this reliable toast function
    try {
      Object.defineProperty(window, 'showToast', {
        get: function() { return toast; },
        set: function() {},
        configurable: true
      });
    } catch(e) {
      window.showToast = toast;
    }

    function escapeHtml(text) {
      if (!text) return '';
      return String(text)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function validateEmail(email) {
      if (typeof window.isValidEmail === 'function') return window.isValidEmail(email);
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    }

    function hasTurkishChars(str) {
      return /[ığüşöçİĞÜŞÖÇ]/.test(str);
    }

    // ─── Turnstile Token Alma & Yedek Render ───────────────────
    function getTurnstileToken() {
      if (window.latestTurnstileToken) return window.latestTurnstileToken;
      var input = document.querySelector('[name="cf-turnstile-response"]');
      if (input && input.value) return input.value;
      if (typeof window.turnstile !== 'undefined' && typeof window.turnstile.getResponse === 'function') {
        try {
          var t = window.turnstile.getResponse();
          if (t) return t;
        } catch (e) {}
      }
      return '';
    }

    function resetTurnstile() {
      window.latestTurnstileToken = '';
      if (typeof window.turnstile !== 'undefined' && typeof window.turnstile.reset === 'function') {
        try { window.turnstile.reset(); } catch (e) {}
      }
    }

    function isTurnstileRequired() {
      if (typeof window.isTurnstileConfigured === 'function') {
        return window.isTurnstileConfigured();
      }
      return true;
    }

    // Yedek render: DOM hazır olduğunda veya gecikme durumunda manuel tetikle
    function ensureTurnstileRender() {
      var c = document.getElementById('turnstile-container');
      if (c && !c.hasChildNodes() && typeof window.turnstile !== 'undefined' && typeof window.turnstile.render === 'function') {
        try {
          window.turnstile.render(c, {
            sitekey: '0x4AAAAAAEzAoR2XhUtPTxV7',
            theme: 'dark',
            size: 'flexible',
            callback: function(token) { window.onTurnstileSuccess(token); },
            'expired-callback': function() { window.onTurnstileExpired(); },
            'error-callback': function() { window.onTurnstileError(); }
          });
        } catch (e) {}
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', ensureTurnstileRender);
    } else {
      ensureTurnstileRender();
    }
    setTimeout(ensureTurnstileRender, 500);

    // ─── Mevcut Oturum Kontrolü (Hızlı 0ms Denetim) ─────────
    function checkExistingSession() {
      if (window.location.search.includes('error=') || window.location.hash.includes('error=') || window.location.search.includes('auth_error=')) {
        return;
      }
      try {
        for (var i = 0; i < localStorage.length; i++) {
          var k = localStorage.key(i);
          if (k && k.indexOf('sb-') === 0 && k.indexOf('-auth-token') !== -1) {
            var raw = localStorage.getItem(k);
            if (raw && (raw.indexOf('access_token') !== -1 || raw.indexOf('currentSession') !== -1)) {
              window.location.replace('dashboard.html');
              return;
            }
          }
        }
      } catch (e) {}

      var client = getSupabase();
      if (client && client.auth) {
        client.auth.getSession().then(function(res) {
          if (res && res.data && res.data.session) {
            window.location.replace('dashboard.html');
          }
        }).catch(function() {});
      }
    }
    checkExistingSession();

    // ─── Google OAuth Kaydı ──────────────────────────────────
    async function signUpWithGoogle() {
      const btn = document.getElementById('google-register-btn');
      btn.disabled = true;
      var originalHTML = btn.innerHTML;
      btn.innerHTML = `
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:20px;height:20px;flex-shrink:0;animation:spin 1s linear infinite;">
          <circle cx="12" cy="12" r="10" stroke="#8b5cf6" stroke-width="2" stroke-dasharray="31.4 31.4" fill="none"/>
        </svg>
        ${authT('common.redirect_google')}
      `;
      try {
        var client = getSupabase();
        if (!client || !client.auth) {
          toast(authT('err.auth_init'), 'error');
          btn.disabled = false;
          btn.innerHTML = originalHTML;
          return;
        }
        const { data, error } = await client.auth.signInWithOAuth({
          provider: 'google',
          options: {
            redirectTo: window.location.origin + '/dashboard.html',
            queryParams: { access_type: 'offline', prompt: 'consent' }
          }
        });
        if (error) {
          toast(authT('err.google_signup_failed') + error.message, 'error');
          btn.disabled = false;
          btn.innerHTML = originalHTML;
          return;
        }
        if (data && data.url) {
          window.location.href = data.url;
        }
      } catch (err) {
        toast(authT('err.unexpected'), 'error');
        btn.disabled = false;
        btn.innerHTML = originalHTML;
      }
    }

    document.getElementById('google-register-btn').addEventListener('click', signUpWithGoogle);

    // ─── E-posta ile Kayıt ────────────────────────────────────
    document.getElementById('register-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const username = document.getElementById('username').value.trim();
      let email = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;
      const pass2 = document.getElementById('password2').value;

      email = email.toLowerCase();

      if (!username) { toast(authT('err.username_required'), 'error'); return; }
      if (username.length < 3) { toast(authT('err.username_short'), 'error'); return; }
      if (!/^[a-zA-Z0-9_.-]+$/.test(username)) { toast(authT('err.username_invalid'), 'error'); return; }
      if (!email || !password) { toast(authT('err.email_password_required'), 'error'); return; }
      if (hasTurkishChars(email)) { toast(authT('err.email_turkish'), 'error'); return; }
      if (!validateEmail(email)) { toast(authT('err.email_invalid'), 'error'); return; }
      if (password.length < 6) { toast(authT('err.password_short'), 'error'); return; }
      if (password !== pass2) { toast(authT('err.password_mismatch'), 'error'); return; }

      var turnstileToken = getTurnstileToken();
      if (!turnstileToken) {
        toast(authT('err.turnstile_required'), 'error');
        return;
      }

      const btn = document.getElementById('register-btn');
      btn.disabled = true;
      btn.textContent = authT('register.submitting');

      var supabaseUrl = (window.WW_CONFIG && window.WW_CONFIG.SUPABASE_URL) || window.SUPABASE_URL || 'https://odasapyhtdopbnlfhwde.supabase.co';
      var supabaseAnonKey = (window.WW_CONFIG && window.WW_CONFIG.SUPABASE_ANON_KEY) || window.WW_CONFIG.SUPABASE_ANON_KEY || 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9kYXNhcHlodGRvcGJubGZod2RlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzg0NDk0NjgsImV4cCI6MjA5NDAyNTQ2OH0.AH7V9i61pFWj33sCy51khdYHZn34BNitXY9exJySmWg';
      var client = getSupabase();

      // Sadece Edge Function ile kayıt yap. Başarısız olursa Native Supabase'e DÜŞME,
      // çünkü Native Supabase e-posta onayı gerektirir ve kullanıcı anında giriş yapmak istiyor.
      try {
        const res = await fetch(
          supabaseUrl + '/functions/v1/verify-auth',
          {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'apikey': supabaseAnonKey,
            },
            body: JSON.stringify({ action: 'register', email, password, username, turnstileToken }),
          }
        );

        const result = await res.json().catch(() => ({}));

        if (res.ok && result.success) {
          if (result.access_token && result.refresh_token && client && client.auth) {
            await client.auth.setSession({
              access_token: result.access_token,
              refresh_token: result.refresh_token,
            });
          }
          btn.textContent = authT('register.done');
          toast(authT('register.created'), 'success');
          setTimeout(() => { window.location.href = 'dashboard.html'; }, 180);
          return;
        }

        // Edge Function hata döndürdüyse (örneğin rate limit, turnstile, username vs.)
        // Kullanıcıya doğrudan hatayı göster ve işlemi durdur.
        btn.disabled = false;
        btn.textContent = authT('register.submit');
        resetTurnstile();

        let errorMessage = result.error || authT('err.register_failed');
        
        // Turnstile hatasını daha anlaşılır yap
        if (errorMessage.toLowerCase().includes('verification failed') || errorMessage.toLowerCase().includes('turnstile')) {
          errorMessage = authT('err.turnstile_failed');
        } else if (errorMessage.toLowerCase().includes('already registered') || errorMessage.toLowerCase().includes('user already registered')) {
          errorMessage = authT('err.email_taken');
        } else if (errorMessage.toLowerCase().includes('username already taken')) {
          errorMessage = authT('err.username_taken');
        }
        
        toast(errorMessage, 'error');
        return;

      } catch (err) {
        console.error('Register error:', err);
        toast(authT('err.server'), 'error');
        resetTurnstile();
        btn.disabled = false;
        btn.textContent = authT('register.submit');
      }
    });

  </script>
</Layout>
