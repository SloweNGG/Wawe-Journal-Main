---
import PageLayout from '../layouts/PageLayout.astro';
---
<PageLayout title="Wawe Social – Trader için Sosyal Medya" noIndex={true}>
  <section class="page-hero solo">
    <div class="wrap">
      <span class="pill anim" style="--d:.05s"><b data-i18n="hero.beta">BETA</b></span>
      <h1 class="anim" style="--d:.15s" data-i18n="social.title">🌊 Wawe Social</h1>
      <p class="page-lead anim" style="--d:.3s" data-i18n="social.desc">Trader'lar için özel sosyal medya platformu. Çok yakında…</p>
      <div class="page-actions anim" style="--d:.45s">
        <a href="/" class="btn btn-line" data-i18n="common.back_home">← Ana Sayfaya Dön</a>
      </div>
    </div>
  </section>
</PageLayout>
