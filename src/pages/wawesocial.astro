---
import Layout from '../layouts/Layout.astro';
---
<Layout lang="tr" bodyStyle="display:flex;flex-direction:column;min-height:100vh;">
<Fragment slot="head">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Wawe Social – Trader'lar için Sosyal Medya</title>
  <link rel="icon" type="image/svg+xml" href="/resim.svg">
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css" />
  <style>
    .coming-soon {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 70vh;
      text-align: center;
      padding: 2rem;
    }
    .coming-soon h1 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 3rem;
      font-weight: 800;
      margin-bottom: 1rem;
      background: linear-gradient(135deg, var(--text), var(--accent));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .coming-soon p {
      color: var(--muted);
      font-size: 1.1rem;
      max-width: 500px;
    }
    .coming-soon .btn-back {
      margin-top: 2rem;
    }
  </style>
</Fragment>
  <nav class="nav">
    <a href="index.html" class="nav-logo">
      <div class="logo-icon">
        <svg width="16" height="16" viewBox="0 0 22 22" fill="none">
          <polyline points="2,16 7,9 12,13 19,4" stroke="#7c6dfa" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      Wawe<span>Social</span>
    </a>
    <div class="nav-links">
      <a href="index.html" class="btn-ghost">Ana Sayfa</a>
      <a href="login.html" class="btn-login">Giriş Yap</a>
      <a href="register.html" class="btn-register">Kayıt Ol →</a>
    </div>
  </nav>

  <main>
    <div class="coming-soon">
      <h1>🌊 Wawe Social</h1>
      <p>Trader'lar için özel sosyal medya platformu.<br>Çok yakında…</p>
      <div class="btn-back">
        <a href="index.html" class="btn btn-primary">← Ana Sayfaya Dön</a>
      </div>
    </div>
  </main>

  <footer class="site-footer" style="margin-top: auto;">
    <div class="footer-container">
      <div class="footer-col">
        <div class="footer-logo">
          <svg width="18" height="18" viewBox="0 0 22 22" fill="none">
            <polyline points="2,16 7,9 12,13 19,4" stroke="#7c6dfa" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Wawe<span>Social</span>
        </div>
        <p class="footer-desc">Trader'lar için özel sosyal medya platformu. Yakında.</p>
      </div>
      <div class="footer-col">
        <h4>Linkler</h4>
        <ul>
          <li><a href="index.html">Wawe Journal</a></li>
          <li><a href="login.html">Giriş Yap</a></li>
          <li><a href="register.html">Kayıt Ol</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Kurumsal</h4>
        <ul>
          <li><a href="about.html">Biz Kimiz?</a></li>
          <li><a href="privacy.html">Gizlilik</a></li>
          <li><a href="terms.html">Kullanım Şartları</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>İletişim</h4>
        <ul>
          <li><a href="mailto:destek@wawedev.com">destek@wawedev.com</a></li>
          <li><span>Denizli, Türkiye</span></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom-bar">
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" is:inline></script>
  <script src="/config.js" is:inline></script>
  <script src="/script.js" is:inline></script>
</Layout>
