          // trade_count yalnızca CANLI işlemleri sayar (list_journals, Migration 05). delete_journal backtest
          // aynalarını da siler; sayıları tıklama anında HEAD count ile okunur (satır indirilmez).
          var msgEl = document.getElementById('delete-modal-msg');
          var baseMsg = i18n.t('journal.delete_message').replace('{tradeCount}', j.trade_count || 0).replace('{strategyCount}', j.strategy_count || 0);
          msgEl.textContent = baseMsg;
          document.getElementById('delete-modal').classList.add('active');
          var askedFor = j.id;
          if (window.WwTrades) {
            window.WwTrades.count({ journalId: j.id, scope: 'backtest' }).then(function (r) {
              if (deleteId !== askedFor || !r || r.error || !r.count) return;
              var extra = i18n.t('journal.delete_message_backtest', { count: r.count });
              if (!extra || extra === 'journal.delete_message_backtest') extra = 'Ayrıca ' + r.count + ' backtest işlemi silinecek.';
              msgEl.textContent = baseMsg + ' ' + extra;
            });
          }
        };
      }
    });
    
    if (typeof lucide !== 'undefined') lucide.createIcons();
  }

  function tryRenderCachedJournals() {
    try {
      var rawJ = localStorage.getItem('ww_cached_journals_list');
      var rawProps = localStorage.getItem('ww_cached_props_map');
      var rawCt = localStorage.getItem('ww_cached_ctrader_map');
      if (rawJ) {
        var parsedJ = JSON.parse(rawJ);
        if (Array.isArray(parsedJ) && parsedJ.length > 0) {
          var pMap = new Map();
          if (rawProps) {
            var po = JSON.parse(rawProps);
            Object.keys(po).forEach(function(k) { pMap.set(k, po[k]); });
          }
          var cMap = new Map();
          if (rawCt) {
            var co = JSON.parse(rawCt);
            Object.keys(co).forEach(function(k) { cMap.set(k, co[k]); });
          }
          drawJournalsGrid(parsedJ, pMap, cMap, isPro, window.__wwUserProfile || null);
        }
      }
    } catch(e) {}
  }

  // Önceki bilinen cTrader hesapları: bu oturumda çekilen liste, yoksa localStorage önbelleği
  function previousCtraderAccounts() {
    if (Array.isArray(window._allCtraderAccounts) && window._allCtraderAccounts.length) return window._allCtraderAccounts;
    try {
      var m = JSON.parse(localStorage.getItem('ww_cached_ctrader_map') || 'null');
      if (m && typeof m === 'object') return Object.keys(m).map(function(k) { return m[k]; });
    } catch (e) {}
    return [];
  }

  // cTrader durumunu çeker. Zaman aşımı / RPC hatası / bozuk cevapta BOŞ liste dönmez (eskiden dönüyordu: kartlardan
  // cTrader çubuğu ve bakiye kayboluyor, boş liste önbelleğe de yazılıyordu); önceki bilinen hesaplar korunur.
  async function fetchCtraderStatusSafe(timeoutMs) {
    var fallback = { data: { accounts: previousCtraderAccounts() }, stale: true };
    if (!window.sb || typeof window.sb.rpc !== 'function') return fallback;
    try {
      var res = await Promise.race([
        window.sb.rpc('get_ctrader_status'),
        new Promise(function(resolve) { setTimeout(function() { resolve(null); }, timeoutMs); })
      ]);
      if (!res || res.error || !res.data || !Array.isArray(res.data.accounts)) return fallback;
      return res;
    } catch (e) {
      return fallback;
    }
  }

  async function renderJournals() {
    // ⚡ 0ms SWR ÖNBELLEK: Önce RAM/localStorage'daki veriyi hemen bas
    tryRenderCachedJournals();

    if (_isRenderingJournals) return;
    _isRenderingJournals = true;

    try {
      await ensureDependencies();

      var user = await getAuthenticatedUser();
      if (!user) {
        var gridEl = document.getElementById('journals-grid');
        if (gridEl && (!journalsData || journalsData.length === 0)) gridEl.innerHTML = '';
        return;
      }

      // 🚀 PARALEL SORGULAMA: Profil, Defterler, Prop Hesapları ve cTrader verilerini tek turda eşzamanlı çek!
      var profilePromise = (async function() {
        if (window.__wwUserProfile) return { data: window.__wwUserProfile };
        if (!window.sb) return { data: null };
        try {
          var res = await window.sb.from('user_profiles').select('plan, max_journals').eq('id', user.id).maybeSingle();
          return res || { data: null };
        } catch (e) {
          return { data: null };
        }
      })();

      var journalsPromise = (async function() {
        if (!window.journal || typeof window.journal.listJournals !== 'function') return null;
        try {
          var res = await window.journal.listJournals();
          return Array.isArray(res) ? res : null;
        } catch (e) {
          console.warn('listJournals hatası:', e);
          return null;
        }
      })();

      var propPromise = (async function() {
        if (!window.PropService || typeof window.PropService.getActivePropAccounts !== 'function') return [];
        try {
          var res = await window.PropService.getActivePropAccounts();
          return Array.isArray(res) ? res : [];
        } catch (e) {
          return [];
        }
      })();

      var ctraderPromise = fetchCtraderStatusSafe(1500);

      var [profRes, jListData, activeProps, ctRes] = await Promise.all([
        profilePromise,
        journalsPromise,
        propPromise,
        ctraderPromise
      ]);

      var profile = profRes ? profRes.data : null;
      isPro = profile?.plan === 'premium';
      if (jListData !== null) {
        journalsData = jListData;
      }

      if (window.location.search.includes('test=') && (!journalsData || journalsData.length === 0)) {
        journalsData = [
          { id: 'j-ftmo', name: 'FTMO Challenge 100K', icon: 'briefcase', total_pnl: 4320.50, trade_count: 24, is_default: true, max_journals: 10 },
          { id: 'j-fn', name: 'FundedNext Stellar 50K', icon: 'zap', total_pnl: -1250.00, trade_count: 18, is_default: false, max_journals: 10 },
          { id: 'j-fp', name: 'FundingPips Master 100K', icon: 'target', total_pnl: 8120.00, trade_count: 42, is_default: false, max_journals: 10 },
          { id: 'j-pers', name: 'Personal Swing Account', icon: 'trending-up', total_pnl: 1450.20, trade_count: 15, is_default: false, max_journals: 10 }
        ];
      }

      // Active prop accounts lookup
      var propAccountsMap = new Map();
      if (window.location.search.includes('test=')) {
        propAccountsMap.set('j-ftmo', { journal_id: 'j-ftmo', template_key: 'ftmo-2step', phase_index: 0, rules: { firm: 'FTMO', phase_name: 'Phase 1 (Challenge)' } });
        propAccountsMap.set('j-fn', { journal_id: 'j-fn', template_key: 'fundednext-stellar-1step', phase_index: 0, rules: { firm: 'FundedNext', phase_name: 'Phase 1' } });
        propAccountsMap.set('j-fp', { journal_id: 'j-fp', template_key: 'fundingpips-2step', phase_index: 1, rules: { firm: 'FundingPips', phase_name: 'Phase 2 (Evaluation)' } });
      } else if (Array.isArray(activeProps)) {
        activeProps.forEach(function(pa) {
          if (pa && pa.journal_id) {
            propAccountsMap.set(pa.journal_id, pa);
          }
        });
      }

      // ⭐ cTrader hesap eşlemelerini yükle
      var ctraderAccountsMap = new Map();
      var allCtraderAccounts = [];
      if (ctRes && ctRes.data && Array.isArray(ctRes.data.accounts)) {
        allCtraderAccounts = ctRes.data.accounts;
        allCtraderAccounts.forEach(function(acc) {
          if (acc.journal_id) {
            ctraderAccountsMap.set(acc.journal_id, acc);
          }
        });
      }
      window._allCtraderAccounts = allCtraderAccounts;
      window._allJournalsList = journalsData;

      // Izgarayı taze verilerle güncelle
      drawJournalsGrid(journalsData, propAccountsMap, ctraderAccountsMap, isPro, profile);

      // Cache'e yaz (sadece başarılı bir liste alındığında)
      if (jListData !== null) {
        try {
          localStorage.setItem('ww_cached_journals_list', JSON.stringify(journalsData));
          var pObj = {};
          propAccountsMap.forEach(function(v, k) { pObj[k] = v; });
          localStorage.setItem('ww_cached_props_map', JSON.stringify(pObj));
          var cObj = {};
          ctraderAccountsMap.forEach(function(v, k) { cObj[k] = v; });
          localStorage.setItem('ww_cached_ctrader_map', JSON.stringify(cObj));
        } catch(e) {}
      }

      if (typeof lucide !== 'undefined') lucide.createIcons();
      
    } catch(err) {
      wwLog.error(err);
    } finally {
      _isRenderingJournals = false;
    }
  }
  
  function bootJournals() {
    initModals();

    JOURNALS_PAGE.on(document, 'click', function(e) {
      if (!e.target.closest('.journal-menu-dropdown')) {
        document.querySelectorAll('.journal-menu-dropdown.open').forEach(function(el) {
          el.classList.remove('open');
        });
      }
    });
    
    var cancelBtn = document.getElementById('wizard-btn-cancel') || document.getElementById('journal-modal-cancel');
    if (cancelBtn) cancelBtn.onclick = closeModal;
    
    window.saveJournalModal = async function() {
      var id = document.getElementById('journal-id')?.value;
      var name = (document.getElementById('journal-name')?.value || '').trim();
      var desc = (document.getElementById('journal-desc')?.value || '').trim();
      var color = getSelectedColor();
      var icon = getSelectedIcon();
      var tradeScope = getSelectedScope();

      var isProp = document.getElementById('journal-prop-toggle')?.checked;
      var propAccountId = document.getElementById('prop-account-id')?.value;
      var propTmplKey = document.getElementById('prop-template-select')?.value;
      var propPhaseIdx = Number(document.getElementById('prop-phase-select')?.value) || 0;
      var propBalSelVal = document.getElementById('prop-balance-select')?.value;
      var propStartingBal = propBalSelVal === 'custom' 
        ? Number(document.getElementById('prop-custom-balance')?.value) 
        : Number(propBalSelVal);
      var propStartDate = document.getElementById('prop-start-date')?.value;
      var propResetTz = document.getElementById('prop-reset-tz-select')?.value;
      
      if (!name) {
        if (window.showToast) window.showToast(i18n.t('journal.err_invalid_name'), 'error');
        goToWizardStep(1);
        return;
      }

      if (isProp) {
        if (!propStartingBal || propStartingBal <= 0 || isNaN(propStartingBal)) {
          if (window.showToast) window.showToast(i18n.t('prop.err_invalid_balance'), 'error');
          goToWizardStep(2);
          return;
        }
        if (!propStartDate) {
          if (window.showToast) window.showToast(i18n.t('prop.err_select_start_date'), 'error');
          goToWizardStep(2);
          return;
        }
        var todayStr = (window.WwTime ? window.WwTime.todayKey() : new Date().toISOString().slice(0, 10));
        if (propStartDate > todayStr) {
          if (window.showToast) window.showToast(i18n.t('prop.err_future_start_date'), 'error');
          goToWizardStep(2);
          return;
        }
        if (!propResetTz) {
          if (window.showToast) window.showToast(i18n.t('prop.err_select_reset_tz'), 'error');
          goToWizardStep(2);
          return;
        }
      }
      
      var btn = document.getElementById('journal-modal-save');
      if (btn) {
        btn.disabled = true;
        btn.textContent = '...';
      }

      try {
        var journalId = id;
        
        if (id) {
          await window.journal.updateJournal(id, { name, description: desc, color, icon, trade_scope: tradeScope });
        } else {
          var newJ = await window.journal.createJournal({ name, description: desc, color, icon, trade_scope: tradeScope });
          journalId = (newJ && newJ.id) ? newJ.id : (typeof newJ === 'string' ? newJ : null);
          if (!journalId) {
            var refreshedList = await window.journal.listJournals(true);
            var found = refreshedList.find(function(x) { return x.name === name; });
            if (found) journalId = found.id;
          }
        }

        // Manage prop account record
        if (window.PropService && journalId) {
          if (isProp) {
            var rawShift = parseFloat(document.getElementById('prop-time-shift-num')?.value);
            var propTimeShift = isNaN(rawShift) ? 0 : Math.min(14, Math.max(-14, rawShift));
            var defaultRules = (window.PropTemplates && propTmplKey !== 'custom') 
              ? window.PropTemplates.getDefaultRules(propTmplKey, propPhaseIdx) 
              : {};
            var isCustomized = checkIsCustomized();
            var propRules = Object.assign({}, defaultRules);

            if (isCustomized || propTmplKey === 'custom') {
              propRules.is_customized = true;
              var targetVal = document.getElementById('prop-rule-target')?.value;
              propRules.profit_target_pct = (targetVal === '' || targetVal === null) ? null : Number(targetVal);
              propRules.daily_loss_limit_pct = Number(document.getElementById('prop-rule-daily')?.value) || 5;
              propRules.daily_loss_amount_base = document.getElementById('prop-rule-daily-base')?.value || 'initial_balance';
              propRules.max_loss_limit_pct = Number(document.getElementById('prop-rule-max')?.value) || 10;
              propRules.max_loss_type = document.getElementById('prop-rule-max-type')?.value || 'static';
              propRules.min_trading_days = Number(document.getElementById('prop-rule-min-days')?.value) || 0;
              
              var conVal = document.getElementById('prop-rule-consistency')?.value;
              if (conVal && Number(conVal) > 0) {
                propRules.consistency_rule = { enabled: true, max_single_day_profit_pct: Number(conVal) };
              } else {
                propRules.consistency_rule = { enabled: false, max_single_day_profit_pct: null };
              }
            } else {
              propRules.is_customized = false;
            }
            propRules.reset_tz = propResetTz;
            propRules.phase_index = propPhaseIdx;

            var chosenPhase = getSelectedPhase();
            if (chosenPhase) {
              propRules.verified = Boolean(chosenPhase.verified);
              propRules.phase_name = chosenPhase.phase_name;
            }

            var propPayload = {
              journal_id: journalId,
              template_key: propTmplKey,
              starting_balance: propStartingBal,
              start_date: propStartDate,
              reset_tz: propResetTz,
              time_shift_hours: propTimeShift,
              phase_index: propPhaseIdx,
              rules: propRules
            };

            if (propAccountId) {
              await window.PropService.updatePropAccount(propAccountId, propPayload);
            } else {
              var existing = await window.PropService.getPropAccountByJournalId(journalId);
              if (existing) {
                await window.PropService.updatePropAccount(existing.id, propPayload);
              } else {
                await window.PropService.createPropAccount(propPayload);
              }
            }
          } else {
            // Prop mode was turned OFF
            if (propAccountId) {
              await window.PropService.deletePropAccount(propAccountId);
            } else if (id) {
              var existingAcc = await window.PropService.getPropAccountByJournalId(id);
              if (existingAcc) {
                await window.PropService.deletePropAccount(existingAcc.id);
              }
            }
          }
        }

        // Step 3: Broker Bağlantısı İşlemleri
        if (selectedBrokerChoice === 'ctrader' && journalId) {
          var select = document.getElementById('wizard-existing-ctrader-select');
          var chosenVal = select ? select.value : null;

          if (chosenVal && chosenVal !== 'new_oauth') {
            try {
              await window.sb.rpc('link_ctrader_account', {
                p_account_id: chosenVal,
                p_journal_id: journalId
              });
              if (window.showToast) {
                window.showToast(jt('journal.wiz.saved_linked', 'Hesap kaydedildi ve cTrader hesabınız bağlandı!'), 'success');
              }
            } catch (ctLinkErr) {
              if (window.showToast) window.showToast(jt('journal.wiz.saved_link_failed', 'Hesap kaydedildi fakat broker bağlanamadı: {error}', { error: ctLinkErr.message }), 'warning');
            }
          } else {
            // Yeni cTrader OAuth yetkilendirmesi
            localStorage.setItem('ww_ctrader_target_journal', journalId);
            if (window.showToast) {
              window.showToast(jt('journal.wiz.redirecting', 'Hesap oluşturuldu! cTrader yetkilendirme ekranına yönlendiriliyorsunuz...'), 'info');
            }
            if (window.CTRADER_CONFIG && typeof window.CTRADER_CONFIG.getAuthUrl === 'function') {
              setTimeout(function() {
                window.location.href = window.CTRADER_CONFIG.getAuthUrl();
              }, 600);
              return;
            }
          }
        } else {
          if (window.showToast) {
            window.showToast(i18n.t(id ? 'prop.account_updated' : 'prop.account_created'), 'success');
          }
        }
        
        closeModal();
        renderJournals();
      } catch (err) {
        if (err.code === 'QUOTA_EXCEEDED' || err.code === 'PROP_LIMIT_EXCEEDED') {
          if (typeof window.openUpgradeModal === 'function') {
            window.openUpgradeModal({ feature: 'journal' });
          } else if (window.showToast) {
            window.showToast(i18n.t('prop.err_quota_exceeded', { limit: err.limit || 1 }), 'error');
          }
        } else if (err.code === 'INVALID_TZ') {
          if (window.showToast) window.showToast(i18n.t('prop.err_invalid_tz'), 'error');
        } else {
          var msgKey = err.code ? 'journal.err_' + err.code.toLowerCase() : 'journal.err_generic';
          var msg = i18n.t(msgKey);
          if (msg === msgKey) msg = err.message;
          if (window.showToast) window.showToast(msg, 'error');
        }
      } finally {
        var btn = document.getElementById('journal-modal-save');
        if (btn) {
          btn.disabled = false;
          btn.textContent = (currentModalMode === 'edit') ? jt('journal.wiz.save_changes', 'Değişiklikleri Kaydet') : (selectedBrokerChoice === 'ctrader' ? jt('journal.wiz.create_connect', 'Hesabı Oluştur & cTrader\'a Bağlan') : jt('journal.wiz.create', 'Hesabı Oluştur'));
        }
      }
    };
    
    document.getElementById('delete-modal-cancel').onclick = function() {
      document.getElementById('delete-modal').classList.remove('active');
      deleteId = null;
    };
    
    document.getElementById('delete-modal-confirm').onclick = async function() {
      if (!deleteId) return;
      try {
        var btn = document.getElementById('delete-modal-confirm');
        btn.disabled = true;
        btn.textContent = '...';

        // Soft-delete prop account if linked
        if (window.PropService) {
          try {
            var linkedProp = await window.PropService.getPropAccountByJournalId(deleteId);
            if (linkedProp) {
              await window.PropService.deletePropAccount(linkedProp.id);
            }
          } catch (pDelErr) {}
        }
        
        await window.journal.deleteJournal(deleteId);
        if (window.showToast) window.showToast(i18n.t('prop.account_deleted'), 'success');
        
        document.getElementById('delete-modal').classList.remove('active');
        deleteId = null;
        renderJournals();
      } catch (err) {
        var msgKey = err.code ? 'journal.err_' + err.code.toLowerCase() : 'journal.err_generic';
        var msg = i18n.t(msgKey);
        if (msg === msgKey) msg = err.message;
        if (window.showToast) window.showToast(msg, 'error');
      } finally {
        var btn = document.getElementById('delete-modal-confirm');
        btn.disabled = false;
        btn.textContent = i18n.t('journal.delete_confirm');
      }
    };

    // ⭐ cTrader Broker Modal İşlemleri
    var currentBrokerJournalId = null;

    window.openBrokerModal = function(journalId, journalName) {
      currentBrokerJournalId = journalId;
      var modal = document.getElementById('broker-modal');
      var nameEl = document.getElementById('broker-modal-journal-name');
      if (nameEl) nameEl.textContent = journalName || 'Seçili';

      var existingWrap = document.getElementById('existing-ctrader-wrap');
      var existingSelect = document.getElementById('existing-ctrader-select');
      var accounts = window._allCtraderAccounts || [];
      var journals = window._allJournalsList || [];

      if (accounts.length > 0 && existingSelect && existingWrap) {
        existingSelect.innerHTML = '';
        accounts.forEach(function(a) {
          var opt = document.createElement('option');
          opt.value = a.id;
          var tag = a.is_live ? '[LIVE] ' : '[DEMO] ';
          var label = tag + (a.broker_name || 'cTrader') + ' #' + (a.trader_login || a.ctid_trader_account_id);
          if (a.journal_id) {
            if (a.journal_id === journalId) {
              label += ' (Bu deftere bağlı)';
              opt.selected = true;
            } else {
              var jMatch = journals.find(function(x) { return x.id === a.journal_id; });
              label += ' (' + (jMatch?.name || 'Başka defter') + ' defterine bağlı)';
            }
          } else {
            label += ' (Boşta)';
          }
          opt.textContent = label;
          existingSelect.appendChild(opt);
        });
        existingWrap.style.display = 'block';
      } else if (existingWrap) {
        existingWrap.style.display = 'none';
      }

      if (modal) modal.classList.add('active');
      if (typeof lucide !== 'undefined') lucide.createIcons();
    };

    window.closeBrokerModal = function() {
      var modal = document.getElementById('broker-modal');
      if (modal) modal.classList.remove('active');
      currentBrokerJournalId = null;
    };

    var btnLinkExisting = document.getElementById('btn-link-existing-ctrader');
    if (btnLinkExisting) {
      btnLinkExisting.onclick = async function() {
        var select = document.getElementById('existing-ctrader-select');
        var accId = select ? select.value : null;
        if (!accId || !currentBrokerJournalId) return;

        btnLinkExisting.disabled = true;
        btnLinkExisting.textContent = 'Bağlanıyor...';

        try {
          var res = await window.sb.rpc('link_ctrader_account', {
            p_account_id: accId,
            p_journal_id: currentBrokerJournalId
          });
          if (res && res.data && res.data.success) {
            if (window.showToast) window.showToast('cTrader hesabı defterinize bağlandı!', 'success');
            closeBrokerModal();
            renderJournals();
          } else {
            throw new Error(res?.data?.error || 'Bağlantı kurulamadı.');
          }
        } catch(e) {
          if (window.showToast) window.showToast(e.message, 'error');
        } finally {
          btnLinkExisting.disabled = false;
          btnLinkExisting.textContent = 'Bu Hesabı Deftere Bağla';
        }
      };
    }

    var btnOauth = document.getElementById('btn-oauth-ctrader');
    if (btnOauth) {
      btnOauth.onclick = function() {
        if (!currentBrokerJournalId) return;
        localStorage.setItem('ww_ctrader_target_journal', currentBrokerJournalId);
        if (window.CTRADER_CONFIG && typeof window.CTRADER_CONFIG.getAuthUrl === 'function') {
          window.location.href = window.CTRADER_CONFIG.getAuthUrl();
        } else {
          alert('cTrader konfigürasyonu bulunamadı.');
        }
      };
    }
    
    // Anında render et (gecikmesiz)
    renderJournals();
    if (window.i18nReady) {
      window.i18nReady.then(function() {
        if (window.i18n && typeof window.i18n.apply === 'function') window.i18n.apply();
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootJournals);
  } else {
    bootJournals();
  }
  
  JOURNALS_PAGE.on(document, 'journal-changed', renderJournals);

  // cTrader senkronu (navbar.js wwSyncCtrader) bittiğinde window.loadTrades() varsa onu çağırır, yoksa SAYFAYI YENİLER.
  // Yenileme bildirimleri (bakiye, uyarılar) yarım saniyede yok ediyordu; bu sayfada kartları yerinde tazeliyoruz.
  // (Takvim sayfası da aynı kalıbı kullanıyor: CAL_PAGE.expose('loadTrades', ...))
  JOURNALS_PAGE.expose('loadTrades', renderJournals);
  
</script>

</Layout>

