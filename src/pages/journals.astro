                <i data-lucide="more-vertical"></i>
              </button>
              <div class="journal-menu-dropdown">
                ${!j.is_default ? `<button class="journal-menu-item btn-make-default"><i data-lucide="check-circle"></i> ${i18n.t('journal.set_default')}</button>` : ''}
                <button class="journal-menu-item btn-edit"><i data-lucide="edit"></i> ${i18n.t('journal.edit')}</button>
                ${ctMenuHtml}
                ${!j.is_default ? `<button class="journal-menu-item danger btn-delete"><i data-lucide="trash-2"></i> ${i18n.t('journal.delete')}</button>` : ''}
