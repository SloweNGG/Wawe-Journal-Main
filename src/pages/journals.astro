---
// src/pages/journals.astro
import Layout from '../layouts/Layout.astro';
---
<Layout lang="en" bodyClass="journals-page">
<Fragment slot="head">
  <link rel="stylesheet" href="/interface/journals/css/journals.css?v=1791381600" />
  <title data-i18n="journal.title">Hesaplarım – Wawe Journal</title>
    

  <link rel="preload" href="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" as="script" />
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" is:inline defer></script>
  <script src="/config.js" is:inline defer></script>
  <script src="/i18n.js" is:inline defer></script>
  <script type="module" src="/src/bundle.js" is:inline defer></script>
</Fragment>

<main class="main dashboard-main">
  <div class="page-header">
    <div>
      <h1 data-i18n="journal.title">Hesaplarım</h1>
      <p class="subtitle" data-i18n="journal.subtitle">İşlemlerini hesaplara ayır, performansı takip et</p>
    </div>
    <div class="header-actions">
      <button class="btn-new-journal" id="btn-new-journal">
        <i data-lucide="plus" style="width:16px;height:16px;margin-right:4px;vertical-align:middle;"></i>
        <span data-i18n="journal.new_button">Yeni Hesap</span>
      </button>
    </div>
  </div>
  
  <div class="journals-usage-bar" id="usage-text">
    —
  </div>
  
  <div class="journals-grid" id="journals-grid">
    <!-- Skeleton -->
    <div class="journal-card" style="opacity:0.5;">
      <div class="journal-color-bar" style="background:var(--border);"></div>
      <div class="journal-card-top">
        <div class="journal-icon-wrap" style="background:var(--border);width:32px;height:32px;border-radius:8px;"></div>
      </div>
      <div class="journal-body">
        <div style="height:20px;width:60%;background:var(--border);border-radius:4px;margin-bottom:8px;"></div>
        <div style="height:14px;width:90%;background:var(--border);border-radius:4px;"></div>
      </div>
    </div>
  </div>
</main>

<!-- Create / Edit Modal -->
<div class="journal-modal-overlay" id="journal-modal">
  <div class="journal-modal">
    <div class="journal-modal-header"><h3 id="journal-modal-title" data-i18n="journal.create_title">Yeni Hesap Oluştur</h3><button class="journal-modal-close" onclick="closeModal()"><i data-lucide="x"></i></button></div><div class="journal-modal-body">
    <input type="hidden" id="journal-id" value="">
    
    <div class="journal-modal-grid">
      <!-- SOL PANEL: Temel Hesap Bilgileri -->
      <div class="journal-modal-col">
        <div class="journal-col-heading">
          <i data-lucide="wallet"></i>
          <span data-i18n="journal.section_account">Hesap Bilgileri</span>
        </div>

        <div class="journal-field">
          <label data-i18n="journal.name_label">Hesap Adı</label>
          <input type="text" id="journal-name" maxlength="60" data-i18n-placeholder="journal.name_placeholder" placeholder="Örn: Scalping, Swing, Prop Firm">
        </div>
        
        <div class="journal-field">
          <label data-i18n="journal.description_label">Açıklama (opsiyonel)</label>
          <textarea id="journal-desc" rows="3" maxlength="200"></textarea>
        </div>
        
        <div class="journal-field">
          <label data-i18n="journal.color_label">Renk</label>
          <div class="journal-color-picker" id="color-grid">
            <!-- JS fills -->
          </div>
        </div>
        
        <div class="journal-field">
          <label data-i18n="journal.icon_label">İkon</label>
          <div class="journal-icon-picker" id="icon-grid">
            <!-- JS fills -->
          </div>
        </div>
      </div>

      <!-- SAĞ PANEL: Prop Firm & Mod Ayarları -->
      <div class="journal-modal-col">
        <div class="journal-col-heading">
          <i data-lucide="award"></i>
          <span data-i18n="journal.section_prop">Prop Firm & Takip</span>
        </div>

        <!-- ⭐ PROP FIRM MODU TOGGLE -->
        <div class="journal-prop-toggle-card">
          <div class="journal-prop-toggle-info">
            <div>
              <div class="journal-prop-toggle-title">
                <span data-i18n="prop.mode">Prop Firm Modu</span>
                <span class="journal-prop-tag" data-i18n="prop.evaluation">DEĞERLENDİRME</span>
              </div>
              <div class="journal-prop-toggle-sub" data-i18n="prop.toggle_sub">Kuralları, günlük kaybı ve hedefleri otomatik takip et</div>
            </div>
          </div>
          <label class="journal-switch" for="journal-prop-toggle">
            <input type="checkbox" id="journal-prop-toggle">
            <span class="journal-slider"></span>
          </label>
        </div>

        <!-- Quota Warning if limit reached -->
        <div id="prop-quota-warning" class="journal-prop-alert danger" style="display:none;">
          <div>
            <strong data-i18n="prop.quota_title">Prop Hesabı Kotası Doldu</strong>
            <div id="prop-quota-desc" style="font-size:0.75rem;margin-top:2px;" data-i18n="prop.quota_desc">Free planda 1 aktif prop hesabı oluşturabilirsiniz. Daha fazla hesap için Premium'a yükseltin.</div>
            <a href="/settings.html#panel-plan" style="color:#fff;text-decoration:underline;font-weight:600;font-size:0.75rem;display:inline-block;margin-top:4px;" data-i18n="prop.upgrade_plan">Planı Yükselt →</a>
          </div>
        </div>

        <!-- Prop Inactive Info Box (Prop kapalıyken sağ paneli bilgilendirici ve dolu tutar) -->
        <div id="prop-inactive-card" class="journal-prop-inactive-box">
          <div class="journal-prop-inactive-icon"><i data-lucide="shield-check"></i></div>
          <div class="journal-prop-inactive-title" data-i18n="prop.standard_mode_title">Standart Portföy Hesabı</div>
          <p class="journal-prop-inactive-desc" data-i18n="prop.standard_mode_desc">Bu hesapta kural ve kayıp limiti olmadan tüm işlemlerinizi serbestçe takip edebilirsiniz.</p>
          <div class="journal-prop-inactive-tip" data-i18n="prop.standard_mode_tip">💡 FTMO, FundedNext gibi değerlendirme kurallarını izlemek için yukarıdan Prop Firm Modu'nu açın.</div>
        </div>

        <!-- Prop Settings Section (shown when toggle is on) -->
        <div id="journal-prop-section" class="journal-prop-section">
          <input type="hidden" id="prop-account-id" value="">

      <!-- Şablon & Faz -->
      <div class="journal-prop-row">
        <div class="journal-field" style="margin-bottom:0;">
          <label data-i18n="prop.firm_template">Prop Firması / Şablon</label>
          <select id="prop-template-select" class="journal-prop-select">
            <!-- JS fills from PropTemplates -->
          </select>
        </div>
        <div class="journal-field" style="margin-bottom:0;">
          <label data-i18n="prop.phase">Aşama / Faz</label>
          <select id="prop-phase-select" class="journal-prop-select">
            <!-- JS fills based on template -->
          </select>
        </div>
      </div>

      <!-- Bakiye & Başlangıç Tarihi -->
      <div class="journal-prop-row">
        <div class="journal-field" style="margin-bottom:0;">
          <label data-i18n="prop.starting_balance">Başlangıç Bakiyesi ($)</label>
          <select id="prop-balance-select" class="journal-prop-select">
            <option value="5000">5.000 $</option>
            <option value="10000">10.000 $</option>
            <option value="25000">25.000 $</option>
            <option value="50000">50.000 $</option>
            <option value="100000" selected>100.000 $</option>
            <option value="200000">200.000 $</option>
            <option value="custom" data-i18n="prop.custom_amount">Özel Tutar...</option>
          </select>
          <input type="number" id="prop-custom-balance" class="journal-prop-input" placeholder="Örn: 150000" data-i18n-placeholder="prop.custom_placeholder" style="display:none;margin-top:6px;" min="100">
        </div>
        <div class="journal-field" style="margin-bottom:0;">
          <label data-i18n="prop.start_date">Başlangıç Tarihi</label>
          <input type="date" id="prop-start-date" class="journal-prop-input">
          <div class="journal-field-hint" style="font-size:0.75rem;color:var(--muted);margin-top:4px;" data-i18n="prop.start_date_hint">Challenge'a başladığın günü gir (öncesindeki işlemler sayılmaz).</div>
        </div>
      </div>

      <!-- Reset Saat Dilimi (reset_tz) -->
      <div class="journal-field" style="margin-bottom:0.75rem;">
        <label data-i18n="prop.reset_tz">Gün Sonu / Reset Saat Dilimi</label>
        <select id="prop-reset-tz-select" class="journal-prop-select">
          <option value="">-- Saat Dilimi Seçiniz / Select Timezone --</option>
          <option value="Europe/Prague">Europe/Prague (FTMO — CET/CEST Gece Yarısı)</option>
          <option value="Etc/GMT-3">Etc/GMT-3 (FundingPips — UTC+3 Gece Yarısı)</option>
          <option value="Europe/Athens">Europe/Athens (FundedNext — Öneri: MT5 Sunucu Saati)</option>
          <option value="UTC">UTC (Evrensel Gece Yarısı)</option>
          <option value="America/New_York">America/New_York (ABD Doğu Saati)</option>
          <option value="Europe/London">Europe/London (GMT/BST)</option>
          <option value="Asia/Dubai">Asia/Dubai (GST - UTC+4)</option>
        </select>
      </div>

      <!-- Broker Saat Kaydırma (time_shift_hours) -->
      <div class="journal-field" style="margin-bottom:0.75rem;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;">
          <label data-i18n="prop.time_shift_hours" style="margin-bottom:0;">Broker Saat Kaydırma (time_shift_hours)</label>
          <span id="prop-time-shift-display" style="font-weight:600;font-size:0.8rem;color:var(--accent);">0 saat</span>
        </div>
        <div style="display:flex;align-items:center;gap:0.75rem;">
          <input type="range" id="prop-time-shift" min="-14" max="14" step="0.5" value="0" class="journal-prop-slider" style="flex:1;">
          <input type="number" id="prop-time-shift-num" min="-14" max="14" step="0.5" value="0" class="journal-prop-input" style="width:65px;text-align:center;padding:0.35rem 0.5rem;">
        </div>
        <div class="journal-field-hint" style="font-size:0.75rem;color:var(--muted);margin-top:4px;" data-i18n="prop.time_shift_hint">Broker sunucu saatiniz ile yerel veya reset saati arasındaki farkı ayarlayın (-14 ile +14).</div>
        
        <!-- Son 3 işlem saat önizlemesi -->
        <div id="prop-time-shift-preview" class="journal-prop-time-preview">
          <div class="journal-prop-time-preview-title" data-i18n="prop.time_shift_preview_title">Son 3 işlemin saati bu ayarla şöyle görünüyor:</div>
          <div id="prop-time-shift-preview-list" class="journal-prop-time-preview-list">
            <div data-i18n="prop.time_shift_no_trades">Henüz işlem bulunmuyor (örnek önizleme: 14:00 ➔ 16:00 UTC+2)</div>
          </div>
        </div>
      </div>

      <!-- Doğrulanmadı Uyarısı (verified: false) -->
      <div id="prop-unverified-alert" class="journal-prop-alert warning" style="display:none;margin-bottom:0.75rem;">
        <span data-i18n="prop.unverified_warning">Bu fazın kuralları doğrulanmadı, firmanın sitesinden kontrol et.</span>
      </div>

      <!-- FundedNext MT5 Server Timezone Uyarısı -->
      <div id="prop-tz-required-alert" class="journal-prop-alert warning" style="display:none;margin-bottom:0.75rem;">
        <span data-i18n="prop.tz_required_warning">Saat Dilimi Seçimi Zorunludur: Bu firma günü broker server saatine göre bitirir. MT5 hesabınızın server saat dilimini seçiniz (ör. Europe/Athens).</span>
      </div>

      <!-- Equity Bazlı Günlük/Max Kayıp Tahmini Uyarısı -->
      <div id="prop-estimated-alert" class="journal-prop-alert info" style="display:none;margin-bottom:0.75rem;">
        <span data-i18n="prop.estimated_warning">Tahmini Kural Uyarısı: Bu firmanın günlük veya maksimum kayıp kuralı equity (açık işlem) bazlıdır; Wawe Journal'da açık pozisyon tutulmadığından kapanmış işlemlerle tahmini hesaplanacaktır.</span>
      </div>

      <!-- Gelişmiş Kural Ayarları (Tüm Şablonlar İçin Özelleştirilebilir) -->
      <details id="prop-advanced-rules-box" class="journal-custom-rules-box" style="margin-top:0.75rem;cursor:pointer;">
        <summary class="journal-custom-rules-header" style="display:flex;justify-content:space-between;align-items:center;user-select:none;">
          <span data-i18n="prop.advanced_rules">Gelişmiş Kural Ayarları</span>
          <span id="prop-customized-badge" style="display:none;font-size:0.7rem;font-weight:600;padding:2px 8px;border-radius:12px;background:rgba(124,109,250,0.2);color:var(--accent);border:1px solid rgba(124,109,250,0.3);" data-i18n="prop.customized">Özelleştirildi</span>
        </summary>
        <div class="journal-custom-grid" style="margin-top:0.75rem;cursor:default;">
          <div class="journal-field" style="margin-bottom:0;">
            <label data-i18n="prop.profit_target">Kâr Hedefi (%)</label>
            <input type="number" id="prop-rule-target" class="journal-prop-input" value="10" step="0.5" min="0">
          </div>
          <div class="journal-field" style="margin-bottom:0;">
            <label data-i18n="prop.daily_loss">Günlük Kayıp (%)</label>
            <input type="number" id="prop-rule-daily" class="journal-prop-input" value="5" step="0.5" min="0">
          </div>
          <div class="journal-field" style="margin-bottom:0;">
            <label data-i18n="prop.daily_loss_base">Günlük Kayıp Tabanı</label>
            <select id="prop-rule-daily-base" class="journal-prop-select">
              <option value="initial_balance" data-i18n="prop.base_initial">Başlangıç Bakiyesi</option>
              <option value="day_start_balance" data-i18n="prop.base_day_start">Gün Başı Bakiyesi</option>
            </select>
          </div>
          <div class="journal-field" style="margin-bottom:0;">
            <label data-i18n="prop.max_loss">Maksimum Kayıp (%)</label>
            <input type="number" id="prop-rule-max" class="journal-prop-input" value="10" step="0.5" min="0">
          </div>
          <div class="journal-field" style="margin-bottom:0;">
            <label data-i18n="prop.max_loss_type">Maksimum Kayıp Tipi</label>
            <select id="prop-rule-max-type" class="journal-prop-select">
              <option value="static" data-i18n="prop.type_static">Sabit (Static)</option>
              <option value="eod_trailing" data-i18n="prop.type_trailing_eod">Gün Sonu Takip Eden (Trailing EOD)</option>
            </select>
          </div>
          <div class="journal-field" style="margin-bottom:0;">
            <label data-i18n="prop.min_trading_days">Min İşlem Günü</label>
            <input type="number" id="prop-rule-min-days" class="journal-prop-input" value="4" min="0">
          </div>
          <div class="journal-field" style="margin-bottom:0;">
            <label data-i18n="prop.consistency_rule">Tutarlılık Kuralı (%)</label>
            <input type="number" id="prop-rule-consistency" class="journal-prop-input" placeholder="Yok (Örn: 50)" step="1" min="0" max="100">
          </div>
        </div>
      </details>
    </div>
      </div>
    </div>
    </div>
    <div class="journal-modal-footer">
      <button class="journal-btn-cancel" id="journal-modal-cancel" data-i18n="journal.cancel">İptal</button>
      <button class="journal-btn-save" id="journal-modal-save" data-i18n="journal.save">Kaydet</button>
    </div>
  </div>
</div>

<!-- Delete Confirm Modal -->
<div class="journal-modal-overlay" id="delete-modal">
  <div class="journal-modal">
    <div class="journal-modal-header"><h3 data-i18n="journal.delete_title" style="color:var(--red);">Hesabı Sil</h3><button class="journal-modal-close" onclick="closeModal()"><i data-lucide="x"></i></button></div><div class="journal-modal-body">
    <p style="font-family:'DM Sans', sans-serif;font-size:0.95rem;color:var(--text);margin-bottom:1.5rem;line-height:1.5;" id="delete-modal-msg"></p>
    </div>
    <div class="journal-modal-footer">
      <button class="journal-btn-cancel" id="delete-modal-cancel" data-i18n="journal.cancel">İptal</button>
      <button class="journal-btn-danger" id="delete-modal-confirm" data-i18n="journal.delete_confirm">Evet, Sil</button>
    </div>
  </div>
</div>







<script is:inline>
  var COLORS = ['#7c6dfa','#22c55e','#ef4444','#f59e0b','#3b82f6','#ec4899','#14b8a6','#f97316'];
  var ICONS = ['folder', 'chart-bar', 'trending-up', 'target', 'rocket', 'gem', 'flame', 'zap', 'waves', 'crown', 'star', 'palette'];
  
  var journalsData = [];
  var isPremium = false;
  var deleteId = null;
  var currentModalMode = 'create';
  
  function populatePropTemplates() {
    var sel = document.getElementById('prop-template-select');
    if (!sel || !window.PropTemplates) return;
    sel.innerHTML = '';
    var templates = window.PropTemplates.getPropTemplates();
    templates.forEach(function(tmpl) {
      var opt = document.createElement('option');
      opt.value = tmpl.key;
      opt.textContent = tmpl.name;
      sel.appendChild(opt);
    });
  }

  function escapeHtml(str) {
    if (str === null || str === undefined) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function getSelectedPhase() {
    var tmplSel = document.getElementById('prop-template-select');
    var phaseSel = document.getElementById('prop-phase-select');
    if (!tmplSel || !phaseSel || !window.PropTemplates) return null;
    var tmpl = window.PropTemplates.getPropTemplate(tmplSel.value);
    if (!tmpl || !tmpl.phases) return null;
    var pIdx = parseInt(phaseSel.value, 10) || 0;
    return tmpl.phases.find(function(p) { return p.phase_index === pIdx; }) || tmpl.phases[0];
  }

  function syncAdvancedRulesInputs(phaseRules) {
    if (!phaseRules) return;
    var targetEl = document.getElementById('prop-rule-target');
    var dailyEl = document.getElementById('prop-rule-daily');
    var dailyBaseEl = document.getElementById('prop-rule-daily-base');
    var maxEl = document.getElementById('prop-rule-max');
    var maxTypeEl = document.getElementById('prop-rule-max-type');
    var minDaysEl = document.getElementById('prop-rule-min-days');
    var consistencyEl = document.getElementById('prop-rule-consistency');

    if (targetEl) targetEl.value = (phaseRules.profit_target_pct !== null && phaseRules.profit_target_pct !== undefined) ? phaseRules.profit_target_pct : '';
    if (dailyEl) dailyEl.value = (phaseRules.daily_loss_limit_pct !== null && phaseRules.daily_loss_limit_pct !== undefined) ? phaseRules.daily_loss_limit_pct : 5;
    if (dailyBaseEl) dailyBaseEl.value = phaseRules.daily_loss_amount_base || 'initial_balance';
    if (maxEl) maxEl.value = (phaseRules.max_loss_limit_pct !== null && phaseRules.max_loss_limit_pct !== undefined) ? phaseRules.max_loss_limit_pct : 10;
    if (maxTypeEl) maxTypeEl.value = phaseRules.max_loss_type || 'static';
    if (minDaysEl) minDaysEl.value = (phaseRules.min_trading_days !== null && phaseRules.min_trading_days !== undefined) ? phaseRules.min_trading_days : 0;
    if (consistencyEl) {
      var cPct = (phaseRules.consistency_rule && phaseRules.consistency_rule.enabled) ? phaseRules.consistency_rule.max_single_day_profit_pct : '';
      consistencyEl.value = cPct || '';
    }
    checkIsCustomized();
  }

  function checkIsCustomized() {
    var tmplSel = document.getElementById('prop-template-select');
    var phaseSel = document.getElementById('prop-phase-select');
    var badge = document.getElementById('prop-customized-badge');
    if (!tmplSel || !phaseSel || !window.PropTemplates) return false;

    var tmplKey = tmplSel.value;
    var phaseIdx = parseInt(phaseSel.value, 10) || 0;
    var def = window.PropTemplates.getDefaultRules(tmplKey, phaseIdx);
    if (!def) return false;

    if (tmplKey === 'custom') {
      if (badge) badge.style.display = 'inline-block';
      return true;
    }

    var targetVal = document.getElementById('prop-rule-target')?.value;
    var curTarget = (targetVal === '' || targetVal === null) ? null : Number(targetVal);
    var curDaily = Number(document.getElementById('prop-rule-daily')?.value);
    var curDailyBase = document.getElementById('prop-rule-daily-base')?.value;
    var curMax = Number(document.getElementById('prop-rule-max')?.value);
    var curMaxType = document.getElementById('prop-rule-max-type')?.value;
    var curMinDays = Number(document.getElementById('prop-rule-min-days')?.value);
    var conVal = document.getElementById('prop-rule-consistency')?.value;
    var curCon = conVal ? Number(conVal) : null;

    var defCon = (def.consistency_rule && def.consistency_rule.enabled) ? def.consistency_rule.max_single_day_profit_pct : null;

    var isDiff = (
      curTarget !== def.profit_target_pct ||
      curDaily !== def.daily_loss_limit_pct ||
      curDailyBase !== def.daily_loss_amount_base ||
      curMax !== def.max_loss_limit_pct ||
      curMaxType !== def.max_loss_type ||
      curMinDays !== def.min_trading_days ||
      curCon !== defCon
    );

    if (badge) badge.style.display = isDiff ? 'inline-block' : 'none';
    return isDiff;
  }

  function onPropPhaseChange() {
    var phase = getSelectedPhase();
    if (!phase) return;

    // verified: false warning
    var unverifiedAlert = document.getElementById('prop-unverified-alert');
    if (unverifiedAlert) {
      unverifiedAlert.style.display = (phase.verified === false) ? 'flex' : 'none';
    }

    syncAdvancedRulesInputs(phase);
  }

  function onPropTemplateChange() {
    var tmplSel = document.getElementById('prop-template-select');
    var phaseSel = document.getElementById('prop-phase-select');
    var tzSel = document.getElementById('prop-reset-tz-select');
    var tzAlert = document.getElementById('prop-tz-required-alert');
    var estAlert = document.getElementById('prop-estimated-alert');

    if (!tmplSel || !window.PropTemplates) return;
    var tmplKey = tmplSel.value;
    var tmpl = window.PropTemplates.getPropTemplate(tmplKey);
    if (!tmpl) return;

    // Phases
    phaseSel.innerHTML = '';
    (tmpl.phases || []).forEach(function(p) {
      var opt = document.createElement('option');
      opt.value = p.phase_index;
      opt.textContent = p.phase_name + (p.profit_target_pct ? ' (%' + p.profit_target_pct + ' Hedef)' : '');
      phaseSel.appendChild(opt);
    });

    // Reset timezone defaults & requirements
    if (tmpl.reset_tz_required) {
      if (tzAlert) tzAlert.style.display = 'flex';
      // FundedNext requires broker server timezone. Do not carry over fixed timezones; leave empty to force selection (Europe/Athens suggested in note).
      tzSel.value = '';
    } else {
      if (tzAlert) tzAlert.style.display = 'none';
      if (tmpl.reset_tz) {
        tzSel.value = tmpl.reset_tz;
      }
    }

    // Estimated rules alert (daily loss or max loss equity based)
    var hasEst = (tmpl.estimated_rules && tmpl.estimated_rules.length > 0);
    if (estAlert) estAlert.style.display = hasEst ? 'flex' : 'none';

    onPropPhaseChange();
    updateTimeShiftPreview();
  }

  async function updateTimeShiftPreview(journalId) {
    var previewList = document.getElementById('prop-time-shift-preview-list');
    var shiftEl = document.getElementById('prop-time-shift-num');
    var tzSel = document.getElementById('prop-reset-tz-select');
    if (!previewList) return;

    var parsedShift = parseFloat(shiftEl ? shiftEl.value : 0);
    var shiftHours = isNaN(parsedShift) ? 0 : Math.min(14, Math.max(-14, parsedShift));
    var targetTz = (tzSel && tzSel.value) ? tzSel.value : 'UTC';

    var trades = [];
    var jId = journalId || (document.getElementById('journal-id') ? document.getElementById('journal-id').value : null);

    if (jId && window.wwCache) {
      var uId = (window.currentUser && window.currentUser.id) || (window.__wwUserProfile && window.__wwUserProfile.id);
      if (uId) {
        var cached = window.wwCache.get('trades_dashboard', uId, jId) || window.wwCache.get('trades', uId, jId);
        if (cached && Array.isArray(cached) && cached.length > 0) {
          trades = cached.slice(-3);
        }
      }
    }

    if (trades.length === 0 && jId && window.sb) {
      try {
        var res = await window.sb
          .from('trades')
          .select('trade_date, pnl')
          .eq('journal_id', jId)
          .order('trade_date', { ascending: false })
          .limit(3);
        if (res.data && res.data.length > 0) {
          trades = res.data;
        }
      } catch (e) {}
    }

    if (!trades || trades.length === 0) {
      var now = new Date();
      var shiftedSample = new Date(now.getTime() + (shiftHours * 3600000));
      var sampleStr;
      try {
        sampleStr = new Intl.DateTimeFormat('tr-TR', {
          timeZone: targetTz,
          month: 'short', day: '2-digit', hour: '2-digit', minute: '2-digit'
        }).format(shiftedSample);
      } catch (e) {
        sampleStr = shiftedSample.toISOString().slice(11, 16);
      }
      previewList.innerHTML = `
        <div style="font-style:italic;color:var(--muted);">${window.i18n ? window.i18n.t('prop.time_shift_no_trades') : 'Henüz işlem bulunmuyor.'} (Örnek: şu anki saat ${shiftHours >= 0 ? '+' + shiftHours : shiftHours}h ➔ ${sampleStr} ${targetTz})</div>
      `;
      return;
    }

    var html = '';
    trades.forEach(function(t) {
      var origDate = new Date(t.trade_date);
      var shiftedDate = new Date(origDate.getTime() + (shiftHours * 3600000));
      var shiftedFormatted;
      try {
        shiftedFormatted = new Intl.DateTimeFormat('tr-TR', {
          timeZone: targetTz,
          year: 'numeric', month: '2-digit', day: '2-digit',
          hour: '2-digit', minute: '2-digit'
        }).format(shiftedDate);
      } catch (e) {
        shiftedFormatted = shiftedDate.toISOString().replace('T', ' ').slice(0, 16);
      }
      var origRaw = String(t.trade_date).replace('T', ' ').slice(0, 16);
      html += `
        <div style="display:flex;align-items:center;justify-content:space-between;padding:2px 0;">
          <span style="opacity:0.7;">${escapeHtml(origRaw)} (ham)</span>
          <span style="font-weight:600;color:var(--accent);">➔ ${escapeHtml(shiftedFormatted)} (${escapeHtml(targetTz)})</span>
        </div>
      `;
    });
    previewList.innerHTML = html;
  }

  function initModals() {
    var cGrid = document.getElementById('color-grid');
    COLORS.forEach(function(c) {
      var btn = document.createElement('div');
      btn.className = 'journal-color-btn';
      btn.style.backgroundColor = c;
      btn.dataset.color = c;
      btn.onclick = function() {
        document.querySelectorAll('.journal-color-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
      };
      cGrid.appendChild(btn);
    });
    
    var iGrid = document.getElementById('icon-grid');
    ICONS.forEach(function(icon) {
      var btn = document.createElement('button');
      btn.className = 'journal-icon-btn';
      btn.dataset.icon = icon;
      btn.innerHTML = '<i data-lucide="' + icon + '" style="width:20px;height:20px;"></i>';
      btn.onclick = function() {
        document.querySelectorAll('.journal-icon-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
      };
      iGrid.appendChild(btn);
    });

    // Prop template setup
    populatePropTemplates();

    var tmplSel = document.getElementById('prop-template-select');
    if (tmplSel) tmplSel.addEventListener('change', onPropTemplateChange);

    var phaseSel = document.getElementById('prop-phase-select');
    if (phaseSel) phaseSel.addEventListener('change', onPropPhaseChange);

    var tzSel = document.getElementById('prop-reset-tz-select');
    if (tzSel) {
      tzSel.addEventListener('change', function() { updateTimeShiftPreview(); });
    }

    var timeSlider = document.getElementById('prop-time-shift');
    var timeNum = document.getElementById('prop-time-shift-num');
    var timeDisplay = document.getElementById('prop-time-shift-display');
    if (timeSlider && timeNum) {
      function onTimeShiftInput(val) {
        var v = parseFloat(val);
        if (isNaN(v)) v = 0;
        if (v < -14) v = -14;
        if (v > 14) v = 14;
        timeSlider.value = v;
        timeNum.value = v;
        if (timeDisplay) timeDisplay.textContent = (v > 0 ? '+' + v : v) + ' saat';
        updateTimeShiftPreview();
      }
      timeSlider.addEventListener('input', function() { onTimeShiftInput(timeSlider.value); });
      timeNum.addEventListener('input', function() { onTimeShiftInput(timeNum.value); });
    }

    var advInputs = [
      'prop-rule-target', 'prop-rule-daily', 'prop-rule-daily-base',
      'prop-rule-max', 'prop-rule-max-type', 'prop-rule-min-days', 'prop-rule-consistency'
    ];
    advInputs.forEach(function(inpId) {
      var el = document.getElementById(inpId);
      if (el) el.addEventListener('input', checkIsCustomized);
    });

    var balSel = document.getElementById('prop-balance-select');
    var customBal = document.getElementById('prop-custom-balance');
    if (balSel) {
      balSel.addEventListener('change', function() {
        if (balSel.value === 'custom') {
          customBal.style.display = 'block';
          customBal.focus();
        } else {
          customBal.style.display = 'none';
        }
      });
    }

    var propToggle = document.getElementById('journal-prop-toggle');
    var propSection = document.getElementById('journal-prop-section');
    var inactiveCard = document.getElementById('prop-inactive-card');
    if (propToggle) {
      propToggle.addEventListener('change', async function() {
        if (propToggle.checked) {
          if (currentModalMode === 'create' && window.PropService) {
            try {
              var quota = await window.PropService.checkPropAccountQuota();
              if (!quota.canCreate) {
                var quotaWarn = document.getElementById('prop-quota-warning');
                if (quotaWarn) quotaWarn.style.display = 'flex';
                propToggle.checked = false;
                if (inactiveCard) inactiveCard.style.display = 'block';
                if (window.showToast) {
                  window.showToast('Prop hesabı kotasına ulaştınız. (' + quota.count + '/' + quota.limit + ')', 'warning');
                }
                return;
              }
            } catch (qErr) {}
          }
          propSection.classList.add('active');
          if (inactiveCard) inactiveCard.style.display = 'none';
          if (typeof lucide !== 'undefined') lucide.createIcons();
          updateTimeShiftPreview();
        } else {
          propSection.classList.remove('active');
          if (inactiveCard) inactiveCard.style.display = 'block';
        }
      });
    }
  }
  
  function getSelectedColor() {
    var active = document.querySelector('.journal-color-btn.active');
    return active ? active.dataset.color : COLORS[0];
  }
  
  function getSelectedIcon() {
    var active = document.querySelector('.journal-icon-btn.active');
    return active ? active.dataset.icon : ICONS[0];
  }
  
  async function openModal(mode, id) {
    currentModalMode = mode;
    var titleEl = document.getElementById('journal-modal-title');
    var idEl = document.getElementById('journal-id');
    var nameEl = document.getElementById('journal-name');
    var descEl = document.getElementById('journal-desc');
    var propToggle = document.getElementById('journal-prop-toggle');
    var propSection = document.getElementById('journal-prop-section');
    var inactiveCard = document.getElementById('prop-inactive-card');
    var propAccountIdEl = document.getElementById('prop-account-id');
    var propQuotaWarn = document.getElementById('prop-quota-warning');
    var propBalSel = document.getElementById('prop-balance-select');
    var propCustomBal = document.getElementById('prop-custom-balance');
    var propStartDate = document.getElementById('prop-start-date');
    var propTmplSel = document.getElementById('prop-template-select');
    var propPhaseSel = document.getElementById('prop-phase-select');
    var propTzSel = document.getElementById('prop-reset-tz-select');

    document.querySelectorAll('.journal-color-btn, .journal-icon-btn').forEach(b => b.classList.remove('active'));
    if (propQuotaWarn) propQuotaWarn.style.display = 'none';
    if (propCustomBal) propCustomBal.style.display = 'none';
    if (propAccountIdEl) propAccountIdEl.value = '';

    if (mode === 'create') {
      titleEl.textContent = i18n.t('journal.create_title');
      titleEl.setAttribute('data-i18n', 'journal.create_title');
      idEl.value = '';
      nameEl.value = '';
      descEl.value = '';
      document.querySelector('.journal-color-btn[data-color="' + COLORS[0] + '"]').classList.add('active');
      document.querySelector('.journal-icon-btn[data-icon="' + ICONS[0] + '"]').classList.add('active');

      if (propToggle) {
        propToggle.checked = false;
        propToggle.disabled = false;
      }
      if (propSection) propSection.classList.remove('active');
      if (inactiveCard) inactiveCard.style.display = 'block';
      if (propStartDate) {
        propStartDate.value = new Date().toISOString().slice(0, 10);
        propStartDate.max = new Date().toISOString().slice(0, 10);
      }
      if (propBalSel) propBalSel.value = '100000';
      
      var timeSlider = document.getElementById('prop-time-shift');
      var timeNum = document.getElementById('prop-time-shift-num');
      var timeDisplay = document.getElementById('prop-time-shift-display');
      if (timeSlider) timeSlider.value = 0;
      if (timeNum) timeNum.value = 0;
      if (timeDisplay) timeDisplay.textContent = '0 saat';

      var advBox = document.getElementById('prop-advanced-rules-box');
      if (advBox) advBox.open = false;

      if (propTmplSel) {
        propTmplSel.value = 'ftmo-2step';
        onPropTemplateChange();
      }
      updateTimeShiftPreview();

      // Check quota in advance
      if (window.PropService) {
        window.PropService.checkPropAccountQuota().then(function(quota) {
          if (!quota.canCreate && propQuotaWarn) {
            propQuotaWarn.style.display = 'flex';
            var desc = document.getElementById('prop-quota-desc');
            if (desc) {
              desc.textContent = quota.isPremium 
                ? (window.i18n ? window.i18n.t('prop.quota_premium_desc') : 'Premium planda maksimum 10 aktif prop hesabı açabilirsiniz.') 
                : (window.i18n ? window.i18n.t('prop.quota_desc') : 'Free planda yalnızca 1 aktif prop hesabı açabilirsiniz. Daha fazlası için Premium\'a yükseltin.');
            }
          }
        }).catch(function() {});
      }

    } else {
      titleEl.textContent = i18n.t('journal.edit_title');
      titleEl.setAttribute('data-i18n', 'journal.edit_title');
      var j = journalsData.find(x => x.id === id);
      if (j) {
        idEl.value = j.id;
        nameEl.value = j.name;
        descEl.value = j.description || '';
        
        var cBtn = document.querySelector('.journal-color-btn[data-color="' + (j.color || COLORS[0]) + '"]');
        if (cBtn) cBtn.classList.add('active');
        else document.querySelector('.journal-color-btn[data-color="' + COLORS[0] + '"]').classList.add('active');
        
        var iBtn = document.querySelector('.journal-icon-btn[data-icon="' + (j.icon || ICONS[0]) + '"]');
        if (iBtn) iBtn.classList.add('active');
        else document.querySelector('.journal-icon-btn[data-icon="' + ICONS[0] + '"]').classList.add('active');

        // Check if journal has an active prop account
        if (propToggle) propToggle.disabled = false;
        if (window.PropService) {
          try {
            var propAcc = await window.PropService.getPropAccountByJournalId(j.id);
            if (propAcc) {
              if (inactiveCard) inactiveCard.style.display = 'none';
              if (propAccountIdEl) propAccountIdEl.value = propAcc.id;
              if (propToggle) propToggle.checked = true;
              if (propSection) propSection.classList.add('active');

              if (propTmplSel && propAcc.template_key) {
                propTmplSel.value = propAcc.template_key;
                onPropTemplateChange();
              }
              if (propPhaseSel && propAcc.phase_index !== undefined) {
                propPhaseSel.value = propAcc.phase_index;
              }
              if (propStartDate && propAcc.start_date) {
                propStartDate.value = String(propAcc.start_date).slice(0, 10);
                propStartDate.max = new Date().toISOString().slice(0, 10);
              }
              if (propTzSel && propAcc.reset_tz) {
                propTzSel.value = propAcc.reset_tz;
              }

              // Time shift
              var timeSlider = document.getElementById('prop-time-shift');
              var timeNum = document.getElementById('prop-time-shift-num');
              var timeDisplay = document.getElementById('prop-time-shift-display');
              var shiftVal = propAcc.time_shift_hours !== undefined ? propAcc.time_shift_hours : 0;
              if (timeSlider) timeSlider.value = shiftVal;
              if (timeNum) timeNum.value = shiftVal;
              if (timeDisplay) timeDisplay.textContent = (shiftVal > 0 ? '+' + shiftVal : shiftVal) + ' saat';

              var balVal = String(Number(propAcc.starting_balance) || 100000);
              var stdVals = ['5000', '10000', '25000', '50000', '100000', '200000'];
              if (stdVals.includes(balVal)) {
                if (propBalSel) propBalSel.value = balVal;
                if (propCustomBal) propCustomBal.style.display = 'none';
              } else {
                if (propBalSel) propBalSel.value = 'custom';
                if (propCustomBal) {
                  propCustomBal.style.display = 'block';
                  propCustomBal.value = balVal;
                }
              }

              // Load rules into advanced inputs
              if (propAcc.rules) {
                syncAdvancedRulesInputs(propAcc.rules);
              }
              checkIsCustomized();
              updateTimeShiftPreview(j.id);
            } else {
              if (inactiveCard) inactiveCard.style.display = 'block';
              if (propToggle) propToggle.checked = false;
              if (propSection) propSection.classList.remove('active');
            }
          } catch (propErr) {
            if (inactiveCard) inactiveCard.style.display = 'block';
            if (propToggle) propToggle.checked = false;
            if (propSection) propSection.classList.remove('active');
          }
        }
      }
    }
    
    if (window.i18n && window.i18n.apply) window.i18n.apply();
    document.getElementById('journal-modal').classList.add('active');
    if (typeof lucide !== 'undefined') lucide.createIcons();
  }
  
  function closeModal() {
    document.getElementById('journal-modal').classList.remove('active');
  }
  
  function showUpgradeModal() {
    wwLog.log('Show upgrade modal');
    window.location.href = '/settings.html#panel-plan';
  }
  
  async function renderJournals() {
    try {
      if (!window.sb) throw new Error('No sb client');
      var { data: { user } } = await window.sb.auth.getUser();
      if (!user) {
        if (window.location.search.includes('test=')) {
          user = { id: 'mock-test-user', email: 'test@wawe.com' };
        } else {
          window.location.href = '/index.html';
          return;
        }
      }
      
      var profile = null;
      try {
        var profRes = await window.sb.from('user_profiles').select('plan, max_journals').eq('id', user.id).single();
        profile = profRes ? profRes.data : null;
      } catch(e) {}
      isPremium = profile?.plan === 'premium';
      try {
        journalsData = await window.journal.listJournals();
      } catch(e) {
        journalsData = [];
      }

      if (window.location.search.includes('test=') && (!journalsData || journalsData.length === 0)) {
        journalsData = [
          { id: 'j-ftmo', name: 'FTMO Challenge 100K', icon: 'briefcase', total_pnl: 4320.50, trade_count: 24, is_default: true, max_journals: 10 },
          { id: 'j-fn', name: 'FundedNext Stellar 50K', icon: 'zap', total_pnl: -1250.00, trade_count: 18, is_default: false, max_journals: 10 },
          { id: 'j-fp', name: 'FundingPips Master 100K', icon: 'target', total_pnl: 8120.00, trade_count: 42, is_default: false, max_journals: 10 },
          { id: 'j-pers', name: 'Personal Swing Account', icon: 'trending-up', total_pnl: 1450.20, trade_count: 15, is_default: false, max_journals: 10 }
        ];
      }
      var count = journalsData.length;

      // Active prop accounts lookup
      var propAccountsMap = new Map();
      if (window.location.search.includes('test=')) {
        propAccountsMap.set('j-ftmo', { journal_id: 'j-ftmo', template_key: 'ftmo-2step', phase_index: 0, rules: { firm: 'FTMO', phase_name: 'Phase 1 (Challenge)' } });
        propAccountsMap.set('j-fn', { journal_id: 'j-fn', template_key: 'fundednext-stellar-1step', phase_index: 0, rules: { firm: 'FundedNext', phase_name: 'Phase 1' } });
        propAccountsMap.set('j-fp', { journal_id: 'j-fp', template_key: 'fundingpips-2step', phase_index: 1, rules: { firm: 'FundingPips', phase_name: 'Phase 2 (Evaluation)' } });
      } else if (window.PropService && typeof window.PropService.getActivePropAccounts === 'function') {
        try {
          var activeProps = await window.PropService.getActivePropAccounts();
          (activeProps || []).forEach(function(pa) {
            propAccountsMap.set(pa.journal_id, pa);
          });
        } catch (propLoadErr) {
          if (window.wwLog) window.wwLog.warn('Prop accounts load error:', propLoadErr);
        }
      }
      
      // max_journals kaynagi: RPC eger gonderiyorsa onu kullan, yoksa fallback (premium için en az 10)
      var maxJournals = (count > 0 && journalsData[0].max_journals !== undefined) 
                        ? Math.max(journalsData[0].max_journals, isPremium ? 10 : 2) 
                        : Math.max(profile?.max_journals || 0, isPremium ? 10 : 2);
      
      var usageTmpl = i18n.t('journal.usage');
      var usageTxt = usageTmpl.replace('{used}', count).replace('{limit}', maxJournals);
      document.getElementById('usage-text').innerHTML = '<strong>' + usageTxt + '</strong>';
      
      var btnNew = document.getElementById('btn-new-journal');
      if (count >= maxJournals) {
        btnNew.onclick = showUpgradeModal;
        btnNew.title = i18n.t('journal.err_quota');
      } else {
        btnNew.onclick = () => openModal('create');
        btnNew.title = '';
      }
      
      var grid = document.getElementById('journals-grid');
      grid.innerHTML = '';
      
      if (journalsData.length === 0) {
        grid.innerHTML = '<div style="color:var(--muted);">' + i18n.t('journal.empty') + '</div>';
        return;
      }
      
      journalsData.forEach(function(j) {
        var card = document.createElement('div');
        card.className = 'journal-card';
        card.dataset.id = j.id;
        card.style.setProperty('--journal-color', j.color || '#7c6dfa');
        
        card.onclick = function(e) {
          if (e.target.closest('.journal-menu-btn') || e.target.closest('.journal-menu-dropdown')) return;
          if (typeof window.switchJournalWithAnimation === 'function') {
            window.switchJournalWithAnimation(j, '/dashboard.html');
          } else {
            window.journal.setActiveJournalId(j.id);
            window.location.href = '/dashboard.html';
          }
        };
        
        var formatCurrencyFn = window.formatCurrency || (val => Number(val).toFixed(2));
        var pnl = Number(j.total_pnl || 0);
        var pnlClass = pnl > 0 ? 'positive' : (pnl < 0 ? 'negative' : 'neutral');
        var pnlText = pnl === 0 ? '0.00' : formatCurrencyFn(pnl);
        var iconStr = j.icon || 'folder';
        
        var defaultBadge = j.is_default ? `<div class="journal-card-badge"><i data-lucide="star" style="width:12px;height:12px;fill:currentColor;"></i> ${i18n.t('journal.default_badge')}</div>` : '';
        var tradesTxt = i18n.t('journal.trades_count').replace('{count}', j.trade_count || 0);

        // Prop firm branding & badge on card
        var propBadge = '';
        var propAcc = propAccountsMap.get(j.id);
        var propInfo = null;
        if (propAcc) {
          var tmplKey = propAcc.template_key;
          var tmpl = window.PropTemplates ? window.PropTemplates.getPropTemplate(tmplKey) : null;
          var firmName = tmpl ? tmpl.firm : (propAcc.rules?.firm || 'Prop');
          
          var resolver = window.getPropFirmInfo || (window.PropTemplates && window.PropTemplates.getPropFirmInfo);
          if (typeof resolver === 'function') {
            propInfo = resolver(firmName || tmplKey);
          }
          if (!propInfo) {
            propInfo = {
              id: 'custom',
              name: firmName || 'Prop',
              logo: '/images/props/custom.svg',
              symbolLogo: '/images/props/custom.svg',
              badgeClass: 'prop-custom',
              accentColor: '#a855f7'
