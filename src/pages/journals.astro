          }

          var phaseNum = (propAcc.phase_index !== undefined ? propAcc.phase_index + 1 : 1);
          var phaseLabel = (propAcc.rules && propAcc.rules.phase_name) 
            ? propAcc.rules.phase_name 
            : (window.i18n ? window.i18n.t('prop.phase_num', { n: phaseNum }) : ('Faz ' + phaseNum));
          var isCustomized = Boolean(propAcc.rules && propAcc.rules.is_customized);
