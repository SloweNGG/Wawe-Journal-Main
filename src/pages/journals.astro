            <button class="btn-card-sync" type="button" onclick="window.wwSyncCtrader(event, '${ctAcc.ctid_trader_account_id}', '${j.id}', this)" title="Son senkron: ${ctAcc.last_sync_at ? new Date(ctAcc.last_sync_at).toLocaleTimeString() : 'Henüz yapılmadı'}">
              <i data-lucide="refresh-cw"></i>
              <span>Senkronla</span>
