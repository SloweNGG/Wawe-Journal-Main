        `;
        ctMenuHtml = `<button class="journal-menu-item danger btn-unlink-ctrader" data-acid="${ctAcc.id}"><i data-lucide="unlink"></i> cTrader Bağlantısını Kes</button>`;
      } else {
        ctBarHtml = '';
        ctMenuHtml = '';
