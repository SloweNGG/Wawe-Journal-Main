<script is:inline>
  // SPA: bu script'in global dinleyicileri sayfadan çıkınca kaldırılır (BaseHead.astro → wwPage)
  var JOURNALS_PAGE = window.wwPage.current();

  var i18n = window.i18n || {
    t: function(k, params) {
      if (window.i18n && typeof window.i18n.t === 'function') {
        return window.i18n.t(k, params);
      }
      return k;
    }
  };
  var COLORS = ['#7c6dfa','#22c55e','#ef4444','#f59e0b','#3b82f6','#ec4899','#14b8a6','#f97316'];

  // ---- cTrader kartı: bakiye + son senkron gösterimi ----
  var CT_CURRENCY_SYMBOLS = { USD: '$', EUR: '€', GBP: '£', TRY: '₺', JPY: '¥', AUD: 'A$', CAD: 'C$', CHF: 'CHF ', PLN: 'zł ', RUB: '₽' };

  // Bakiye, hesabın KENDİ para biriminde gösterilir (PnL gibi tr-TR biçimi: 12.337,79). Birim bilinmiyorsa uygulama sembolü.
  // i18n yardımcıları: anahtar yoksa yedek metin; pencerenin tüm metinleri seçili dile göre gelir
  function jt(key, fallback, params) {
    try {
      var v = window.i18n ? window.i18n.t(key, params) : key;
      return (v && v !== key) ? v : fallback;
    } catch (e) { return fallback; }
  }
  function uiLocale() {
    var l = window.i18n && window.i18n.getCurrentLanguage ? window.i18n.getCurrentLanguage() : 'tr';
    return l === 'en' ? 'en-GB' : (l === 'de' ? 'de-DE' : 'tr-TR');
  }
  function hoursText(v) { return jt('journal.wiz.hours', (v > 0 ? '+' + v : v) + ' saat', { n: (v > 0 ? '+' + v : String(v)) }); }

  function formatAccountBalance(value, code) {
    var num = Number(value);
    if (!isFinite(num)) return '—';
    var c = String(code || '').toUpperCase();
    var crypto = (c === 'BTC' || c === 'ETH');
    var txt = Math.abs(num).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: crypto ? 8 : 2 });
    var sign = num < 0 ? '-' : '';
    if (!c) {
      var sym = '$';
      try { sym = localStorage.getItem('ww_currency') || '$'; } catch (e) {}
      return sign + sym + txt;
    }
    if (CT_CURRENCY_SYMBOLS[c]) return sign + CT_CURRENCY_SYMBOLS[c] + txt;
    return sign + txt + ' ' + c;
  }

  function relativeTimeTr(iso) {
    var t = new Date(iso).getTime();
    if (!isFinite(t)) return '';
    var sec = Math.max(0, Math.round((Date.now() - t) / 1000));
    if (sec < 60) return 'az önce';
    var min = Math.floor(sec / 60);
    if (min < 60) return min + ' dk önce';
    var hr = Math.floor(min / 60);
    if (hr < 24) return hr + ' sa önce';
    return Math.floor(hr / 24) + ' gün önce';
  }

  // Mutlak zaman (kullanıcının Ayarlar > Görünüm saat dilimine göre)
  function absoluteTime(iso) {
    try {
      if (window.WwTime && typeof window.WwTime.formatDateTime === 'function') {
        var out = window.WwTime.formatDateTime(iso);
        if (out) return out;
      }
    } catch (e) {}
    var d = new Date(iso);
    return isFinite(d.getTime()) ? d.toLocaleString() : '';
  }
  
  var journalsData = [];
  var isPro = false;
  var deleteId = null;
  var currentModalMode = 'create';
  
  function populatePropTemplates() {
    var sel = document.getElementById('prop-template-select');
    if (!sel || !window.PropTemplates) return;
    sel.innerHTML = '';
    var templates = window.PropTemplates.getPropTemplates();
    templates.forEach(function(tmpl) {
      var opt = document.createElement('option');
      opt.value = tmpl.key;
      opt.textContent = tmpl.name;
      sel.appendChild(opt);
    });
  }

  function escapeHtml(str) {
    if (str === null || str === undefined) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function getSelectedPhase() {
    var tmplSel = document.getElementById('prop-template-select');
    var phaseSel = document.getElementById('prop-phase-select');
    if (!tmplSel || !phaseSel || !window.PropTemplates) return null;
    var tmpl = window.PropTemplates.getPropTemplate(tmplSel.value);
    if (!tmpl || !tmpl.phases) return null;
    var pIdx = parseInt(phaseSel.value, 10) || 0;
    return tmpl.phases.find(function(p) { return p.phase_index === pIdx; }) || tmpl.phases[0];
  }

  function syncAdvancedRulesInputs(phaseRules) {
    if (!phaseRules) return;
    var targetEl = document.getElementById('prop-rule-target');
    var dailyEl = document.getElementById('prop-rule-daily');
    var dailyBaseEl = document.getElementById('prop-rule-daily-base');
    var maxEl = document.getElementById('prop-rule-max');
    var maxTypeEl = document.getElementById('prop-rule-max-type');
    var minDaysEl = document.getElementById('prop-rule-min-days');
    var consistencyEl = document.getElementById('prop-rule-consistency');

    if (targetEl) targetEl.value = (phaseRules.profit_target_pct !== null && phaseRules.profit_target_pct !== undefined) ? phaseRules.profit_target_pct : '';
    if (dailyEl) dailyEl.value = (phaseRules.daily_loss_limit_pct !== null && phaseRules.daily_loss_limit_pct !== undefined) ? phaseRules.daily_loss_limit_pct : 5;
    if (dailyBaseEl) dailyBaseEl.value = phaseRules.daily_loss_amount_base || 'initial_balance';
    if (maxEl) maxEl.value = (phaseRules.max_loss_limit_pct !== null && phaseRules.max_loss_limit_pct !== undefined) ? phaseRules.max_loss_limit_pct : 10;
    if (maxTypeEl) maxTypeEl.value = phaseRules.max_loss_type || 'static';
    if (minDaysEl) minDaysEl.value = (phaseRules.min_trading_days !== null && phaseRules.min_trading_days !== undefined) ? phaseRules.min_trading_days : 0;
    if (consistencyEl) {
      var cPct = (phaseRules.consistency_rule && phaseRules.consistency_rule.enabled) ? phaseRules.consistency_rule.max_single_day_profit_pct : '';
      consistencyEl.value = cPct || '';
    }
    checkIsCustomized();
  }

  function checkIsCustomized() {
    var tmplSel = document.getElementById('prop-template-select');
    var phaseSel = document.getElementById('prop-phase-select');
    var badge = document.getElementById('prop-customized-badge');
    if (!tmplSel || !phaseSel || !window.PropTemplates) return false;

    var tmplKey = tmplSel.value;
    var phaseIdx = parseInt(phaseSel.value, 10) || 0;
    var def = window.PropTemplates.getDefaultRules(tmplKey, phaseIdx);
    if (!def) return false;

    if (tmplKey === 'custom') {
      if (badge) badge.style.display = 'inline-block';
      return true;
    }

    var targetVal = document.getElementById('prop-rule-target')?.value;
    var curTarget = (targetVal === '' || targetVal === null) ? null : Number(targetVal);
    var curDaily = Number(document.getElementById('prop-rule-daily')?.value);
    var curDailyBase = document.getElementById('prop-rule-daily-base')?.value;
    var curMax = Number(document.getElementById('prop-rule-max')?.value);
    var curMaxType = document.getElementById('prop-rule-max-type')?.value;
    var curMinDays = Number(document.getElementById('prop-rule-min-days')?.value);
    var conVal = document.getElementById('prop-rule-consistency')?.value;
    var curCon = conVal ? Number(conVal) : null;

    var defCon = (def.consistency_rule && def.consistency_rule.enabled) ? def.consistency_rule.max_single_day_profit_pct : null;

    var isDiff = (
      curTarget !== def.profit_target_pct ||
      curDaily !== def.daily_loss_limit_pct ||
      curDailyBase !== def.daily_loss_amount_base ||
      curMax !== def.max_loss_limit_pct ||
      curMaxType !== def.max_loss_type ||
      curMinDays !== def.min_trading_days ||
      curCon !== defCon
    );

    if (badge) badge.style.display = isDiff ? 'inline-block' : 'none';
    return isDiff;
  }

  function onPropPhaseChange() {
    var phase = getSelectedPhase();
    if (!phase) return;

    // verified: false warning
    var unverifiedAlert = document.getElementById('prop-unverified-alert');
    if (unverifiedAlert) {
      unverifiedAlert.style.display = (phase.verified === false) ? 'flex' : 'none';
    }

    syncAdvancedRulesInputs(phase);
  }

  function onPropTemplateChange() {
    var tmplSel = document.getElementById('prop-template-select');
    var phaseSel = document.getElementById('prop-phase-select');
    var tzSel = document.getElementById('prop-reset-tz-select');
    var tzAlert = document.getElementById('prop-tz-required-alert');
    var estAlert = document.getElementById('prop-estimated-alert');

    if (!tmplSel || !window.PropTemplates) return;
    var tmplKey = tmplSel.value;
    var tmpl = window.PropTemplates.getPropTemplate(tmplKey);
    if (!tmpl) return;

    // Phases
    phaseSel.innerHTML = '';
    (tmpl.phases || []).forEach(function(p) {
      var opt = document.createElement('option');
      opt.value = p.phase_index;
      opt.textContent = p.phase_name + (p.profit_target_pct ? ' ' + jt('prop.phase_target_suffix', '(%{pct} Hedef)', { pct: p.profit_target_pct }) : '');
      phaseSel.appendChild(opt);
    });

    // Reset timezone defaults & requirements
    if (tmpl.reset_tz_required) {
      if (tzAlert) tzAlert.style.display = 'flex';
      // FundedNext requires broker server timezone. Do not carry over fixed timezones; leave empty to force selection (Europe/Athens suggested in note).
      tzSel.value = '';
    } else {
      if (tzAlert) tzAlert.style.display = 'none';
      if (tmpl.reset_tz) {
        tzSel.value = tmpl.reset_tz;
      }
    }

    // Estimated rules alert (daily loss or max loss equity based)
    var hasEst = (tmpl.estimated_rules && tmpl.estimated_rules.length > 0);
    if (estAlert) estAlert.style.display = hasEst ? 'flex' : 'none';

    onPropPhaseChange();
    updateTimeShiftPreview();
  }

  async function updateTimeShiftPreview(journalId) {
    var previewList = document.getElementById('prop-time-shift-preview-list');
    var shiftEl = document.getElementById('prop-time-shift-num');
    var tzSel = document.getElementById('prop-reset-tz-select');
    if (!previewList) return;

    var parsedShift = parseFloat(shiftEl ? shiftEl.value : 0);
    var shiftHours = isNaN(parsedShift) ? 0 : Math.min(14, Math.max(-14, parsedShift));
    var targetTz = (tzSel && tzSel.value) ? tzSel.value : 'UTC';

    // Başlıktaki {tz} yer tutucusu: data-i18n-params dil değişince de doldurulur
    var previewTitle = document.getElementById('prop-time-shift-preview-title');
    if (previewTitle) {
      previewTitle.setAttribute('data-i18n-params', JSON.stringify({ tz: targetTz }));
      previewTitle.textContent = jt('prop.time_shift_preview_title', 'Son 3 işlemin bu ayarla görünümü ({tz}):', { tz: targetTz });
    }

    var trades = [];
    var jId = journalId || (document.getElementById('journal-id') ? document.getElementById('journal-id').value : null);

    if (jId && window.wwCache) {
      var uId = (window.currentUser && window.currentUser.id) || (window.__wwUserProfile && window.__wwUserProfile.id);
      if (uId) {
        var previewCols = ['trade_date', 'pnl', 'platform_source'];
        var cached = window.wwCache.get('trades_dashboard', uId, jId, previewCols) || window.wwCache.get('trades', uId, jId, previewCols);
        if (cached && Array.isArray(cached) && cached.length > 0) {
          // Yalnızca canlı işlemler; önbellek listesi ASC ya da DESC olabilir -> tarihe göre en yeni 3
          // (eskiden DESC 'trades' listesinde slice(-3) EN ESKİ 3 işlemi gösteriyordu)
          trades = window.WwTrades.filterScope(cached, 'live').slice().sort(function (a, b) {
            return (Date.parse(b.trade_date) || 0) - (Date.parse(a.trade_date) || 0);
          }).slice(0, 3);
        }
      }
    }

    if (trades.length === 0 && jId && window.sb) {
      try {
        // Prop zaman kaydırma önizlemesi: yalnızca canlı işlemler
        var previewQuery = window.sb
          .from('trades')
          .select('trade_date, pnl, platform_source')
          .eq('journal_id', jId);
        var res = await window.WwTrades.applyScope(previewQuery, 'live')
          .order('trade_date', { ascending: false })
          .limit(3);
        if (res.data && res.data.length > 0) {
          trades = res.data;
        }
      } catch (e) {}
    }

    if (!trades || trades.length === 0) {
      var now = new Date();
      var shiftedSample = new Date(now.getTime() + (shiftHours * 3600000));
      var sampleStr;
      try {
        sampleStr = new Intl.DateTimeFormat(uiLocale(), {
          timeZone: targetTz,
          month: 'short', day: '2-digit', hour: '2-digit', minute: '2-digit'
        }).format(shiftedSample);
      } catch (e) {
        sampleStr = shiftedSample.toISOString().slice(11, 16);
      }
      previewList.innerHTML = `
        <div style="font-style:italic;color:var(--muted);">${jt('prop.time_shift_no_trades', 'Henüz işlem bulunmuyor.')} ${jt('prop.time_shift_sample', '(Örnek: şu anki saat {shift}h ➔ {sample} {tz})', { shift: (shiftHours >= 0 ? '+' + shiftHours : shiftHours), sample: sampleStr, tz: targetTz })}</div>
      `;
      return;
    }

    var html = '';
    trades.forEach(function(t) {
      var origDate = new Date(t.trade_date);
      var shiftedDate = new Date(origDate.getTime() + (shiftHours * 3600000));
      var shiftedFormatted;
      try {
        shiftedFormatted = new Intl.DateTimeFormat('tr-TR', {
          timeZone: targetTz,
          year: 'numeric', month: '2-digit', day: '2-digit',
          hour: '2-digit', minute: '2-digit'
        }).format(shiftedDate);
      } catch (e) {
        shiftedFormatted = shiftedDate.toISOString().replace('T', ' ').slice(0, 16);
      }
      var origRaw = String(t.trade_date).replace('T', ' ').slice(0, 16);
      html += `
        <div style="display:flex;align-items:center;justify-content:space-between;padding:2px 0;">
          <span style="opacity:0.7;">${escapeHtml(origRaw)} (ham)</span>
          <span style="font-weight:600;color:var(--accent);">➔ ${escapeHtml(shiftedFormatted)} (${escapeHtml(targetTz)})</span>
        </div>
      `;
    });
    previewList.innerHTML = html;
  }

  function initModals() {
    var cGrid = document.getElementById('color-grid');
    COLORS.forEach(function(c) {
      var btn = document.createElement('div');
      btn.className = 'journal-color-btn';
      btn.style.backgroundColor = c;
      btn.dataset.color = c;
      btn.onclick = function() {
        document.querySelectorAll('.journal-color-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        syncColorHintDot();
      };
      cGrid.appendChild(btn);
    });
    
    // Prop template setup
    populatePropTemplates();

    var tmplSel = document.getElementById('prop-template-select');
    if (tmplSel) tmplSel.addEventListener('change', onPropTemplateChange);

    var phaseSel = document.getElementById('prop-phase-select');
    if (phaseSel) phaseSel.addEventListener('change', onPropPhaseChange);

    var tzSel = document.getElementById('prop-reset-tz-select');
    if (tzSel) {
      tzSel.addEventListener('change', function() { updateTimeShiftPreview(); });
    }

    var timeSlider = document.getElementById('prop-time-shift');
    var timeNum = document.getElementById('prop-time-shift-num');
    var timeDisplay = document.getElementById('prop-time-shift-display');
    if (timeSlider && timeNum) {
      function onTimeShiftInput(val) {
        var v = parseFloat(val);
        if (isNaN(v)) v = 0;
        if (v < -14) v = -14;
        if (v > 14) v = 14;
        timeSlider.value = v;
        timeNum.value = v;
        if (timeDisplay) timeDisplay.textContent = hoursText(v);
        updateTimeShiftPreview();
      }
      timeSlider.addEventListener('input', function() { onTimeShiftInput(timeSlider.value); });
      timeNum.addEventListener('input', function() { onTimeShiftInput(timeNum.value); });
    }

    var advInputs = [
      'prop-rule-target', 'prop-rule-daily', 'prop-rule-daily-base',
      'prop-rule-max', 'prop-rule-max-type', 'prop-rule-min-days', 'prop-rule-consistency'
    ];
    advInputs.forEach(function(inpId) {
      var el = document.getElementById(inpId);
      if (el) el.addEventListener('input', checkIsCustomized);
    });

    var balSel = document.getElementById('prop-balance-select');
    var customBal = document.getElementById('prop-custom-balance');
    if (balSel) {
      balSel.addEventListener('change', function() {
        if (balSel.value === 'custom') {
          customBal.style.display = 'block';
          customBal.focus();
        } else {
          customBal.style.display = 'none';
        }
      });
    }

    var propToggle = document.getElementById('journal-prop-toggle');
    var propSection = document.getElementById('journal-prop-section');
    var inactiveCard = document.getElementById('prop-inactive-card');
    if (propToggle) {
      propToggle.addEventListener('change', async function() {
        if (propToggle.checked) {
          if (currentModalMode === 'create' && window.PropService) {
            try {
              var quota = await window.PropService.checkPropAccountQuota();
              if (!quota.canCreate) {
                var quotaWarn = document.getElementById('prop-quota-warning');
                if (quotaWarn) quotaWarn.style.display = 'flex';
                propToggle.checked = false;
                if (inactiveCard) inactiveCard.style.display = 'block';
                if (window.showToast) {
                  window.showToast(jt('prop.err_quota_reached', 'Prop hesabı kotasına ulaştınız. ({count}/{limit})', { count: quota.count, limit: quota.limit }), 'warning');
                }
                return;
              }
            } catch (qErr) {}
          }
          propSection.classList.add('active');
          if (inactiveCard) inactiveCard.style.display = 'none';
          if (typeof lucide !== 'undefined') lucide.createIcons();
          updateTimeShiftPreview();
        } else {
          propSection.classList.remove('active');
          if (inactiveCard) inactiveCard.style.display = 'block';
        }
      });
    }
  }

  // Hangi işlemler görünsün? (journals.trade_scope: live | backtest | all)
  function getSelectedScope() {
    var r = document.querySelector('input[name="journal-trade-scope"]:checked');
    return r ? r.value : 'live';
  }
  function setSelectedScope(scope) {
    var v = (scope === 'backtest' || scope === 'all') ? scope : 'live';
    document.querySelectorAll('input[name="journal-trade-scope"]').forEach(function (r) { r.checked = (r.value === v); });
  }

  function getSelectedColor() {
    var active = document.querySelector('.journal-color-btn.active');
    return active ? active.dataset.color : COLORS[0];
  }

  // İkon seçimi kaldırıldı (hesabı artık renk noktası / bağlı logo temsil ediyor). `icon` sütunu geriye uyumluluk için
  // korunur: düzenlemede mevcut değeri, yeni hesapta 'folder' gönderilir.
  function getSelectedIcon() {
    var id = document.getElementById('journal-id')?.value;
    var cur = id ? journalsData.find(function(x) { return x.id === id; }) : null;
    return (cur && cur.icon) || 'folder';
  }

  // Renk seçiciyle açıklamadaki örnek nokta aynı renkte kalsın
  function syncColorHintDot() {
    var dot = document.getElementById('color-hint-dot');
    if (!dot) return;
    var c = getSelectedColor();
    dot.style.setProperty('--mk', c);
    dot.style.setProperty('--mk-ring', c + '40');
  }

  var currentWizardStep = 1;
  var selectedBrokerChoice = 'none';

  function goToWizardStep(step) {
    if (step === currentWizardStep) return;

    // Oluşturma modunda adımları sırayla geçmeye zorla & validasyon yap
    if (currentModalMode === 'create') {
      if (step > 1) {
        var nameVal = (document.getElementById('journal-name')?.value || '').trim();
        if (!nameVal) {
          if (window.showToast) window.showToast(jt('journal.wiz.err_name_first', 'Lütfen önce hesap adını giriniz.'), 'warning');
          document.getElementById('journal-name')?.focus();
          return;
        }
      }

      if (step > 2) {
        var isPropOn = document.getElementById('journal-prop-toggle')?.checked;
        if (isPropOn) {
          var balSelVal = document.getElementById('prop-balance-select')?.value;
          var startBal = balSelVal === 'custom' 
            ? Number(document.getElementById('prop-custom-balance')?.value) 
            : Number(balSelVal);
          var sDate = document.getElementById('prop-start-date')?.value;
          var rTz = document.getElementById('prop-reset-tz-select')?.value;

          if (!startBal || startBal <= 0 || isNaN(startBal)) {
            if (window.showToast) window.showToast(jt('prop.err_invalid_balance', 'Lütfen geçerli bir başlangıç bakiyesi giriniz.'), 'warning');
            return;
          }
          if (!sDate) {
            if (window.showToast) window.showToast(jt('prop.err_select_start_date', 'Lütfen başlangıç tarihi seçiniz.'), 'warning');
            return;
          }
          var todayStr = (window.WwTime ? window.WwTime.todayKey() : new Date().toISOString().slice(0, 10));
          if (sDate > todayStr) {
            if (window.showToast) window.showToast(jt('prop.err_future_start_date', 'Başlangıç tarihi bugünden ileri bir tarih olamaz.'), 'warning');
            return;
          }
          if (!rTz) {
            if (window.showToast) window.showToast(jt('prop.err_select_reset_tz', 'Lütfen gün sonu / reset saat dilimini seçiniz.'), 'warning');
            return;
          }
        }
      }
    }

    currentWizardStep = step;
    updateWizardUI();
  }

  function wizardNextStep() {
    if (currentWizardStep < 3) {
      goToWizardStep(currentWizardStep + 1);
    }
  }

  function wizardPrevStep() {
    if (currentWizardStep > 1) {
      goToWizardStep(currentWizardStep - 1);
    }
  }

  function updateWizardUI() {
    [1, 2, 3].forEach(function(s) {
      var tab = document.getElementById('wizard-step-tab-' + s);
      var panel = document.getElementById('wizard-panel-' + s);
      if (!tab || !panel) return;

      tab.classList.remove('active', 'completed');
      if (s === currentWizardStep) {
        tab.classList.add('active');
        panel.classList.add('active');
      } else if (s < currentWizardStep) {
        tab.classList.add('completed');
        panel.classList.remove('active');
      } else {
        panel.classList.remove('active');
      }
    });

    var line1 = document.getElementById('wizard-step-line-1');
    var line2 = document.getElementById('wizard-step-line-2');
    if (line1) {
      if (currentWizardStep > 1) line1.classList.add('active');
      else line1.classList.remove('active');
    }
    if (line2) {
      if (currentWizardStep > 2) line2.classList.add('active');
      else line2.classList.remove('active');
    }

    var btnPrev = document.getElementById('wizard-btn-prev');
    var btnCancel = document.getElementById('wizard-btn-cancel');
    var btnNext = document.getElementById('wizard-btn-next');
    var btnSave = document.getElementById('journal-modal-save');

    if (currentModalMode === 'edit') {
      // Düzenleme modunda: her adımda serbest geçiş ve doğrudan kaydetme
      if (btnPrev) btnPrev.style.display = currentWizardStep > 1 ? 'inline-flex' : 'none';
      if (btnCancel) btnCancel.style.display = 'inline-flex';
      if (btnNext) btnNext.style.display = currentWizardStep < 3 ? 'inline-flex' : 'none';
      if (btnSave) {
        btnSave.style.display = 'inline-flex';
        btnSave.textContent = jt('journal.wiz.save_changes', 'Değişiklikleri Kaydet');
      }
    } else {
      // Oluşturma modunda: adımlı sihirbaz
      if (btnPrev) btnPrev.style.display = currentWizardStep > 1 ? 'inline-flex' : 'none';
      if (btnCancel) btnCancel.style.display = currentWizardStep === 1 ? 'inline-flex' : 'none';

      if (currentWizardStep < 3) {
        if (btnNext) btnNext.style.display = 'inline-flex';
        if (btnSave) btnSave.style.display = 'none';
      } else {
        if (btnNext) btnNext.style.display = 'none';
        if (btnSave) {
          btnSave.style.display = 'inline-flex';
          var saveTxt = (selectedBrokerChoice === 'ctrader') ? jt('journal.wiz.create_connect', 'Hesabı Oluştur & cTrader\'a Bağlan') : jt('journal.wiz.create', 'Hesabı Oluştur');
          btnSave.textContent = saveTxt;
        }
      }
    }

    if (typeof lucide !== 'undefined') lucide.createIcons();
  }

  function selectBrokerChoice(choice) {
    selectedBrokerChoice = choice;
    document.querySelectorAll('.broker-choice-card').forEach(function(c) {
      c.classList.remove('active');
    });
    var activeCard = document.getElementById('choice-' + choice);
    if (activeCard) activeCard.classList.add('active');

    var subpanel = document.getElementById('wizard-ctrader-subpanel');
    if (subpanel) {
      subpanel.style.display = (choice === 'ctrader') ? 'block' : 'none';
    }

    if (currentModalMode === 'create' && currentWizardStep === 3) {
      var btnSave = document.getElementById('journal-modal-save');
      if (btnSave) {
        btnSave.textContent = (choice === 'ctrader') ? jt('journal.wiz.create_connect', 'Hesabı Oluştur & cTrader\'a Bağlan') : jt('journal.wiz.create', 'Hesabı Oluştur');
      }
    }
  }

  function populateWizardCtraderAccounts(journalId) {
    var accounts = window._allCtraderAccounts || [];
    var journals = window._allJournalsList || [];
    var select = document.getElementById('wizard-existing-ctrader-select');
    var wrap = document.getElementById('wizard-existing-accounts-wrap');
    if (!select || !wrap) return;

    select.innerHTML = '';
    if (accounts.length > 0) {
      accounts.forEach(function(a) {
        var opt = document.createElement('option');
        opt.value = a.id;
        var tag = a.is_live ? '[LIVE] ' : '[DEMO] ';
        var label = tag + (a.broker_name || 'cTrader') + ' #' + (a.trader_login || a.ctid_trader_account_id);
        if (a.journal_id) {
          if (a.journal_id === journalId) {
            label += ' (' + jt('journal.wiz.linked_here', 'Bu deftere bağlı') + ')';
            opt.selected = true;
          } else {
            var jMatch = journals.find(function(x) { return x.id === a.journal_id; });
            label += ' (' + jt('journal.wiz.linked_other', '{name} defterine bağlı', { name: (jMatch?.name || jt('journal.wiz.other_journal', 'Başka defter')) }) + ')';
          }
        } else {
          label += ' (' + jt('journal.wiz.unlinked', 'Boşta') + ')';
        }
        opt.textContent = label;
        select.appendChild(opt);
      });
      var newOpt = document.createElement('option');
      newOpt.value = 'new_oauth';
      newOpt.textContent = jt('journal.wiz.new_oauth', '+ Yeni bir cTrader hesabı bağla (OAuth)');
      select.appendChild(newOpt);
      wrap.style.display = 'block';
    } else {
      wrap.style.display = 'none';
    }
  }

  window.unlinkCurrentJournalCtrader = async function() {
    var jId = document.getElementById('journal-id')?.value;
    if (!jId) return;
    var linkedAcc = (window._allCtraderAccounts || []).find(function(a) { return a.journal_id === jId; });
    if (!linkedAcc) return;

    if (!confirm(jt('journal.wiz.unlink_confirm', 'cTrader hesabının bu defterle olan bağlantısını kesmek istediğinize emin misiniz? (İşlemleriniz silinmez)'))) {
      return;
    }

    try {
      var res = await window.sb.rpc('unlink_ctrader_account', { p_account_id: linkedAcc.id });
      if (res && res.data && res.data.success) {
        if (window.showToast) window.showToast(jt('journal.wiz.unlink_done', 'cTrader bağlantısı kesildi.'), 'success');
        linkedAcc.journal_id = null;
        var banner = document.getElementById('wizard-already-linked-banner');
        if (banner) banner.style.display = 'none';
        var sec = document.getElementById('wizard-broker-selection-section');
        if (sec) sec.style.display = 'block';
        selectBrokerChoice('none');
        populateWizardCtraderAccounts(jId);
        renderJournals();
      } else {
        throw new Error(res?.data?.error || jt('journal.wiz.unlink_failed', 'Bağlantı kesilemedi.'));
      }
    } catch(e) {
      if (window.showToast) window.showToast(e.message, 'error');
    }
  };

  window.goToWizardStep = goToWizardStep;
  window.wizardNextStep = wizardNextStep;
  window.wizardPrevStep = wizardPrevStep;
  window.selectBrokerChoice = selectBrokerChoice;

  async function openModal(mode, id) {
    currentModalMode = mode;
    currentWizardStep = 1;
    selectedBrokerChoice = 'none';

    var titleEl = document.getElementById('journal-modal-title');
    var idEl = document.getElementById('journal-id');
    var nameEl = document.getElementById('journal-name');
    var descEl = document.getElementById('journal-desc');
    var propToggle = document.getElementById('journal-prop-toggle');
    var propSection = document.getElementById('journal-prop-section');
    var inactiveCard = document.getElementById('prop-inactive-card');
    var propAccountIdEl = document.getElementById('prop-account-id');
    var propQuotaWarn = document.getElementById('prop-quota-warning');
    var propBalSel = document.getElementById('prop-balance-select');
    var propCustomBal = document.getElementById('prop-custom-balance');
    var propStartDate = document.getElementById('prop-start-date');
    var propTmplSel = document.getElementById('prop-template-select');
    var propPhaseSel = document.getElementById('prop-phase-select');
    var propTzSel = document.getElementById('prop-reset-tz-select');

    document.querySelectorAll('.journal-color-btn').forEach(b => b.classList.remove('active'));
    if (propQuotaWarn) propQuotaWarn.style.display = 'none';
    if (propCustomBal) propCustomBal.style.display = 'none';
    if (propAccountIdEl) propAccountIdEl.value = '';

    var linkedBanner = document.getElementById('wizard-already-linked-banner');
    var brokerSec = document.getElementById('wizard-broker-selection-section');

    if (mode === 'create') {
      titleEl.textContent = i18n.t('journal.create_title');
      titleEl.setAttribute('data-i18n', 'journal.create_title');
      idEl.value = '';
      nameEl.value = '';
      descEl.value = '';
      document.querySelector('.journal-color-btn[data-color="' + COLORS[0] + '"]')?.classList.add('active');
      syncColorHintDot();
      setSelectedScope('live');

      if (propToggle) {
        propToggle.checked = false;
        propToggle.disabled = false;
      }
      if (propSection) propSection.classList.remove('active');
      if (inactiveCard) inactiveCard.style.display = 'block';
      if (propStartDate) {
        propStartDate.value = (window.WwTime ? window.WwTime.todayKey() : new Date().toISOString().slice(0, 10));
        propStartDate.max = (window.WwTime ? window.WwTime.todayKey() : new Date().toISOString().slice(0, 10));
      }
      if (propBalSel) propBalSel.value = '100000';
      
      var timeSlider = document.getElementById('prop-time-shift');
      var timeNum = document.getElementById('prop-time-shift-num');
      var timeDisplay = document.getElementById('prop-time-shift-display');
      if (timeSlider) timeSlider.value = 0;
      if (timeNum) timeNum.value = 0;
      if (timeDisplay) timeDisplay.textContent = hoursText(0);

      var advBox = document.getElementById('prop-advanced-rules-box');
      if (advBox) advBox.open = false;

      if (propTmplSel) {
        propTmplSel.value = 'ftmo-2step';
        onPropTemplateChange();
      }
      updateTimeShiftPreview();

      // Step 3 hazırlığı
      if (linkedBanner) linkedBanner.style.display = 'none';
      if (brokerSec) brokerSec.style.display = 'block';
      selectBrokerChoice('none');
      populateWizardCtraderAccounts(null);

      // Kota kontrolü
      if (window.PropService) {
        window.PropService.checkPropAccountQuota().then(function(quota) {
          if (!quota.canCreate && propQuotaWarn) {
            propQuotaWarn.style.display = 'flex';
            var desc = document.getElementById('prop-quota-desc');
            if (desc) {
              desc.textContent = quota.isPro 
                ? (window.i18n ? window.i18n.t('prop.quota_pro_desc') : 'Pro planda maksimum 10 aktif prop hesabı açabilirsiniz.') 
                : (window.i18n ? window.i18n.t('prop.quota_desc') : 'Free planda yalnızca 1 aktif prop hesabı açabilirsiniz. Daha fazlası için Pro\'ya yükseltin.');
            }
          }
        }).catch(function() {});
      }

    } else {
      // DÜZENLEME MODU (EDIT)
      titleEl.textContent = i18n.t('journal.edit_title');
      titleEl.setAttribute('data-i18n', 'journal.edit_title');
      var j = journalsData.find(x => x.id === id);
      if (j) {
        idEl.value = j.id;
        nameEl.value = j.name;
        descEl.value = j.description || '';
        setSelectedScope(j.trade_scope);
        
        var cBtn = document.querySelector('.journal-color-btn[data-color="' + (j.color || COLORS[0]) + '"]');
        if (cBtn) cBtn.classList.add('active');
        else document.querySelector('.journal-color-btn[data-color="' + COLORS[0] + '"]')?.classList.add('active');
        
        syncColorHintDot();

        // Prop hesabı durumu
        if (propToggle) propToggle.disabled = false;
        if (window.PropService) {
          try {
            var propAcc = await window.PropService.getPropAccountByJournalId(j.id);
            if (propAcc) {
              if (inactiveCard) inactiveCard.style.display = 'none';
              if (propAccountIdEl) propAccountIdEl.value = propAcc.id;
              if (propToggle) propToggle.checked = true;
              if (propSection) propSection.classList.add('active');

              if (propTmplSel && propAcc.template_key) {
                propTmplSel.value = propAcc.template_key;
                onPropTemplateChange();
              }
              if (propPhaseSel && propAcc.phase_index !== undefined) {
                propPhaseSel.value = propAcc.phase_index;
              }
              if (propStartDate && propAcc.start_date) {
                propStartDate.value = String(propAcc.start_date).slice(0, 10);
                propStartDate.max = (window.WwTime ? window.WwTime.todayKey() : new Date().toISOString().slice(0, 10));
              }
              if (propTzSel && propAcc.reset_tz) {
                propTzSel.value = propAcc.reset_tz;
              }

              var timeSlider = document.getElementById('prop-time-shift');
              var timeNum = document.getElementById('prop-time-shift-num');
              var timeDisplay = document.getElementById('prop-time-shift-display');
              var shiftVal = propAcc.time_shift_hours !== undefined ? propAcc.time_shift_hours : 0;
              if (timeSlider) timeSlider.value = shiftVal;
              if (timeNum) timeNum.value = shiftVal;
              if (timeDisplay) timeDisplay.textContent = hoursText(shiftVal);

              var balVal = String(Number(propAcc.starting_balance) || 100000);
              var stdVals = ['5000', '10000', '25000', '50000', '100000', '200000'];
              if (stdVals.includes(balVal)) {
                if (propBalSel) propBalSel.value = balVal;
                if (propCustomBal) propCustomBal.style.display = 'none';
              } else {
                if (propBalSel) propBalSel.value = 'custom';
                if (propCustomBal) {
                  propCustomBal.style.display = 'block';
                  propCustomBal.value = balVal;
                }
              }

              if (propAcc.rules) {
                syncAdvancedRulesInputs(propAcc.rules);
              }
              checkIsCustomized();
              updateTimeShiftPreview(j.id);
            } else {
              if (inactiveCard) inactiveCard.style.display = 'block';
              if (propToggle) propToggle.checked = false;
              if (propSection) propSection.classList.remove('active');
            }
          } catch (propErr) {
            if (inactiveCard) inactiveCard.style.display = 'block';
            if (propToggle) propToggle.checked = false;
            if (propSection) propSection.classList.remove('active');
          }
        }

        // Step 3 Broker durumu (Düzenleme modu)
        var ctAcc = (window._allCtraderAccounts || []).find(function(a) { return a.journal_id === j.id; });
        if (ctAcc) {
          if (linkedBanner) {
            linkedBanner.style.display = 'block';
            var titleLinked = document.getElementById('wizard-linked-title');
            if (titleLinked) { titleLinked.removeAttribute('data-i18n'); titleLinked.textContent = 'cTrader ' + (ctAcc.is_live ? 'Live' : 'Demo') + ' (#' + (ctAcc.trader_login || ctAcc.ctid_trader_account_id) + ')'; }
            var subLinked = document.getElementById('wizard-linked-sub');
            if (subLinked) { subLinked.removeAttribute('data-i18n'); subLinked.textContent = jt('journal.wiz.linked_sub', '{broker} • Son senkron: {time}', { broker: (ctAcc.broker_name || 'cTrader'), time: (ctAcc.last_sync_at ? new Date(ctAcc.last_sync_at).toLocaleTimeString(uiLocale()) : jt('journal.wiz.never_synced', 'Henüz yapılmadı')) }); }
            var dotLinked = document.getElementById('wizard-linked-dot');
            if (dotLinked) dotLinked.className = 'ctrader-status-dot ' + (ctAcc.is_live ? 'live' : 'demo');
          }
          if (brokerSec) brokerSec.style.display = 'none';
        } else {
          if (linkedBanner) linkedBanner.style.display = 'none';
          if (brokerSec) brokerSec.style.display = 'block';
          selectBrokerChoice('none');
          populateWizardCtraderAccounts(j.id);
        }
      }
    }
    
    currentWizardStep = 1;
    updateWizardUI();

    if (window.i18n && window.i18n.apply) window.i18n.apply();
    document.getElementById('journal-modal').classList.add('active');
    if (typeof lucide !== 'undefined') lucide.createIcons();
  }

  function closeModal() {
    document.getElementById('journal-modal').classList.remove('active');
  }
  
  function showUpgradeModal() {
    wwLog.log('Show upgrade modal');
    if (typeof window.openUpgradeModal === 'function') {
      window.openUpgradeModal({ feature: 'journal' });
    } else {
      window.location.href = '/settings.html#panel-plan';
    }
  }
  
  var _isRenderingJournals = false;

  async function ensureDependencies() {
    var attempts = 0;
    while ((!window.sb || !window.journal || typeof window.journal.listJournals !== 'function') && attempts < 25) {
      await new Promise(function(r) { setTimeout(r, 30); });
      attempts++;
    }
    return Boolean(window.sb && window.journal && typeof window.journal.listJournals === 'function');
  }

  async function getAuthenticatedUser() {
    if (window.location.search.includes('test=')) {
      return { id: 'mock-test-user', email: 'test@wawe.com' };
    }
    if (window.currentUser && window.currentUser.id) return window.currentUser;
    if (window.__wwUserProfile && window.__wwUserProfile.id) return window.__wwUserProfile;

    try {
      var cachedProf = sessionStorage.getItem('ww_cached_profile');
      if (cachedProf) {
        var cp = JSON.parse(cachedProf);
        if (cp && cp.id) {
          window.currentUser = cp;
          return cp;
        }
      }
    } catch (e) {}

    if (typeof window.requireAuth === 'function') {
      try {
        var user = await window.requireAuth();
        if (user) {
          window.currentUser = user;
          return user;
        }
      } catch (e) {}
    }

    if (window.sb && window.sb.auth) {
      try {
        var sess = await window.sb.auth.getSession();
        if (sess && sess.data && sess.data.session && sess.data.session.user) {
          window.currentUser = sess.data.session.user;
          return sess.data.session.user;
        }
      } catch (e) {}
    }

    return null;
  }

  function drawJournalsGrid(list, propAccountsMap, ctraderAccountsMap, isPrem, profile) {
    journalsData = list || [];
    var count = journalsData.length;
    var maxJournals = (count > 0 && journalsData[0].max_journals !== undefined) 
                      ? Math.max(journalsData[0].max_journals, isPrem ? 10 : 2) 
                      : Math.max(profile?.max_journals || 0, isPrem ? 10 : 2);
    
    var usageTmpl = (i18n && typeof i18n.t === 'function') ? i18n.t('journal.usage') : '{used} / {limit} hesap';
    var usageTxt = usageTmpl.replace('{used}', count).replace('{limit}', maxJournals);
    var usageEl = document.getElementById('usage-text');
    if (usageEl) usageEl.innerHTML = '<strong>' + usageTxt + '</strong>';
    
    var btnNew = document.getElementById('btn-new-journal');
    if (btnNew) {
      if (count >= maxJournals) {
        btnNew.onclick = showUpgradeModal;
        btnNew.title = (i18n && typeof i18n.t === 'function') ? i18n.t('journal.err_quota') : 'Kota dolu';
      } else {
        btnNew.onclick = () => openModal('create');
        btnNew.title = '';
      }
