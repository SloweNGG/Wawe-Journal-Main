---
// src/pages/journals.astro
import Layout from '../layouts/Layout.astro';
---
<Layout lang="en" bodyClass="journals-page" spa={true}>
<Fragment slot="head">
  <link rel="stylesheet" href="/interface/journals/css/journals.css?v=1792800100" />
  <title data-i18n="journal.title">Hesaplarım – Wawe Journal</title>
    

  <link rel="preload" href="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.117.3" as="script" />
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.117.3" is:inline defer></script>
  <script src="/config.js" is:inline defer></script>
  <script src="/i18n.js?v=1792300000" is:inline defer></script>
  <script type="module" src="/src/bundle.js" is:inline defer></script>
</Fragment>

<main class="main dashboard-main">
  <div class="page-header">
    <div>
      <h1 data-i18n="journal.title">Hesaplarım</h1>
      <p class="subtitle" data-i18n="journal.subtitle">İşlemlerini hesaplara ayır, performansı takip et</p>
    </div>
    <div class="header-actions">
      <button class="btn-new-journal" id="btn-new-journal">
        <i data-lucide="plus" style="width:16px;height:16px;margin-right:4px;vertical-align:middle;"></i>
        <span data-i18n="journal.new_button">Yeni Hesap</span>
      </button>
    </div>
  </div>
  
  <div class="journals-usage-bar" id="usage-text">
    —
  </div>
  
  <div class="journals-grid" id="journals-grid">
    <!-- Skeleton -->
    <div class="journal-card" style="opacity:0.5;">
      <div class="journal-color-bar" style="background:var(--border);"></div>
      <div class="journal-card-top">
        <div class="journal-icon-wrap" style="background:var(--border);width:32px;height:32px;border-radius:8px;"></div>
      </div>
      <div class="journal-body">
        <div style="height:20px;width:60%;background:var(--border);border-radius:4px;margin-bottom:8px;"></div>
        <div style="height:14px;width:90%;background:var(--border);border-radius:4px;"></div>
      </div>
    </div>
  </div>
  <script is:inline>
    (function() {
      try {
        var rawJ = localStorage.getItem('ww_cached_journals_list');
        if (rawJ) {
          var list = JSON.parse(rawJ);
          if (Array.isArray(list) && list.length > 0) {
            var grid = document.getElementById('journals-grid');
            if (grid) {
              var cur = localStorage.getItem('ww_currency') || '$';
              grid.innerHTML = list.map(function(j) {
                var pnl = Number(j.total_pnl || 0);
                var pnlClass = pnl > 0 ? 'positive' : (pnl < 0 ? 'negative' : 'neutral');
                var pnlFormatted = (pnl < 0 ? '-' : (pnl > 0 ? '+' : '')) + cur + Math.abs(pnl).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                var defaultBadge = j.is_default ? '<div class="journal-card-badge">★ Varsayılan</div>' : '';
                var safeName = (j.name || '').replace(/[&<>"']/g, function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});
                var safeDesc = (j.description || '').replace(/[&<>"']/g, function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});
                var trades = (j.trade_count || 0) + ' işlem';
                return '<div class="journal-card" data-id="' + j.id + '" style="--journal-color:' + (j.color || '#7c6dfa') + '">' +
                  '<div class="journal-card-top">' +
                    '<div class="journal-icon-wrap">' + (window.WwJournalMark ? window.WwJournalMark.forJournal(j, { dotSize: 14 }) : '') + '</div>' +
                    '<div class="journal-card-actions">' + defaultBadge + '</div>' +
                  '</div>' +
                  '<div class="journal-card-name" title="' + safeName + '">' + safeName + '</div>' +
                  '<div class="journal-card-desc">' + safeDesc + '</div>' +
                  '<div class="journal-card-stats" style="margin-top:auto;padding-top:0.75rem;">' +
                    '<span>' + trades + '</span>' +
                    '<span class="journal-card-pnl ' + pnlClass + '">' + pnlFormatted + '</span>' +
                  '</div>' +
                '</div>';
              }).join('');
            }
          }
        }
      } catch(e) {}
    })();
  </script>
</main>

<!-- Create / Edit Modal (3 Adımlı Wizard) -->
<div class="journal-modal-overlay" id="journal-modal">
  <div class="journal-modal" style="max-width: 680px;">
    <div class="journal-modal-header">
      <h3 id="journal-modal-title" data-i18n="journal.create_title">Yeni Hesap Oluştur</h3>
      <button class="journal-modal-close" onclick="closeModal()"><i data-lucide="x"></i></button>
    </div>

    <!-- ⭐ ADIM GÖSTERGESİ (WIZARD STEPS) -->
    <div class="journal-wizard-steps" id="wizard-steps-header">
      <div class="wizard-step-item active" data-step="1" id="wizard-step-tab-1" onclick="goToWizardStep(1)">
        <span class="step-num">1</span>
        <span class="step-title" data-i18n="journal.wiz.step_account">Hesap Bilgileri</span>
      </div>
      <div class="wizard-step-line" id="wizard-step-line-1"></div>
      <div class="wizard-step-item" data-step="2" id="wizard-step-tab-2" onclick="goToWizardStep(2)">
        <span class="step-num">2</span>
        <span class="step-title" data-i18n="journal.wiz.step_prop">Prop Takip</span>
      </div>
      <div class="wizard-step-line" id="wizard-step-line-2"></div>
      <div class="wizard-step-item" data-step="3" id="wizard-step-tab-3" onclick="goToWizardStep(3)">
        <span class="step-num">3</span>
        <span class="step-title" data-i18n="journal.wiz.step_broker">Broker Bağla</span>
      </div>
    </div>

    <div class="journal-modal-body" style="padding: 1.5rem;">
      <input type="hidden" id="journal-id" value="">
      
      <!-- ==========================================
           ADIM 1: TEMEL HESAP BİLGİLERİ
           ========================================== -->
      <div class="wizard-step-panel active" id="wizard-panel-1">
        <div class="journal-col-heading" style="margin-bottom:1.25rem;">
          <i data-lucide="wallet"></i>
          <span data-i18n="journal.wiz.heading_account">Temel Hesap Bilgileri</span>
        </div>

        <div class="journal-field">
          <label data-i18n="journal.name_label">Hesap Adı *</label>
          <input type="text" id="journal-name" maxlength="60" data-i18n-placeholder="journal.name_placeholder" placeholder="Örn: Scalping, Swing, FTMO Challenge">
        </div>
        
        <div class="journal-field">
          <label data-i18n="journal.description_label">Açıklama (opsiyonel)</label>
          <textarea id="journal-desc" rows="2" maxlength="200" data-i18n-placeholder="journal.wiz.desc_placeholder" placeholder="Bu hesabın stratejisi veya hedefleri..."></textarea>
        </div>
        
        <div class="journal-field">
          <label data-i18n="journal.color_label">Renk</label>
          <div class="journal-color-picker" id="color-grid">
            <!-- JS fills -->
          </div>
          <div class="journal-color-hint" id="color-hint">
            <span class="ww-mark ww-mark--dot" id="color-hint-dot" style="--mk-size:9px;--mk:#7c6dfa;--mk-ring:#7c6dfa40"><span class="ww-mark-dot"></span></span>
            <span data-i18n="journal.wiz.color_hint">Hesabın listelerde görünen noktası. Prop firma veya broker bağlı hesapların noktası yanıp söner.</span>
          </div>
        </div>

        <!-- Hangi işlemler görünsün? (journals.trade_scope) -->
        <div class="journal-field journal-scope-field" style="margin-bottom:0;" role="radiogroup" aria-labelledby="journal-scope-label">
          <label id="journal-scope-label" data-i18n="journal.scope_label">Hangi işlemler görünsün?</label>
          <div class="journal-scope-options">
            <label class="journal-scope-opt">
              <input type="radio" name="journal-trade-scope" value="live" checked>
              <span class="journal-scope-opt-body">
                <span class="journal-scope-opt-title" data-i18n="journal.scope_live">Sadece normal işlemler</span>
                <span class="journal-scope-opt-desc" data-i18n="journal.scope_live_desc">Backtest işlemleri bu hesapta gösterilmez (varsayılan).</span>
              </span>
            </label>
            <label class="journal-scope-opt">
              <input type="radio" name="journal-trade-scope" value="backtest">
              <span class="journal-scope-opt-body">
                <span class="journal-scope-opt-title" data-i18n="journal.scope_backtest">Sadece backtest işlemleri</span>
                <span class="journal-scope-opt-desc" data-i18n="journal.scope_backtest_desc">Yalnızca bu hesaba bağlı backtest hesaplarından aktarılan işlemler.</span>
              </span>
            </label>
            <label class="journal-scope-opt">
              <input type="radio" name="journal-trade-scope" value="all">
              <span class="journal-scope-opt-body">
                <span class="journal-scope-opt-title" data-i18n="journal.scope_all">İkisi de</span>
                <span class="journal-scope-opt-desc" data-i18n="journal.scope_all_desc">Normal ve backtest işlemleri birlikte.</span>
              </span>
            </label>
          </div>
          <div class="journal-field-hint" data-i18n="journal.scope_hint">Panel, analitik, takvim, stratejiler, PDF raporu, hesap kartlarındaki kâr/zarar ve Trades sayfasının varsayılan filtresi bunu kullanır. Prop takip, cTrader senkronu ve bildirimler her zaman yalnızca normal işlemleri sayar.</div>
        </div>
      </div>

      <!-- ==========================================
           ADIM 2: PROP FIRM TAKİP AYARLARI
           ========================================== -->
      <div class="wizard-step-panel" id="wizard-panel-2">
        <div class="journal-col-heading" style="margin-bottom:1.25rem;">
          <i data-lucide="award"></i>
          <span data-i18n="journal.wiz.heading_prop">Prop Firm & Takip Modu</span>
        </div>

        <!-- PROP FIRM MODU TOGGLE -->
        <div class="journal-prop-toggle-card">
          <div class="journal-prop-toggle-info">
            <div>
              <div class="journal-prop-toggle-title">
                <span data-i18n="prop.mode">Prop Firm Modu</span>
                <span class="journal-prop-tag" data-i18n="prop.evaluation">DEĞERLENDİRME</span>
              </div>
              <div class="journal-prop-toggle-sub" data-i18n="prop.toggle_sub">Kuralları, günlük kaybı ve hedefleri otomatik takip et</div>
            </div>
          </div>
          <label class="journal-switch" for="journal-prop-toggle">
            <input type="checkbox" id="journal-prop-toggle">
            <span class="journal-slider"></span>
          </label>
        </div>

        <!-- Quota Warning if limit reached -->
        <div id="prop-quota-warning" class="journal-prop-alert danger" style="display:none;">
          <div>
            <strong data-i18n="prop.quota_title">Prop Hesabı Kotası Doldu</strong>
            <div id="prop-quota-desc" style="font-size:0.75rem;margin-top:2px;" data-i18n="prop.quota_desc">Free planda 1 aktif prop hesabı oluşturabilirsiniz. Daha fazla hesap için Pro'ya yükseltin.</div>
            <a href="/settings.html#panel-plan" style="color:#fff;text-decoration:underline;font-weight:600;font-size:0.75rem;display:inline-block;margin-top:4px;" data-i18n="prop.upgrade_plan">Planı Yükselt</a>
          </div>
        </div>

        <!-- Prop Inactive Info Box -->
        <div id="prop-inactive-card" class="journal-prop-inactive-box">
          <div class="journal-prop-inactive-icon"><i data-lucide="shield-check"></i></div>
          <div class="journal-prop-inactive-title" data-i18n="prop.standard_mode_title">Standart Portföy Hesabı</div>
          <p class="journal-prop-inactive-desc" data-i18n="prop.standard_mode_desc">Bu hesapta kural ve kayıp limiti olmadan tüm işlemlerinizi serbestçe takip edebilirsiniz.</p>
          <div class="journal-prop-inactive-tip" data-i18n="prop.standard_mode_tip">💡 FTMO, FundedNext gibi değerlendirme kurallarını izlemek için yukarıdan Prop Firm Modu'nu açın.</div>
        </div>

        <!-- Prop Settings Section (shown when toggle is on) -->
        <div id="journal-prop-section" class="journal-prop-section">
          <input type="hidden" id="prop-account-id" value="">

          <!-- Şablon & Faz -->
          <div class="journal-prop-row">
            <div class="journal-field" style="margin-bottom:0;">
              <label data-i18n="prop.firm_template">Prop Firması / Şablon</label>
              <select id="prop-template-select" class="journal-prop-select">
                <!-- JS fills from PropTemplates -->
              </select>
            </div>
            <div class="journal-field" style="margin-bottom:0;">
              <label data-i18n="prop.phase">Aşama / Faz</label>
              <select id="prop-phase-select" class="journal-prop-select">
                <!-- JS fills based on template -->
              </select>
            </div>
          </div>

          <!-- Bakiye & Başlangıç Tarihi -->
          <div class="journal-prop-row">
            <div class="journal-field" style="margin-bottom:0;">
              <label data-i18n="prop.starting_balance">Başlangıç Bakiyesi ($)</label>
              <select id="prop-balance-select" class="journal-prop-select">
                <option value="5000">5.000 $</option>
                <option value="10000">10.000 $</option>
                <option value="25000">25.000 $</option>
                <option value="50000">50.000 $</option>
                <option value="100000" selected>100.000 $</option>
                <option value="200000">200.000 $</option>
                <option value="custom" data-i18n="prop.custom_amount">Özel Tutar...</option>
              </select>
              <input type="number" id="prop-custom-balance" class="journal-prop-input" placeholder="Örn: 150000" data-i18n-placeholder="prop.custom_placeholder" style="display:none;margin-top:6px;" min="100">
            </div>
            <div class="journal-field" style="margin-bottom:0;">
              <label data-i18n="prop.start_date">Başlangıç Tarihi</label>
              <input type="date" id="prop-start-date" class="journal-prop-input">
              <div class="journal-field-hint" style="font-size:0.75rem;color:var(--muted);margin-top:4px;" data-i18n="prop.start_date_hint">Challenge'a başladığın günü gir (öncesindeki işlemler sayılmaz).</div>
            </div>
          </div>

          <!-- Reset Saat Dilimi -->
          <div class="journal-field" style="margin-bottom:0.75rem;">
            <label data-i18n="prop.reset_tz">Gün Sonu / Reset Saat Dilimi</label>
            <select id="prop-reset-tz-select" class="journal-prop-select">
              <option value="" data-i18n="prop.tz_select">-- Saat Dilimi Seçiniz --</option>
              <option value="Europe/Prague" data-i18n="prop.tz_prague">Europe/Prague (FTMO — CET/CEST Gece Yarısı)</option>
              <option value="Etc/GMT-3" data-i18n="prop.tz_gmt3">Etc/GMT-3 (FundingPips — UTC+3 Gece Yarısı)</option>
              <option value="Europe/Athens" data-i18n="prop.tz_athens">Europe/Athens (FundedNext — MT5 Sunucu Saati)</option>
              <option value="UTC" data-i18n="prop.tz_utc">UTC (Evrensel Gece Yarısı)</option>
              <option value="America/New_York" data-i18n="prop.tz_ny">America/New_York (ABD Doğu Saati)</option>
              <option value="Europe/London" data-i18n="prop.tz_london">Europe/London (GMT/BST)</option>
              <option value="Asia/Dubai" data-i18n="prop.tz_dubai">Asia/Dubai (GST - UTC+4)</option>
            </select>
          </div>

          <!-- Broker Saat Kaydırma -->
          <div class="journal-field" style="margin-bottom:0.75rem;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;">
              <label data-i18n="prop.time_shift_hours" style="margin-bottom:0;">Saat Kaydırma (Time Shift)</label>
              <span id="prop-time-shift-display" style="font-weight:600;font-size:0.8rem;color:var(--accent);">0</span>
            </div>
            <div style="display:flex;align-items:center;gap:0.75rem;">
              <input type="range" id="prop-time-shift" min="-14" max="14" step="0.5" value="0" class="journal-prop-slider" style="flex:1;">
              <input type="number" id="prop-time-shift-num" min="-14" max="14" step="0.5" value="0" class="journal-prop-input" style="width:65px;text-align:center;padding:0.35rem 0.5rem;">
            </div>
            <div class="journal-field-hint" style="font-size:0.75rem;color:var(--muted);margin-top:4px;" data-i18n="prop.time_shift_hint">Broker sunucu saatiniz ile yerel saat arasındaki fark (-14 ile +14).</div>
            
            <div id="prop-time-shift-preview" class="journal-prop-time-preview">
              <div class="journal-prop-time-preview-title" id="prop-time-shift-preview-title" data-i18n="prop.time_shift_preview_title">Son 3 işlemin saati önizlemesi:</div>
              <div id="prop-time-shift-preview-list" class="journal-prop-time-preview-list">
                <div data-i18n="prop.time_shift_no_trades">Henüz işlem bulunmuyor (örnek önizleme: 14:00 ➔ 16:00 UTC+2)</div>
              </div>
            </div>
          </div>

          <!-- Uyarılar -->
          <div id="prop-unverified-alert" class="journal-prop-alert warning" style="display:none;margin-bottom:0.75rem;">
            <span data-i18n="prop.unverified_warning">Bu fazın kuralları doğrulanmadı, firmanın sitesinden kontrol et.</span>
          </div>
          <div id="prop-tz-required-alert" class="journal-prop-alert warning" style="display:none;margin-bottom:0.75rem;">
            <span data-i18n="prop.tz_required_warning">Saat Dilimi Seçimi Zorunludur: MT5 hesabınızın server saat dilimini seçiniz (ör. Europe/Athens).</span>
          </div>
          <div id="prop-estimated-alert" class="journal-prop-alert info" style="display:none;margin-bottom:0.75rem;">
            <span data-i18n="prop.estimated_warning">Tahmini Kural Uyarısı: Bu firmanın kuralları equity bazlıdır; kapanmış işlemlerle tahmini hesaplanacaktır.</span>
          </div>

          <!-- Gelişmiş Kural Ayarları -->
          <details id="prop-advanced-rules-box" class="journal-custom-rules-box" style="margin-top:0.75rem;cursor:pointer;">
            <summary class="journal-custom-rules-header" style="display:flex;justify-content:space-between;align-items:center;user-select:none;">
              <span data-i18n="prop.advanced_rules">Gelişmiş Kural Ayarları</span>
              <span id="prop-customized-badge" style="display:none;font-size:0.7rem;font-weight:600;padding:2px 8px;border-radius:12px;background:rgba(124,109,250,0.2);color:var(--accent);border:1px solid rgba(124,109,250,0.3);" data-i18n="prop.customized">Özelleştirildi</span>
            </summary>
            <div class="journal-custom-grid" style="margin-top:0.75rem;cursor:default;">
              <div class="journal-field" style="margin-bottom:0;">
                <label data-i18n="prop.profit_target">Kâr Hedefi (%)</label>
                <input type="number" id="prop-rule-target" class="journal-prop-input" value="10" step="0.5" min="0">
              </div>
              <div class="journal-field" style="margin-bottom:0;">
                <label data-i18n="prop.daily_loss">Günlük Kayıp (%)</label>
                <input type="number" id="prop-rule-daily" class="journal-prop-input" value="5" step="0.5" min="0">
              </div>
              <div class="journal-field" style="margin-bottom:0;">
                <label data-i18n="prop.daily_loss_base">Günlük Kayıp Tabanı</label>
                <select id="prop-rule-daily-base" class="journal-prop-select">
                  <option value="initial_balance" data-i18n="prop.base_initial">Başlangıç Bakiyesi</option>
                  <option value="day_start_balance" data-i18n="prop.base_day_start">Gün Başı Bakiyesi</option>
                </select>
              </div>
              <div class="journal-field" style="margin-bottom:0;">
                <label data-i18n="prop.max_loss">Maksimum Kayıp (%)</label>
                <input type="number" id="prop-rule-max" class="journal-prop-input" value="10" step="0.5" min="0">
              </div>
              <div class="journal-field" style="margin-bottom:0;">
                <label data-i18n="prop.max_loss_type">Maksimum Kayıp Tipi</label>
                <select id="prop-rule-max-type" class="journal-prop-select">
                  <option value="static" data-i18n="prop.type_static">Sabit (Static)</option>
                  <option value="eod_trailing" data-i18n="prop.type_trailing_eod">Gün Sonu Takip Eden (Trailing EOD)</option>
                </select>
              </div>
              <div class="journal-field" style="margin-bottom:0;">
                <label data-i18n="prop.min_trading_days">Min İşlem Günü</label>
                <input type="number" id="prop-rule-min-days" class="journal-prop-input" value="4" min="0">
              </div>
              <div class="journal-field" style="margin-bottom:0;">
                <label data-i18n="prop.consistency_rule">Tutarlılık Kuralı (%)</label>
                <input type="number" id="prop-rule-consistency" class="journal-prop-input" data-i18n-placeholder="prop.consistency_placeholder" placeholder="Yok (Örn: 50)" step="1" min="0" max="100">
              </div>
            </div>
          </details>
        </div>
      </div>

      <!-- ==========================================
           ADIM 3: BROKER ENTEGRASYONU (İSTEĞE BAĞLI)
           ========================================== -->
      <div class="wizard-step-panel" id="wizard-panel-3">
        <div class="journal-col-heading" style="margin-bottom:0.75rem;">
          <i data-lucide="link-2"></i>
          <span data-i18n="journal.wiz.heading_broker">Broker Entegrasyonu (İsteğe Bağlı)</span>
        </div>
        <p class="journal-broker-intro" data-i18n="journal.wiz.broker_intro">
          Bu hesaba cTrader bağlayarak kapanmış işlemlerinizi tek tıkla senkronize edebilirsiniz. İsterseniz bu adımı atlayıp daha sonra da bağlayabilirsiniz.
        </p>

        <!-- Düzenleme Modunda: Zaten Bağlı Olan cTrader Hesabı Bilgisi -->
        <div id="wizard-already-linked-banner" class="journal-linked-banner" style="display:none;">
          <div class="journal-linked-banner-row">
            <div class="journal-linked-banner-info">
              <span class="ctrader-status-dot live" id="wizard-linked-dot"></span>
              <div>
                <div class="journal-linked-banner-title">
                  <span id="wizard-linked-title" data-i18n="journal.wiz.linked_title_default">cTrader Bağlı</span>
                  <span class="journal-linked-banner-tag" data-i18n="journal.wiz.linked_active">Aktif</span>
                </div>
                <div class="journal-linked-banner-sub" id="wizard-linked-sub" data-i18n="journal.wiz.linked_sub_default">Otomatik senkronizasyon açık.</div>
              </div>
            </div>
            <button type="button" class="journal-btn-cancel journal-btn-unlink" onclick="unlinkCurrentJournalCtrader()" data-i18n="journal.wiz.unlink_btn">Bağlantıyı Kes</button>
          </div>
        </div>

        <div id="wizard-broker-selection-section">
          <!-- Broker Kartları Seçimi -->
          <div class="broker-choice-grid">
            <!-- Seçenek A: Manuel / Bağlama -->
            <div class="broker-choice-card active" id="choice-none" onclick="selectBrokerChoice('none')">
              <div class="broker-choice-icon">
