---
import PageLayout from '../layouts/PageLayout.astro';
---
<PageLayout title="İletişim – Wawe Journal">
  <div class="page-card">
    <h1 data-i18n="contact.title">İletişim</h1>

    <div class="contact-grid">
      <div class="contact-info">
        <h2 data-i18n="contact.get_in_touch">Bize Ulaşın</h2>

        <div class="contact-item">
          <span class="contact-icon">📧</span>
          <div>
            <strong data-i18n="contact.email_label">E-posta</strong><br />
            <a href="mailto:destek@wawedev.com">destek@wawedev.com</a>
          </div>
        </div>

        <div class="contact-item">
          <span class="contact-icon">📍</span>
          <div>
            <strong data-i18n="contact.address_label">Adres</strong><br />
            <span>EU Finland</span>
          </div>
        </div>

        <div class="contact-item">
          <span class="contact-icon">🕒</span>
          <div>
            <strong data-i18n="contact.hours_label">Çalışma Saatleri</strong><br />
            <span data-i18n="contact.hours_weekdays">Hafta içi: 09:00 - 18:00</span><br />
            <span data-i18n="contact.hours_weekend">Hafta sonu: Kapalı</span>
          </div>
        </div>

        <div class="contact-social">
          <h3 data-i18n="contact.social_media">Sosyal Medya</h3>
          <div class="social-links">
            <a href="https://www.instagram.com/wawejournal/" target="_blank" class="social-btn">📷 Instagram</a>
            <a href="https://youtube.com/@wawedev" target="_blank" class="social-btn">🎥 YouTube</a>
          </div>
        </div>
      </div>

      <div class="contact-map">
        <h2 data-i18n="contact.location_title">Konum</h2>
        <div class="map-placeholder">
          <svg width="100%" height="200" viewBox="0 0 400 200" style="background:var(--bg);border-radius:12px;">
            <rect width="400" height="200" fill="var(--surface)" stroke="var(--border)" stroke-width="1"/>
            <circle cx="200" cy="100" r="8" fill="var(--accent)"/>
            <text x="200" y="130" text-anchor="middle" fill="var(--muted)" font-size="11">EU Finland</text>
            <path d="M200,100 L200,80 M200,100 L220,100" stroke="var(--accent)" stroke-width="2"/>
          </svg>
          <p class="map-note">📍 EU Finland</p>
        </div>
      </div>
    </div>

    <div class="support-note">
      <h3 data-i18n="contact.support_title">Destek Talepleri</h3>
      <p data-i18n="contact.support_desc">Teknik destek, hesap sorunları veya önerileriniz için bize e-posta gönderebilirsiniz. En kısa sürede dönüş yapacağız.</p>
      <p><strong data-i18n="contact.support_reply">Ortalama yanıt süresi: 24 saat (hafta içi)</strong></p>
    </div>

    <div class="back-link">
      <a href="/" class="btn btn-ghost" data-i18n="common.back_home">← Ana Sayfaya Dön</a>
    </div>
  </div>
</PageLayout>
