---
import PageLayout from '../layouts/PageLayout.astro';
---
<PageLayout title="Contact Us – Wawe Journal Support and Feedback" description="Get help with your Wawe Journal account, report a bug or suggest a feature. We reply within 24 hours on weekdays.">
  <section class="page-hero">
    <div class="wrap">
      <span class="pill anim" style="--d:.05s"><b data-i18n="contact.get_in_touch">Get in Touch</b></span>
      <h1 class="anim" style="--d:.15s" data-i18n="contact.title">Contact</h1>
      <p class="page-lead anim" style="--d:.3s" data-i18n="contact.support_desc">For technical help, account issues, or feature suggestions, feel free to drop us an email. We will get back to you promptly.</p>
    </div>
  </section>

  <section class="page-body">
    <div class="wrap">
      <div class="bento">
        <article class="card reveal">
          <div class="card-body">
            <div class="card-label">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              <span data-i18n="contact.email_label">Email</span>
            </div>
            <p class="card-value"><a href="mailto:support@wawejournal.com" class="text-link">support@wawejournal.com</a></p>
          </div>
        </article>

        <article class="card reveal">
          <div class="card-body">
            <div class="card-label">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span data-i18n="contact.address_label">Address</span>
            </div>
            <p class="card-value">İstanbul, Türkiye</p>
            <p class="card-desc">Wawe Journal</p>
          </div>
        </article>

        <article class="card reveal">
          <div class="card-body">
            <div class="card-label">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <span data-i18n="contact.hours_label">Working Hours</span>
            </div>
            <p class="card-value" data-i18n="contact.hours_weekdays">Weekdays: 09:00 - 18:00</p>
            <p class="card-desc" data-i18n="contact.hours_weekend">Weekends: Closed</p>
          </div>
        </article>

        <article class="card reveal">
          <div class="card-body">
            <div class="card-label">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
              <span data-i18n="contact.social_media">Social Media</span>
            </div>
            <div class="card-actions">
              <a href="https://www.instagram.com/wawejournal/" target="_blank" rel="noopener" class="btn btn-line">Instagram</a>
            </div>
          </div>
        </article>

        <article class="card wide featured reveal">
          <div class="card-body">
            <h2 class="card-title" data-i18n="contact.support_title">Support Requests</h2>
            <div>
              <p class="card-desc"><strong data-i18n="contact.support_reply">Average response time: 24 hours (weekdays)</strong></p>
              <div class="card-actions">
                <a href="mailto:support@wawejournal.com" class="btn btn-accent">support@wawejournal.com →</a>
              </div>
            </div>
          </div>
        </article>
      </div>

      <div class="page-actions">
        <a href="/" class="btn btn-line" data-i18n="common.back_home">← Back to Home</a>
      </div>
    </div>
  </section>
</PageLayout>
