---
import PageLayout from '../layouts/PageLayout.astro';
---
<PageLayout title="İletişim – Wawe Journal">
  <section class="page-hero">
    <div class="wrap">
      <span class="pill anim" style="--d:.05s"><b data-i18n="contact.get_in_touch">Bize Ulaşın</b></span>
      <h1 class="anim" style="--d:.15s" data-i18n="contact.title">İletişim</h1>
      <p class="page-lead anim" style="--d:.3s" data-i18n="contact.support_desc">Teknik destek, hesap sorunları veya önerileriniz için bize e-posta gönderebilirsiniz. En kısa sürede dönüş yapacağız.</p>
    </div>
  </section>

  <section class="page-body">
    <div class="wrap">
      <div class="bento">
        <article class="card reveal">
          <div class="card-body">
            <div class="card-label">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              <span data-i18n="contact.email_label">E-posta</span>
            </div>
            <p class="card-value"><a href="mailto:destek@wawedev.com" class="text-link">destek@wawedev.com</a></p>
          </div>
        </article>

        <article class="card reveal">
          <div class="card-body">
            <div class="card-label">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span data-i18n="contact.address_label">Adres</span>
            </div>
            <p class="card-value">EU Finland</p>
            <p class="card-desc">WaweDev Inc</p>
          </div>
        </article>

        <article class="card reveal">
          <div class="card-body">
            <div class="card-label">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <span data-i18n="contact.hours_label">Çalışma Saatleri</span>
            </div>
            <p class="card-value" data-i18n="contact.hours_weekdays">Hafta içi: 09:00 - 18:00</p>
            <p class="card-desc" data-i18n="contact.hours_weekend">Hafta sonu: Kapalı</p>
          </div>
        </article>

        <article class="card reveal">
          <div class="card-body">
            <div class="card-label">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
              <span data-i18n="contact.social_media">Sosyal Medya</span>
            </div>
            <div class="card-actions">
              <a href="https://www.instagram.com/wawejournal/" target="_blank" rel="noopener" class="btn btn-line">Instagram</a>
              <a href="https://youtube.com/@wawedev" target="_blank" rel="noopener" class="btn btn-line">YouTube</a>
            </div>
          </div>
        </article>

        <article class="card wide featured reveal">
          <div class="card-body">
            <h2 class="card-title" data-i18n="contact.support_title">Destek Talepleri</h2>
            <div>
              <p class="card-desc"><strong data-i18n="contact.support_reply">Ortalama yanıt süresi: 24 saat (hafta içi)</strong></p>
              <div class="card-actions">
                <a href="mailto:destek@wawedev.com" class="btn btn-accent">destek@wawedev.com →</a>
              </div>
            </div>
          </div>
        </article>
      </div>

      <div class="page-actions">
        <a href="/" class="btn btn-line" data-i18n="common.back_home">← Ana Sayfaya Dön</a>
      </div>
    </div>
  </section>
</PageLayout>
