---
import Layout from '../layouts/Layout.astro';
---
<Layout lang="tr" showQuickAdd={true}>
<Fragment slot="head">
  <title data-i18n="dashboard.title">Dashboard - Wawe Journal</title>

  <link rel="stylesheet" href="/interface/dashboard/css/dashboard.css?v=1790432900" />
  <link rel="stylesheet" href="/interface/dashboard/css/prop-banner.css?v=1790433100" />
  <link rel="stylesheet" href="/interface/quick-add/css/quick-add.css" />

  <style>
    html.light-theme-pending body {
      background: #f4f4f9;
    }
    /* ⭐ CLS SIFIRLAMA: Skeleton ile gerçek kartların birebir aynı yükseklikte kalmasını sağlar */
    .skeleton-stats {
      min-height: 84px;
    }
    .skeleton-stat {
      min-height: 84px;
      box-sizing: border-box;
    }
    #charts-top-skeleton .skeleton-chart {
      height: 250px;
      min-height: 250px;
      box-sizing: border-box;
    }
    #charts-bottom-skeleton .skeleton-chart {
      height: 220px;
      min-height: 220px;
      box-sizing: border-box;
    }
    #recent-trades-skeleton,
    #recent-trades-container-wrap {
      min-height: 270px;
      box-sizing: border-box;
    }
  </style>
</Fragment>

  <main class="main dashboard-main">

    <div class="page-header">
      <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
        <h1 data-i18n="dashboard.title">Dashboard</h1>
        <div id="dashboard-prop-badge"></div>
      </div>
      <div class="header-actions">
        <!-- DASHBOARD TOOLBAR -->
        <div class="dashboard-toolbar" id="dashboard-toolbar">
          <div class="date-filter-group" id="date-filter-group">
            <button class="date-filter-option active" data-range="all" data-i18n="dashboard.filter.all">Tümü</button>
            <button class="date-filter-option" data-range="week" data-i18n="dashboard.filter.week">Bu Hafta</button>
            <button class="date-filter-option" data-range="month" data-i18n="dashboard.filter.month">Bu Ay</button>
            <button class="date-filter-option" data-range="year" data-i18n="dashboard.filter.year">Bu Yıl</button>
            <button class="date-filter-option" data-range="custom" id="custom-range-btn" data-i18n="dashboard.filter.custom">Özel</button>
          </div>
          <div class="custom-range-panel" id="custom-range-panel" style="display:none;">
            <input type="date" id="custom-range-start" class="custom-range-input" />
            <span class="custom-range-sep">–</span>
            <input type="date" id="custom-range-end" class="custom-range-input" />
            <button class="custom-range-apply" id="custom-range-apply" data-i18n="dashboard.filter.apply">Uygula</button>
          </div>
          <button class="export-btn" id="export-csv-desktop" title="CSV">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span data-i18n="dashboard.export_csv">CSV</span>
          </button>
          <button class="export-btn" id="export-pdf-desktop" title="PDF">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            <span data-i18n="dashboard.export_pdf">PDF</span>
          </button>
        </div>
      </div>
    </div>

    <!-- STATS - SKELETON (5 EŞİT KART) -->
    <div id="stats-skeleton" class="skeleton-stats">
      <div class="skeleton-stat"><div class="skeleton-line"></div><div class="skeleton-line" style="width:60%;"></div></div>
      <div class="skeleton-stat"><div class="skeleton-line"></div><div class="skeleton-line" style="width:60%;"></div></div>
      <div class="skeleton-stat"><div class="skeleton-line"></div><div class="skeleton-line" style="width:60%;"></div></div>
      <div class="skeleton-stat"><div class="skeleton-line"></div><div class="skeleton-line" style="width:60%;"></div></div>
      <div class="skeleton-stat"><div class="skeleton-line"></div><div class="skeleton-line" style="width:60%;"></div></div>
    </div>

    <!-- STATS - GERÇEK (5 EŞİT STAT KARTI) -->
    <div class="stats-grid" id="stats-grid" style="display:none;">
      <div class="stat-card">
        <div class="stat-label" data-i18n="dashboard.stats.total_trades">Toplam İşlem</div>
        <div class="stat-value" id="stat-total">—</div>
        <div class="stat-trend" id="trend-total"></div>
      </div>
      <div class="stat-card" id="stat-pnl-card" data-critical="true">
        <div class="stat-label" data-i18n="dashboard.stats.total_pnl">Toplam K/Z</div>
        <div class="stat-value" id="stat-pnl">—</div>
        <div class="stat-trend" id="trend-pnl"></div>
      </div>
      <div class="stat-card" data-critical="true">
        <div class="stat-label" data-i18n="dashboard.stats.win_rate">Win Rate</div>
        <div class="stat-value" id="stat-winrate">—</div>
        <div class="stat-trend" id="trend-wr"></div>
      </div>
      <div class="stat-card">
        <div class="stat-label" data-i18n="dashboard.stats.winners">Kazanan</div>
        <div class="stat-value positive" id="stat-wins">—</div>
        <div class="stat-trend" id="trend-wins"></div>
      </div>
      <div class="stat-card">
        <div class="stat-label" data-i18n="dashboard.stats.losers">Kaybeden</div>
        <div class="stat-value negative" id="stat-losses">—</div>
        <div class="stat-trend" id="trend-losses"></div>
      </div>
    </div>

    <!-- KPI ACCORDION -->
    <div class="kpi-section">
      <button class="kpi-toggle-btn" id="kpi-toggle-btn" aria-expanded="true">
        <span data-i18n="dashboard.kpi.detailed_stats">Detaylı İstatistikler</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="kpi-toggle-chevron"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="kpi-bar-wrapper" id="kpi-bar-wrapper">
        <div class="kpi-bar" id="kpi-bar">
          <div class="kpi-item"><span class="kpi-label" data-i18n="dashboard.kpi.avg_win">Ort. Kazanç</span><span class="kpi-value positive" id="kpi-avg-win">—</span></div>
          <div class="kpi-item"><span class="kpi-label" data-i18n="dashboard.kpi.avg_loss">Ort. Kayıp</span><span class="kpi-value negative" id="kpi-avg-loss">—</span></div>
          <div class="kpi-item"><span class="kpi-label" data-i18n="dashboard.kpi.profit_factor">Profit Factor</span><span class="kpi-value" id="kpi-pf">—</span></div>
          <div class="kpi-item"><span class="kpi-label" data-i18n="dashboard.kpi.max_drawdown">Max Drawdown</span><span class="kpi-value negative" id="kpi-dd">—</span></div>
          <div class="kpi-item"><span class="kpi-label" data-i18n="dashboard.kpi.avg_rr">Ort. R:R</span><span class="kpi-value" id="kpi-rr">—</span></div>
          <div class="kpi-item">
            <span class="kpi-label" data-i18n="dashboard.kpi.monthly_goal">Aylık Hedef</span>
            <div class="goal-wrapper">
              <div class="progress-bar"><div class="progress-fill" id="goal-progress"></div></div>
              <span class="kpi-value" id="goal-percent">0%</span>
              <button class="goal-edit-btn" id="edit-goal-btn" data-i18n-title="dashboard.goal.edit" title="Hedefi Düzenle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- CHARTS - SKELETON -->
    <div class="charts-top-grid" id="charts-top-skeleton">
      <div class="chart-card"><div class="skeleton-chart"><div class="skeleton-bar-group"><div class="skeleton-bar"></div><div class="skeleton-bar"></div><div class="skeleton-bar"></div><div class="skeleton-bar"></div><div class="skeleton-bar"></div><div class="skeleton-bar"></div><div class="skeleton-bar"></div><div class="skeleton-bar"></div><div class="skeleton-bar"></div><div class="skeleton-bar"></div></div><div class="skeleton-label"></div></div></div>
      <div class="chart-card performance-card-skeleton">
        <div class="skeleton-perf-header"><div class="skeleton-line" style="width:42%;"></div><div class="skeleton-line" style="width:24%;"></div></div>
        <div class="skeleton-perf-banner"><div class="skeleton-line" style="width:55%;height:10px;"></div><div class="skeleton-line" style="width:100%;height:5px;border-radius:999px;"></div></div>
        <div class="skeleton-perf-grid">
          <div class="skeleton-perf-box"><div class="skeleton-line" style="width:50%;"></div><div class="skeleton-line" style="width:70%;"></div></div>
          <div class="skeleton-perf-box"><div class="skeleton-line" style="width:50%;"></div><div class="skeleton-line" style="width:70%;"></div></div>
          <div class="skeleton-perf-box"><div class="skeleton-line" style="width:50%;"></div><div class="skeleton-line" style="width:70%;"></div></div>
          <div class="skeleton-perf-box"><div class="skeleton-line" style="width:50%;"></div><div class="skeleton-line" style="width:70%;"></div></div>
        </div>
      </div>
    </div>

    <!-- CHARTS - GERÇEK -->
    <div class="charts-top-grid" id="charts-top-grid" style="display:none;">
      <div class="chart-card">
        <div class="chart-header">
          <h3 data-i18n="dashboard.chart.cumulative">Kümülatif K/Z Serisi</h3>
          <span class="chart-badge" id="cumulative-change">↑ +0%</span>
        </div>
        <div class="chart-wrap chart-wrap--tall">
          <div id="chart-cumulative"></div>
        </div>
      </div>
      <!-- PROP FIRM OVERVIEW KARTI (Win/Loss yerine) -->
      <div class="chart-card prop-dashboard-card" id="dashboard-prop-card">
        <div class="prop-card-loading">
          <div class="prop-card-spinner"></div>
          <span>Yükleniyor...</span>
        </div>
      </div>
    </div>

    <!-- CHARTS BOTTOM - SKELETON -->
    <div class="charts-bottom-grid" id="charts-bottom-skeleton">
      <div class="chart-card"><div class="skeleton-chart"><div class="skeleton-bar-group"><div class="skeleton-bar"></div><div class="skeleton-bar"></div><div class="skeleton-bar"></div><div class="skeleton-bar"></div><div class="skeleton-bar"></div><div class="skeleton-bar"></div><div class="skeleton-bar"></div><div class="skeleton-bar"></div><div class="skeleton-bar"></div><div class="skeleton-bar"></div></div><div class="skeleton-label"></div></div></div>
      <div class="chart-card"><div class="skeleton-chart"><div class="skeleton-bar-group"><div class="skeleton-bar"></div><div class="skeleton-bar"></div><div class="skeleton-bar"></div><div class="skeleton-bar"></div><div class="skeleton-bar"></div><div class="skeleton-bar"></div><div class="skeleton-bar"></div><div class="skeleton-bar"></div><div class="skeleton-bar"></div><div class="skeleton-bar"></div></div><div class="skeleton-label"></div></div></div>
      <div class="chart-card"><div class="skeleton-chart" style="justify-content:center;"><div class="skeleton-doughnut"></div></div></div>
    </div>

    <!-- CHARTS BOTTOM - GERÇEK -->
    <div class="charts-bottom-grid" id="charts-bottom-grid" style="display:none;">
      <div class="chart-card">
        <h3 data-i18n="dashboard.chart.daily">Günlük K/Z – Son 30 Gün</h3>
        <div class="chart-wrap">
          <div id="chart-daily"></div>
        </div>
      </div>
      <div class="chart-card">
        <h3 data-i18n="dashboard.chart.symbol">Sembol Bazlı Performans</h3>
        <div class="chart-wrap">
          <div id="chart-symbol"></div>
        </div>
      </div>
      <!-- 2'Lİ DONUT SLIDER KARTI (Win/Loss + Long/Short) -->
      <div class="chart-card donut-slider-card" id="donut-slider-card">
        <div class="chart-header donut-slider-header">
          <div class="donut-slider-title-box">
            <h3 id="donut-slider-title" data-i18n="dashboard.chart.winloss">Win / Loss Dağılımı</h3>
          </div>
          <div class="donut-slider-controls">
            <button type="button" class="donut-nav-btn prev" id="donut-prev-btn" title="Önceki" aria-label="Önceki Dağılım">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <div class="donut-slider-dots" id="donut-slider-dots">
              <button type="button" class="donut-slider-dot active" data-slide="0" aria-label="Win / Loss Dağılımı"></button>
              <button type="button" class="donut-slider-dot" data-slide="1" aria-label="Long / Short Dağılımı"></button>
            </div>
            <button type="button" class="donut-nav-btn next" id="donut-next-btn" title="Sonraki" aria-label="Sonraki Dağılım">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
        </div>
        <div class="donut-slider-viewport" id="donut-slider-viewport">
          <div class="donut-slider-track" id="donut-slider-track">
            <!-- SLIDE 0: WIN / LOSS -->
            <div class="donut-slider-slide" data-slide-index="0" data-title-key="dashboard.chart.winloss" data-default-title="Win / Loss Dağılımı">
              <div class="chart-wrap chart-wrap--doughnut">
                <div id="chart-winloss"></div>
              </div>
            </div>
            <!-- SLIDE 1: LONG / SHORT -->
            <div class="donut-slider-slide" data-slide-index="1" data-title-key="dashboard.chart.direction" data-default-title="Long / Short Dağılımı">
              <div class="chart-wrap chart-wrap--doughnut">
                <div id="chart-direction"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Mini Takvim + Strategy Tags -->
    <div class="dashboard-grid-2col">
      <div class="mini-calendar-card">
        <div class="mini-cal-header">
          <div class="mini-cal-title">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/>
              <line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            <span id="mini-cal-week-label" data-i18n="dashboard.calendar.this_week">Bu Hafta</span>
          </div>
          <a href="/calendar.html" class="mini-cal-link" data-i18n="dashboard.calendar.view_detail">
            Detaylı Takvim
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
          </a>
        </div>
        <div class="mini-cal-grid" id="mini-cal-grid"></div>
        <div style="display:flex; justify-content:space-between; margin-top:0.5rem; font-size:10px; color:var(--muted); flex-wrap:wrap; gap:0.3rem;">
          <span id="mini-cal-today-info"></span>
          <span id="mini-cal-week-summary"></span>
        </div>
      </div>

      <div class="strategy-tags-card">
        <div class="strategy-tags-title" data-i18n="dashboard.strategies.title">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
          <span data-i18n="dashboard.strategies.title_full">KULLANILAN STRATEJİLER</span>
        </div>
        <div id="strategy-tags-container"></div>
        <div class="best-worst" id="best-worst">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
            <polyline points="3.29 7 12 12 20.71 7"/>
            <line x1="12" y1="22" x2="12" y2="12"/>
          </svg>
          <span data-i18n="dashboard.total_strategies">Toplam Strateji</span>
          <span class="bw-count" id="strategy-count-display">0</span>
        </div>
      </div>
    </div>

    <!-- RECENT TRADES - SKELETON -->
    <div class="chart-card" style="padding: 1rem;" id="recent-trades-skeleton">
      <div class="chart-header" style="margin-bottom: 0.75rem;">
        <h3 data-i18n="dashboard.recent_trades">SON İŞLEMLER</h3>
        <a href="/trades.html" style="color: var(--accent); font-size: 10px; text-decoration: none;" data-i18n="dashboard.recent_trades.view_all">Tümünü Gör →</a>
      </div>
      <div class="skeleton-table">
        <div class="skeleton-row"><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div></div>
        <div class="skeleton-row"><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div></div>
        <div class="skeleton-row"><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div></div>
        <div class="skeleton-row"><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div></div>
        <div class="skeleton-row"><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div></div>
      </div>
    </div>

    <!-- RECENT TRADES - GERÇEK -->
    <div class="chart-card" style="padding: 1rem; display:none;" id="recent-trades-container-wrap">
      <div class="chart-header" style="margin-bottom: 0.75rem;">
        <h3 data-i18n="dashboard.recent_trades">SON İŞLEMLER</h3>
        <a href="/trades.html" style="color: var(--accent); font-size: 10px; text-decoration: none;" data-i18n="dashboard.recent_trades.view_all">Tümünü Gör →</a>
      </div>
      <div id="recent-trades-container"></div>
    </div>

  </main>

  <!-- GOAL MODAL -->
  <div id="goal-modal" class="goal-modal-overlay" style="display:none;">
    <div class="goal-modal">
      <div class="goal-modal-header">
        <div class="goal-modal-title-wrap">
          <div class="goal-modal-icon-badge">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <circle cx="12" cy="12" r="6"/>
              <circle cx="12" cy="12" r="2"/>
            </svg>
          </div>
          <div class="goal-modal-title-text">
            <h3 data-i18n="dashboard.goal.title">Aylık Hedef Belirle</h3>
            <p data-i18n="dashboard.goal.subtitle">Aylık kâr hedefinizi belirleyin ve ilerlemenizi anlık takip edin.</p>
          </div>
        </div>
        <button class="goal-modal-close" id="close-goal-modal" aria-label="Kapat">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <div class="goal-modal-body">
        <div class="goal-field-group">
          <label class="goal-field-label" data-i18n="dashboard.goal.label">Hedef Tutar</label>
          <div class="goal-input-wrapper">
            <span class="goal-currency-symbol">$</span>
            <input type="number" id="goal-amount" class="goal-input" step="100" min="1" data-i18n-placeholder="dashboard.goal.placeholder" placeholder="5000" />
          </div>
        </div>

        <div class="goal-presets">
          <button type="button" class="goal-preset-chip" data-goal="1000">$1,000</button>
          <button type="button" class="goal-preset-chip" data-goal="2500">$2,500</button>
          <button type="button" class="goal-preset-chip" data-goal="5000">$5,000</button>
          <button type="button" class="goal-preset-chip" data-goal="10000">$10,000</button>
          <button type="button" class="goal-preset-chip" data-goal="25000">$25,000</button>
        </div>

        <div class="goal-hint-row">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="16" x2="12" y2="12"/>
            <line x1="12" y1="8" x2="12.01" y2="8"/>
          </svg>
          <span data-i18n="dashboard.goal.desc">Bu hedef, ana paneldeki ilerleme çubuğunda gösterilecektir.</span>
        </div>
      </div>
      <div class="goal-modal-footer">
        <button class="goal-btn-cancel" id="cancel-goal-btn" data-i18n="common.cancel">İptal</button>
        <button class="goal-btn-save" id="save-goal-btn" data-i18n="common.save">Kaydet</button>
      </div>
    </div>
  </div>

  <!-- CHART EXPAND MODAL -->
  <div id="chart-expand-modal" class="chart-expand-overlay" style="display:none;">
    <div class="chart-expand-box">
      <div class="chart-expand-header">
        <h3 id="chart-expand-title"></h3>
        <button class="chart-expand-close" id="chart-expand-close">✕</button>
      </div>
      <div class="chart-expand-body">
        <div id="chart-expand-container" style="width:100%;"></div>
        <div id="chart-expand-summary" class="chart-expand-summary"></div>
      </div>
    </div>
  </div>

  <!-- PROP FIRM ADVANCE PHASE MODAL (OUTSIDE MAIN FOR PERFECT CENTERING) -->
  <div id="dashboard-advance-phase-modal" class="prop-modal-backdrop" style="display:none;">
    <div class="prop-modal-box">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;border-bottom:1px solid rgba(255,255,255,0.06);padding-bottom:0.75rem;">
        <h3 style="margin:0;font-size:1.05rem;font-weight:700;" data-i18n="prop.advance_modal_title">
          <span>Sonraki Faza Geç</span>
        </h3>
        <button id="close-advance-modal" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:1.4rem;line-height:1;">&times;</button>
      </div>
      <p style="font-size:0.85rem;color:var(--muted);margin-bottom:1.2rem;line-height:1.45;" data-i18n="prop.advance_modal_desc">
        Yeni faza geçtiğinizde başlangıç tarihi güncellenir ve eski işlemler bu faza dahil edilmez.
      </p>
      <div style="margin-bottom:1rem;">
        <label style="display:block;font-size:0.8rem;font-weight:600;margin-bottom:4px;" data-i18n="prop.advance_start_date_label">Yeni Faz Başlangıç Tarihi</label>
        <input type="date" id="advance-phase-start-date" class="journal-prop-input" style="width:100%;padding:0.6rem;border-radius:8px;border:1px solid var(--border);background:var(--bg2,#0d0d14);color:var(--text);box-sizing:border-box;" />
      </div>

      <!-- İşlem Çakışması Uyarısı (Yeni start_date'te işlem varsa) -->
      <div id="advance-trades-warning" style="display:none;margin-bottom:1rem;padding:0.75rem;background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.3);border-radius:8px;font-size:0.8rem;color:#f59e0b;">
        <div>
          <span id="advance-trades-warning-text">Bu tarihte işlemler var, yeni faza dahil edilecek.</span>
          <div style="margin-top:6px;">
            <button type="button" id="advance-bump-date-btn" style="background:#f59e0b;color:#000;border:none;border-radius:4px;padding:3px 8px;font-size:0.75rem;font-weight:600;cursor:pointer;" data-i18n="prop.advance_bump_date">
              Başlangıç tarihini ertesi güne al
            </button>
          </div>
        </div>
      </div>

      <!-- Özelleştirilmiş Kuralları Koruma Seçeneği -->
      <div id="advance-custom-rules-choice" style="display:none;margin-bottom:1rem;padding:0.75rem;background:rgba(255,255,255,0.03);border:1px solid var(--border);border-radius:8px;font-size:0.8rem;">
        <div style="font-weight:600;margin-bottom:6px;" data-i18n="prop.advance_rules_title">Kural Ayarları</div>
        <label style="display:flex;align-items:center;gap:6px;margin-bottom:6px;cursor:pointer;">
          <input type="radio" name="advance-rules-mode" value="keep" id="advance-rules-keep" checked />
          <span data-i18n="prop.advance_rules_keep">Özelleştirilmiş kurallarımı koru</span>
        </label>
        <label style="display:flex;align-items:center;gap:6px;cursor:pointer;">
          <input type="radio" name="advance-rules-mode" value="template" id="advance-rules-template" />
          <span data-i18n="prop.advance_rules_template">Yeni faz varsayılanlarını kullan</span>
        </label>
      </div>

      <div style="margin-bottom:1.25rem;">
        <label style="display:block;font-size:0.8rem;font-weight:600;margin-bottom:4px;" data-i18n="prop.advance_balance_label">Yeni Başlangıç Bakiyesi ($)</label>
        <input type="number" id="advance-phase-starting-balance" class="journal-prop-input" style="width:100%;padding:0.6rem;border-radius:8px;border:1px solid var(--border);background:var(--bg2,#0d0d14);color:var(--text);box-sizing:border-box;" min="1" step="100" />
      </div>
      <div style="display:flex;justify-content:flex-end;gap:0.75rem;">
        <button id="cancel-advance-modal" class="journal-btn-cancel" style="padding:0.5rem 1rem;border-radius:8px;border:1px solid var(--border);background:transparent;color:var(--text);cursor:pointer;" data-i18n="journal.cancel">İptal</button>
        <button id="confirm-advance-modal" class="journal-btn-save" style="padding:0.5rem 1.25rem;border-radius:8px;border:none;background:var(--accent);color:#fff;font-weight:600;cursor:pointer;" data-i18n="prop.advance_confirm_btn">Faza Geç</button>
      </div>
    </div>
  </div>

  <!-- PROP NOTICES / RULES MODAL (OUTSIDE MAIN FOR PERFECT CENTERING) -->
  <div id="dashboard-prop-notices-modal" class="prop-modal-backdrop" style="display:none;">
    <div class="prop-notices-modal-content">
      <div class="prop-notices-modal-header">
        <h3 class="prop-notices-modal-title">
          <span id="dashboard-prop-notices-title" data-i18n="prop.rule_notices_modal_title">Kurallar ve Bildirimler</span>
        </h3>
        <button id="close-dashboard-prop-notices" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:1.4rem;line-height:1;">&times;</button>
      </div>
      <div id="dashboard-prop-notices-body" class="prop-notices-list"></div>
      <div id="dashboard-prop-notices-disclaimer" class="prop-native-disclaimer" style="margin-top:0.5rem;padding-top:0.5rem;border-top:1px solid rgba(255,255,255,0.06);"></div>
    </div>
  </div>

  <!-- SCRIPTS -->
  <Fragment slot="head">
    <!-- PRELOAD CRITICAL SCRIPTS -->
    <link rel="preload" href="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" as="script" />

    <script src="https://cdn.jsdelivr.net/npm/apexcharts" is:inline defer></script>
    <script src="https://cdn.jsdelivr.net/npm/lightweight-charts@4.1.3/dist/lightweight-charts.standalone.production.js" is:inline defer></script>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" is:inline defer></script>

    <script src="/config.js" is:inline defer></script>
    <script src="/i18n.js?v=1790432600" is:inline defer></script>

    <!-- ⭐ ParserV2 -->
    <script src="/interface/quick-add/js/broker-dictionary.js" is:inline defer></script>
    <script src="/interface/quick-add/js/broker-detector.js" is:inline defer></script>
    <script src="/interface/quick-add/js/fill-pairing.js" is:inline defer></script>
    <script src="/interface/quick-add/js/parser-v2.js" is:inline defer></script>

    <script type="module" src="/src/bundle.js" is:inline defer></script>
   
    <script src="/interface/quick-add/js/quick-modal-i18n.js?v=1791383000" is:inline defer></script>
    <script src="/interface/quick-add/js/quick-add.js?v=1791383000" is:inline defer></script>

    <script src="/interface/dashboard/js/dashboard.js?v=1791460010" is:inline defer></script>
  </Fragment>

  <script is:inline>
    function escapeHtml(str) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    var _currentPropSync = null;

    async function refreshDashboardPropBanner() {
      var propCardEl = document.getElementById('dashboard-prop-card');
      var badgeEl = document.getElementById('dashboard-prop-badge');
      var bannerEl = document.getElementById('dashboard-prop-banner');
      if (bannerEl) {
        bannerEl.style.display = 'none';
        bannerEl.innerHTML = '';
      }

      var statsGridEl = document.getElementById('stats-grid');
      if (statsGridEl && statsGridEl.style.display === 'none') {
        var statsSkelEl = document.getElementById('stats-skeleton');
        if (statsSkelEl && statsSkelEl.style.display === 'none') {
          statsGridEl.style.display = 'grid';
        }
      }

      if (!window.PropService || !window.journal) {
        renderStandardAccountCard(propCardEl);
        if (badgeEl) badgeEl.innerHTML = '';
        return;
      }

      var activeId = window.journal.getActiveJournalId();
      if (!activeId) {
        window._isPropAccountActive = false;
        renderStandardAccountCard(propCardEl);
        if (badgeEl) badgeEl.innerHTML = '';
        return;
      }

      // Fast-render: if previously cached as standard, render immediately without waiting
      var isPropCached = false;
      try {
        var rawCache = sessionStorage.getItem('ww_is_prop_' + activeId);
        if (rawCache === '1') isPropCached = true;
      } catch (e) {}

      if (!isPropCached && !window._isPropAccountActive) {
        renderStandardAccountCard(propCardEl);
      }

      try {
        var syncRes = await window.PropService.syncPropAccountStatus(activeId);
        if (!syncRes || !syncRes.account || !syncRes.status) {
          window._isPropAccountActive = false;
          try { sessionStorage.setItem('ww_is_prop_' + activeId, '0'); } catch (e) {}
          renderStandardAccountCard(propCardEl);
          if (badgeEl) badgeEl.innerHTML = '';
          return;
        }

        try { sessionStorage.setItem('ww_is_prop_' + activeId, '1'); } catch (e) {}

        window._isPropAccountActive = true;
        _currentPropSync = syncRes;
        var account = syncRes.account;
        var status = syncRes.status;
        var tmplKey = account.template_key;
        var tmpl = window.PropTemplates ? window.PropTemplates.getPropTemplate(tmplKey) : null;
        var firmName = tmpl ? tmpl.firm : (account.rules?.firm || 'Prop');
        var phaseNum = (account.phase_index !== undefined ? account.phase_index + 1 : 1);
        var t = function (key, params) {
          return (window.i18n && typeof window.i18n.t === 'function') ? window.i18n.t(key, params) : key;
        };
        var curLang = (window.i18n && typeof window.i18n.getCurrentLanguage === 'function') ? window.i18n.getCurrentLanguage() : 'tr';
        var localeStr = curLang === 'tr' ? 'tr-TR' : (curLang === 'de' ? 'de-DE' : 'en-US');

        function localizePhaseName(rawPhase) {
          if (!rawPhase) return '';
          if (curLang === 'tr') {
            return String(rawPhase)
              .replace(/Phase 1 \(Challenge\)/i, 'Faz 1 (Challenge)')
              .replace(/Phase 1 \(Evaluation\)/i, 'Faz 1 (Değerlendirme)')
              .replace(/Phase 1 \(Single Phase\)/i, 'Faz 1 (Tek Aşama)')
              .replace(/Phase 2 \(Verification\)/i, 'Faz 2 (Doğrulama)')
              .replace(/Phase 2/i, 'Faz 2')
              .replace(/Phase 1/i, 'Faz 1')
              .replace(/Funded \((.*?)\)/i, 'Fonlandı ($1)')
              .replace(/^Funded$/i, 'Fonlandı (Canlı)');
          } else if (curLang === 'de') {
            return String(rawPhase)
              .replace(/Phase 1 \(Challenge\)/i, 'Phase 1 (Challenge)')
              .replace(/Phase 1 \(Evaluation\)/i, 'Phase 1 (Bewertung)')
              .replace(/Phase 1 \(Single Phase\)/i, 'Phase 1 (Einzelschritt)')
              .replace(/Phase 2 \(Verification\)/i, 'Phase 2 (Verifizierung)')
              .replace(/Funded \((.*?)\)/i, 'Gefördert ($1)')
              .replace(/^Funded$/i, 'Gefördert (Live)');
          }
          return rawPhase;
        }

        var rawPhaseName = account.rules?.phase_name || t('prop.phase_num', { n: phaseNum });
        var phaseName = localizePhaseName(rawPhaseName);

        var currSym = (typeof window.getCurrencySymbol === 'function') 
          ? window.getCurrencySymbol() 
          : (localStorage.getItem('ww_currency') || '$');

        var fmtPlain = function(val) {
          var n = Number(val) || 0;
          return currSym + Math.abs(n).toLocaleString(localeStr, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        };
        var fmtDelta = function(val) {
          var n = Number(val) || 0;
          var sign = n > 0 ? '+' : (n < 0 ? '-' : '');
          return sign + currSym + Math.abs(n).toLocaleString(localeStr, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        };
        var fmtPct = function(pct) {
          var p = Math.round(Number(pct) || 0);
          return curLang === 'tr' ? '%' + p : p + '%';
        };

        // Action buttons & warnings
        var warningsList = (status.warnings || []).slice();
        if (account.rules && account.rules.verified === false) {
          warningsList.unshift('UNVERIFIED_PHASE_RULES');
        }
        var currentPhaseIdx = account.phase_index !== undefined ? account.phase_index : 0;
        var nextPhaseIdx = currentPhaseIdx + 1;
        var hasNextPhase = Boolean(tmpl && tmpl.phases && tmpl.phases.length > nextPhaseIdx);

        var st = status.overall_status || 'in_progress';
        var stLabel = st === 'passed' ? t('prop.status_passed') : (st === 'failed' ? t('prop.status_failed') : t('prop.status_in_progress'));

        // Başlığın sağındaki prop firm ibareleri kaldırıldı
        if (badgeEl) {
          badgeEl.innerHTML = '';
          badgeEl.style.display = 'none';
        }
        bindHudButtons(account, tmpl, nextPhaseIdx, warningsList);

        // Calculations for Prop Card
        var dailyRem = status.daily_loss ? Number(status.daily_loss.remaining_margin || 0) : 0;
        var dailyLimit = status.daily_loss ? Number(status.daily_loss.limit_amount || 0) : 0;
        var dailyToday = status.daily_loss ? Number(status.daily_loss.today_pnl || 0) : 0;
        var dailyValColor = dailyRem <= 0 ? 'var(--red,#ef4444)' : 'var(--green,#22c55e)';

        var maxStop = status.max_loss ? Number(status.max_loss.hard_stop_level || 0) : 0;
        var maxDist = status.max_loss ? Number(status.max_loss.distance_to_stop || 0) : 0;
        var maxDistPct = status.max_loss ? Number(status.max_loss.distance_to_stop_pct || 0) : 0;

        var targetAmount = status.profit_target ? Number(status.profit_target.target_amount || 0) : 0;
        var targetRem = status.profit_target ? Number(status.profit_target.remaining_amount || 0) : 0;
        var targetPct = status.profit_target ? Number(status.profit_target.progress_pct || 0) : 0;
        var targetBarFill = targetAmount > 0 ? Math.min(100, Math.max(0, targetPct)) : 0;

        var dayCount = status.trading_days ? (status.trading_days.count || 0) : 0;
        var dayMin = status.trading_days ? (status.trading_days.min_required || 0) : 0;

        var tradeList = (syncRes.trades && Array.isArray(syncRes.trades)) ? syncRes.trades : [];
        var totalTrades = tradeList.length;
        var totalPnl = tradeList.reduce((acc, tr) => acc + (Number(tr.pnl) || 0), 0);
        var wins = tradeList.filter(tr => (Number(tr.pnl) || 0) > 0).length;
        var losses = tradeList.filter(tr => (Number(tr.pnl) || 0) < 0).length;
        var wrPct = totalTrades > 0 ? Math.round((wins / totalTrades) * 100) : 0;
        var pnlValColor = totalPnl >= 0 ? 'var(--green,#22c55e)' : 'var(--red,#ef4444)';

        // Status description text for phase (Lucide SVG icon instead of emojis)
        var phaseStatusIcon = '';
        var phaseStatusText = '';
        var phaseStatusClass = st;
        if (st === 'passed') {
          phaseStatusIcon = `<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="prop-status-icon passed"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`;
          phaseStatusText = t('prop.target_reached_desc');
        } else if (st === 'failed') {
          phaseStatusIcon = `<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="prop-status-icon failed"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`;
          phaseStatusText = t('prop.status_failed') + ': ' + (status.failed_rule || t('prop.limits_exceeded'));
        } else {
          phaseStatusIcon = `<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="prop-status-icon target"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>`;
          if (targetAmount > 0) {
            phaseStatusText = targetRem <= 0 
              ? t('prop.target_reached_desc')
              : t('prop.target_remaining_info', { rem: fmtPlain(targetRem), target: fmtPlain(targetAmount) });
          } else {
            phaseStatusIcon = `<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="prop-status-icon info"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>`;
            phaseStatusText = t('prop.unlimited_time_hint');
          }
        }

        // Render into dashboard-prop-card
        if (propCardEl) {
          propCardEl.innerHTML = `
            <div class="prop-card-header">
              <div class="prop-card-firm-title">
                <span class="prop-card-firm-name">${escapeHtml(firmName)}</span>
                <span class="prop-card-phase-tag">${escapeHtml(phaseName)}</span>
              </div>
              <div class="prop-card-badge-row">
                ${warningsList.length > 0 ? `
                  <button type="button" id="prop-card-notices-btn" class="prop-card-btn-notices" title="${escapeHtml(t('prop.notices_count_title', { n: warningsList.length }))}">
                    <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    <span>${warningsList.length}</span>
                  </button>
                ` : ''}
                <span class="prop-status-pill ${st}">
                  <span class="prop-status-dot"></span>
                  <span>${escapeHtml(stLabel)}</span>
                </span>
                ${(hasNextPhase && st === 'passed') ? `
                  <button type="button" id="prop-card-advance-btn" class="prop-card-btn-advance">
                    ${escapeHtml(t('prop.next_phase'))}
                  </button>
                ` : ''}
              </div>
            </div>

            <!-- PHASE DURUMU & HEDEF İLERLEMESİ -->
            <div class="prop-card-phase-banner ${phaseStatusClass}">
              <div class="prop-card-phase-banner-top">
                <span class="prop-card-phase-desc">
                  ${phaseStatusIcon}
                  <span>${escapeHtml(phaseStatusText)}</span>
                </span>
                <span class="prop-card-phase-pct">${fmtPct(targetPct)}</span>
              </div>
              <div class="prop-card-progress-bar">
                <div class="prop-card-progress-fill ${st}" style="width: ${targetBarFill}%;"></div>
              </div>
            </div>

            <!-- METRİK IZGARASI (KALAN MARGIN, MAX LOSS, TOTAL PNL, GÜNLER/BAKİYE) -->
            <div class="prop-card-grid">
              <!-- 1. KALAN MARGIN -->
              <div class="prop-card-box">
                <div class="prop-card-box-label">
                  <span>${escapeHtml(t('prop.remaining_margin'))}</span>
                  <span class="prop-card-dot" style="background:${dailyValColor};"></span>
                </div>
                <div class="prop-card-box-value" style="color:${dailyValColor};">
                  ${fmtDelta(dailyRem)}
                </div>
                <div class="prop-card-box-sub">
                  <span>${escapeHtml(t('prop.limit'))}: ${fmtPlain(dailyLimit)}</span>
                  <span>${escapeHtml(t('prop.today'))}: ${fmtDelta(dailyToday)}</span>
                </div>
              </div>

              <!-- 2. MAX LOSS FLOOR MESAFESİ -->
              <div class="prop-card-box">
                <div class="prop-card-box-label">
                  <span>${escapeHtml(t('prop.max_loss_distance'))}</span>
                  <span class="prop-card-dot" style="background:${maxDist <= 0 ? 'var(--red,#ef4444)' : (maxDistPct <= 25 ? '#f59e0b' : 'var(--green,#22c55e)')};"></span>
                </div>
                <div class="prop-card-box-value" style="color:${maxDist <= 0 ? 'var(--red,#ef4444)' : 'inherit'};">
                  ${fmtPlain(maxDist)}
                </div>
                <div class="prop-card-box-sub">
                  <span>${escapeHtml(t('prop.stop_level'))}: ${fmtPlain(maxStop)}</span>
                  <span>${escapeHtml(t('prop.remaining'))}: ${fmtPct(maxDistPct)}</span>
                </div>
              </div>

              <!-- 3. TOTAL PNL -->
              <div class="prop-card-box">
                <div class="prop-card-box-label">
                  <span>${escapeHtml(t('prop.total_pnl'))}</span>
                  <span class="prop-card-dot" style="background:${pnlValColor};"></span>
                </div>
                <div class="prop-card-box-value" style="color:${pnlValColor};">
                  ${fmtDelta(totalPnl)}
                </div>
                <div class="prop-card-box-sub">
                  <span>${escapeHtml(t('prop.win_rate'))}: ${fmtPct(wrPct)}</span>
                  <span>${escapeHtml(t('prop.trades_summary', { count: totalTrades, wins: wins, losses: losses }))}</span>
                </div>
              </div>

              <!-- 4. BAKİYE & GÜN -->
              <div class="prop-card-box">
                <div class="prop-card-box-label">
                  <span>${escapeHtml(t('prop.balance_and_days'))}</span>
                  <span class="prop-card-dot" style="background:#38bdf8;"></span>
                </div>
                <div class="prop-card-box-value">
                  ${fmtPlain(status.current_balance || status.account?.starting_balance)}
                </div>
                <div class="prop-card-box-sub">
                  <span>${escapeHtml(t('prop.day'))}: ${dayCount}${dayMin ? '/' + dayMin : ''}</span>
                  <span>${escapeHtml(t('prop.starting'))}: ${fmtPlain(status.account?.starting_balance)}</span>
                </div>
              </div>
            </div>
          `;

          // Bind advance button in card if present
          var cardAdvBtn = document.getElementById('prop-card-advance-btn');
          if (cardAdvBtn) {
            cardAdvBtn.onclick = function() {
              var mainAdvBtn = document.getElementById('dashboard-advance-phase-btn');
              if (mainAdvBtn) mainAdvBtn.click();
            };
          }

          // Bind notices button in card if present
          var cardNoticesBtn = document.getElementById('prop-card-notices-btn');
          if (cardNoticesBtn) {
            cardNoticesBtn.onclick = function() {
              var modal = document.getElementById('dashboard-prop-notices-modal');
              if (modal) {
                modal.style.display = 'flex';
                modal.classList.add('active');
                if (typeof lucide !== 'undefined') lucide.createIcons();
              }
            };
          }
        }

        if (typeof lucide !== 'undefined') lucide.createIcons();
      } catch (err) {
        if (window.wwLog) window.wwLog.error('refreshDashboardPropBanner err:', err);
        renderStandardAccountCard(propCardEl);
      }
    }

    function renderStandardAccountCard(propCardEl) {
      if (!propCardEl) return;
      var t = function (key, params) {
        return (window.i18n && typeof window.i18n.t === 'function') ? window.i18n.t(key, params) : key;
      };
      var sym = (typeof window.getCurrencySymbol === 'function') ? window.getCurrencySymbol() : '$';
      var fmtPnl = function (val) {
        if (typeof window.formatCurrency === 'function') {
          return window.formatCurrency(val);
        }
        var num = parseFloat(val) || 0;
        var formatted = Math.abs(num).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        return (num >= 0 ? '+' : '-') + sym + formatted;
      };
      var fmtTarget = function (val) {
        var num = Math.abs(parseFloat(val) || 0);
        return sym + num.toLocaleString('tr-TR', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
      };

      // Get trades from dashboard state
      var trades = (window._currentDashboardTrades && Array.isArray(window._currentDashboardTrades))
        ? window._currentDashboardTrades
        : ((window._allDashboardTrades && Array.isArray(window._allDashboardTrades)) ? window._allDashboardTrades : []);

      var closed = trades.filter(function (tr) {
        return tr && (tr.exit_price || (tr.pnl !== null && tr.pnl !== undefined && !isNaN(parseFloat(tr.pnl))));
      });

      var calcPnl = function (tr) {
        if (typeof window.calcTradePnL === 'function') return window.calcTradePnL(tr);
        var p = parseFloat(tr.pnl);
        return !isNaN(p) ? p : 0;
      };

      var bestTrade = null;
      var worstTrade = null;
      var totalWins = 0;
      var winCount = 0;
      var totalLosses = 0;
      var lossCount = 0;
      var totalPnL = 0;

      closed.forEach(function (tr) {
        var pnl = calcPnl(tr);
        totalPnL += pnl;
        if (!bestTrade || pnl > bestTrade.pnl) {
          bestTrade = { pnl: pnl, symbol: tr.symbol || '' };
        }
        if (!worstTrade || pnl < worstTrade.pnl) {
          worstTrade = { pnl: pnl, symbol: tr.symbol || '' };
        }
        if (pnl > 0) {
          totalWins += pnl;
          winCount++;
        } else if (pnl < 0) {
          totalLosses += Math.abs(pnl);
          lossCount++;
        }
      });

      // Fallback PnL from DOM stat-pnl if closed is empty but DOM has value
      if (closed.length === 0) {
        var pnlDom = document.getElementById('stat-pnl');
        if (pnlDom && pnlDom.textContent && pnlDom.textContent !== '—') {
          var cleaned = pnlDom.textContent.replace(/[^0-9.-]/g, '');
          var parsed = parseFloat(cleaned);
          if (!isNaN(parsed)) totalPnL = parsed;
        }
      }

      // Target calculations
      var jid = window.journal ? window.journal.getActiveJournalId() : '';
      var savedTarget = localStorage.getItem('ww_monthly_target_' + jid);
      var monthlyTarget = (savedTarget && !isNaN(parseFloat(savedTarget))) ? parseFloat(savedTarget) : 5000;

      var rawGoalPct = monthlyTarget > 0 ? ((totalPnL / monthlyTarget) * 100) : 0;
      var goalPctText = rawGoalPct > 100 ? '>100%' : (rawGoalPct < -100 ? '<-100%' : rawGoalPct.toFixed(1) + '%');
      var goalFillWidth = Math.min(100, Math.max(0, rawGoalPct));
      var goalGradient = rawGoalPct >= 100
        ? 'linear-gradient(90deg, #10b981, #22c55e)'
        : (rawGoalPct > 0 ? 'linear-gradient(90deg, #6366f1, #818cf8)' : 'rgba(255,255,255,0.08)');
      var goalPctColor = rawGoalPct >= 100 ? '#4ade80' : (rawGoalPct > 0 ? '#818cf8' : 'var(--muted)');

      // Box 1: En İyi İşlem
      var bestText = '—';
      var bestSub = t('dashboard.card.no_trades') || 'Kayıtlı İşlem Yok';
      if (bestTrade && bestTrade.pnl > 0) {
        bestText = fmtPnl(bestTrade.pnl);
        bestSub = bestTrade.symbol ? (bestTrade.symbol + ' • ' + (t('dashboard.card.profit_tag') || 'Kazanç')) : (t('dashboard.card.best_trade') || 'En İyi İşlem');
      } else if (closed.length > 0) {
        bestText = sym + '0,00';
        bestSub = t('dashboard.card.no_win') || 'Kârlı İşlem Yok';
      }

      // Box 2: En Kötü İşlem
      var worstText = '—';
      var worstSub = t('dashboard.card.no_trades') || 'Kayıtlı İşlem Yok';
      var worstColor = 'var(--text)';
      if (worstTrade && worstTrade.pnl < 0) {
        worstText = fmtPnl(worstTrade.pnl);
        worstColor = '#f87171';
        worstSub = worstTrade.symbol ? (worstTrade.symbol + ' • ' + (t('dashboard.card.loss_tag') || 'Kayıp')) : (t('dashboard.card.worst_trade') || 'En Kötü İşlem');
      } else if (closed.length > 0) {
        worstText = sym + '0,00';
        worstColor = 'var(--text)';
        worstSub = t('dashboard.card.no_loss') || 'Kayıp İşlem Yok';
      }

      // Box 3: Expectancy (İşlem Başına Matematiksel Beklenti)
      var expVal = closed.length > 0 ? (totalPnL / closed.length) : null;
      var expText = '—';
      var expColor = 'var(--text)';
      if (expVal !== null) {
        expText = fmtPnl(expVal);
        expColor = expVal >= 0 ? '#4ade80' : '#f87171';
      }

      // Box 4: Payoff Ratio (Ort. Kazanç / Ort. Kayıp)
      var avgWin = winCount > 0 ? (totalWins / winCount) : 0;
      var avgLoss = lossCount > 0 ? (totalLosses / lossCount) : 0;
      var payoffText = '—';
      var payoffSub = t('dashboard.card.payoff_sub') || 'Ort. Win / Ort. Loss';
      if (avgLoss > 0 && avgWin > 0) {
        payoffText = (avgWin / avgLoss).toFixed(2) + 'x';
      } else if (avgWin > 0 && avgLoss === 0) {
        payoffText = 'Max';
        payoffSub = t('dashboard.card.no_loss') || 'Kayıp İşlem Yok';
      } else if (closed.length > 0) {
        payoffText = '0.00x';
      }

      propCardEl.innerHTML = `
        <div class="prop-card-header">
          <div class="prop-card-firm-title">
            <span class="prop-card-firm-name">${t('dashboard.card.performance_edge') || 'Performans & Edge'}</span>
          </div>
          <button type="button" class="prop-card-btn-notices" id="standard-edit-goal-btn" title="${t('dashboard.goal.title') || 'Aylık Hedef Belirle'}" style="background:rgba(124,109,250,0.12);color:#c4b5fd;border-color:rgba(124,109,250,0.25);cursor:pointer;display:inline-flex;align-items:center;gap:4px;padding:3px 9px;">
            <i data-lucide="target"></i>
            <span>${t('dashboard.card.set_goal') || 'Hedef Belirle'}</span>
          </button>
        </div>

        <div class="prop-card-phase-banner" style="background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.06);">
          <div class="prop-card-phase-banner-top">
            <span class="prop-card-phase-desc" style="display:inline-flex;align-items:center;gap:6px;">
              <i data-lucide="target" style="color:#818cf8;flex-shrink:0;"></i>
              <span>${t('dashboard.card.monthly_target') || 'Aylık Hedef'}: <strong style="color:var(--text);">${fmtPnl(totalPnL)}</strong> / ${fmtTarget(monthlyTarget)}</span>
            </span>
            <span class="prop-card-phase-pct" style="color:${goalPctColor};">${goalPctText}</span>
          </div>
          <div class="prop-card-progress-bar">
            <div class="prop-card-progress-fill" style="width:${goalFillWidth}%;background:${goalGradient};"></div>
          </div>
        </div>

        <div class="prop-card-grid">
          <div class="prop-card-box">
            <div class="prop-card-box-label">
              <span style="display:inline-flex;align-items:center;gap:4px;">
                <i data-lucide="arrow-up-right" style="color:#4ade80;"></i>
                <span>${t('dashboard.card.best_trade') || 'En İyi İşlem'}</span>
              </span>
              <span class="prop-card-dot" style="background:#4ade80;"></span>
            </div>
            <div class="prop-card-box-value" style="color:#4ade80;">${bestText}</div>
            <div class="prop-card-box-sub"><span>${bestSub}</span></div>
          </div>

          <div class="prop-card-box">
            <div class="prop-card-box-label">
              <span style="display:inline-flex;align-items:center;gap:4px;">
                <i data-lucide="arrow-down-right" style="color:#f87171;"></i>
                <span>${t('dashboard.card.worst_trade') || 'En Kötü İşlem'}</span>
              </span>
              <span class="prop-card-dot" style="background:#f87171;"></span>
            </div>
            <div class="prop-card-box-value" style="color:${worstColor};">${worstText}</div>
            <div class="prop-card-box-sub"><span>${worstSub}</span></div>
          </div>

          <div class="prop-card-box">
            <div class="prop-card-box-label">
              <span style="display:inline-flex;align-items:center;gap:4px;">
                <i data-lucide="scale" style="color:#818cf8;"></i>
                <span>${t('dashboard.card.expectancy') || 'Beklenti (Exp.)'}</span>
              </span>
              <span class="prop-card-dot" style="background:#818cf8;"></span>
            </div>
            <div class="prop-card-box-value" style="color:${expColor};">${expText}</div>
            <div class="prop-card-box-sub"><span>${t('dashboard.card.expectancy_sub') || 'İşlem Başı Ort. K/Z'}</span></div>
          </div>

          <div class="prop-card-box">
            <div class="prop-card-box-label">
              <span style="display:inline-flex;align-items:center;gap:4px;">
                <i data-lucide="zap" style="color:#38bdf8;"></i>
                <span>${t('dashboard.card.payoff_ratio') || 'Payoff Ratio'}</span>
              </span>
              <span class="prop-card-dot" style="background:#38bdf8;"></span>
            </div>
            <div class="prop-card-box-value" style="color:#38bdf8;">${payoffText}</div>
            <div class="prop-card-box-sub"><span>${payoffSub}</span></div>
          </div>
        </div>
      `;

      var editBtn = document.getElementById('standard-edit-goal-btn');
      if (editBtn) {
        editBtn.onclick = function () {
          var mainBtn = document.getElementById('edit-goal-btn');
          if (mainBtn) {
            mainBtn.click();
          } else {
            var modal = document.getElementById('goal-modal');
            if (modal) {
              modal.style.display = 'flex';
              modal.classList.add('active');
            }
          }
        };
      }

      if (typeof lucide !== 'undefined' && typeof lucide.createIcons === 'function') {
        try {
          lucide.createIcons({ root: propCardEl });
        } catch (e) {
          lucide.createIcons();
        }
      }
    }

    function bindHudButtons(account, tmpl, nextPhaseIdx, warningsList) {
      var t = function (key, params) {
        return (window.i18n && typeof window.i18n.t === 'function') ? window.i18n.t(key, params) : key;
      };

      // Toggle View button
      var toggleBtn = document.getElementById('dashboard-toggle-view-btn');
      if (toggleBtn) {
        toggleBtn.onclick = function() {
          window._propViewMode = window._propViewMode === 'standard' ? 'prop' : 'standard';
          refreshDashboardPropBanner();
        };
      }

      // Prepare notices modal content
      var noticesBodyEl = document.getElementById('dashboard-prop-notices-body');
      var noticesDiscEl = document.getElementById('dashboard-prop-notices-disclaimer');
      if (noticesBodyEl) {
        var itemsHtml = '';
        (warningsList || []).forEach(function(w) {
          var msg = '';
          if (w === 'UNVERIFIED_PHASE_RULES') msg = t('prop.unverified_warning');
          else if (w === 'EQUITY_BASED_ESTIMATED') msg = t('prop.warn_equity_estimated');
          else if (w === 'INTRADAY_BREACH_POSSIBLE') msg = t('prop.warn_intraday_breach');
          else if (w === 'INTRADAY_ORDER_UNKNOWN') msg = t('prop.warn_intraday_order');
          else if (w === 'CONSISTENCY_NOT_MET') msg = t('prop.warn_consistency');
          else msg = w;
          itemsHtml += `
            <div class="prop-notice-item">
              <span>${escapeHtml(msg)}</span>
            </div>
          `;
        });
        noticesBodyEl.innerHTML = itemsHtml || `<div style="font-size:0.85rem;color:var(--muted);padding:0.5rem 0;">${escapeHtml(t('prop.no_warnings') || 'Aktif kural uyarısı bulunmuyor.')}</div>`;
      }
      if (noticesDiscEl) {
        noticesDiscEl.innerHTML = `
          <span>${escapeHtml(t('prop.disclaimer', { last_verified: (account.rules && account.rules.last_verified) || (tmpl && tmpl.last_verified) || '2026-10-04' }))}</span>
        `;
      }

      // Bind notices button
      var openNoticesBtn = document.getElementById('dashboard-open-notices-btn');
      if (openNoticesBtn) {
        openNoticesBtn.onclick = function() {
          var modal = document.getElementById('dashboard-prop-notices-modal');
          if (modal) {
            modal.style.display = 'flex';
            modal.classList.add('active');
            if (typeof lucide !== 'undefined') lucide.createIcons();
          }
        };
      }

      // Bind advance button click
      var advBtn = document.getElementById('dashboard-advance-phase-btn');
      if (advBtn) {
        advBtn.onclick = function() {
          openAdvancePhaseModal(account, tmpl, nextPhaseIdx);
        };
      }
    }

    function updateTradesOnDateWarning(dateVal) {
      var warnBox = document.getElementById('advance-trades-warning');
      var warnText = document.getElementById('advance-trades-warning-text');
      var bumpBtn = document.getElementById('advance-bump-date-btn');
      if (!warnBox || !warnText || !dateVal) return;

      var tradesList = [];
      if (_currentPropSync && _currentPropSync.trades && Array.isArray(_currentPropSync.trades)) {
        tradesList = _currentPropSync.trades;
      } else if (window.wwCache && window.currentUser) {
        var jid = window.journal ? window.journal.getActiveJournalId() : null;
        tradesList = window.wwCache.get('trades_dashboard', window.currentUser.id, jid) || [];
      }

      var count = 0;
      for (var i = 0; i < tradesList.length; i++) {
        var td = String(tradesList[i].trade_date || '').slice(0, 10);
        if (td === dateVal) count++;
      }

      if (count > 0) {
        var d = new Date(dateVal + 'T00:00:00');
        d.setDate(d.getDate() + 1);
        var tomorrowStr = d.toISOString().slice(0, 10);
        var tFn = function(k, p) { return (window.i18n && window.i18n.t) ? window.i18n.t(k, p) : k; };
        warnText.textContent = tFn('prop.advance_trades_on_date_warn', { n: count, tomorrow: tomorrowStr }) || ('Bu tarihte ' + count + ' işlem var, yeni faza dahil edilecek. Başlangıç tarihini ertesi güne (' + tomorrowStr + ') almak ister misin?');
        if (bumpBtn) {
          bumpBtn.onclick = function() {
            var dateInput = document.getElementById('advance-phase-start-date');
            if (dateInput) {
              dateInput.value = tomorrowStr;
              updateTradesOnDateWarning(tomorrowStr);
            }
          };
        }
        warnBox.style.display = 'block';
      } else {
        warnBox.style.display = 'none';
      }
    }

    function openAdvancePhaseModal(account, tmpl, nextPhaseIdx) {
      var modal = document.getElementById('dashboard-advance-phase-modal');
      var dateInput = document.getElementById('advance-phase-start-date');
      var balInput = document.getElementById('advance-phase-starting-balance');
      var customChoice = document.getElementById('advance-custom-rules-choice');
      if (!modal || !dateInput || !balInput) return;

      var todayStr = new Date().toISOString().slice(0, 10);
      dateInput.value = todayStr;
      balInput.value = account.starting_balance || 100000;

      // Show custom rules choice if account rules were customized
      if (customChoice) {
        var isCust = Boolean(account.rules && account.rules.is_customized);
        customChoice.style.display = isCust ? 'block' : 'none';
        var keepRadio = document.getElementById('advance-rules-keep');
        if (keepRadio) keepRadio.checked = true;
      }

      updateTradesOnDateWarning(todayStr);
      dateInput.onchange = function() { updateTradesOnDateWarning(dateInput.value); };
      dateInput.oninput = function() { updateTradesOnDateWarning(dateInput.value); };

      modal.style.display = 'flex';
      modal.classList.add('active');
      if (typeof lucide !== 'undefined') lucide.createIcons();
    }

    function closeAdvancePhaseModal() {
      var modal = document.getElementById('dashboard-advance-phase-modal');
      if (modal) {
        modal.style.display = 'none';
        modal.classList.remove('active');
      }
    }

    document.addEventListener('DOMContentLoaded', function() {
      var closeBtn = document.getElementById('close-advance-modal');
      var cancelBtn = document.getElementById('cancel-advance-modal');
      var confirmBtn = document.getElementById('confirm-advance-modal');
      if (closeBtn) closeBtn.onclick = closeAdvancePhaseModal;
      if (cancelBtn) cancelBtn.onclick = closeAdvancePhaseModal;

      var closeNoticesBtn = document.getElementById('close-dashboard-prop-notices');
      if (closeNoticesBtn) {
        closeNoticesBtn.onclick = function() {
          var modal = document.getElementById('dashboard-prop-notices-modal');
          if (modal) {
            modal.style.display = 'none';
            modal.classList.remove('active');
          }
        };
      }

      var advModal = document.getElementById('dashboard-advance-phase-modal');
      if (advModal) {
        advModal.addEventListener('click', function(e) {
          if (e.target === advModal) closeAdvancePhaseModal();
        });
      }
      var noticesModal = document.getElementById('dashboard-prop-notices-modal');
      if (noticesModal) {
        noticesModal.addEventListener('click', function(e) {
          if (e.target === noticesModal) {
            noticesModal.style.display = 'none';
            noticesModal.classList.remove('active');
          }
        });
      }

      if (confirmBtn) {
        confirmBtn.onclick = async function() {
          if (!_currentPropSync || !_currentPropSync.account) return;
          var account = _currentPropSync.account;
          var nextPhaseIdx = (account.phase_index !== undefined ? account.phase_index + 1 : 1);
          var startDate = document.getElementById('advance-phase-start-date').value;
          var balance = Number(document.getElementById('advance-phase-starting-balance').value);
          var keepCustomRules = document.getElementById('advance-rules-keep') ? document.getElementById('advance-rules-keep').checked : false;
          var t = function (key) {
            return (window.i18n && typeof window.i18n.t === 'function') ? window.i18n.t(key) : key;
          };

          if (!startDate) {
            if (window.showToast) window.showToast(t('prop.err_select_start_date'), 'error');
            return;
          }
          if (isNaN(balance) || balance <= 0) {
            if (window.showToast) window.showToast(t('prop.err_invalid_balance'), 'error');
            return;
          }

          try {
            confirmBtn.disabled = true;
            await window.PropService.advancePhase(account.id, {
              newPhaseIndex: nextPhaseIdx,
              startDate: startDate,
              startingBalance: balance,
              keepCustomRules: keepCustomRules
            });
            if (window.showToast) window.showToast(t('prop.advance_success'), 'success');
            closeAdvancePhaseModal();
            refreshDashboardPropBanner();
          } catch (err) {
            if (window.showToast) window.showToast(err.message, 'error');
          } finally {
            confirmBtn.disabled = false;
          }
        };
      }

      // ============================================================
      // DUAL DONUT SLIDER (WIN/LOSS & LONG/SHORT)
      // ============================================================
      function initDonutSlider() {
        var card = document.getElementById('donut-slider-card');
        var track = document.getElementById('donut-slider-track');
        var prevBtn = document.getElementById('donut-prev-btn');
        var nextBtn = document.getElementById('donut-next-btn');
        var dots = document.querySelectorAll('#donut-slider-dots .donut-slider-dot');
        var titleEl = document.getElementById('donut-slider-title');
        if (!card || !track) return;

        var currentSlide = 0;
        var totalSlides = 2;

        function updateSlide(idx) {
          currentSlide = (idx + totalSlides) % totalSlides;
          track.style.transform = 'translateX(-' + (currentSlide * 100) + '%)';
          
          dots.forEach(function(dot, i) {
            if (i === currentSlide) {
              dot.classList.add('active');
            } else {
              dot.classList.remove('active');
            }
          });

          if (titleEl) {
            var t = function(key, fallback) {
              return (window.i18n && typeof window.i18n.t === 'function') ? window.i18n.t(key) : fallback;
            };
            if (currentSlide === 0) {
              titleEl.textContent = t('dashboard.chart.winloss') || 'Win / Loss Dağılımı';
              titleEl.setAttribute('data-i18n', 'dashboard.chart.winloss');
            } else {
              titleEl.textContent = t('dashboard.chart.direction') || 'Long / Short Dağılımı';
              titleEl.setAttribute('data-i18n', 'dashboard.chart.direction');
            }
          }
        }

        if (prevBtn) {
          prevBtn.onclick = function(e) {
            e.stopPropagation();
            updateSlide(currentSlide - 1);
          };
        }
        if (nextBtn) {
          nextBtn.onclick = function(e) {
            e.stopPropagation();
            updateSlide(currentSlide + 1);
          };
        }
        dots.forEach(function(dot) {
          dot.onclick = function(e) {
            e.stopPropagation();
            var slideIdx = parseInt(dot.getAttribute('data-slide'), 10) || 0;
            updateSlide(slideIdx);
          };
        });

        // Touch swipe support
        var touchStartX = 0;
        var touchEndX = 0;
        card.addEventListener('touchstart', function(e) {
          touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });

        card.addEventListener('touchend', function(e) {
          touchEndX = e.changedTouches[0].screenX;
          var diff = touchStartX - touchEndX;
          if (Math.abs(diff) > 40) {
            if (diff > 0) {
              updateSlide(currentSlide + 1);
            } else {
              updateSlide(currentSlide - 1);
            }
          }
        }, { passive: true });

        window._updateDonutSlider = updateSlide;
        updateSlide(0);
      }

      initDonutSlider();

      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
        if (typeof wwLog !== 'undefined' && wwLog.log) {
          wwLog.log('✅ Lucide icons initialized on dashboard!');
        }
      }
      refreshDashboardPropBanner();
    });

    window.addEventListener('journal-changed', function() {
      refreshDashboardPropBanner();
    });
    window.addEventListener('trade-saved', function() {
      refreshDashboardPropBanner();
    });
    window.addEventListener('trade-deleted', function() {
      refreshDashboardPropBanner();
    });
    window.addEventListener('dashboard-refreshed', function() {
      refreshDashboardPropBanner();
    });
    if (window.i18n && typeof window.i18n.onChange === 'function') {
      window.i18n.onChange(function() {
        refreshDashboardPropBanner();
        if (typeof window._updateDonutSlider === 'function') {
          window._updateDonutSlider(0);
        }
      });
    }
  </script>

</Layout>