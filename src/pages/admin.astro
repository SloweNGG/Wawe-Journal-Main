  <script is:inline>
    (function bootstrapAdmin() {
      function start() {
        if (typeof loadNavbar === 'function') {
          try { loadNavbar('navbar-container'); } catch(e) {}
        }
        if (typeof lucide !== 'undefined') {
          try { lucide.createIcons(); } catch(e) {}
        }

        var attempts = 0;
        var checkInterval = setInterval(function() {
          attempts++;
          if (typeof initAdmin === 'function') {
            clearInterval(checkInterval);
            try {
              initAdmin();
            } catch(e) {
              console.error('Admin panel hatasÄ±:', e);
            }
          } else if (attempts >= 80) {
            clearInterval(checkInterval);
            console.error('initAdmin fonksiyonu bulunamadÄ± (timeout).');
            var mc = document.getElementById('main-content');
            if (mc) {
              mc.innerHTML = '<div style="text-align:center;padding:4rem;"><p style="color:#ef4444;font-weight:600;font-size:15px;">Admin panel baÅŸlatÄ±lamadÄ±.</p><p style="color:var(--muted);font-size:13px;margin-top:0.5rem;">LÃ¼tfen sayfayÄ± yenileyin veya internet baÄŸlantÄ±nÄ±zÄ± kontrol edin.</p><button class="btn btn-primary" onclick="location.reload()" style="margin-top:1.25rem;">SayfayÄ± Yenile</button></div>';
            }
          }
        }, 100);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start);
      } else {
        start();
      }
    })();
  </script>
