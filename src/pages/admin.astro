---
import Layout from '../layouts/Layout.astro';
---
<Layout lang="tr" spa={true}>
<Fragment slot="head">
  <title>Admin Panel – Wawe Journal</title>

  <!-- ADMIN CSS -->
  <link rel="stylesheet" href="/interface/admin/css/admin.css?v=1792800100" />

  <link rel="preload" href="https://cdn.jsdelivr.net/npm/apexcharts@8.2.0" as="script" />
  <link rel="preload" href="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.117.3" as="script" />
  <script src="https://cdn.jsdelivr.net/npm/apexcharts@8.2.0" is:inline defer></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.117.3" is:inline defer></script>
  <script src="/config.js?v=1790450000" is:inline defer></script>
  <script src="/i18n.js?v=1790450000" is:inline defer></script>
  <script type="module" src="/src/bundle.js?v=1790450000" is:inline></script>
  <script src="/interface/admin/js/admin-core.js?v=1792800100" is:inline defer data-page-script></script>
  <script src="/interface/admin/js/admin-data.js?v=1792800100" is:inline defer data-page-script></script>
  <script src="/interface/admin/js/admin-dashboard.js?v=1792800100" is:inline defer data-page-script></script>
</Fragment>
  <!-- MAIN -->
  <main class="admin-main" id="main-content">
    <div class="admin-loading">
      <div class="spinner"></div>
      <p>Admin panel yükleniyor...</p>
    </div>
  </main>

  <!-- TOAST -->
  <div class="toast-container" id="toast-container"></div>

  <!-- REFERANS MODAL -->
  <div id="ref-modal" class="modal-overlay">
    <div class="modal-box">
      <div class="modal-header">
        <h2 id="ref-modal-title">Yeni Referans Ekle</h2>
        <button type="button" class="modal-close" id="close-ref-modal" aria-label="Kapat">✕</button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="ref-id" />
        <div class="field-row">
          <div class="field">
            <label for="ref-name">İsim *</label>
            <input type="text" id="ref-name" placeholder="Ahmet Yılmaz" />
          </div>
          <div class="field">
            <label for="ref-title">Ünvan / Pozisyon</label>
            <input type="text" id="ref-title" placeholder="Forex Trader" />
          </div>
        </div>
        <div class="field">
          <label for="ref-desc">Açıklama</label>
          <textarea id="ref-desc" rows="3" placeholder="Bu kişi hakkında kısa bilgi..."></textarea>
        </div>
        <div class="section-divider">Profil Fotoğrafı</div>
        <div class="avatar-upload">
          <div class="avatar-preview-sm">
            <img id="ref-image-preview-img" src="https://placehold.co/64x64?text=Photo" alt="Önizleme" />
          </div>
          <div class="avatar-actions">
            <input type="file" id="ref-image-file" accept="image/*" hidden />
            <button type="button" class="btn btn-ghost btn-sm" id="upload-image-btn">Resim Seç</button>
            <button type="button" class="btn btn-danger btn-sm" id="remove-image-btn">Kaldır</button>
            <input type="hidden" id="ref-image" value="" />
          </div>
        </div>
        <div class="field-row field-row-spaced">
          <div class="field"><label for="ref-order">Sıralama</label><input type="number" id="ref-order" value="0" /></div>
          <div class="field"><label for="ref-active">Durum</label><select id="ref-active"><option value="true">Aktif</option><option value="false">Pasif</option></select></div>
        </div>
        <div class="section-divider">Sosyal Medya</div>
        <div class="field-row">
          <div class="field"><label for="ref-insta">Instagram</label><input type="text" id="ref-insta" placeholder="https://instagram.com/..." /></div>
          <div class="field"><label for="ref-twitter">Twitter / X</label><input type="text" id="ref-twitter" placeholder="https://twitter.com/..." /></div>
        </div>
        <div class="field-row">
          <div class="field"><label for="ref-youtube">YouTube</label><input type="text" id="ref-youtube" placeholder="https://youtube.com/..." /></div>
          <div class="field"><label for="ref-linkedin">LinkedIn</label><input type="text" id="ref-linkedin" placeholder="https://linkedin.com/..." /></div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" id="cancel-ref-btn">İptal</button>
        <button type="button" class="btn btn-primary" id="save-ref-btn">Kaydet</button>
      </div>
    </div>
  </div>

  <!-- REFERRAL CODE MODAL -->
  <div id="referral-code-modal" class="modal-overlay">
    <div class="modal-box">
      <div class="modal-header">
        <h2 id="rc-modal-title">Yeni Referans Kodu Ekle</h2>
        <button type="button" class="modal-close" id="close-rc-modal" aria-label="Kapat">✕</button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="rc-id" />
        <div class="field-row">
          <div class="field">
            <label for="rc-code">Kod *</label>
            <input type="text" id="rc-code" placeholder="Örn: AHMET20" class="input-upper" />
          </div>
          <div class="field">
            <label for="rc-discount">İndirim Yüzdesi * (0-100)</label>
            <input type="number" id="rc-discount" placeholder="20" min="0" max="100" />
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="rc-name">Referans Adı</label>
            <input type="text" id="rc-name" placeholder="Ahmet Yılmaz" />
          </div>
          <div class="field">
            <label for="rc-email">Referans E-postası</label>
            <input type="email" id="rc-email" placeholder="ahmet@example.com" />
          </div>
        </div>
        <div class="field">
          <label for="rc-influencer-email">Influencer Hesabı (Sistem E-postası)</label>
          <input type="email" id="rc-influencer-email" placeholder="Sisteme kayıtlı e-posta..." />
          <small class="field-hint">Boş bırakılırsa Kazançlarım paneline yansımaz.</small>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="rc-commission">Aylık Komisyon ($)</label>
            <input type="number" id="rc-commission" placeholder="Örn: 4" min="0" step="0.01" />
          </div>
          <div class="field">
            <label for="rc-commission-yearly">Yıllık Komisyon ($)</label>
            <input type="number" id="rc-commission-yearly" placeholder="Örn: 25" min="0" step="0.01" />
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="rc-max-usage">Maksimum Kullanım (Boş = Sınırsız)</label>
            <input type="number" id="rc-max-usage" placeholder="100" min="0" />
          </div>
          <div class="field">
            <label for="rc-expires">Son Kullanma Tarihi (Boş = Süresiz)</label>
            <input type="date" id="rc-expires" />
          </div>
        </div>
        <div class="field-row field-row-spaced">
          <div class="field">
            <label for="rc-active">Durum</label>
            <select id="rc-active">
              <option value="true">Aktif</option>
              <option value="false">Pasif</option>
            </select>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" id="cancel-rc-btn">İptal</button>
        <button type="button" class="btn btn-primary" id="save-rc-btn">Kaydet</button>
      </div>
    </div>
  </div>

  <!-- PAYOUT ACTION MODAL -->
  <div id="payout-action-modal" class="modal-overlay">
    <div class="modal-box modal-box-sm">
      <div class="modal-header">
        <h2 id="payout-modal-title">Çekim Talebi İşlemi</h2>
        <button type="button" class="modal-close" id="close-payout-modal" aria-label="Kapat" onclick="if(window.closePayoutModal) window.closePayoutModal();">✕</button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="payout-action-id" />
        <input type="hidden" id="payout-action-type" />

        <div class="info-box">
          <div class="info-row">
            <span>Kullanıcı</span>
            <strong id="payout-modal-user">—</strong>
          </div>
          <div class="info-row">
            <span>Tutar</span>
            <strong id="payout-modal-amount" class="text-green">—</strong>
          </div>
          <div class="info-row">
            <span>Kripto Para</span>
            <strong id="payout-modal-currency">—</strong>
          </div>
          <div class="info-col">
            <span>Çekim Adresi</span>
            <div id="payout-modal-address" class="info-mono">—</div>
          </div>
        </div>

        <div class="field">
          <label id="payout-note-label" for="payout-modal-note">Admin Notu / İşlem Referansı (TxID)</label>
          <textarea id="payout-modal-note" rows="3" placeholder="Örn: TXID: a1b2c3d4... veya onaylandı/reddedildi açıklaması"></textarea>
          <small id="payout-note-help" class="field-hint">Bu not kullanıcı tarafından da görüntülenebilir.</small>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" id="cancel-payout-btn" onclick="if(window.closePayoutModal) window.closePayoutModal();">Vazgeç</button>
        <button type="button" class="btn btn-primary" id="confirm-payout-btn" onclick="if(window.confirmPayoutAction) window.confirmPayoutAction();">Onayla</button>
      </div>
    </div>
  </div>

  <!-- PARTNER APPLICATION REVIEW MODAL -->
  <div id="partner-app-modal" class="modal-overlay">
    <div class="modal-box modal-box-md">
      <div class="modal-header">
        <h2 id="partner-app-modal-title">Partner Başvurusu İşlemi</h2>
        <button type="button" class="modal-close" id="close-partner-app-modal" aria-label="Kapat" onclick="if(window.closePartnerAppModal) window.closePartnerAppModal();">✕</button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="pa-modal-id" />
        <input type="hidden" id="pa-modal-type" />

        <div class="info-box">
          <div class="info-row">
            <span>Kullanıcı</span>
            <strong id="pa-modal-user">—</strong>
          </div>
          <div class="info-row">
            <span>Instagram</span>
            <a id="pa-modal-instagram" href="#" target="_blank" rel="noopener noreferrer" class="info-link">—</a>
          </div>
          <div class="info-row">
            <span>Takipçi Boyutu</span>
            <strong id="pa-modal-followers">—</strong>
          </div>
          <div class="info-row">
            <span>Kripto Kullanımı</span>
            <strong id="pa-modal-crypto">—</strong>
          </div>
          <div class="info-col">
            <span>Kullanıcı Notu</span>
            <div id="pa-modal-user-note" class="info-note">—</div>
          </div>
        </div>

        <!-- Onaylama durumunda görünen kod tanımlama alanları -->
        <div id="pa-approve-fields" class="approve-fields">
          <div class="section-divider">Tanımlanacak Referans Kodu</div>
          <div class="field-row">
            <div class="field">
              <label for="pa-code-input">Referans Kodu *</label>
              <input type="text" id="pa-code-input" placeholder="Örn: INSTA10" class="input-upper" />
            </div>
            <div class="field">
              <label for="pa-discount-input">Kullanıcı İndirimi (%) *</label>
              <input type="number" id="pa-discount-input" value="10" min="0" max="100" />
            </div>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="pa-commission-input">Aylık Komisyon ($/satış) *</label>
              <input type="number" id="pa-commission-input" value="4" min="0" step="0.5" />
            </div>
            <div class="field">
              <label for="pa-commission-yearly-input">Yıllık Komisyon ($/satış) *</label>
              <input type="number" id="pa-commission-yearly-input" value="25" min="0" step="0.5" />
            </div>
          </div>
        </div>

        <!-- Yönetici notu (her iki durumda da geçerli) -->
        <div class="field">
          <label id="pa-note-label" for="pa-modal-admin-note">Yönetici Notu</label>
          <textarea id="pa-modal-admin-note" rows="3" placeholder="Açıklama veya ret gerekçesi..."></textarea>
          <small id="pa-note-help" class="field-hint">Bu açıklama kullanıcının panelinde gösterilir.</small>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="if(window.closePartnerAppModal) window.closePartnerAppModal();">Vazgeç</button>
        <button type="button" class="btn btn-primary" id="confirm-partner-app-btn" onclick="if(window.confirmPartnerAppAction) window.confirmPartnerAppAction();">Onayla</button>
      </div>
    </div>
  </div>

  <!-- BİLDİRİM GÖNDERME MODAL -->
  <div class="modal-overlay" id="admin-notification-modal">
    <div class="modal-box modal-box-sm">
      <div class="modal-header">
        <h2>Özel Bildirim Gönder</h2>
        <button type="button" class="modal-close" aria-label="Kapat" onclick="if(window.closeNotificationModal) window.closeNotificationModal();">✕</button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="noti-modal-user-id" />
        <div class="info-box">
          <div class="info-row">
            <span>Kullanıcı</span>
            <strong id="noti-modal-user-name">—</strong>
          </div>
        </div>
        <div class="field">
          <label for="noti-modal-type">Bildirim Tipi</label>
          <select id="noti-modal-type" class="ww-select">
            <option value="info">Bilgi (Info)</option>
            <option value="success">Başarılı (Success)</option>
            <option value="warning">Uyarı (Warning)</option>
            <option value="error">Hata (Error)</option>
            <option value="finance">Finans (Finance)</option>
          </select>
        </div>
        <div class="field">
          <label for="noti-modal-title">Başlık</label>
          <input type="text" id="noti-modal-title" placeholder="Örn: Hesabınız Onaylandı" />
        </div>
        <div class="field">
          <label for="noti-modal-desc">Açıklama</label>
          <textarea id="noti-modal-desc" rows="3" placeholder="Mesajınız..."></textarea>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="if(window.closeNotificationModal) window.closeNotificationModal();">Vazgeç</button>
        <button type="button" class="btn btn-primary" id="send-noti-btn" onclick="if(window.sendAdminNotification) window.sendAdminNotification();">Bildirimi Gönder</button>
      </div>
    </div>
  </div>

  <!-- DESTEK ENGELLEME MODAL -->
  <div class="modal-overlay" id="support-ban-modal">
    <div class="modal-box modal-box-sm">
      <div class="modal-header">
        <h2 class="modal-title-danger">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
          Kullanıcıyı Destekten Engelle
        </h2>
        <button type="button" class="modal-close" aria-label="Kapat" onclick="if(window.closeBanModal) window.closeBanModal();">✕</button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="ban-modal-user-id" />
        <input type="hidden" id="ban-modal-user-email" />
        <input type="hidden" id="ban-modal-user-name" />

        <div class="info-box info-box-danger">
          <div class="info-row">
            <span>Kullanıcı Adı</span>
            <strong id="ban-modal-display-name">—</strong>
          </div>
          <div class="info-row">
            <span>E-posta</span>
            <strong id="ban-modal-display-email" class="mono">—</strong>
          </div>
        </div>

        <div class="field">
          <label for="ban-modal-reason">Engelleme Gerekçesi (Kullanıcıya Gösterilecek) *</label>
          <textarea id="ban-modal-reason" rows="3" placeholder="Örn: Uygunsuz üslup, spam ve anlamsız hata bildirimleri gönderimi sebebiyle erişiminiz askıya alınmıştır."></textarea>
          <small class="field-hint">Bu gerekçe kullanıcı hata bildirme sayfasına girdiğinde doğrudan karşısına çıkacak ve form göndermesi engellenecektir.</small>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="if(window.closeBanModal) window.closeBanModal();">Vazgeç</button>
        <button type="button" class="btn btn-danger btn-danger-solid" id="confirm-ban-btn" onclick="if(window.confirmSupportBan) window.confirmSupportBan();">Engelle ve Erişimi Durdur</button>
      </div>
    </div>
  </div>

  <!-- HATA BİLDİRİMİ YANIT MODAL -->
  <div class="modal-overlay" id="bug-reply-modal">
    <div class="modal-box modal-box-md">
      <div class="modal-header">
        <h2 class="modal-title-accent">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 17 4 12 9 7"/><path d="M20 18v-2a4 4 0 0 0-4-4H4"/></svg>
          Bildirime Yanıt Ver
        </h2>
        <button type="button" class="modal-close" aria-label="Kapat" onclick="if(window.closeBugReplyModal) window.closeBugReplyModal();">✕</button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="reply-modal-report-id" />

        <div class="info-box">
          <div class="info-row">
            <span>Konu</span>
            <strong id="reply-modal-subject">—</strong>
          </div>
          <div class="info-row">
            <span>Gönderen</span>
            <strong id="reply-modal-sender" class="text-accent">—</strong>
          </div>
        </div>

        <div class="field">
          <label for="reply-modal-status">Yeni Durum</label>
          <select id="reply-modal-status" class="ww-select">
            <option value="answered">Yanıtlandı (Answered)</option>
            <option value="in_progress">İnceleniyor (In Progress)</option>
            <option value="closed">Çözüldü &amp; Kapatıldı (Resolved)</option>
            <option value="rejected">Reddedildi (Rejected)</option>
          </select>
        </div>

        <div class="field">
          <label for="reply-modal-text">Admin Yanıtı *</label>
          <textarea id="reply-modal-text" rows="4" placeholder="Kullanıcıya iletilecek açıklama ve çözüm mesajı..."></textarea>
          <small class="field-hint">Mesaj kullanıcıya "Wawe Journal Ekibi (Admin)" rozetiyle aktarılacaktır.</small>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="if(window.closeBugReplyModal) window.closeBugReplyModal();">Vazgeç</button>
        <button type="button" class="btn btn-primary" id="confirm-reply-btn" onclick="if(window.confirmBugReply) window.confirmBugReply();">Cevabı Gönder</button>
      </div>
    </div>
  </div>

  <!-- HATA BİLDİRİMİ RET MODAL -->
  <div class="modal-overlay" id="bug-reject-modal">
    <div class="modal-box modal-box-md">
      <div class="modal-header">
        <h2 class="modal-title-danger">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
          Bildirimi Reddet
        </h2>
        <button type="button" class="modal-close" aria-label="Kapat" onclick="if(window.closeBugRejectModal) window.closeBugRejectModal();">✕</button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="reject-modal-report-id" />

        <div class="info-box info-box-danger">
          <div class="info-row">
            <span>Konu</span>
            <strong id="reject-modal-subject">—</strong>
          </div>
          <div class="info-row">
            <span>Gönderen</span>
            <strong id="reject-modal-sender" class="text-red">—</strong>
          </div>
        </div>

        <div class="field">
          <label for="reject-preset-select">Hızlı Reddetme Gerekçesi</label>
          <select id="reject-preset-select" class="ww-select" onchange="if(window.onBugRejectPresetChange) window.onBugRejectPresetChange(this.value);">
            <option value="invalid">Geçersiz / Doğrulanamayan Bildirim</option>
            <option value="user_error">Kullanıcı Hatası / Sistem Hatası Değil</option>
            <option value="duplicate">Mükerrer / Zaten Bildirilmiş Konu</option>
            <option value="missing_info">Eksik Bilgi / Yetersiz Detay</option>
            <option value="spam">Asılsız / Spam Bildirim</option>
            <option value="custom">Özel Gerekçe Yaz</option>
          </select>
        </div>

        <div class="field">
          <label for="reject-modal-reason">Kullanıcıya Gösterilecek Reddetme Notu *</label>
          <textarea id="reject-modal-reason" rows="3" placeholder="Bildirimin neden reddedildiğini açıklayın..."></textarea>
          <small class="field-hint">Bu açıklama kullanıcının hata bildirimi detayında "Reddedildi" statüsü altında görüntülenecektir.</small>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="if(window.closeBugRejectModal) window.closeBugRejectModal();">Vazgeç</button>
        <button type="button" class="btn btn-danger btn-danger-solid" id="confirm-reject-btn" onclick="if(window.confirmBugReject) window.confirmBugReject();">Bildirimi Reddet</button>
      </div>
    </div>
  </div>

  <script is:inline>
    (function bootstrapAdmin() {
      function start() {
        if (typeof loadNavbar === 'function') {
          try { loadNavbar('navbar-container'); } catch(e) {}
        }
        if (typeof lucide !== 'undefined') {
          try { lucide.createIcons(); } catch(e) {}
        }

        var attempts = 0;
        var checkInterval = setInterval(function() {
          attempts++;
          if (typeof initAdmin === 'function') {
            clearInterval(checkInterval);
            try {
              initAdmin();
            } catch(e) {
              console.error('Admin panel hatası:', e);
            }
          } else if (attempts >= 80) {
            clearInterval(checkInterval);
            console.error('initAdmin fonksiyonu bulunamadı (timeout).');
            var mc = document.getElementById('main-content');
            if (mc) {
              mc.innerHTML = '<div class="admin-loading"><p class="admin-error-title">Admin panel başlatılamadı.</p><p>Lütfen sayfayı yenileyin veya internet bağlantınızı kontrol edin.</p><button type="button" class="btn btn-primary" onclick="location.reload()">Sayfayı Yenile</button></div>';
            }
          }
        }, 100);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start);
      } else {
        start();
      }
    })();
  </script>
</Layout>
