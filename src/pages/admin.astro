---
import Layout from '../layouts/Layout.astro';
---
<Layout lang="tr">
<Fragment slot="head">
  <title>Admin Panel – Wawe Journal</title>
  
  <!-- ADMIN CSS -->
  <link rel="stylesheet" href="/interface/admin/css/admin.css?v=26" />
  
  <link rel="preload" href="https://cdn.jsdelivr.net/npm/apexcharts@3.45.2" as="script" />
  <link rel="preload" href="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" as="script" />
  <script src="https://cdn.jsdelivr.net/npm/apexcharts@3.45.2" is:inline defer></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" is:inline defer></script>
  <script src="/config.js?v=26" is:inline defer></script>
  <script src="/i18n.js?v=26" is:inline defer></script>
  <script type="module" src="/src/bundle.js?v=26" is:inline></script>
  <script src="/components/navbar/navbar.js?v=1790153937" is:inline defer></script>
  <script src="/interface/admin/js/admin-core.js?v=26" is:inline defer></script>
  <script src="/interface/admin/js/admin-data.js?v=26" is:inline defer></script>
  <script src="/interface/admin/js/admin-dashboard.js?v=26" is:inline defer></script>
</Fragment>
  <!-- MAIN -->
  <main class="admin-main" id="main-content">
    <div style="display:flex;justify-content:center;padding:4rem;flex-direction:column;align-items:center;gap:1rem;">
      <div class="spinner"></div>
      <p style="color:var(--muted);">Admin panel yükleniyor...</p>
    </div>
  </main>

  <!-- TOAST -->
  <div class="toast-container" id="toast-container"></div>

  <!-- REFERANS MODAL -->
  <div id="ref-modal" class="modal-overlay">
    <div class="modal-box">
      <div class="modal-header">
        <h2 id="ref-modal-title">Yeni Referans Ekle</h2>
        <button class="modal-close" id="close-ref-modal">✕</button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="ref-id" />
        <div class="field-row">
          <div class="field">
            <label>İsim *</label>
            <input type="text" id="ref-name" placeholder="Ahmet Yılmaz" />
          </div>
          <div class="field">
            <label>Ünvan / Pozisyon</label>
            <input type="text" id="ref-title" placeholder="Forex Trader" />
          </div>
        </div>
        <div class="field">
          <label>Açıklama</label>
          <textarea id="ref-desc" rows="3" placeholder="Bu kişi hakkında kısa bilgi..."></textarea>
        </div>
        <div class="section-divider">Profil Fotoğrafı</div>
        <div class="avatar-upload">
          <div class="avatar-preview-sm">
            <img id="ref-image-preview-img" src="https://placehold.co/64x64?text=Photo" />
          </div>
          <div class="avatar-actions">
            <input type="file" id="ref-image-file" accept="image/*" style="display:none;" />
            <button type="button" class="btn btn-ghost btn-sm" id="upload-image-btn">Resim Seç</button>
            <button type="button" class="btn btn-danger btn-sm" id="remove-image-btn">Kaldır</button>
            <input type="hidden" id="ref-image" value="" />
          </div>
        </div>
        <div class="field-row" style="margin-top:0.75rem;">
          <div class="field"><label>Sıralama</label><input type="number" id="ref-order" value="0" /></div>
          <div class="field"><label>Durum</label><select id="ref-active"><option value="true">✓ Aktif</option><option value="false">○ Pasif</option></select></div>
        </div>
        <div class="section-divider">Sosyal Medya</div>
        <div class="field-row">
          <div class="field"><label>Instagram</label><input type="text" id="ref-insta" placeholder="https://instagram.com/..." /></div>
          <div class="field"><label>Twitter / X</label><input type="text" id="ref-twitter" placeholder="https://twitter.com/..." /></div>
        </div>
        <div class="field-row">
          <div class="field"><label>YouTube</label><input type="text" id="ref-youtube" placeholder="https://youtube.com/..." /></div>
          <div class="field"><label>LinkedIn</label><input type="text" id="ref-linkedin" placeholder="https://linkedin.com/..." /></div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-ghost" id="cancel-ref-btn">İptal</button>
        <button class="btn btn-primary" id="save-ref-btn">Kaydet</button>
      </div>
    </div>
  </div>


  <!-- REFERRAL CODE MODAL -->
  <div id="referral-code-modal" class="modal-overlay">
    <div class="modal-box">
      <div class="modal-header">
        <h2 id="rc-modal-title">Yeni Referans Kodu Ekle</h2>
        <button class="modal-close" id="close-rc-modal">✕</button>
      </div>
      <div class="modal-body">
        <input type="hidden" id="rc-id" />
        <div class="field-row">
          <div class="field">
            <label>Kod *</label>
            <input type="text" id="rc-code" placeholder="Örn: AHMET20" style="text-transform: uppercase;" />
          </div>
          <div class="field">
            <label>İndirim Yüzdesi * (0-100)</label>
            <input type="number" id="rc-discount" placeholder="20" min="0" max="100" />
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label>Referans Adı</label>
            <input type="text" id="rc-name" placeholder="Ahmet Yılmaz" />
          </div>
          <div class="field">
            <label>Referans E-postası</label>
            <input type="email" id="rc-email" placeholder="ahmet@example.com" />
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label>Influencer Hesabı (Sistem E-postası)</label>
            <input type="email" id="rc-influencer-email" placeholder="Sisteme kayıtlı e-posta..." />
            <small style="color:var(--muted);font-size:0.75rem;">Boş bırakılırsa panele yansımaz.</small>
          </div>
          <div class="field">
            <label>Komisyon Oranı ($)</label>
            <input type="number" id="rc-commission" placeholder="Kullanım başına kazanç (örn: 5)" min="0" step="0.01" />
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label>Maksimum Kullanım (Boş = Sınırsız)</label>
            <input type="number" id="rc-max-usage" placeholder="100" />
          </div>
          <div class="field">
            <label>Son Kullanma Tarihi (Boş = Süresiz)</label>
            <input type="date" id="rc-expires" />
          </div>
        </div>
        <div class="field-row" style="margin-top:0.75rem;">
          <div class="field">
            <label>Durum</label>
            <select id="rc-active">
              <option value="true">✓ Aktif</option>
              <option value="false">○ Pasif</option>
            </select>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-ghost" id="cancel-rc-btn">İptal</button>
        <button class="btn btn-primary" id="save-rc-btn">Kaydet</button>
      </div>
    </div>
  </div>

  <!-- SCRIPTS -->
  
  
  
  
  
  
  
  
  
  
  <script is:inline>
    (function bootstrapAdmin() {
      function start() {
        if (typeof loadNavbar === 'function') {
          try { loadNavbar('navbar-container'); } catch(e) {}
        }
        if (typeof lucide !== 'undefined') {
          try { lucide.createIcons(); } catch(e) {}
        }

        var attempts = 0;
        var checkInterval = setInterval(function() {
          attempts++;
          if (typeof initAdmin === 'function') {
            clearInterval(checkInterval);
            try {
              initAdmin();
            } catch(e) {
              console.error('Admin panel hatası:', e);
            }
          } else if (attempts >= 80) {
            clearInterval(checkInterval);
            console.error('initAdmin fonksiyonu bulunamadı (timeout).');
            var mc = document.getElementById('main-content');
            if (mc) {
              mc.innerHTML = '<div style="text-align:center;padding:4rem;"><p style="color:#ef4444;font-weight:600;font-size:15px;">Admin panel başlatılamadı.</p><p style="color:var(--muted);font-size:13px;margin-top:0.5rem;">Lütfen sayfayı yenileyin veya internet bağlantınızı kontrol edin.</p><button class="btn btn-primary" onclick="location.reload()" style="margin-top:1.25rem;">Sayfayı Yenile</button></div>';
            }
          }
        }, 100);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start);
      } else {
        start();
      }
    })();
  </script>
</Layout>