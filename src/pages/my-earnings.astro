    .crypto-radio-card.active {
      border-color: var(--accent);
      background: rgba(139, 92, 246, 0.12);
      color: var(--text);
    }
    body.light-theme .crypto-radio-card.active {
      background: rgba(108, 92, 231, 0.08);
      border-color: var(--accent);
    }

    /* Modal Stilleri */
    .earnings-modal-overlay {
      position: fixed;
      inset: 0;
      background: var(--modal-backdrop);
      backdrop-filter: blur(var(--modal-blur));
      -webkit-backdrop-filter: blur(var(--modal-blur));
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
      padding: 1rem;
    }
    .earnings-modal-overlay.open {
      opacity: 1;
      pointer-events: auto;
    }
    .earnings-modal-card {
      font-family: var(--font);
      background: var(--modal-bg);
      border: 1px solid var(--modal-line);
      border-radius: var(--modal-radius);
      width: 100%;
      max-width: 480px;
      box-shadow: var(--modal-shadow);
      overflow: hidden;
      transform: translateY(15px);
      transition: transform 0.2s ease;
    }
    .earnings-modal-overlay.open .earnings-modal-card {
      transform: translateY(0);
    }
    .earnings-modal-header {
      padding: 1.1rem var(--modal-pad-x);
      border-bottom: 1px solid var(--modal-line);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .earnings-modal-header h3 {
      font-family: var(--font-display) !important;
      margin: 0;
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: -0.01em;
      color: var(--text);
      -webkit-text-fill-color: initial !important;
      background: none !important;
    }
    .earnings-modal-body {
      font-family: var(--font);
      padding: 1.25rem var(--modal-pad-x);
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    .earnings-modal-footer {
      padding: 0.95rem var(--modal-pad-x);
      border-top: 1px solid var(--modal-line);
      display: flex;
      justify-content: flex-end;
      gap: 0.6rem;
      background: var(--modal-bg);
    }
    .crypto-radio-group {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }
    .crypto-radio-card input {
      margin: 0;
    }

    /* Partner başvuru formu */
    .apply-card {
      max-width: 500px;
      background: #000;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 18px;
    }
    .apply-head {
      display: flex;
      align-items: flex-start;
      gap: 0.85rem;
      padding: 1.35rem 1.5rem 1.1rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .apply-head-icon {
      width: 38px;
      height: 38px;
      flex-shrink: 0;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #a78bfa;
    }
    .apply-head-text {
      flex: 1;
      min-width: 0;
    }
    .apply-title {
      font-family: var(--font) !important;
      font-size: 1.08rem;
      font-weight: 650;
      letter-spacing: -0.01em;
      margin: 0 0 0.25rem;
      color: var(--text) !important;
      -webkit-text-fill-color: initial !important;
      background: none !important;
    }
    .apply-sub {
      margin: 0;
      font-size: 12.5px;
      line-height: 1.5;
      color: var(--muted);
    }
    .apply-close {
      width: 30px;
      height: 30px;
      flex-shrink: 0;
      margin: -2px -6px 0 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: none;
      border-radius: 8px;
      color: var(--muted);
      cursor: pointer;
      transition: color 0.15s ease, background 0.15s ease;
    }
    .apply-close:hover {
      color: var(--text);
      background: rgba(255, 255, 255, 0.07);
    }
    .apply-body {
      font-family: var(--font);
      padding: 1.35rem 1.5rem 0.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.35rem;
    }
    .apply-field {
      display: flex;
      flex-direction: column;
    }
    .apply-label {
      font-size: 13px;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 0.5rem;
    }
    .apply-label-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
    }
    .apply-optional {
      font-size: 11.5px;
      font-weight: 500;
      color: var(--muted);
    }
    .apply-hint {
      margin: -0.25rem 0 0.65rem;
      font-size: 12px;
      color: var(--muted);
    }
    .apply-input-wrap {
      position: relative;
      display: flex;
      align-items: center;
    }
    .apply-input-wrap > i,
    .apply-input-wrap > svg {
      position: absolute;
      left: 0.85rem;
      color: var(--muted);
      pointer-events: none;
    }
    .apply-input {
      width: 100%;
      box-sizing: border-box;
      padding: 0.7rem 0.85rem;
      background: #000;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 10px;
      color: var(--text);
      font-family: var(--font);
      font-size: 14px;
      outline: none;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .apply-input-wrap .apply-input {
      padding-left: 2.4rem;
    }
    .apply-input::placeholder {
      color: rgba(255, 255, 255, 0.3);
    }
    .apply-input:focus {
      border-color: #7c6dfa;
      box-shadow: 0 0 0 3px rgba(124, 109, 250, 0.16);
    }
    .apply-textarea {
      resize: vertical;
      min-height: 88px;
      line-height: 1.5;
    }
    .apply-counter {
      align-self: flex-end;
      margin-top: 0.35rem;
      font-size: 11px;
      color: var(--muted);
      font-variant-numeric: tabular-nums;
    }
    .apply-chips {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.5rem;
    }
    .apply-chip {
      padding: 0.6rem 0.4rem;
      background: #000;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 10px;
      color: var(--muted);
      font-family: var(--font);
      font-size: 13px;
      font-weight: 600;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
      cursor: pointer;
      transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
    }
    .apply-chip:hover {
      color: var(--text);
      border-color: rgba(167, 139, 250, 0.5);
    }
    .apply-chip.active {
      color: #fff;
      border-color: #7c6dfa;
      background: rgba(124, 109, 250, 0.12);
    }
    .apply-choices {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem;
    }
    .apply-choice.crypto-radio-card {
      background: #000;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 10px;
      padding: 0.75rem 0.85rem;
      gap: 0.6rem;
      font-size: 13px;
      font-weight: 500;
      color: var(--muted);
    }
    .apply-choice.crypto-radio-card:hover {
      border-color: rgba(167, 139, 250, 0.5);
      color: var(--text);
    }
    .apply-choice.crypto-radio-card.active {
      border-color: #7c6dfa;
      background: rgba(124, 109, 250, 0.12);
      color: #fff;
    }
    .apply-radio {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
      border-radius: 50%;
      border: 1.5px solid rgba(255, 255, 255, 0.3);
      box-sizing: border-box;
      transition: border 0.15s ease;
    }
    .apply-choice.active .apply-radio {
      border: 5px solid #a78bfa;
    }
    .apply-chip:focus-visible,
    .apply-close:focus-visible {
      outline: 2px solid #a78bfa;
      outline-offset: 2px;
    }
    .apply-footer {
      display: flex;
      justify-content: flex-end;
      gap: 0.6rem;
      padding: 1rem 1.5rem 1.25rem;
    }

    body.light-theme .apply-card,
    body.light-theme .apply-input,
    body.light-theme .apply-chip,
    body.light-theme .apply-choice.crypto-radio-card {
      background: #fff;
      border-color: var(--border);
    }
    body.light-theme .apply-head {
      border-bottom-color: var(--border);
    }
    body.light-theme .apply-head-icon {
      border-color: var(--border);
      color: #7c3aed;
    }
    body.light-theme .apply-close:hover {
      background: rgba(0, 0, 0, 0.05);
    }
    body.light-theme .apply-input::placeholder {
      color: #94a3b8;
    }
    body.light-theme .apply-input:focus {
      border-color: #6366f1;
      box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.14);
    }
    body.light-theme .apply-chip.active,
    body.light-theme .apply-choice.crypto-radio-card.active {
      color: #1a1033;
      border-color: #7c3aed;
      background: rgba(124, 58, 237, 0.06);
    }
    body.light-theme .apply-radio {
      border-color: #cbd5e1;
    }
    body.light-theme .apply-choice.active .apply-radio {
      border-color: #7c3aed;
    }

    @media (max-width: 520px) {
      .apply-chips {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .apply-choices {
        grid-template-columns: 1fr;
      }
    }
  </style>

