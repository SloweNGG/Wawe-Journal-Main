---
import Layout from '../layouts/Layout.astro';
---
<Layout lang="en">
<Fragment slot="head">
  <title data-i18n="earnings.title">Kazançlarım & Para Çekme - Wawe Journal</title>
  
  <style>
    .earnings-stat-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .earnings-stat-grid .stat-card {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 102px;
      padding: 1.1rem 1.25rem;
    }
    .earnings-stat-grid .stat-label {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 0.25rem;
    }
    .earnings-stat-grid .stat-value {
      font-size: 1.75rem;
      font-weight: 700;
      line-height: 1.2;
      margin: 0.25rem 0;
    }
    .earnings-stat-grid .stat-sub {
      font-size: 11px;
      color: var(--muted);
      margin-top: 4px;
      line-height: 1.3;
    }
    .earnings-table-wrap {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      margin-bottom: 2rem;
    }
    .earnings-table-title {
      padding: 1.25rem 1.5rem;
      border-bottom: 1px solid var(--border);
      font-size: 1rem;
      font-weight: 600;
      margin: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .code-chip {
      font-family: monospace;
      font-size: 0.95rem;
      font-weight: 700;
      background: var(--surface2);
      color: var(--accent);
      border: 1px solid var(--border);
      padding: 4px 10px;
      border-radius: 6px;
      letter-spacing: 0.05em;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .earnings-empty {
      text-align: center;
      padding: 4rem 1rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      margin: 0;
    }
    .badge-status {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 10px;
      border-radius: 99px;
      font-size: 11px;
      font-weight: 600;
    }
    .badge-pending {
      background: rgba(234, 179, 8, 0.12);
      color: #eab308;
      border: 1px solid rgba(234, 179, 8, 0.25);
    }
    .badge-approved {
      background: rgba(34, 197, 94, 0.12);
      color: #22c55e;
      border: 1px solid rgba(34, 197, 94, 0.25);
    }
    .badge-rejected {
      background: rgba(239, 68, 68, 0.12);
      color: #ef4444;
      border: 1px solid rgba(239, 68, 68, 0.25);
    }

    /* Partner Hero & Application Stilleri */
    .partner-hero-card {
      font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background: linear-gradient(180deg, rgba(139, 92, 246, 0.08) 0%, rgba(20, 20, 30, 0.5) 100%);
      border: 1px solid rgba(139, 92, 246, 0.25);
      border-radius: 16px;
      padding: 3rem 2rem;
      text-align: center;
      position: relative;
      overflow: hidden;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
      margin-bottom: 2rem;
    }
    @keyframes pulseGlow {
      0%, 100% { opacity: 0.6; transform: translateX(-50%) scale(1); }
      50% { opacity: 1; transform: translateX(-50%) scale(1.15); }
    }
    .partner-hero-card::before {
      content: '';
      position: absolute;
      top: -100px;
      left: 50%;
      transform: translateX(-50%);
      width: 400px;
      height: 220px;
      background: radial-gradient(circle, rgba(139, 92, 246, 0.22) 0%, transparent 70%);
      pointer-events: none;
      animation: pulseGlow 4s ease-in-out infinite;
    }
    .partner-hero-badge {
      font-family: 'DM Sans', sans-serif;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(139, 92, 246, 0.12);
      border: 1px solid rgba(139, 92, 246, 0.3);
      padding: 6px 16px;
      border-radius: 99px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.08em;
      color: var(--accent);
      margin-bottom: 1.25rem;
    }
    .partner-hero-title {
      font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif !important;
      font-size: clamp(1.5rem, 2.6vw, 2.2rem);
      font-weight: 700;
      color: #ffffff;
      letter-spacing: -0.03em;
      margin: 0 auto 0.85rem auto;
      max-width: 650px;
      line-height: 1.25;
      -webkit-text-fill-color: initial !important;
      background: none !important;
    }
    .partner-hero-desc {
      font-family: 'DM Sans', sans-serif;
      color: var(--muted);
      font-size: clamp(13px, 1.2vw, 15px);
      max-width: 580px;
      margin: 0 auto 2.5rem auto;
      line-height: 1.6;
      font-weight: 400;
    }
    .partner-steps-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1.25rem;
      text-align: left;
    }
    .partner-step-card {
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1.5rem;
      transition: all 0.2s ease;
      position: relative;
    }
    .partner-step-card:hover {
      border-color: rgba(139, 92, 246, 0.4);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    }
    .step-icon-wrap {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      background: rgba(139, 92, 246, 0.12);
      border: 1px solid rgba(139, 92, 246, 0.25);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1rem;
      color: var(--accent);
    }
    .step-title {
      font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif !important;
      font-size: 1.05rem;
      font-weight: 700;
      color: #fff;
      margin: 0 0 0.5rem 0;
      letter-spacing: -0.01em;
      -webkit-text-fill-color: initial !important;
      background: none !important;
    }
    .step-desc {
      font-family: 'DM Sans', sans-serif;
      font-size: 13.5px;
      color: var(--muted);
      line-height: 1.5;
      margin: 0;
    }
    .partner-cta-btn {
      font-family: 'DM Sans', sans-serif;
      padding: 0.9rem 2.2rem;
      font-size: 1rem;
      font-weight: 700;
      border-radius: 12px;
      box-shadow: 0 4px 20px rgba(139, 92, 246, 0.4);
      display: inline-flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .partner-cta-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 28px rgba(139, 92, 246, 0.55);
    }
    .partner-status-banner {
      border-radius: 14px;
      padding: 1.25rem 1.75rem;
      max-width: 600px;
      margin: 0 auto;
      text-align: left;
    }
    .banner-pending {
      background: rgba(234, 179, 8, 0.08);
      border: 1px solid rgba(234, 179, 8, 0.25);
    }
    .banner-rejected {
      background: rgba(239, 68, 68, 0.08);
      border: 1px solid rgba(239, 68, 68, 0.25);
    }
    .status-banner-header {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 15px;
      font-weight: 700;
      color: #fff;
    }
    .crypto-radio-card {
      border: 1px solid var(--border);
      background: var(--surface2);
      border-radius: 8px;
      padding: 10px 14px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      transition: all 0.15s ease;
      user-select: none;
    }
    .crypto-radio-card.active {
      border-color: var(--accent);
      background: rgba(139, 92, 246, 0.12);
      color: #fff;
    }

    /* Modal Stilleri */
    .earnings-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9999;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
      padding: 1rem;
    }
    .earnings-modal-overlay.open {
      opacity: 1;
      pointer-events: auto;
    }
    .earnings-modal-card {
      font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      width: 100%;
      max-width: 480px;
      box-shadow: 0 20px 40px rgba(0,0,0,0.5);
      overflow: hidden;
      transform: translateY(15px);
      transition: transform 0.2s ease;
    }
    .earnings-modal-overlay.open .earnings-modal-card {
      transform: translateY(0);
    }
    .earnings-modal-header {
      padding: 1.25rem 1.5rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .earnings-modal-header h3 {
      font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif !important;
      margin: 0;
      font-size: 1.15rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      -webkit-text-fill-color: initial !important;
      background: none !important;
    }
    .earnings-modal-body {
      font-family: 'DM Sans', sans-serif;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    .earnings-modal-footer {
      padding: 1rem 1.5rem;
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: flex-end;
      gap: 0.75rem;
      background: var(--surface2);
    }
    .crypto-radio-group {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }
    .crypto-radio-card {
      border: 1px solid var(--border);
      background: var(--surface2);
      border-radius: var(--radius-sm);
      padding: 0.75rem 1rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      transition: all 0.2s ease;
    }
    .crypto-radio-card.active {
      border-color: var(--accent);
      background: rgba(124, 109, 250, 0.08);
    }
    .crypto-radio-card input {
      margin: 0;
    }
  </style>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" is:inline></script>
  <script src="/config.js" is:inline></script>
  <script src="/i18n.js" is:inline></script>
  <script type="module" src="/src/bundle.js" is:inline defer></script>
  <script src="/components/navbar/navbar.js?v=1790153937" is:inline defer></script>
</Fragment>

  <main class="main dashboard-main">

    <div class="page-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1rem;">
      <div>
        <h1 data-i18n="earnings.title">Kazançlarım & Para Çekme</h1>
        <p style="color:var(--muted); font-size:13px; margin-top:2px;" data-i18n="earnings.subtitle">Referans komisyonlarınızı yönetin ve çekim talebi oluşturun</p>
      </div>
      <div id="top-action-buttons" style="display:none; gap:0.5rem; flex-wrap:wrap;">
        <button id="open-wallets-modal-btn" class="btn btn-ghost btn-sm" style="display:inline-flex; align-items:center; gap:6px;">
          <i data-lucide="wallet" style="width:15px; height:15px;"></i>
          <span data-i18n="earnings.btn_wallets">Cüzdan Adreslerim</span>
        </button>
        <button id="open-payout-modal-btn" class="btn btn-primary btn-sm" style="display:inline-flex; align-items:center; gap:6px;">
          <i data-lucide="arrow-up-right" style="width:15px; height:15px;"></i>
          <span data-i18n="earnings.btn_request_payout">Para Çekme Talebi Gönder</span>
        </button>
      </div>
    </div>

    <!-- Yükleniyor -->
    <div id="loading-state" style="text-align:center; padding: 4rem;">
      <div class="spinner" style="margin: 0 auto;"></div>
      <p style="color:var(--muted); margin-top:1rem;" data-i18n="earnings.loading">Veriler yükleniyor...</p>
    </div>

    <!-- Partner Karşılama Alanı (Kodu Olmayan Kullanıcılar) -->
    <div id="empty-state" style="display:none;">
      <div class="partner-hero-card">
        <div class="partner-hero-badge">
          <i data-lucide="sparkles" style="width:14px; height:14px; color:var(--accent);"></i>
          <span data-i18n="earnings.partner_badge">WJ PARTNER PROGRAMI</span>
        </div>
        
        <h2 class="partner-hero-title" data-i18n="earnings.partner_hero_title">
          Topluluğunuzu Büyütün, Her Satıştan Gelir Elde Edin
        </h2>
        <p class="partner-hero-desc" data-i18n="earnings.partner_hero_desc">
          Wawe Journal ekosistemine yeni traderlar kazandırarak düzenli pasif gelir elde edin. Şeffaf komisyon ve kripto ile anında çekim imkanı.
        </p>

        <!-- 3 Adım Kartları (Lucide İkonlu) -->
        <div class="partner-steps-grid">
          <div class="partner-step-card">
            <div class="step-icon-wrap">
              <i data-lucide="tag" style="width:20px; height:20px;"></i>
            </div>
            <h4 class="step-title" data-i18n="earnings.step1_title">1. Kodunuzu Alın</h4>
            <p class="step-desc" data-i18n="earnings.step1_desc">Başvurunuz onaylandığında takipçilerinize özel % indirim kodu ve size komisyon hakkı tanımlanır.</p>
          </div>

          <div class="partner-step-card">
            <div class="step-icon-wrap">
              <i data-lucide="share-2" style="width:20px; height:20px;"></i>
            </div>
            <h4 class="step-title" data-i18n="earnings.step2_title">2. Paylaşın & Kazandırın</h4>
            <p class="step-desc" data-i18n="earnings.step2_desc">Takipçileriniz indirimli fiyata abone olsun, profesyonel analiz araçlarıyla hesaplarını büyütsün.</p>
          </div>

          <div class="partner-step-card">
            <div class="step-icon-wrap">
              <i data-lucide="wallet" style="width:20px; height:20px;"></i>
            </div>
            <h4 class="step-title" data-i18n="earnings.step3_title">3. Kripto ile Çekin</h4>
            <p class="step-desc" data-i18n="earnings.step3_desc">Her abonelikten net $ komisyon kazanın, bakiyenizi dilediğiniz an BTC veya LTC ile çekin.</p>
          </div>
        </div>

        <!-- Başvuru Durum Alanı (Dinamik JS ile yönetilir) -->
        <div id="partner-status-container" style="margin-top:2.5rem; text-align:center;">
          <!-- 1. Durum: Başvurusu Yok / Başvuru Yap Butonu -->
          <div id="status-can-apply" style="display:none;">
            <button id="btn-open-application-modal" class="btn btn-primary partner-cta-btn">
              <i data-lucide="send" style="width:18px; height:18px;"></i>
              <span data-i18n="earnings.btn_apply_partner">Partner Başvurusu Yap</span>
            </button>
          </div>

          <!-- 2. Durum: Başvurusu Beklemede (Pending) -->
          <div id="status-pending-app" class="partner-status-banner banner-pending" style="display:none;">
            <div class="status-banner-header">
              <i data-lucide="clock" style="width:20px; height:20px; color:#eab308;"></i>
              <span data-i18n="earnings.app_pending_title">Başvurunuz Değerlendiriliyor</span>
            </div>
            <p style="font-size:13px; color:var(--muted); margin: 6px 0 0 0;" data-i18n="earnings.app_pending_desc">
              Partner başvurunuz ekibimiz tarafından incelenmektedir. Ortalama değerlendirme süresi 24-48 saattir.
            </p>
          </div>

          <!-- 3. Durum: Başvurusu Reddedildi (Rejected - 14 Gün Geri Sayım) -->
          <div id="status-rejected-app" class="partner-status-banner banner-rejected" style="display:none;">
            <div class="status-banner-header">
              <i data-lucide="alert-circle" style="width:20px; height:20px; color:#ef4444;"></i>
              <span data-i18n="earnings.app_rejected_title">Başvurunuz Onaylanmadı</span>
            </div>
            <p id="app-rejection-reason" style="font-size:13px; color:var(--muted); margin: 6px 0 0 0; display:none;"></p>
            <div id="app-countdown-wrap" style="margin-top:10px; font-size:13px; color:#ef4444; font-weight:600;">
              <i data-lucide="calendar" style="width:14px; height:14px; display:inline-block; vertical-align:middle; margin-right:4px;"></i>
              <span id="app-countdown-text"></span>
            </div>
            <div id="status-can-reapply" style="margin-top:14px; display:none;">
              <button id="btn-reapply-partner" class="btn btn-primary btn-sm" style="display:inline-flex; align-items:center; gap:6px;">
                <i data-lucide="rotate-cw" style="width:14px; height:14px;"></i>
                <span data-i18n="earnings.btn_reapply_partner">Yeni Başvuru Yap</span>
              </button>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Ana İçerik -->
    <div id="data-state" style="display:none;">

      <!-- 4'lü Stat Grid -->
      <div class="earnings-stat-grid">
        <div class="stat-card">
          <div class="stat-label" data-i18n="earnings.stat_available">Çekilebilir Bakiye</div>
          <div class="stat-value" id="stat-available" style="color:#22c55e;">$0.00</div>
          <div class="stat-sub" data-i18n="earnings.min_payout_note">Minimum çekim: $20.00</div>
        </div>
        <div class="stat-card">
          <div class="stat-label" data-i18n="earnings.stat_earnings">Toplam Kazanç</div>
          <div class="stat-value" id="stat-earnings" style="color:var(--accent);">$0.00</div>
          <div class="stat-sub" data-i18n="earnings.stat_earnings_sub">Tüm zamanların toplamı</div>
        </div>
        <div class="stat-card">
          <div class="stat-label" data-i18n="earnings.stat_pending">Bekleyen Talepler</div>
          <div class="stat-value" id="stat-pending" style="color:#eab308;">$0.00</div>
          <div class="stat-sub" data-i18n="earnings.pending_sub">Admin onayı bekleniyor</div>
        </div>
        <div class="stat-card">
          <div class="stat-label" data-i18n="earnings.stat_paid">Toplam Ödenen</div>
          <div class="stat-value" id="stat-paid" style="color:#8b5cf6;">$0.00</div>
          <div class="stat-sub" data-i18n="earnings.paid_sub">Tamamlanan çekimler</div>
        </div>
      </div>

      <!-- Tanımlı Kodlar Tablosu -->
      <div class="earnings-table-wrap">
        <div class="earnings-table-title">
          <span data-i18n="earnings.table_title">Tanımlı Referans Kodlarınız</span>
          <span style="font-size:12px; color:var(--muted); font-weight:normal;" data-i18n="earnings.table_subtitle">Abonelik alımlarında kodunuz kullanıldıkça komisyon hesabınıza işlenir</span>
        </div>
        <div class="ww-table-wrapper" style="overflow-x:auto;">
          <table class="ww-table">
            <thead>
              <tr>
                <th style="padding-left: 1.5rem;" data-i18n="earnings.col_code">Kod</th>
                <th data-i18n="earnings.col_discount">Kullanıcı İndirimi</th>
                <th data-i18n="earnings.col_usage">Abonelik Alımları</th>
                <th data-i18n="earnings.col_commission">Komisyon / Satış</th>
                <th style="padding-right: 1.5rem;" data-i18n="earnings.col_total">Toplam Kazanç</th>
              </tr>
            </thead>
            <tbody id="codes-tbody">
              <!-- JS ile dolacak -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- Çekim Talepleri Geçmişi Tablosu -->
      <div class="earnings-table-wrap">
        <div class="earnings-table-title">
          <span data-i18n="earnings.payouts_history_title">Para Çekme Talepleri Geçmişi</span>
          <button id="refresh-payouts-btn" class="btn btn-ghost btn-sm" style="font-size:11px; padding:2px 8px;">
            <i data-lucide="refresh-cw" style="width:12px; height:12px;"></i> <span data-i18n="earnings.btn_refresh">Yenile</span>
          </button>
        </div>
        <div class="ww-table-wrapper" style="overflow-x:auto;">
          <table class="ww-table">
            <thead>
              <tr>
                <th style="padding-left: 1.5rem;" data-i18n="earnings.col_date">Tarih</th>
                <th data-i18n="earnings.col_amount">Tutar ($)</th>
                <th data-i18n="earnings.col_method">Yöntem</th>
                <th data-i18n="earnings.col_address">Cüzdan Adresi</th>
                <th data-i18n="earnings.col_status">Durum</th>
                <th style="padding-right: 1.5rem;" data-i18n="earnings.col_note">Not / Açıklama</th>
              </tr>
            </thead>
            <tbody id="payouts-tbody">
              <!-- JS ile dolacak -->
            </tbody>
          </table>
        </div>
      </div>

    </div>

  </main>

  <!-- ============================================================ -->
  <!-- MODAL 1: PARA ÇEKME TALEBİ GÖNDERME                          -->
  <!-- ============================================================ -->
  <div id="payout-modal" class="earnings-modal-overlay">
    <div class="earnings-modal-card">
      <div class="earnings-modal-header">
        <div style="display:flex; align-items:center; gap:8px;">
          <div style="width:32px; height:32px; border-radius:8px; background:rgba(34,197,94,0.12); display:flex; align-items:center; justify-content:center; color:#22c55e;">
            <i data-lucide="arrow-up-right" style="width:18px; height:18px;"></i>
          </div>
          <h3 data-i18n="earnings.modal_payout_title">Para Çekme Talebi</h3>
        </div>
        <button type="button" class="btn btn-ghost btn-sm" onclick="closePayoutModal()" style="padding:4px 8px;">✕</button>
      </div>
      
      <div class="earnings-modal-body">
        <div style="background:var(--surface2); border:1px solid var(--border); border-radius:var(--radius-sm); padding:1rem; display:flex; justify-content:space-between; align-items:center;">
          <div>
            <div style="font-size:11px; color:var(--muted); text-transform:uppercase;" data-i18n="earnings.stat_available">Çekilebilir Bakiye</div>
            <div id="modal-available-balance" style="font-size:1.3rem; font-weight:700; color:#22c55e;">$0.00</div>
          </div>
          <div style="text-align:right;">
            <div style="font-size:11px; color:var(--muted);" data-i18n="earnings.min_payout">Minimum Çekim</div>
            <div style="font-weight:600; color:var(--text);">$20.00</div>
          </div>
        </div>

        <div>
          <label style="display:block; font-size:12px; font-weight:600; color:var(--muted); margin-bottom:6px;" data-i18n="earnings.payout_method_label">ÇEKİM YÖNTEMİ</label>
          <div class="crypto-radio-group">
            <div class="crypto-radio-card active" id="crypto-card-ltc" onclick="selectCryptoMethod('LTC')">
              <input type="radio" name="payout_crypto" id="crypto-ltc" value="LTC" checked>
              <div>
                <strong style="display:block; font-size:13px;">Litecoin (LTC)</strong>
                <span style="font-size:11px; color:var(--muted);" data-i18n="earnings.ltc_low_fee">Düşük ağ ücreti</span>
              </div>
            </div>
            <div class="crypto-radio-card" id="crypto-card-btc" onclick="selectCryptoMethod('BTC')">
              <input type="radio" name="payout_crypto" id="crypto-btc" value="BTC">
              <div>
                <strong style="display:block; font-size:13px;">Bitcoin (BTC)</strong>
                <span style="font-size:11px; color:var(--muted);" data-i18n="earnings.btc_network">BTC ağı</span>
              </div>
            </div>
          </div>
        </div>

        <div>
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
            <label style="font-size:12px; font-weight:600; color:var(--muted);" data-i18n="earnings.withdraw_amount_label">ÇEKİLECEK TUTAR ($)</label>
            <button type="button" class="btn btn-ghost btn-sm" onclick="setMaxWithdrawAmount()" style="font-size:11px; padding:1px 6px; color:var(--accent);" data-i18n="earnings.withdraw_all">Tümünü Çek</button>
