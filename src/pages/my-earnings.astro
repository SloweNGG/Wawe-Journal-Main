---
import Layout from '../layouts/Layout.astro';
---
<Layout lang="tr">
<Fragment slot="head">
  <title data-i18n="earnings.title">Kazançlarım - Wawe Journal</title>
  <link rel="stylesheet" href="/interface/dashboard/css/dashboard.css" />
  <style>
    /* my-earnings uses global page-header, chart-card, ww-table styles */
  </style>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" is:inline defer></script>
  <script src="/config.js" is:inline defer></script>
  <script src="/i18n.js" is:inline defer></script>
  <script type="module" src="/src/bundle.js" is:inline></script>
  <script src="/components/navbar/navbar.js" is:inline defer></script>
</Fragment>

  <main class="main">
    <div class="page-header">
      <div>
        <h1 data-i18n="earnings.title">Kazançlarım</h1>
      </div>
    </div>

    <div id="loading-state" style="text-align:center; padding: 3rem;">
      <div class="spinner" style="margin: 0 auto;"></div>
      <p style="color:var(--muted); margin-top:1rem;">Veriler yükleniyor...</p>
    </div>

    <div id="empty-state" style="display:none; text-align:center; padding: 4rem 1rem; background: var(--surface); border-radius: var(--radius); border: 1px solid var(--border); margin: 1rem 0;">
      <i data-lucide="trending-up" style="width:48px;height:48px;color:var(--muted);margin-bottom:1rem;display:inline-block;"></i>
      <h3 style="font-size:1.25rem; font-weight:600; margin-bottom:0.5rem;">Henüz bir kazanç profiliniz yok</h3>
      <p style="color:var(--muted);">Size tanımlanmış bir indirim veya referans kodu bulunmuyor. Eğer bir partner iseniz, lütfen yönetici ile iletişime geçin.</p>
    </div>

    <div id="data-state" style="display:none;">
      <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
        <div class="chart-card" style="padding:1.5rem;">
          <div style="color:var(--muted); font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.5rem;">Toplam Kullanım</div>
          <div id="stat-usage" style="font-size:2rem; font-weight:700; color:var(--accent);">0</div>
        </div>
        <div class="chart-card" style="padding:1.5rem;">
          <div style="color:var(--muted); font-size:12px; font-weight:600; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:0.5rem;">Toplam Kazanç</div>
          <div id="stat-earnings" style="font-size:2rem; font-weight:700; color:var(--green);">$0.00</div>
        </div>
      </div>

      <div class="chart-card" style="padding:0;">
        <div style="padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border);">
          <h2 style="font-size:1rem; font-weight:600; margin:0;">Tanımlı Kodlarınız</h2>
        </div>
        <div style="overflow-x:auto;">
          <table class="ww-table" style="width:100%;">
            <thead>
              <tr>
                <th>Kod</th>
                <th>İndirim</th>
                <th>Kullanım Sayısı</th>
                <th>Komisyon / Kod Başına ($)</th>
                <th>Elde Edilen Kazanç</th>
              </tr>
            </thead>
            <tbody id="codes-tbody">
              <!-- JS ile dolacak -->
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', async function() {
      if (typeof window.sb === 'undefined') {
        console.error("Supabase yüklenemedi.");
        return;
      }
      
      const { data: { session } } = await window.sb.auth.getSession();
      if (!session) {
        window.location.href = '/login.html';
        return;
      }

      try {
        const { data, error } = await window.sb.rpc('get_influencer_earnings');
        
        document.getElementById('loading-state').style.display = 'none';

        if (error) {
          console.error("RPC Error:", error);
          document.getElementById('empty-state').style.display = 'block';
          return;
        }

        if (!data || data.length === 0) {
          document.getElementById('empty-state').style.display = 'block';
          return;
        }

        document.getElementById('data-state').style.display = 'block';

        let totalUsage = 0;
        let totalEarnings = 0;
        const tbody = document.getElementById('codes-tbody');
        tbody.innerHTML = '';

        data.forEach(item => {
          totalUsage += item.usage_count || 0;
          totalEarnings += parseFloat(item.total_earnings || 0);

          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td><strong style="color:var(--primary); font-family:monospace; font-size:1.1rem; background:var(--bg-muted); padding:4px 8px; border-radius:4px;">${item.code}</strong></td>
            <td>%${item.discount_percent}</td>
            <td>${item.usage_count}</td>
            <td>$${item.commission_rate || 0}</td>
            <td style="font-weight:600; color:var(--success);">$${parseFloat(item.total_earnings || 0).toFixed(2)}</td>
          `;
          tbody.appendChild(tr);
        });

        document.getElementById('stat-usage').textContent = totalUsage;
        document.getElementById('stat-earnings').textContent = '$' + totalEarnings.toFixed(2);
        
        if (typeof lucide !== 'undefined') lucide.createIcons();
      } catch (err) {
        console.error(err);
        document.getElementById('loading-state').style.display = 'none';
        document.getElementById('empty-state').style.display = 'block';
      }
    });
  </script>
</Layout>
