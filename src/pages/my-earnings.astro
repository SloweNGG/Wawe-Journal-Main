              <i data-lucide="wallet" style="width:13px; height:13px; color:#f59e0b;"></i>
              <span data-i18n="earnings.field_crypto">Kripto para kullanıyor musunuz?</span>
            </label>
            <p style="font-size:11px; color:var(--muted); margin:0 0 8px 0;" data-i18n="earnings.field_crypto_desc">Affiliate komisyon ödemeleri BTC ve LTC ağları üzerinden yapılmaktadır.</p>
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:0.75rem;">
              <label class="crypto-radio-card active" id="crypto-opt-yes-card" onclick="selectCryptoUsage(true)">
                <input type="radio" name="apply_crypto" value="true" checked style="display:none;">
                <i data-lucide="check-circle-2" style="width:16px; height:16px; color:#22c55e;"></i>
                <span data-i18n="earnings.crypto_yes">Evet, aktif kullanıyorum</span>
              </label>
              <label class="crypto-radio-card" id="crypto-opt-no-card" onclick="selectCryptoUsage(false)">
                <input type="radio" name="apply_crypto" value="false" style="display:none;">
                <i data-lucide="help-circle" style="width:16px; height:16px; color:var(--muted);"></i>
                <span data-i18n="earnings.crypto_no">Hayır, henüz kullanmıyorum</span>
              </label>
