---
import Layout from '../layouts/Layout.astro';
---
<Layout lang="tr">
<Fragment slot="head">
  <title data-i18n="earnings.title">Kazançlarım - Wawe Journal</title>
  <link rel="stylesheet" href="/interface/dashboard/css/dashboard.css" />
  <style>
    .earnings-stat-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .earnings-stat-box {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.5rem;
    }
    .earnings-stat-label {
      color: var(--muted);
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.5rem;
    }
    .earnings-stat-value {
      font-size: 2rem;
      font-weight: 700;
    }
    .earnings-table-wrap {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
    }
    .earnings-table-title {
      padding: 1.25rem 1.5rem;
      border-bottom: 1px solid var(--border);
      font-size: 1rem;
      font-weight: 600;
      margin: 0;
    }
    .earnings-table {
      width: 100%;
      border-collapse: collapse;
    }
    .earnings-table th {
      padding: 0.85rem 1.25rem;
      text-align: left;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
      background: var(--surface2);
      border-bottom: 1px solid var(--border);
    }
    .earnings-table td {
      padding: 0.9rem 1.25rem;
      border-bottom: 1px solid var(--border);
      font-size: 14px;
    }
    .earnings-table tr:last-child td { border-bottom: none; }
    .earnings-table tbody tr:hover { background: var(--surface2); }
    .code-chip {
      font-family: monospace;
      font-size: 1rem;
      font-weight: 700;
      background: var(--surface2);
      color: var(--accent);
      border: 1px solid var(--border);
      padding: 3px 10px;
      border-radius: 6px;
      letter-spacing: 0.05em;
    }
    .earnings-empty {
      text-align: center;
      padding: 4rem 1rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      margin: 0;
    }
  </style>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" is:inline defer></script>
  <script src="/config.js" is:inline defer></script>
  <script src="/i18n.js" is:inline defer></script>
  <script type="module" src="/src/bundle.js" is:inline></script>
  <script src="/components/navbar/navbar.js" is:inline defer></script>
</Fragment>

  <main class="main dashboard-main">

    <div class="page-header">
      <div>
        <h1 data-i18n="earnings.title">Kazançlarım</h1>
      </div>
    </div>

    <!-- Yükleniyor -->
    <div id="loading-state" style="text-align:center; padding: 4rem;">
      <div class="spinner" style="margin: 0 auto;"></div>
      <p style="color:var(--muted); margin-top:1rem;">Veriler yükleniyor...</p>
    </div>

    <!-- Kod tanımlı değil -->
    <div id="empty-state" class="earnings-empty" style="display:none;">
      <i data-lucide="trending-up" style="width:48px;height:48px;color:var(--muted);margin-bottom:1rem;display:inline-block;"></i>
      <h3 style="font-size:1.25rem; font-weight:600; margin-bottom:0.5rem;">Henüz bir kazanç profiliniz yok</h3>
      <p style="color:var(--muted);">Size tanımlanmış bir indirim veya referans kodu bulunmuyor.<br>Eğer bir partner iseniz, lütfen yönetici ile iletişime geçin.</p>
    </div>

    <!-- Ana İçerik -->
    <div id="data-state" style="display:none;">

      <div class="earnings-stat-grid">
        <div class="earnings-stat-box">
          <div class="earnings-stat-label">Toplam Kullanım</div>
          <div class="earnings-stat-value" id="stat-usage" style="color:var(--accent);">0</div>
        </div>
        <div class="earnings-stat-box">
          <div class="earnings-stat-label">Toplam Kazanç</div>
          <div class="earnings-stat-value" id="stat-earnings" style="color:#22c55e;">$0.00</div>
        </div>
      </div>

      <div class="earnings-table-wrap">
        <h2 class="earnings-table-title">Tanımlı Kodlarınız</h2>
        <div style="overflow-x:auto;">
          <table class="earnings-table">
            <thead>
              <tr>
                <th>Kod</th>
                <th>İndirim</th>
                <th>Kullanım Sayısı</th>
                <th>Komisyon / Kullanım ($)</th>
                <th>Toplam Kazanç</th>
              </tr>
            </thead>
            <tbody id="codes-tbody">
              <!-- JS ile dolacak -->
            </tbody>
          </table>
        </div>
      </div>

    </div>

  </main>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', async function() {
      var sb = window.sb;
      if (!sb) {
        document.getElementById('loading-state').style.display = 'none';
        document.getElementById('empty-state').style.display = 'block';
        return;
      }

      const { data: { session } } = await sb.auth.getSession();
      if (!session) {
        window.location.href = '/login.html';
        return;
      }

      try {
        const { data, error } = await sb.rpc('get_influencer_earnings');
        document.getElementById('loading-state').style.display = 'none';

        if (error || !data || data.length === 0) {
          document.getElementById('empty-state').style.display = 'block';
          return;
        }

        document.getElementById('data-state').style.display = 'block';

        let totalUsage = 0;
        let totalEarnings = 0;
        const tbody = document.getElementById('codes-tbody');
        tbody.innerHTML = '';

        data.forEach(function(item) {
          totalUsage += item.usage_count || 0;
          totalEarnings += parseFloat(item.total_earnings || 0);

          const tr = document.createElement('tr');
          tr.innerHTML =
            '<td><span class="code-chip">' + item.code + '</span></td>' +
            '<td>%' + item.discount_percent + '</td>' +
            '<td>' + item.usage_count + '</td>' +
            '<td>$' + (item.commission_rate || 0) + '</td>' +
            '<td style="font-weight:600; color:#22c55e;">$' + parseFloat(item.total_earnings || 0).toFixed(2) + '</td>';
          tbody.appendChild(tr);
        });

        document.getElementById('stat-usage').textContent = totalUsage;
        document.getElementById('stat-earnings').textContent = '$' + totalEarnings.toFixed(2);

        if (typeof lucide !== 'undefined') lucide.createIcons();
      } catch (err) {
        console.error(err);
        document.getElementById('loading-state').style.display = 'none';
        document.getElementById('empty-state').style.display = 'block';
      }
    });
  </script>
</Layout>
