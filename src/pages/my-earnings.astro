      <form id="partner-apply-form" onsubmit="submitPartnerApplication(event)">
        <div class="earnings-modal-body">
          <!-- Instagram -->
          <div>
            <label style="display:flex; align-items:center; gap:6px; font-size:12px; font-weight:600; color:var(--muted); margin-bottom:6px;">
              <i data-lucide="instagram" style="width:13px; height:13px; color:#e1306c;"></i>
