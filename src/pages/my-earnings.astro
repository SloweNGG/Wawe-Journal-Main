      gap: 8px;
      font-size: 15px;
      font-weight: 700;
      color: var(--text);
    }
    .crypto-radio-card {
      border: 1px solid var(--border);
      background: var(--surface2);
      border-radius: 8px;
      padding: 10px 14px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      transition: all 0.15s ease;
      user-select: none;
      color: var(--text);
