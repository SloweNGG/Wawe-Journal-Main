---
import Layout from '../layouts/Layout.astro';
---
<Layout lang="tr">
<Fragment slot="head">
  <title data-i18n="earnings.title">Kazançlarım - Wawe Journal</title>
  
  <style>
    /* Özelleştirilmiş tablolar için gerekli css */
    .earnings-stat-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .earnings-table-wrap {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
    }
    .earnings-table-title {
      padding: 1.25rem 1.5rem;
      border-bottom: 1px solid var(--border);
      font-size: 1rem;
      font-weight: 600;
      margin: 0;
    }
    .code-chip {
      font-family: monospace;
      font-size: 1rem;
      font-weight: 700;
      background: var(--surface2);
      color: var(--accent);
      border: 1px solid var(--border);
      padding: 3px 10px;
      border-radius: 6px;
      letter-spacing: 0.05em;
    }
    .earnings-empty {
      text-align: center;
      padding: 4rem 1rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      margin: 0;
    }
  </style>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" is:inline></script>
  <script src="/config.js" is:inline></script>
  <script src="/i18n.js" is:inline></script>
  <!-- defer is removed from supabase to ensure it's loaded before script execution -->
  <script type="module" src="/src/bundle.js" is:inline defer></script>
  <script src="/components/navbar/navbar.js?v=1790153937" is:inline defer></script>
</Fragment>

  <main class="main dashboard-main">

    <div class="page-header">
      <div>
        <h1 data-i18n="earnings.title">Kazançlarım</h1>
      </div>
    </div>

    <!-- Yükleniyor -->
    <div id="loading-state" style="text-align:center; padding: 4rem;">
      <div class="spinner" style="margin: 0 auto;"></div>
      <p style="color:var(--muted); margin-top:1rem;">Veriler yükleniyor...</p>
    </div>

    <!-- Kod tanımlı değil -->
    <div id="empty-state" class="earnings-empty" style="display:none;">
      <i data-lucide="trending-up" style="width:48px;height:48px;color:var(--muted);margin-bottom:1rem;display:inline-block;"></i>
      <h3 style="font-size:1.25rem; font-weight:600; margin-bottom:0.5rem;">Henüz bir kazanç profiliniz yok</h3>
      <p style="color:var(--muted);">Size tanımlanmış bir indirim veya referans kodu bulunmuyor.<br>Eğer bir partner iseniz, lütfen yönetici ile iletişime geçin.</p>
    </div>

    <!-- Ana İçerik -->
    <div id="data-state" style="display:none;">

      <div class="earnings-stat-grid">
        <div class="stat-card">
          <div class="stat-label">Toplam Kullanım</div>
          <div class="stat-value" id="stat-usage" style="color:var(--accent);">0</div>
        </div>
        <div class="stat-card">
          <div class="stat-label">Toplam Kazanç</div>
          <div class="stat-value positive" id="stat-earnings">$0.00</div>
        </div>
      </div>

      <div class="earnings-table-wrap">
        <h2 class="earnings-table-title">Tanımlı Kodlarınız</h2>
        <div class="ww-table-wrapper" style="overflow-x:auto;">
          <table class="ww-table">
            <thead>
              <tr>
                <th style="padding-left: 1.5rem;">Kod</th>
                <th>İndirim</th>
                <th>Kullanım Sayısı</th>
                <th>Komisyon / Kullanım ($)</th>
                <th style="padding-right: 1.5rem;">Toplam Kazanç</th>
              </tr>
            </thead>
            <tbody id="codes-tbody">
              <!-- JS ile dolacak -->
            </tbody>
          </table>
        </div>
      </div>

    </div>

  </main>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', async function() {
      // Supabase client helper to handle race conditions with module loading
      async function getSb() {
        if (window.sb) return window.sb;
        for (let i = 0; i < 40; i++) {
          if (window.sb) return window.sb;
          if (typeof window.supabase !== 'undefined' && window.SUPABASE_URL) {
            window.sb = window.supabase.createClient(window.SUPABASE_URL, window.SUPABASE_ANON_KEY);
            return window.sb;
          }
          await new Promise(r => setTimeout(r, 100));
        }
        return null;
      }

      var client = await getSb();
      
      if (!client) {
        document.getElementById('loading-state').style.display = 'none';
        document.getElementById('empty-state').style.display = 'block';
        return;
      }

      const { data: { session } } = await client.auth.getSession();
      if (!session) {
        window.location.href = '/login.html';
        return;
      }

      try {
        let rows = [];
        const { data: rpcData, error: rpcError } = await client.rpc('get_influencer_earnings');
        
        if (!rpcError && Array.isArray(rpcData)) {
          rows = rpcData;
        } else {
          // Fallback direct query if RPC doesn't exist
          const { data: directData, error: directError } = await client
            .from('referral_codes')
            .select('code, discount_percent, usage_count, commission_rate')
            .eq('influencer_user_id', session.user.id);
            
          if (!directError && Array.isArray(directData)) {
            rows = directData.map(r => ({
              code: r.code,
              discount_percent: r.discount_percent,
              usage_count: r.usage_count || 0,
              commission_rate: r.commission_rate || 0,
              total_earnings: (r.usage_count || 0) * (r.commission_rate || 0)
            }));
          }
        }

        document.getElementById('loading-state').style.display = 'none';

        if (rows.length === 0) {
          document.getElementById('empty-state').style.display = 'block';
          return;
        }

        document.getElementById('data-state').style.display = 'block';

        let totalUsage = 0;
        let totalEarnings = 0;
        const tbody = document.getElementById('codes-tbody');
        tbody.innerHTML = '';

        rows.forEach(function(item) {
          totalUsage += item.usage_count || 0;
          totalEarnings += parseFloat(item.total_earnings || 0);

          const tr = document.createElement('tr');
          tr.innerHTML =
            '<td style="padding-left: 1.5rem;"><span class="code-chip">' + item.code + '</span></td>' +
            '<td>%' + item.discount_percent + '</td>' +
            '<td>' + item.usage_count + '</td>' +
            '<td>$' + (item.commission_rate || 0) + '</td>' +
            '<td style="font-weight:600; color:#22c55e; padding-right: 1.5rem;">$' + parseFloat(item.total_earnings || 0).toFixed(2) + '</td>';
          tbody.appendChild(tr);
        });

        document.getElementById('stat-usage').textContent = totalUsage;
        document.getElementById('stat-earnings').textContent = '$' + totalEarnings.toFixed(2);

        if (typeof lucide !== 'undefined') lucide.createIcons();
      } catch (err) {
        console.error(err);
        document.getElementById('loading-state').style.display = 'none';
        document.getElementById('empty-state').style.display = 'block';
      }
    });
  </script>
</Layout>
