    @media (max-width: 960px) {
      .partner-hero-card {
        padding: 2.25rem 1.5rem 2.5rem;
      }
      .partner-hero-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }
      .partner-hero-visual {
        padding-top: 2.25rem;
      }
      .partner-facts {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .partner-fact:nth-child(3) {
        border-left: none;
      }
      .partner-fact:nth-child(n + 3) {
