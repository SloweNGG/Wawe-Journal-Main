  <!-- ============================================================ -->
  <!-- MODAL 3: PARTNER BAŞVURU MODALI                              -->
  <!-- ============================================================ -->
  <div id="partner-apply-modal" class="earnings-modal-overlay">
    <div class="earnings-modal-card" style="max-width: 520px;">
      <div class="earnings-modal-header">
        <div style="display:flex; align-items:center; gap:8px;">
          <div style="width:32px; height:32px; border-radius:8px; background:rgba(139,92,246,0.15); display:flex; align-items:center; justify-content:center; color:var(--accent);">
            <i data-lucide="badge-percent" style="width:18px; height:18px;"></i>
          </div>
          <div>
            <h3 style="margin:0; font-size:1.1rem; font-weight:700;" data-i18n="earnings.modal_apply_title">WJ Partner Başvurusu</h3>
            <p style="margin:2px 0 0; font-size:11px; color:var(--muted);" data-i18n="earnings.modal_apply_desc">Trading topluluğunuz veya kitleniz hakkında bilgi verin.</p>
          </div>
        </div>
        <button type="button" class="btn btn-ghost btn-sm" onclick="closeApplyModal()" style="padding:4px 8px;">✕</button>
