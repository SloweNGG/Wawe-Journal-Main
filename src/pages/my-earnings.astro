            <input type="text" id="apply-instagram" placeholder="@kullaniciadi veya instagram.com/kullaniciadi" required style="width:100%; padding:0.65rem 0.75rem; background:var(--bg); border:1px solid var(--border); border-radius:var(--radius-sm); color:var(--text); font-size:13px;">
          </div>

          <!-- Takipçi Boyutu -->
          <div>
            <label style="display:flex; align-items:center; gap:6px; font-size:12px; font-weight:600; color:var(--muted); margin-bottom:6px;">
