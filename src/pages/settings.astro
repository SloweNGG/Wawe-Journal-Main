---
import Layout from '../layouts/Layout.astro';
---
<Layout lang="en">
<Fragment slot="head">
  <title data-i18n="settings.title">Ayarlar – Wawe Journal</title>
  
  <!-- ⭐ PREFETCH - ÖN YÜKLEME (HIZLI SAYFA GEÇİŞİ) -->
  <link rel="prefetch" href="/dashboard.html">
  <link rel="prefetch" href="/trades.html">
  <link rel="prefetch" href="/strategies.html">
  <link rel="prefetch" href="/calendar.html">
  <link rel="prefetch" href="/premium-dashboard.html">
  <!-- ⭐ TEMİZLİK: /settings.html prefetch'i kaldırıldı (sayfa kendini prefetch ediyordu) -->
  
  <!-- ⭐ SERVICE WORKER - OFFLINE DESTEĞİ -->
  <!-- ⭐ TEMİZLİK: fetch('/sw.js', { method: 'HEAD' }) kaldırıldı.
       register() zaten dosya varlığını kontrol ediyor — 404 olursa promise reject olur.
       Bu ekstra HEAD isteği SW fetch handler'ında cache.put hatası veriyordu. -->
  <script is:inline>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', function() {
      navigator.serviceWorker.register('/sw.js')
        .then(function(reg) { wwLog.log('SW registered'); })
        .catch(function(err) { wwLog.warn('SW registration failed', err); });
    });
  }
  </script>
  
  <link rel="stylesheet" href="/settings/css/settings.css" />
  
  <!-- ⭐ NAVBAR CSS -->
  

  <link rel="preload" href="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" as="script" />
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" is:inline defer></script>
  <script src="/config.js?v=8" is:inline defer></script>
  <script src="/i18n.js?v=8" is:inline defer></script>
  <script type="module" src="/src/bundle.js?v=8" is:inline defer></script>
  <script src="/components/navbar/navbar.js?v=1790153937" is:inline defer></script>
  <script src="/settings/js/settings.js?v=8" is:inline defer></script>
</Fragment>
  <!-- ⭐ NAVBAR CONTAINER -->

  <!-- ============================================================
       MAIN
       ============================================================ -->
  <main class="main dashboard-main">

    <div class="settings-page-header">
      <div class="settings-page-header-eyebrow" data-i18n="settings.eyebrow">Hesap Yönetimi</div>
      <h1 data-i18n="settings.title">Ayarlar</h1>
      <p data-i18n="settings.subtitle">Hesabını ve tercihlerini buradan yönetebilirsin.</p>
    </div>

    <div class="settings-tabs-mobile" id="mobile-tabs">
      <button class="settings-tab-btn active" data-panel="panel-profile">
        <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="12" r="4"/></svg>
        <span data-i18n="settings.profile">Profil</span>
      </button>
      <button class="settings-tab-btn" data-panel="panel-plan">
        <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        Plan
      </button>
      <button class="settings-tab-btn" data-panel="panel-password">
        <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <span data-i18n="settings.password">Şifre</span>
      </button>
      <button class="settings-tab-btn" data-panel="panel-appearance">
        <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        <span data-i18n="settings.appearance">Görünüm</span>
      </button>
      <button class="settings-tab-btn" data-panel="panel-overtrade">
        <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        Over Trade
      </button>
      <button class="settings-tab-btn danger" data-panel="panel-danger">
        <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        <span data-i18n="settings.danger">Tehlikeli</span>
      </button>
    </div>

    <div class="settings-wrap">
      <aside class="settings-sidebar">
        <div class="sidebar-profile" id="sidebar-profile">
          <div class="sidebar-avatar" id="sb-avatar">
            <span class="no-avatar" id="sb-avatar-text">?</span>
          </div>
          <div class="sidebar-username" id="sb-username">—</div>
          <div class="sidebar-email" id="sb-email">—</div>
        </div>
        <nav class="sidebar-nav">
          <button class="sidebar-nav-item active" data-panel="panel-profile">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="12" r="4"/></svg>
            <span data-i18n="settings.profile_info">Profil Bilgileri</span>
          </button>
          <button class="sidebar-nav-item" data-panel="panel-plan">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            Plan
          </button>
          <button class="sidebar-nav-item" data-panel="panel-password">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <span data-i18n="settings.change_password">Şifre Değiştir</span>
          </button>
          <button class="sidebar-nav-item" data-panel="panel-appearance">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
            <span data-i18n="settings.appearance">Görünüm</span>
          </button>
          <button class="sidebar-nav-item" data-panel="panel-overtrade">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            Over Trade
          </button>
          <div class="sidebar-nav-divider"></div>
          <button class="sidebar-nav-item danger" data-panel="panel-danger">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            <span data-i18n="settings.danger_zone">Tehlikeli Bölge</span>
          </button>
        </nav>
      </aside>

      <div class="settings-panels">
        <div class="panel-glow profile-glow" id="panel-glow"></div>

        <!-- PANEL: Profil -->
        <div class="settings-panel active" id="panel-profile">
          <div style="padding:2rem;text-align:center;color:var(--muted);">
            <div class="spinner" style="width:28px;height:28px;border:2.5px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:spin 0.5s linear infinite;margin:0 auto;"></div>
          </div>
        </div>

        <!-- PANEL: Plan -->
        <div class="settings-panel" id="panel-plan">
          <div style="padding:2rem;text-align:center;color:var(--muted);">
            <div class="spinner" style="width:28px;height:28px;border:2.5px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:spin 0.5s linear infinite;margin:0 auto;"></div>
          </div>
        </div>

        <!-- PANEL: Şifre -->
        <div class="settings-panel" id="panel-password">
          <div style="padding:2rem;text-align:center;color:var(--muted);">
            <div class="spinner" style="width:28px;height:28px;border:2.5px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:spin 0.5s linear infinite;margin:0 auto;"></div>
          </div>
        </div>

        <!-- PANEL: Görünüm -->
        <div class="settings-panel" id="panel-appearance">
          <div style="padding:2rem;text-align:center;color:var(--muted);">
            <div class="spinner" style="width:28px;height:28px;border:2.5px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:spin 0.5s linear infinite;margin:0 auto;"></div>
          </div>
        </div>

        <!-- PANEL: Over Trade -->
        <div class="settings-panel" id="panel-overtrade">
          <div style="padding:2rem;text-align:center;color:var(--muted);">
            <div class="spinner" style="width:28px;height:28px;border:2.5px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:spin 0.5s linear infinite;margin:0 auto;"></div>
          </div>
        </div>

        <!-- PANEL: Tehlikeli -->
        <div class="settings-panel" id="panel-danger">
          <div style="padding:2rem;text-align:center;color:var(--muted);">
            <div class="spinner" style="width:28px;height:28px;border:2.5px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:spin 0.5s linear infinite;margin:0 auto;"></div>
          </div>
        </div>

      </div>
    </div>
  </main>

  <!-- AVATAR POPUP -->
  <div class="avatar-popup-overlay" id="avatar-popup">
    <div class="avatar-popup">
      <button class="avatar-popup-close" id="avatar-popup-close">✕</button>
      <div class="avatar-popup-body">
        <div class="big-avatar" id="popup-big-avatar">
          <span class="big-placeholder" id="popup-placeholder">?</span>
          <img id="popup-avatar-img" style="display:none;" />
        </div>
      </div>
    </div>
  </div>

  <!-- CONFIRM MODAL -->
  <div class="confirm-modal-overlay" id="confirm-modal">
    <div class="confirm-modal-box">
      <div class="confirm-modal-header">
        <div class="icon-wrap">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
        </div>
        <h3 id="confirm-title">⚠️ Dikkat!</h3>
      </div>
      <div class="confirm-modal-body">
        <p id="confirm-message">Bu işlem geri alınamaz. Devam etmek istediğinize emin misiniz?</p>
        <div id="confirm-warning" class="warning-text" style="display:none;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          <span></span>
        </div>
      </div>
      <div class="confirm-modal-footer">
        <button class="btn-modal-cancel" id="confirm-cancel">İptal</button>
        <button class="btn-modal-danger" id="confirm-ok">Evet, Devre Dışı Bırak</button>
      </div>
    </div>
  </div>

  <!-- ============================================================
       ⭐ SCRIPTS
       ============================================================ -->
  
  <!-- 1. ÜÇÜNCÜ PARTY KÜTÜPHANELER -->
  
  
  <!-- 2. CORE KONFİG VE I18N (ES5) -->
  
  
  
  <!-- 3. ⭐ ANA MODÜL SCRIPT (ES Module) -->
  
  
  <!-- 4. NAVBAR (ES5) -->
  
  
  <!-- 5. LUCIDE ICONS INIT -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
        wwLog.log('✅ Lucide icons initialized on settings!');
      }
    });
  </script>
  
  <!-- 6. NAVBAR'ı YÜKLE -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      if (typeof loadNavbar === 'function') {
        loadNavbar('navbar-container');
        wwLog.log('✅ Navbar yüklendi!');
      } else {
        wwLog.warn('⚠️ loadNavbar fonksiyonu bulunamadı!');
      }
    });
  </script>
  
  <!-- 7. SETTINGS JS (ES5 - AYNI KALIR) -->
  
  
  <!-- ⭐ TEMİZLİK: En alttaki tekrar eden @keyframes spin style bloğu kaldırıldı.
       Yukarıdaki ana <style> bloğunda zaten tanımlı. -->
  
</Layout>