---
import Layout from '../layouts/Layout.astro';
---
<Layout lang="en">
<Fragment slot="head">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title data-i18n="settings.title">Ayarlar – Wawe Journal</title>
  <link rel="icon" type="image/svg+xml" href="/resim.svg">
  
  <!-- ⭐ PREFETCH - ÖN YÜKLEME (HIZLI SAYFA GEÇİŞİ) -->
  <link rel="prefetch" href="/dashboard.html">
  <link rel="prefetch" href="/trades.html">
  <link rel="prefetch" href="/strategies.html">
  <link rel="prefetch" href="/calendar.html">
  <link rel="prefetch" href="/settings.html">
  <link rel="prefetch" href="/premium-dashboard.html">
  
  <!-- ⭐ SERVICE WORKER - OFFLINE DESTEĞİ -->
  <script is:inline>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', function() {
      fetch('/sw.js', { method: 'HEAD' })
        .then(function(response) {
          if (response.ok) {
            navigator.serviceWorker.register('/sw.js')
              .then(function(registration) {
                console.log('✅ Service Worker registered:', registration);
              })
              .catch(function(error) {
                console.log('❌ Service Worker registration failed:', error);
              });
          } else {
            console.log('ℹ️ sw.js dosyası mevcut değil, Service Worker atlanıyor');
          }
        })
        .catch(function() {
          console.log('ℹ️ sw.js kontrol edilemedi, Service Worker atlanıyor');
        });
    });
  }
  </script>
  
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css" />
  <link rel="stylesheet" href="/settings/css/settings.css" />
  
  <!-- ⭐ NAVBAR CSS -->
  <link rel="stylesheet" href="/components/navbar/navbar.css" />
  
  <!-- ⭐ LUCIDE ICONS -->
  <script src="https://unpkg.com/lucide@latest" is:inline></script>
  
  <script is:inline>
    (function() {
      var savedTheme = localStorage.getItem('ww_theme');
      if (savedTheme === 'light') {
        document.body.classList.add('light-theme');
      } else {
        document.body.classList.remove('light-theme');
      }
    })();
  </script>

  <!-- ⭐ DİL KALICILIĞI -->
  <script is:inline>
    (function() {
      var savedLang = localStorage.getItem('ww_language');
      if (savedLang && ['en', 'tr', 'de'].includes(savedLang)) {
        document.documentElement.setAttribute('data-lang', savedLang);
        document.documentElement.lang = savedLang;
      } else {
        localStorage.setItem('ww_language', 'en');
        document.documentElement.setAttribute('data-lang', 'en');
        document.documentElement.lang = 'en';
      }
    })();
  </script>
  
  <style>
    /* ⭐ GRİ KUTULARI KÖKTEN KAPAT */
    *:focus,
    *:focus-visible,
    *:focus-within {
      outline: none !important;
      box-shadow: none !important;
      border-color: transparent !important;
    }
    
    button:focus,
    button:focus-visible,
    a:focus,
    a:focus-visible,
    input:focus,
    input:focus-visible,
    select:focus,
    select:focus-visible,
    textarea:focus,
    textarea:focus-visible,
    .sidebar-nav-item:focus,
    .sidebar-nav-item:focus-visible,
    .settings-tab-btn:focus,
    .settings-tab-btn:focus-visible,
    .lang-compact-btn:focus,
    .lang-compact-btn:focus-visible,
    .currency-btn:focus,
    .currency-btn:focus-visible {
      outline: none !important;
      box-shadow: none !important;
      border-color: transparent !important;
    }
    
    .sidebar-nav-item:hover,
    .settings-tab-btn:hover,
    .lang-compact-btn:hover,
    .currency-btn:hover {
      outline: none !important;
      box-shadow: none !important;
      border-color: transparent !important;
    }

    /* ============================================================
       SETTINGS WRAP
       ============================================================ */
    .settings-wrap {
      display: grid;
      grid-template-columns: 220px 1fr;
      gap: 1.25rem;
      align-items: start;
    }
    .settings-sidebar {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      position: sticky;
      top: 80px;
    }
    .sidebar-profile {
      padding: 1.25rem 1rem;
      border-bottom: 1px solid var(--border);
      text-align: center;
      cursor: pointer;
      transition: background 0.2s;
    }
    .sidebar-profile:hover {
      background: rgba(139,92,246,0.03);
    }
    .sidebar-avatar {
      width: 56px;
      height: 56px;
      background: var(--surface2);
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 0.65rem;
      overflow: hidden;
      border: 2px solid var(--border);
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .sidebar-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .sidebar-avatar .no-avatar {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.6rem;
      font-weight: 700;
      color: var(--muted);
      font-family: 'Syne', sans-serif;
      background: var(--surface2);
    }
    .sidebar-avatar:hover {
      transform: scale(1.05);
      box-shadow: 0 0 20px rgba(139,92,246,0.25);
    }
    .sidebar-username {
      font-family: 'Syne', sans-serif;
      font-size: .9rem;
      font-weight: 600;
      color: var(--text);
      margin-bottom: .15rem;
    }
    .sidebar-email {
      font-family: 'DM Mono', monospace;
      font-size: 10px;
      color: var(--muted);
      word-break: break-all;
    }
    .sidebar-nav {
      padding: .5rem;
    }
    .sidebar-nav-item {
      display: flex;
      align-items: center;
      gap: .65rem;
      padding: .6rem .85rem;
      border-radius: 8px;
      font-family: 'DM Sans', sans-serif;
      font-size: 13px;
      font-weight: 500;
      color: var(--muted);
      cursor: pointer;
      transition: all .2s;
      border: none;
      background: none;
      width: 100%;
      text-align: left;
    }
    .sidebar-nav-item .nav-icon {
      width: 16px;
      height: 16px;
      stroke: currentColor;
      stroke-width: 1.8;
      flex-shrink: 0;
    }
    .sidebar-nav-item:hover {
      background: rgba(139,92,246,0.07);
      color: var(--text);
    }
    .sidebar-nav-item.active {
      background: rgba(139,92,246,0.12);
      color: var(--accent2);
    }
    .sidebar-nav-item.danger { color: var(--red); }
    .sidebar-nav-item.danger:hover { background: rgba(239,68,68,0.08); }
    .sidebar-nav-divider {
      height: 1px;
      background: var(--border);
      margin: .4rem .85rem;
    }

    /* ============================================================
       PANELS
       ============================================================ */
    .settings-panels {
      position: relative;
      min-width: 0;
    }
    
    .panel-glow {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 280px;
      border-radius: var(--radius) var(--radius) 0 0;
      pointer-events: none;
      z-index: 0;
      opacity: 0.7;
      transition: all 0.3s ease;
    }
    
    .panel-glow.profile-glow {
      background: radial-gradient(ellipse 70% 30% at 50% 0%, rgba(139,92,246,0.5), transparent 70%);
      animation: glowPulse 3s ease-in-out infinite;
    }
    .panel-glow.password-glow {
      background: radial-gradient(ellipse 70% 30% at 50% 0%, rgba(34,197,94,0.45), transparent 70%);
      animation: glowPulse 3s ease-in-out infinite;
    }
    .panel-glow.appearance-glow {
      background: radial-gradient(ellipse 70% 30% at 50% 0%, rgba(139,92,246,0.5), transparent 70%);
      animation: glowPulse 3s ease-in-out infinite;
    }
    .panel-glow.danger-glow {
      background: radial-gradient(ellipse 70% 30% at 50% 0%, rgba(239,68,68,0.55), transparent 70%);
      animation: glowPulse 2s ease-in-out infinite;
    }
    .panel-glow.plan-glow {
      background: radial-gradient(ellipse 70% 30% at 50% 0%, rgba(139,92,246,0.6), transparent 70%);
      animation: glowPulse 3s ease-in-out infinite;
    }
    .panel-glow.overtrade-glow {
      background: radial-gradient(ellipse 70% 30% at 50% 0%, rgba(251,191,36,0.6), transparent 70%);
      animation: glowPulse 2.5s ease-in-out infinite;
    }
    
    @keyframes glowPulse {
      0%, 100% { opacity: 0.5; }
      50% { opacity: 1; }
    }
    
    body.light-theme .panel-glow.profile-glow {
      background: radial-gradient(ellipse 70% 30% at 50% 0%, rgba(139,92,246,0.25), transparent 70%);
    }
    body.light-theme .panel-glow.password-glow {
      background: radial-gradient(ellipse 70% 30% at 50% 0%, rgba(34,197,94,0.2), transparent 70%);
    }
    body.light-theme .panel-glow.appearance-glow {
      background: radial-gradient(ellipse 70% 30% at 50% 0%, rgba(139,92,246,0.25), transparent 70%);
    }
    body.light-theme .panel-glow.danger-glow {
      background: radial-gradient(ellipse 70% 30% at 50% 0%, rgba(239,68,68,0.25), transparent 70%);
    }
    body.light-theme .panel-glow.plan-glow {
      background: radial-gradient(ellipse 70% 30% at 50% 0%, rgba(139,92,246,0.25), transparent 70%);
    }
    body.light-theme .panel-glow.overtrade-glow {
      background: radial-gradient(ellipse 70% 30% at 50% 0%, rgba(251,191,36,0.2), transparent 70%);
    }
    
    .settings-panel {
      display: none;
      position: relative;
      z-index: 1;
      background: transparent;
    }
    .settings-panel.active {
      display: block;
      animation: panelFadeIn 0.3s ease;
    }
    
    @keyframes panelFadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ============================================================
       S-CARD
       ============================================================ */
    .s-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      margin-bottom: 1rem;
      backdrop-filter: blur(2px);
    }
    .s-card-header {
      padding: 1rem 1.25rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: .65rem;
    }
    .s-card-header .header-icon {
      width: 32px;
      height: 32px;
      background: rgba(139,92,246,0.08);
      border: 1px solid rgba(139,92,246,0.15);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .s-card-header .header-icon svg {
      width: 16px;
      height: 16px;
      stroke: var(--accent2);
      stroke-width: 1.8;
    }
    .s-card-header h2 {
      font-family: 'Syne', sans-serif;
      font-size: .9rem;
      font-weight: 600;
      color: var(--text);
      margin: 0;
    }
    .s-card-header p {
      font-size: 11px;
      color: var(--muted);
      margin: .1rem 0 0;
    }
    .s-card-body { padding: 1.1rem 1.25rem; }

    /* ============================================================
       OVER TRADE AYARLARI
       ============================================================ */
    .ot-premium-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 10px;
      font-weight: 600;
      font-family: 'DM Mono', monospace;
      letter-spacing: 0.08em;
      background: linear-gradient(135deg, rgba(139,92,246,0.15), rgba(192,132,252,0.1));
      color: var(--accent2);
      padding: 0.2rem 0.7rem;
      border-radius: 20px;
      border: 1px solid rgba(139,92,246,0.2);
    }
    .ot-premium-badge .diamond {
      font-size: 10px;
    }
    .ot-premium-locked {
      text-align: center;
      padding: 2.5rem 1.5rem;
      background: var(--surface2);
      border-radius: var(--radius);
      border: 1px solid var(--border);
    }
    .ot-premium-locked .lock-icon {
      font-size: 3rem;
      margin-bottom: 0.75rem;
    }
    .ot-premium-locked h3 {
      font-family: 'Syne', sans-serif;
      font-size: 1rem;
      color: var(--text);
      margin-bottom: 0.5rem;
    }
    .ot-premium-locked p {
      font-size: 13px;
      color: var(--muted);
      max-width: 400px;
      margin: 0 auto 1.25rem;
      line-height: 1.6;
    }
    .ot-premium-locked .btn-premium-cta {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      border: none;
      color: #fff;
      padding: 0.65rem 1.8rem;
      border-radius: 10px;
      font-family: 'DM Sans', sans-serif;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      text-decoration: none;
    }
    .ot-premium-locked .btn-premium-cta:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 24px rgba(139,92,246,0.4);
    }

    /* ============================================================
       AVATAR
       ============================================================ */
    .avatar-upload-section {
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--border);
    }
    .avatar-upload-title {
      font-family: 'Syne', sans-serif;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 0.75rem;
    }
    .avatar-upload-container {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      flex-wrap: wrap;
    }
    .avatar-preview {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      overflow: hidden;
      background: var(--surface2);
      border: 2px solid var(--border);
      flex-shrink: 0;
    }
    .avatar-preview img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .avatar-preview .avatar-placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
      font-weight: 700;
      color: var(--muted);
      font-family: 'Syne', sans-serif;
      background: var(--surface2);
    }
    .avatar-buttons {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }
    .btn-upload {
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      border: none;
      color: #fff;
      padding: 0.5rem 1rem;
      border-radius: 8px;
      font-family: 'DM Sans', sans-serif;
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .btn-upload:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 12px var(--accent-glow);
    }
    .btn-remove-avatar {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--muted);
      padding: 0.5rem 1rem;
      border-radius: 8px;
      font-family: 'DM Sans', sans-serif;
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-remove-avatar:hover {
      border-color: var(--red);
      color: var(--red);
    }
    .upload-progress {
      display: none;
      align-items: center;
      gap: 8px;
      margin-top: 0.5rem;
      font-size: 11px;
      color: var(--muted);
    }
    .upload-progress .spinner-small {
      width: 16px;
      height: 16px;
      border: 2px solid var(--border);
      border-top-color: var(--accent);
      border-radius: 50%;
      animation: spin 0.6s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    .info-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: .65rem 0;
      border-bottom: 1px solid var(--border);
      gap: 1rem;
    }
    .info-row:last-child { border-bottom: none; }
    .info-label {
      font-size: 12.5px;
      color: var(--muted);
      font-weight: 500;
      flex-shrink: 0;
    }
    .info-value {
      font-family: 'DM Mono', monospace;
      font-size: 12px;
      color: var(--text);
      text-align: right;
      word-break: break-all;
    }
    .info-badge {
      display: inline-flex;
      align-items: center;
      gap: .3rem;
      font-family: 'DM Mono', monospace;
      font-size: 10px;
      padding: 2px 9px;
      border-radius: 20px;
      background: rgba(34,197,94,0.1);
      color: var(--green);
      border: 1px solid rgba(34,197,94,0.2);
    }

    /* ============================================================
       PASSWORD
       ============================================================ */
    .pw-field {
      position: relative;
      margin-bottom: .85rem;
    }
    .pw-field label {
      display: block;
      font-family: 'DM Mono', monospace;
      font-size: 9px;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: .4rem;
    }
    .pw-field input {
      width: 100%;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: .65rem 2.5rem .65rem .9rem;
      color: var(--text);
      font-family: 'DM Sans', sans-serif;
      font-size: 14px;
      outline: none;
    }
    .pw-field input:focus { border-color: var(--accent); }
    .pw-toggle {
      position: absolute;
      right: 10px;
      bottom: 11px;
      cursor: pointer;
      color: var(--muted);
      background: none;
      border: none;
      padding: 0;
    }
    .pw-toggle:hover { color: var(--accent); }

    .pw-strength {
      display: flex;
      gap: 3px;
      margin-top: .35rem;
      height: 3px;
    }
    .pw-strength-bar {
      flex: 1;
      border-radius: 99px;
      background: var(--border);
    }
    .pw-strength-bar.weak { background: var(--red); }
    .pw-strength-bar.medium { background: #facc15; }
    .pw-strength-bar.strong { background: var(--green); }
    .pw-strength-label {
      font-family: 'DM Mono', monospace;
      font-size: 9px;
      color: var(--muted);
      margin-top: .25rem;
    }

    /* ============================================================
       THEME / LANGUAGE / CURRENCY
       ============================================================ */
    .theme-toggle-card {
      background: var(--surface2);
      border-radius: 12px;
      padding: 1rem;
    }
    .theme-toggle-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }
    .theme-toggle-info {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .theme-toggle-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background: var(--surface);
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
    }
    .theme-toggle-icon svg {
      width: 20px;
      height: 20px;
      stroke: var(--accent);
      stroke-width: 1.8;
    }
    .theme-toggle-text h4 {
      font-family: 'Syne', sans-serif;
      font-size: 0.9rem;
      font-weight: 600;
      margin: 0 0 2px;
    }
    .theme-toggle-text p {
      font-size: 11px;
      color: var(--muted);
      margin: 0;
    }
    .toggle-switch {
      position: relative;
      width: 50px;
      height: 26px;
      flex-shrink: 0;
    }
    .toggle-switch input {
      opacity: 0;
      width: 0;
      height: 0;
      position: absolute;
    }
    .toggle-slider {
      position: absolute;
      inset: 0;
      background: var(--border);
      border-radius: 99px;
      cursor: pointer;
      transition: background 0.3s;
    }
    .toggle-slider::before {
      content: '';
      position: absolute;
      width: 20px;
      height: 20px;
      left: 3px;
      top: 3px;
      background: #fff;
      border-radius: 50%;
      transition: transform 0.3s;
    }
    .toggle-switch input:checked + .toggle-slider {
      background: linear-gradient(135deg, var(--accent), var(--accent2));
    }
    .toggle-switch input:checked + .toggle-slider::before {
      transform: translateX(24px);
    }

    .lang-selector-compact {
      display: flex;
      gap: 0.5rem;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 40px;
      padding: 0.25rem;
    }
    .lang-compact-btn {
      background: transparent;
      border: none;
      border-radius: 40px;
      padding: 0.35rem 0.75rem;
      cursor: pointer;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.7rem;
      font-weight: 600;
      color: var(--muted);
      transition: all 0.2s ease;
    }
    .lang-compact-btn:hover {
      background: rgba(139,92,246,0.1);
      color: var(--accent);
    }
    .lang-compact-btn.active {
      background: linear-gradient(135deg, var(--accent), var(--accent2));
      color: #fff;
      box-shadow: 0 2px 6px rgba(139,92,246,0.3);
    }

    .currency-selector-compact {
      display: flex;
      gap: 0.5rem;
      background: var(--surface2);
      border: 1px solid var(--border);
      border-radius: 40px;
      padding: 0.25rem;
      flex-wrap: wrap;
    }
    .currency-btn {
      background: transparent;
      border: none;
      border-radius: 40px;
      padding: 0.35rem 0.75rem;
      cursor: pointer;
      font-family: 'DM Sans', sans-serif;
      font-size: 0.7rem;
      font-weight: 600;
      color: var(--muted);
      transition: all 0.2s ease;
    }
    .currency-btn:hover {
      background: rgba(139,92,246,0.1);
      color: var(--accent);
    }
    .currency-btn.active {
