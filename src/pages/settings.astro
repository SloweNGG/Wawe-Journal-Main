  <!-- 2. CORE KONFİG VE İ18N (ES5) -->
  <script src="/config.js" is:inline></script>
  <script src="/i18n.js" is:inline></script>
  
  <!-- 3. ⭐ ANA MODÜL SCRIPT (ES Module) -->
  <script type="module" src="/src/script.js" is:inline></script>
  
  <!-- 4. NAVBAR (ES5) -->
  <script src="/components/navbar/navbar.js" is:inline></script>
  
  <!-- 5. LUCIDE ICONS INIT -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      if (typeof lucide !== 'undefined') {
        lucide.createIcons();
        console.log('✅ Lucide icons initialized on settings!');
      }
    });
  </script>
  
  <!-- 6. NAVBAR'ı YÜKLE -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      if (typeof loadNavbar === 'function') {
        loadNavbar('navbar-container');
        console.log('✅ Navbar yüklendi!');
      } else {
        console.warn('⚠️ loadNavbar fonksiyonu bulunamadı!');
      }
    });
  </script>
  
  <!-- 7. SETTINGS JS (ES5 - AYNI KALIR) -->
  <script src="/settings/js/settings.js" is:inline></script>
  
  <style>
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>
  
