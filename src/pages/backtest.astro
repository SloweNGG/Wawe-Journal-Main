        <button type="button" id="bt-back-cancel" class="btn-modal-cancel"><span data-i18n="common.cancel">İptal</span></button>
        <span class="bt-spacer"></span>
        <button type="button" id="bt-back-reset" class="bt-btn-danger-ghost"><span data-i18n="backtest.back.reset">Hesabı sıfırla ve başla</span></button>
        <button type="button" id="bt-back-continue" class="btn-modal-confirm"><span data-i18n="backtest.back.continue">Devam et</span></button>
