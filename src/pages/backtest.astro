---
// ============================================================
// BACKTEST v2 (Faz 1 pratik modu + Faz 2 cTrader verisi): giriş yapmış herkese açık. Mumlar ya tarayıcıda üretilen sentetik
// veridir ya da (cTrader bağlayanlar için) kullanıcının kendi broker verisi (ctrader-candles Edge Function, bt-ctrader.js);
// hesaplar ve işlemler kullanıcının hesabında (Supabase) saklanır (bkz. docs/backtest-v2/PLAN.md, FAZ-E-VERI.md).
// Route kaydı korunuyor, silmeyin:
//   - src/components/SpaRouter.astro → SPA_PATHS '/backtest'
//   - public/components/navbar/page-transition.js → APP_PATHS '/backtest'
// Lightweight Charts adresi dashboard.astro ile birebir aynı olmalı (SpaRouter kimlik kontrolü).
// ============================================================
import Layout from '../layouts/Layout.astro';
---
<Layout lang="tr" spa={true} title="Backtest – Wawe Journal" bodyClass="backtest-page">
<Fragment slot="head">
  <link rel="stylesheet" href="/interface/backtest/css/backtest.css?v=11" />

  <link rel="preload" href="https://cdn.jsdelivr.net/npm/lightweight-charts@4.1.3/dist/lightweight-charts.standalone.production.js" as="script" />
  <link rel="preload" href="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.117.3" as="script" />
  <script src="https://cdn.jsdelivr.net/npm/lightweight-charts@4.1.3/dist/lightweight-charts.standalone.production.js" is:inline defer></script>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.117.3" is:inline defer></script>
  <script src="/config.js" is:inline defer></script>
  <script src="/i18n.js?v=1793400000" is:inline defer></script>
  <script type="module" src="/src/bundle.js" is:inline defer></script>

  <script src="/interface/backtest/js/bt-symbols.js?v=2" is:inline defer></script>
  <script src="/interface/backtest/js/bt-candles.js?v=2" is:inline defer></script>
  <script src="/interface/backtest/js/bt-engine.js?v=3" is:inline defer></script>
  <script src="/interface/backtest/js/bt-synthetic.js?v=1" is:inline defer></script>
  <script src="/interface/backtest/js/bt-data.js?v=1" is:inline defer></script>
  <script src="/interface/backtest/js/bt-ctrader.js?v=1" is:inline defer></script>
  <script src="/interface/backtest/js/bt-store.js?v=4" is:inline defer></script>
  <script src="/interface/backtest/js/bt-sync.js?v=1" is:inline defer></script>
  <script src="/interface/backtest/js/bt-layout.js?v=2" is:inline defer></script>
  <script src="/interface/backtest/js/bt-look.js?v=1" is:inline defer></script>
  <script src="/interface/backtest/js/bt-draw.js?v=1" is:inline defer></script>
  <script src="/interface/backtest/js/bt-stats.js?v=1" is:inline defer></script>
  <script src="/interface/backtest/js/backtest.js?v=14" is:inline defer data-page-script></script>
</Fragment>

  <main class="bt-main" id="bt-root" data-state="boot">

    <!-- ================= LIST VIEW ================= -->
    <section id="bt-view-list" class="bt-view" aria-labelledby="bt-title" hidden>
      <div class="page-header">
        <div>
          <h1 id="bt-title" data-i18n="backtest.title">Backtest</h1>
          <p class="subtitle" data-i18n="backtest.subtitle">Geçmiş piyasa verisinde mum mum işlem pratiği yap.</p>
        </div>
        <div class="bt-list-actions">
          <span id="bt-quota" class="bt-quota bt-num" aria-live="polite"></span>
          <button type="button" id="bt-new-account-btn" class="btn btn-primary">
            <i data-lucide="plus" aria-hidden="true"></i><span data-i18n="backtest.new_account">Yeni hesap</span>
          </button>
        </div>
      </div>
      <p class="bt-banner bt-banner-test" role="status">
        <i data-lucide="info" aria-hidden="true"></i>
        <span data-i18n="backtest.list_banner">Mumlar sentetiktir, gerçek piyasa verisi değildir. Hesapların kullanıcı hesabında kayıtlıdır.</span>
      </p>
      <p id="bt-ctrader-needed" class="bt-banner bt-banner-error" role="alert" hidden>
        <span data-i18n="backtest.ctrader.needed">cTrader bağlantısı gerekli: bu hesabın mumları cTrader hesabından gelir, ancak bağlantı koptu ya da süresi doldu. İşlemlerin ve defter kopyaları korunur; bağlantıyı yenileyince devam edebilirsin.</span>
        <a class="bt-link" href="/journals" data-i18n="backtest.ctrader.reconnect">cTrader bağlantısını yenile</a>
      </p>
      <p id="bt-storage-warning" class="bt-banner bt-banner-error" role="status" hidden data-i18n="backtest.storage_unavailable">Tarayıcı depolaması kullanılamıyor: hesaplar kaydedilmiyor, sayfa kapanınca kaybolur.</p>
      <p id="bt-quota-note" class="bt-hint" data-i18n="backtest.quota.over_limit" hidden>Plan limitinin üzerindesiniz; mevcut hesaplar çalışmaya devam eder.</p>

      <div id="bt-accounts" class="bt-accounts" aria-busy="true">
        <div class="bt-account-card bt-skeleton"></div>
        <div class="bt-account-card bt-skeleton"></div>
        <div class="bt-account-card bt-skeleton"></div>
      </div>

      <div id="bt-accounts-empty" class="bt-empty" hidden>
        <i data-lucide="history" aria-hidden="true"></i>
        <h2 data-i18n="backtest.empty_title">Henüz backtest hesabın yok</h2>
        <p data-i18n="backtest.empty_desc">Bir sembol ve başlangıç tarihi seç, geçmiş veride mum mum işlem yap.</p>
        <button type="button" id="bt-empty-create-btn" class="btn btn-primary"><span data-i18n="backtest.new_account">Yeni hesap</span></button>
      </div>

      <div id="bt-list-error" class="bt-banner bt-banner-error" role="alert" hidden>
        <span data-i18n="backtest.load_error">Hesaplar yüklenemedi.</span>
        <button type="button" id="bt-list-retry-btn" class="btn btn-ghost"><span data-i18n="backtest.retry">Tekrar dene</span></button>
      </div>
      <p id="bt-demo" class="bt-banner" data-i18n="backtest.demo_mode" hidden>Demo modunda backtest kullanılamaz. Lütfen giriş yapın.</p>
      <p id="bt-fatal" class="bt-banner bt-banner-error" role="alert" data-i18n="backtest.deps_error" hidden>Sayfa bileşenleri yüklenemedi. Lütfen sayfayı yenileyin.</p>
    </section>

    <!-- ================= REPLAY VIEW ================= -->
    <section id="bt-view-replay" class="bt-view" data-replay="idle" hidden>
      <header class="bt-replay-head">
        <button type="button" id="bt-back-btn" class="btn btn-ghost bt-back">
          <i data-lucide="arrow-left" aria-hidden="true"></i><span data-i18n="backtest.back">Hesaplar</span>
        </button>
        <div class="bt-replay-title">
          <h2 id="bt-acc-name"></h2>
          <span id="bt-acc-symbol" class="bt-chip"></span>
        </div>
        <div class="bt-head-tools">
          <div class="bt-seg" role="group" data-i18n-title="backtest.mode.label" title="Görünüm">
            <button type="button" data-bt-mode="simple" aria-pressed="true" data-i18n-title="backtest.mode.simple_hint" title="Grafik, replay ve emir paneli"><span data-i18n="backtest.mode.simple">Basit</span></button>
            <button type="button" data-bt-mode="advanced" aria-pressed="false" data-i18n-title="backtest.mode.advanced_hint" title="Tüm paneller ve araçlar"><span data-i18n="backtest.mode.advanced">Gelişmiş</span></button>
          </div>
          <div class="bt-layout-wrap bt-adv-only">
            <button type="button" id="bt-layout-btn" class="bt-icon-btn" aria-expanded="false" aria-controls="bt-layout-pop" data-i18n-title="backtest.multi.title" title="Grafik düzeni">
              <i data-lucide="layout-grid" aria-hidden="true"></i><span class="bt-sr" data-i18n="backtest.multi.title">Grafik düzeni</span>
            </button>
            <div id="bt-layout-pop" class="bt-layout-pop" role="menu" hidden></div>
          </div>
          <button type="button" id="bt-look-btn" class="bt-icon-btn" aria-expanded="false" aria-controls="bt-look-drawer" data-i18n-title="backtest.look.title" title="Görünüm ayarları">
            <i data-lucide="palette" aria-hidden="true"></i><span class="bt-sr" data-i18n="backtest.look.title">Görünüm ayarları</span>
          </button>
          <button type="button" id="bt-keys-btn" class="bt-icon-btn" data-i18n-title="backtest.keys.title" title="Klavye kısayolları">
            <i data-lucide="keyboard" aria-hidden="true"></i><span class="bt-sr" data-i18n="backtest.keys.title">Klavye kısayolları</span>
          </button>
          <button type="button" id="bt-fs-btn" class="bt-icon-btn" data-bt-fs aria-pressed="false" data-i18n-title="backtest.fs.enter" title="Tam ekran (F)">
            <i data-lucide="maximize-2" aria-hidden="true"></i><span class="bt-sr" data-i18n="backtest.fs.enter">Tam ekran (F)</span>
          </button>
          <button type="button" id="bt-acc-settings-btn" class="btn btn-ghost">
            <i data-lucide="settings-2" aria-hidden="true"></i><span data-i18n="backtest.card.settings">Ayarlar</span>
          </button>
        </div>
      </header>

      <div class="bt-toolbar" role="toolbar">
        <label class="bt-sr" for="bt-tf" data-i18n="backtest.field.timeframe">Zaman dilimi</label>
        <select id="bt-tf" class="bt-select bt-num">
          <option value="1m">M1</option><option value="5m">M5</option><option value="15m">M15</option>
          <option value="30m">M30</option><option value="1h">H1</option><option value="4h">H4</option><option value="1d">D1</option>
        </select>

        <div class="bt-goto">
          <label class="bt-sr" for="bt-goto-input" data-i18n="backtest.goto.label">Tarihe git</label>
          <input id="bt-goto-input" class="bt-input bt-num" type="datetime-local" step="60" />
          <button type="button" id="bt-goto-btn" class="btn btn-ghost"><span data-i18n="backtest.goto.button">Git</span></button>
        </div>

        <div class="bt-transport">
          <button type="button" id="bt-play-btn" class="bt-icon-btn bt-play" aria-pressed="false" data-i18n-title="backtest.play" title="Oynat">
            <i data-lucide="play" aria-hidden="true"></i><span id="bt-play-label" class="bt-sr" data-i18n="backtest.play">Oynat</span>
          </button>
          <button type="button" id="bt-step-btn" class="bt-icon-btn" data-i18n-title="backtest.step" title="Bir mum ilerle">
            <i data-lucide="skip-forward" aria-hidden="true"></i><span class="bt-sr" data-i18n="backtest.step">Bir mum ilerle</span>
          </button>
          <button type="button" id="bt-step1m-btn" class="bt-icon-btn bt-num" data-i18n-title="backtest.step_1m" title="1 dakika ilerle">+1m</button>
          <label class="bt-sr" for="bt-speed" data-i18n="backtest.speed">Hız</label>
          <select id="bt-speed" class="bt-select bt-num" data-i18n-title="backtest.speed_hint" title="Saniyede mum">
            <option value="0.1">0.1×</option><option value="0.3">0.3×</option><option value="0.5">0.5×</option>
            <option value="1" selected>1×</option><option value="3">3×</option><option value="10">10×</option>
          </select>
        </div>

        <div class="bt-clock">
          <span class="bt-sr" data-i18n="backtest.card.replay_time">Replay zamanı</span>
          <span id="bt-clock-time" class="bt-num">—</span>
          <span id="bt-clock-tz" class="bt-clock-tz"></span>
          <span id="bt-market-chip" class="bt-chip bt-chip-muted" hidden></span>
        </div>
      </div>

      <div class="bt-layout">
        <div id="bt-chart-card" class="bt-chart-card">
          <div class="bt-chart-top">
            <div id="bt-legend" class="bt-legend bt-num" aria-hidden="true"></div>
            <span id="bt-source-label" class="bt-source" data-i18n="backtest.source.synthetic">Sentetik veri, gerçek piyasa verisi değildir</span>
          </div>
          <div class="bt-chart-body">
          <div id="bt-draw-bar" class="bt-draw-bar bt-adv-only" role="toolbar" aria-orientation="vertical" data-i18n-title="backtest.draw.toolbar" title="Çizim araçları"></div>
          <div class="bt-chart-wrap">
            <div id="bt-charts" class="bt-charts" data-layout="1">
              <div class="bt-cell bt-cell-main"><div id="bt-chart" class="bt-chart"></div></div>
            </div>
            <div id="bt-chart-overlay" class="bt-chart-overlay" hidden>
              <span id="bt-overlay-text">Mum verisi yükleniyor…</span>
            </div>
          </div>
          </div>
          <div id="bt-data-banner" class="bt-banner" role="status" hidden>
            <span id="bt-data-banner-text"></span>
            <button type="button" id="bt-data-banner-btn" class="btn btn-ghost" hidden></button>
          </div>
          <button type="button" id="bt-fs-exit" class="bt-fs-exit" data-bt-fs aria-pressed="false">
            <i data-lucide="minimize-2" aria-hidden="true"></i><span data-i18n="backtest.fs.exit">Tam ekrandan çık (Esc)</span>
          </button>
          <footer class="bt-chart-foot">
            <span id="bt-gap-note" class="bt-hint"></span>
            <p class="bt-attribution">
              <span data-i18n="backtest.attribution_prefix">Grafikler:</span>
              <a href="https://www.tradingview.com/" target="_blank" rel="noopener noreferrer">TradingView Lightweight Charts™</a>
              <span>Copyright (c) 2023 TradingView, Inc.</span>
            </p>
          </footer>
        </div>

        <div class="bt-split bt-split-v" data-bt-split="side" role="separator" aria-orientation="vertical" tabindex="0" data-i18n-title="backtest.layout.resize_side" title="Paneli yeniden boyutlandır (sürükle veya ok tuşları)"></div>

        <aside class="bt-side">
          <div id="bt-stats" class="bt-card bt-stats">
            <div class="bt-stat"><span class="bt-stat-label" data-i18n="backtest.stat.balance">Bakiye</span><span id="bt-stat-balance" class="bt-num">—</span></div>
            <div class="bt-stat"><span class="bt-stat-label" data-i18n="backtest.stat.equity">Özsermaye</span><span id="bt-stat-equity" class="bt-num">—</span></div>
            <div class="bt-stat"><span class="bt-stat-label" data-i18n="backtest.stat.realized">Gerçekleşen K/Z</span><span id="bt-stat-realized" class="bt-num">—</span></div>
            <div class="bt-stat"><span class="bt-stat-label" data-i18n="backtest.stat.floating">Açık K/Z</span><span id="bt-stat-floating" class="bt-num">—</span></div>
          </div>

          <form id="bt-order-form" class="bt-card bt-order" novalidate autocomplete="off">
            <div id="bt-limit" class="bt-limit" role="status" aria-live="polite" data-i18n-title="backtest.limit.hint" title="cTrader verili hesaplarda ücretsiz planın aylık işlem sınırı; sayaç her ayın 1'inde (UTC) sıfırlanır. Açık pozisyonlar her zaman kapatılabilir." hidden>
              <div class="bt-limit-row"><span id="bt-limit-text" class="bt-num"></span><span class="bt-limit-bar"><span id="bt-limit-fill"></span></span></div>
              <p id="bt-limit-full" class="bt-limit-msg" hidden><span data-i18n="backtest.limit.unlimited">Sınırsız işlem Premium'da</span>
                <button type="button" id="bt-limit-upgrade" class="bt-link-btn" data-i18n="backtest.limit.upgrade">Yükselt</button></p>
            </div>
            <div class="bt-quote">
              <button type="button" id="bt-sell-btn" class="bt-btn-sell" data-dir="-1">
                <span data-i18n="backtest.order.sell">SAT</span><span id="bt-bid" class="bt-num">—</span>
              </button>
              <span id="bt-spread" class="bt-spread bt-num">—</span>
              <button type="button" id="bt-buy-btn" class="bt-btn-buy" data-dir="1">
                <span data-i18n="backtest.order.buy">AL</span><span id="bt-ask" class="bt-num">—</span>
              </button>
            </div>
            <div class="bt-field">
              <label for="bt-lot" data-i18n="backtest.order.lot">Lot</label>
              <input id="bt-lot" class="bt-input bt-num" type="text" inputmode="decimal" value="0.10" />
              <small id="bt-lot-hint" class="bt-hint bt-num"></small>
            </div>
            <div class="bt-field-row">
              <div class="bt-field">
                <label for="bt-sl" data-i18n="backtest.order.sl">Zarar durdur (SL)</label>
                <input id="bt-sl" class="bt-input bt-num" type="text" inputmode="decimal" data-i18n-placeholder="backtest.order.price_ph" placeholder="Fiyat (isteğe bağlı)" />
              </div>
              <div class="bt-field">
                <label for="bt-tp" data-i18n="backtest.order.tp">Kâr al (TP)</label>
                <input id="bt-tp" class="bt-input bt-num" type="text" inputmode="decimal" data-i18n-placeholder="backtest.order.price_ph" placeholder="Fiyat (isteğe bağlı)" />
              </div>
            </div>
            <p id="bt-order-risk" class="bt-hint bt-num"></p>
            <p id="bt-order-error" class="bt-error" role="alert" hidden></p>
          </form>
          <section id="bt-mini-pos" class="bt-card bt-mini-pos bt-simple-only" aria-labelledby="bt-mini-pos-title">
            <p id="bt-mini-pos-title" class="bt-mini-title"><span data-i18n="backtest.pos.title">Açık pozisyonlar</span> <span id="bt-mini-pos-count" class="bt-count bt-num">0</span></p>
            <ul id="bt-mini-pos-list" class="bt-mini-pos-list"></ul>
            <p id="bt-mini-pos-empty" class="bt-hint" data-i18n="backtest.pos.empty">Açık pozisyon yok.</p>
          </section>
          <p class="bt-hint bt-shortcuts"><span data-i18n="backtest.shortcuts">Kısayollar: Boşluk = oynat/duraklat, → = bir mum, Shift+→ = 1 dakika</span>
            <button type="button" id="bt-keys-link" class="bt-link-btn" data-i18n="backtest.keys.all">Tüm kısayollar (?)</button></p>
        </aside>
      </div>

      <div id="bt-save-banner" class="bt-banner bt-banner-error" role="alert" hidden>
        <span data-i18n="backtest.err.save_failed_final">Bazı değişiklikler kaydedilemedi.</span>
        <button type="button" id="bt-save-retry-btn" class="btn btn-ghost"><span data-i18n="backtest.retry">Tekrar dene</span></button>
      </div>

      <div class="bt-split bt-split-h bt-adv-only" data-bt-split="bottom" role="separator" aria-orientation="horizontal" tabindex="0" data-i18n-title="backtest.layout.resize_bottom" title="Alt paneli yeniden boyutlandır (sürükle veya ok tuşları)"></div>

      <section class="bt-card bt-tables bt-adv-only">
        <div class="bt-tabs" role="tablist">
          <button type="button" role="tab" id="bt-tab-open" aria-controls="bt-panel-open" aria-selected="true">
            <span data-i18n="backtest.pos.title">Açık pozisyonlar</span> <span id="bt-open-count" class="bt-count bt-num">0</span></button>
          <button type="button" role="tab" id="bt-tab-history" aria-controls="bt-panel-history" aria-selected="false">
            <span data-i18n="backtest.history.title">İşlem geçmişi</span> <span id="bt-history-count" class="bt-count bt-num">0</span></button>
          <button type="button" role="tab" id="bt-tab-stats" aria-controls="bt-panel-stats" aria-selected="false">
            <span data-i18n="backtest.stats.title">İstatistikler</span></button>
        </div>

        <div id="bt-panel-open" class="bt-panel" role="tabpanel" aria-labelledby="bt-tab-open">
          <div class="bt-table-wrap"><table class="bt-table">
            <thead><tr>
              <th data-i18n="backtest.col.dir">Yön</th><th data-i18n="backtest.col.lot">Lot</th>
              <th data-i18n="backtest.col.entry_time">Giriş zamanı</th><th data-i18n="backtest.col.entry">Giriş</th>
              <th>SL</th><th>TP</th><th data-i18n="backtest.col.price">Güncel fiyat</th>
              <th data-i18n="backtest.col.pnl">K/Z</th><th><span class="bt-sr" data-i18n="backtest.col.actions">İşlemler</span></th>
            </tr></thead>
            <tbody id="bt-open-body"></tbody>
          </table></div>
          <p id="bt-open-empty" class="bt-hint" data-i18n="backtest.pos.empty">Açık pozisyon yok.</p>
        </div>

        <div id="bt-panel-history" class="bt-panel" role="tabpanel" aria-labelledby="bt-tab-history" hidden>
          <div class="bt-table-wrap"><table class="bt-table">
            <thead><tr>
              <th data-i18n="backtest.col.dir">Yön</th><th data-i18n="backtest.col.lot">Lot</th>
              <th data-i18n="backtest.col.entry_time">Giriş zamanı</th><th data-i18n="backtest.col.entry">Giriş</th>
              <th data-i18n="backtest.col.exit_time">Çıkış zamanı</th><th data-i18n="backtest.col.exit">Çıkış</th>
              <th data-i18n="backtest.col.reason">Sebep</th><th data-i18n="backtest.col.commission">Komisyon</th>
              <th data-i18n="backtest.col.net">Net K/Z</th><th data-i18n="backtest.col.rr">R:R</th>
            </tr></thead>
            <tbody id="bt-history-body"></tbody>
          </table></div>
          <p id="bt-history-empty" class="bt-hint" data-i18n="backtest.history.empty">Henüz kapanan işlem yok.</p>
          <p id="bt-history-more" class="bt-hint" hidden></p>
        </div>

        <div id="bt-panel-stats" class="bt-panel" role="tabpanel" aria-labelledby="bt-tab-stats" hidden>
          <div id="bt-stats-view" class="bt-st"></div>
          <p class="bt-hint bt-st-foot"><span id="bt-stats-extra" class="bt-num"></span> <span data-i18n="backtest.stat.currency_note">Tutarlar USD cinsindendir.</span></p>
        </div>
      </section>
    </section>
  </main>

  <!-- appearance drawer (bt-look.js builds the body; outside main so it also covers the full-screen chart) -->
  <aside id="bt-look-drawer" class="bt-drawer" aria-labelledby="bt-look-title" hidden>
    <div class="bt-drawer-head">
      <h3 id="bt-look-title" data-i18n="backtest.look.title">Görünüm ayarları</h3>
      <button type="button" id="bt-look-close" class="modal-close" data-i18n-title="common.close" title="Kapat">✕</button>
    </div>
    <div id="bt-look-body" class="bt-drawer-body"></div>
  </aside>

  <!-- ================= MODALS (page slot: SPA removes them with the page) ================= -->
  <div id="bt-account-modal" class="modal-overlay bt-modal" role="dialog" aria-modal="true" aria-labelledby="bt-account-modal-title">
    <div class="modal-box">
      <div class="modal-header">
        <h3 id="bt-account-modal-title" data-i18n="backtest.modal.create_title">Yeni backtest hesabı</h3>
        <button type="button" id="bt-account-close" class="modal-close" data-i18n-title="common.close" title="Kapat">✕</button>
      </div>
      <form id="bt-account-form" class="modal-body" novalidate autocomplete="off">
        <div class="bt-field"><label for="bt-f-name" data-i18n="backtest.field.name">Hesap adı</label>
          <input id="bt-f-name" class="bt-input" type="text" maxlength="60" data-i18n-placeholder="backtest.field.name_ph" placeholder="Örn. EURUSD Londra seansı" /></div>
        <div class="bt-field-row">
          <div class="bt-field"><label for="bt-f-symbol" data-i18n="backtest.field.symbol">Sembol</label>
            <select id="bt-f-symbol" class="bt-select"></select></div>
          <div class="bt-field"><label for="bt-f-tf" data-i18n="backtest.field.timeframe">Zaman dilimi</label>
            <select id="bt-f-tf" class="bt-select bt-num">
              <option value="1m">M1</option><option value="5m">M5</option><option value="15m">M15</option>
              <option value="30m">M30</option><option value="1h" selected>H1</option><option value="4h">H4</option><option value="1d">D1</option>
            </select></div>
        </div>
        <fieldset class="bt-source-field" id="bt-f-source-wrap">
          <legend data-i18n="backtest.field.source">Veri kaynağı</legend>
          <label class="bt-radio" for="bt-f-source-synthetic">
            <input type="radio" name="bt-f-source" id="bt-f-source-synthetic" value="synthetic" checked />
            <span><span class="bt-radio-title" data-i18n="backtest.source.option_synthetic">Sentetik veri (pratik)</span>
              <small class="bt-hint" data-i18n="backtest.source.option_synthetic_hint">Mumlar tarayıcıda üretilir; gerçek piyasa verisi değildir.</small></span>
          </label>
          <label class="bt-radio" for="bt-f-source-ctrader">
            <input type="radio" name="bt-f-source" id="bt-f-source-ctrader" value="ctrader" disabled />
            <span><span class="bt-radio-title" data-i18n="backtest.source.option_ctrader">cTrader verisi</span>
              <small class="bt-hint" data-i18n="backtest.source.option_ctrader_hint">Mumlar bağlı cTrader hesabından, kendi broker verinle gelir.</small></span>
          </label>
          <small id="bt-f-source-connect" class="bt-hint" hidden><a id="bt-f-source-connect-link" class="bt-link" href="/journals">cTrader hesabını bağla</a></small>
          <small id="bt-f-source-note" class="bt-hint" data-i18n="backtest.source.locked" hidden>Veri kaynağı hesap oluşturulduktan sonra değiştirilemez.</small>
        </fieldset>
        <div id="bt-f-ct-wrap" class="bt-ct-wrap" hidden>
          <div class="bt-field-row">
            <div class="bt-field"><label for="bt-f-ct-account" data-i18n="backtest.ctrader.account">cTrader hesabı</label>
              <select id="bt-f-ct-account" class="bt-select"></select></div>
            <div class="bt-field"><label for="bt-f-ct-symbol" data-i18n="backtest.ctrader.symbol">Broker sembolü</label>
              <select id="bt-f-ct-symbol" class="bt-select"></select></div>
          </div>
          <p id="bt-f-ct-depth" class="bt-hint bt-block-hint" role="status" aria-live="polite"></p>
        </div>
        <p id="bt-f-ct-summary" class="bt-hint bt-block-hint" hidden></p>
        <p id="bt-f-symbol-hint" class="bt-hint bt-block-hint" hidden></p>
        <div class="bt-field" id="bt-f-start-wrap"><label for="bt-f-start" data-i18n="backtest.field.start">Başlangıç tarihi ve saati</label>
          <input id="bt-f-start" class="bt-input bt-num" type="datetime-local" step="60" />
          <small id="bt-f-start-hint" class="bt-hint"></small></div>
        <p id="bt-f-start-note" class="bt-hint bt-block-hint" data-i18n="backtest.field.start_edit_note" hidden>Başlangıç tarihi hesap oluşturulurken seçilir. Replay zamanını değiştirmek için araç çubuğundaki «Tarihe git» alanını kullan.</p>
        <div class="bt-field-row">
          <div class="bt-field" id="bt-f-balance-wrap"><label for="bt-f-balance" data-i18n="backtest.field.balance">Başlangıç bakiyesi (USD)</label>
            <input id="bt-f-balance" class="bt-input bt-num" type="text" inputmode="decimal" value="10000.00" />
            <small id="bt-f-balance-hint" class="bt-hint" hidden></small></div>
          <div class="bt-field"><label for="bt-f-spread" id="bt-f-spread-label" data-i18n="backtest.field.spread">Spread (pip)</label>
            <input id="bt-f-spread" class="bt-input bt-num" type="text" inputmode="decimal" />
            <small id="bt-f-spread-hint" class="bt-hint bt-num"></small></div>
        </div>
        <div class="bt-field"><label for="bt-f-commission" data-i18n="backtest.field.commission">Komisyon (lot başına, açılış+kapanış, USD)</label>
          <input id="bt-f-commission" class="bt-input bt-num" type="text" inputmode="decimal" value="0.00" />
          <small id="bt-f-commission-hint" class="bt-hint" data-i18n="backtest.field.commission_hint">Pozisyon kapanınca bakiyeden düşülür.</small></div>
        <div class="bt-field" id="bt-f-journal-wrap" hidden><label for="bt-f-journal" data-i18n="backtest.field.journal">Bağlı hesap (isteğe bağlı)</label>
          <select id="bt-f-journal" class="bt-select"><option value="" data-i18n="backtest.field.journal_none">Bağlantı yok</option></select>
          <small id="bt-f-journal-hint" class="bt-hint"></small></div>
        <p id="bt-account-error" class="bt-error" role="alert" hidden></p>
      </form>
      <div class="modal-footer">
        <button type="button" id="bt-account-delete" class="bt-btn-danger-ghost" hidden><span data-i18n="backtest.modal.delete_account">Hesabı sil</span></button>
        <button type="button" id="bt-account-reset" class="bt-btn-danger-ghost" hidden><span data-i18n="backtest.reset.button">Hesabı sıfırla</span></button>
        <span class="bt-spacer"></span>
        <button type="button" id="bt-account-cancel" class="btn-modal-cancel"><span data-i18n="common.cancel">İptal</span></button>
        <button type="button" id="bt-account-submit" class="btn-modal-confirm"><span id="bt-account-submit-label" data-i18n="backtest.modal.create">Hesabı oluştur</span></button>
      </div>
    </div>
  </div>

  <div id="bt-delete-modal" class="modal-overlay bt-modal" role="alertdialog" aria-modal="true" aria-labelledby="bt-delete-title">
    <div class="modal-box modal-box-sm">
      <div class="modal-header">
        <h3 id="bt-delete-title" data-i18n="backtest.delete.title">Hesabı sil</h3>
        <button type="button" id="bt-delete-close" class="modal-close" data-i18n-title="common.close" title="Kapat">✕</button>
      </div>
      <div class="modal-body">
        <p id="bt-delete-text"></p>
        <p id="bt-delete-note" class="bt-hint" hidden></p>
      </div>
      <div class="modal-footer">
        <button type="button" id="bt-delete-cancel" class="btn-modal-cancel"><span data-i18n="common.cancel">İptal</span></button>
        <button type="button" id="bt-delete-confirm" class="bt-btn-danger"><span data-i18n="backtest.delete.confirm">Kalıcı olarak sil</span></button>
      </div>
    </div>
  </div>

  <div id="bt-confirm-modal" class="modal-overlay bt-modal" role="alertdialog" aria-modal="true" aria-labelledby="bt-confirm-title">
    <div class="modal-box modal-box-sm">
      <div class="modal-header">
        <h3 id="bt-confirm-title" data-i18n="backtest.confirm.title">Onay</h3>
        <button type="button" id="bt-confirm-close" class="modal-close" data-i18n-title="common.close" title="Kapat">✕</button>
      </div>
      <div class="modal-body"><p id="bt-confirm-text"></p></div>
      <div class="modal-footer">
        <button type="button" id="bt-confirm-cancel" class="btn-modal-cancel"><span data-i18n="common.cancel">İptal</span></button>
        <button type="button" id="bt-confirm-ok" class="bt-btn-danger" data-i18n="backtest.confirm.ok">Devam</button>
      </div>
    </div>
  </div>

  <div id="bt-reset-modal" class="modal-overlay bt-modal" role="alertdialog" aria-modal="true" aria-labelledby="bt-reset-title">
    <div class="modal-box modal-box-sm">
      <div class="modal-header">
        <h3 id="bt-reset-title" data-i18n="backtest.reset.title">Hesabı sıfırla</h3>
        <button type="button" id="bt-reset-close" class="modal-close" data-i18n-title="common.close" title="Kapat">✕</button>
      </div>
      <div class="modal-body">
        <p id="bt-reset-text" data-i18n="backtest.reset.confirm">Tüm işlemler silinir, bakiye başlangıç bakiyesine döner. Sıfırlamadan sonra istediğin tarihe gidebilirsin.</p>
      </div>
      <div class="modal-footer">
        <button type="button" id="bt-reset-cancel" class="btn-modal-cancel"><span data-i18n="common.cancel">İptal</span></button>
        <button type="button" id="bt-reset-confirm" class="bt-btn-danger"><span data-i18n="backtest.reset.confirm_button">Sıfırla</span></button>
      </div>
    </div>
  </div>

  <div id="bt-keys-modal" class="modal-overlay bt-modal" role="dialog" aria-modal="true" aria-labelledby="bt-keys-title">
    <div class="modal-box modal-box-sm">
      <div class="modal-header">
        <h3 id="bt-keys-title" data-i18n="backtest.keys.title">Klavye kısayolları</h3>
        <button type="button" id="bt-keys-close" class="modal-close" data-i18n-title="common.close" title="Kapat">✕</button>
      </div>
      <div class="modal-body"><div id="bt-keys-list"></div></div>
    </div>
  </div>

  <div id="bt-text-modal" class="modal-overlay bt-modal" role="dialog" aria-modal="true" aria-labelledby="bt-text-title">
    <div class="modal-box modal-box-sm">
      <div class="modal-header">
        <h3 id="bt-text-title" data-i18n="backtest.draw.text_title">Metin</h3>
        <button type="button" id="bt-text-close" class="modal-close" data-i18n-title="common.close" title="Kapat">✕</button>
      </div>
      <form id="bt-text-form" class="modal-body" novalidate autocomplete="off">
        <div class="bt-field"><label for="bt-text-input" data-i18n="backtest.draw.text_label">Grafiğe yazılacak metin</label>
          <input id="bt-text-input" class="bt-input" type="text" maxlength="200" /></div>
      </form>
      <div class="modal-footer">
        <button type="button" id="bt-text-cancel" class="btn-modal-cancel"><span data-i18n="common.cancel">İptal</span></button>
        <button type="button" id="bt-text-ok" class="btn-modal-confirm"><span data-i18n="common.save">Kaydet</span></button>
      </div>
    </div>
  </div>

  <div id="bt-pos-modal" class="modal-overlay bt-modal" role="dialog" aria-modal="true" aria-labelledby="bt-pos-title">
    <div class="modal-box modal-box-sm">
      <div class="modal-header">
        <h3 id="bt-pos-title" data-i18n="backtest.pos.modal_title">Pozisyonu düzenle</h3>
        <button type="button" id="bt-pos-close" class="modal-close" data-i18n-title="common.close" title="Kapat">✕</button>
      </div>
      <form id="bt-pos-form" class="modal-body" novalidate autocomplete="off">
        <p id="bt-pos-info" class="bt-hint bt-num"></p>
        <div class="bt-field-row">
          <div class="bt-field"><label for="bt-pos-sl" data-i18n="backtest.order.sl">Zarar durdur (SL)</label>
            <input id="bt-pos-sl" class="bt-input bt-num" type="text" inputmode="decimal" /></div>
          <div class="bt-field"><label for="bt-pos-tp" data-i18n="backtest.order.tp">Kâr al (TP)</label>
            <input id="bt-pos-tp" class="bt-input bt-num" type="text" inputmode="decimal" /></div>
        </div>
        <p id="bt-pos-error" class="bt-error" role="alert" hidden></p>
      </form>
      <div class="modal-footer">
        <button type="button" id="bt-pos-cancel" class="btn-modal-cancel"><span data-i18n="common.cancel">İptal</span></button>
        <button type="button" id="bt-pos-save" class="btn-modal-confirm"><span data-i18n="common.save">Kaydet</span></button>
      </div>
    </div>
  </div>
</Layout>
