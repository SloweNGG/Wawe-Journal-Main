        <button type="button" id="bt-ord-close" class="modal-close" data-i18n-title="common.close" title="Kapat">✕</button>
      </div>
      <form id="bt-ord-form" class="modal-body" novalidate autocomplete="off">
        <p id="bt-ord-info" class="bt-hint bt-num"></p>
        <div class="bt-field-row">
          <div class="bt-field"><label for="bt-ord-f-price" data-i18n="backtest.order.price">Emir fiyatı</label>
            <input id="bt-ord-f-price" class="bt-input bt-num" type="text" inputmode="decimal" /></div>
          <div class="bt-field"><label for="bt-ord-f-lot" data-i18n="backtest.order.lot">Lot</label>
            <input id="bt-ord-f-lot" class="bt-input bt-num" type="text" inputmode="decimal" /></div>
        </div>
        <div class="bt-field-row">
          <div class="bt-field"><label for="bt-ord-f-sl" data-i18n="backtest.order.sl">Zarar durdur (SL)</label>
            <input id="bt-ord-f-sl" class="bt-input bt-num" type="text" inputmode="decimal" /></div>
          <div class="bt-field"><label for="bt-ord-f-tp" data-i18n="backtest.order.tp">Kâr al (TP)</label>
            <input id="bt-ord-f-tp" class="bt-input bt-num" type="text" inputmode="decimal" /></div>
        </div>
        <p id="bt-ord-error" class="bt-error" role="alert" hidden></p>
      </form>
      <div class="modal-footer">
        <button type="button" id="bt-ord-cancel-order" class="bt-btn-danger-ghost"><span data-i18n="backtest.orders.cancel">Emri iptal et</span></button>
        <span class="bt-spacer"></span>
        <button type="button" id="bt-ord-cancel" class="btn-modal-cancel"><span data-i18n="common.cancel">İptal</span></button>
        <button type="button" id="bt-ord-save" class="btn-modal-confirm"><span data-i18n="common.save">Kaydet</span></button>
      </div>
    </div>
  </div>

  <div id="bt-pos-modal" class="modal-overlay bt-modal" role="dialog" aria-modal="true" aria-labelledby="bt-pos-title">
    <div class="modal-box modal-box-sm">
      <div class="modal-header">
        <h3 id="bt-pos-title" data-i18n="backtest.pos.modal_title">Pozisyonu düzenle</h3>
        <button type="button" id="bt-pos-close" class="modal-close" data-i18n-title="common.close" title="Kapat">✕</button>
      </div>
      <form id="bt-pos-form" class="modal-body" novalidate autocomplete="off">
        <p id="bt-pos-info" class="bt-hint bt-num"></p>
