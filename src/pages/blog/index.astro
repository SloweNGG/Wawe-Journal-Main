---
// Blog liste sayfası (en yeni üstte). Yazılar: src/content/blog/*.md
import PageLayout from '../../layouts/PageLayout.astro';
import { allPosts, fmtDate } from '../../data/blog';

const posts = allPosts();
const schema = [
  {
    '@type': 'Blog',
    '@id': 'https://wawejournal.com/blog#blog',
    name: 'Wawe Journal blog',
    url: 'https://wawejournal.com/blog',
    publisher: { '@id': 'https://wawejournal.com/#organization' },
    blogPost: posts.map((p) => ({ '@id': `https://wawejournal.com/blog/${p.fm.slug}#article` })),
  },
];
---
<PageLayout
  title="Trading Journal Blog: Guides for Better Trading"
  description="Practical trading guides from Wawe Journal: how to keep a trading journal, backtest a strategy and pass a prop firm challenge, with real numbers."
  crumb="Blog"
  schema={schema}
>
  <section class="page-hero">
    <div class="wrap">
      <nav class="crumbs anim" style="--d:.02s" aria-label="Breadcrumb"><a href="/">Wawe Journal</a><span aria-hidden="true">/</span><span>Blog</span></nav>
      <h1 class="anim wide" style="--d:.1s">Guides for better trading</h1>
      <p class="page-lead anim" style="--d:.2s">How to journal, review, backtest and protect a funded account, with real numbers instead of slogans.</p>
    </div>
  </section>

  <div class="wrap">
    <section class="fp-sec">
      <div class="blog-list">
        {posts.map((p) => (
          <a class="fp-item gl-card blog-card" href={`/blog/${p.fm.slug}`}>
            <span class="blog-meta">{fmtDate(p.fm.updated || p.fm.date)} · {p.minutes} min read</span>
            <h2>{p.fm.title}</h2>
            <p>{p.fm.summary}</p>
          </a>
        ))}
      </div>
      <div class="fp-related"><a href="/glossary" class="btn btn-line">Trading glossary →</a><a href="/tools" class="btn btn-line">Free trading calculators →</a></div>
    </section>
  </div>
</PageLayout>
