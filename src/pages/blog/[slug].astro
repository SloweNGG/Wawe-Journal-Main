---
// Blog yazısı (EN). Sayfa: src/components/blog/BlogPostPage.astro · yazılar: src/data/blog.ts
import BlogPostPage from '../../components/blog/BlogPostPage.astro';
import { allPosts, type BlogPost } from '../../data/blog';

export function getStaticPaths() {
  return allPosts('en').map((p) => ({ params: { slug: p.fm.slug }, props: { post: p } }));
}
const { post } = Astro.props as { post: BlogPost };
---
<BlogPostPage post={post} />
