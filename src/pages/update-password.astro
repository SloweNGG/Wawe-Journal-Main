---
import Layout from '../layouts/Layout.astro';
---
<Layout lang="en" showNavbar={false} noIndex={true}>
<Fragment slot="head">
  <!-- Google Fonts -->
  <title>Update Password – Wawe Journal</title>
  <style is:global>
    /* ═══════════════════════════════════════════════════════════════
       WAWE JOURNAL — AUTH (Login / Sign Up) · siyah + mor, iki sütun
       ═══════════════════════════════════════════════════════════════ */
    :root {
      --bg: #000000;
      --border: rgba(255, 255, 255, 0.09);
      --border2: rgba(255, 255, 255, 0.18);
      --text: #f1f1f5;
      --text2: #9494a8;
      --label: #d4d4e0;
      --muted: #8e8ea0;
      --accent: #8b5cf6;
      --accent2: #c084fc;
      --accent-deep: #6d28d9;
      --accent-glow: rgba(139, 92, 246, 0.22);
      --radius: 22px;
      --radius-sm: 10px;
      --transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      --font: 'Geist', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      --font-display: 'Syne', 'Geist', system-ui, sans-serif;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body {
      width: 100%;
      min-height: 100vh;
      min-height: 100dvh;
      margin: 0;
      padding: 0;
      background: var(--bg);
      color: var(--text);
      font-family: var(--font);
      overflow-x: hidden;
      color-scheme: dark;
    }

    #navbar-container { display: none !important; }

    #app-scroll-container {
      min-height: 100vh !important;
      min-height: 100dvh !important;
      height: 100% !important;
      width: 100% !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: center !important;
      align-items: center !important;
      padding: clamp(1rem, 4vh, 2.5rem) 1.25rem !important;
      box-sizing: border-box !important;
      overflow-y: auto !important;
      overflow-x: hidden !important;
      position: relative !important;
    }

    .wj-ambient-backdrop,
    body::before,
    body::after {
      display: none !important;
    }

    /* Çerçeve: solda form, sağda dağ görseli */
    .auth-shell {
      width: 100%;
      max-width: 1120px;
      min-height: min(740px, calc(100dvh - 2rem));
      margin: auto !important;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      box-shadow: 0 30px 100px rgba(0, 0, 0, 0.7), 0 0 80px rgba(139, 92, 246, 0.06);
    }

    .auth-side {
      display: flex;
      flex-direction: column;
      padding: 1.75rem 2rem 2rem;
      min-width: 0;
    }

    .brand-logo {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      align-self: flex-start;
      text-decoration: none;
      transition: transform 0.25s ease;
    }
    .brand-logo:hover { transform: translateY(-1px); }
    .brand-logo .brand-mark {
      display: block;
      width: 36px;
      height: 24px;
      object-fit: contain;
    }

    .auth-form {
      width: 100%;
      max-width: 360px;
      margin: auto;
      padding: 2rem 0 0.5rem;
    }

    .auth-title {
      font-size: 1.75rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      color: var(--text);
      margin-bottom: 0.35rem;
    }
    .auth-sub {
      font-size: 0.875rem;
      color: var(--text2);
      margin-bottom: 1.5rem;
    }

    .field { margin-bottom: 1rem; }
    .field-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 0.45rem;
    }
    .field label {
      display: block;
      font-size: 13px;
      font-weight: 500;
      color: var(--label);
      margin-bottom: 0.45rem;
    }
    .field-head label { margin-bottom: 0; }
    .field input {
      width: 100%;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 0.68rem 0.9rem;
      color: var(--text);
      font-family: var(--font);
      font-size: 14px;
      outline: none;
      transition: var(--transition);
    }
    .field input::placeholder { color: var(--muted); opacity: 0.55; }
    .field input:hover { border-color: var(--border2); }
    .field input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-glow);
    }

    .input-wrap { position: relative; }
    .input-wrap input { padding-right: 2.75rem; }
    .pw-toggle {
      position: absolute;
      top: 50%;
      right: 6px;
      transform: translateY(-50%);
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: none;
      border-radius: 7px;
      background: transparent;
      color: var(--text2);
      cursor: pointer;
      transition: var(--transition);
    }
    .pw-toggle:hover { color: var(--accent2); }
    .pw-toggle svg { width: 17px; height: 17px; }
    .pw-toggle .eye-off { display: none; }
    .pw-toggle[aria-pressed="true"] .eye-on { display: none; }
    .pw-toggle[aria-pressed="true"] .eye-off { display: block; }

    .forgot-link {
      color: var(--accent2);
      font-size: 12px;
      font-weight: 500;
      text-decoration: underline;
      text-underline-offset: 3px;
      text-decoration-color: rgba(192, 132, 252, 0.4);
      transition: color 0.2s;
    }
    .forgot-link:hover { color: #fff; }

    .turnstile-wrap {
      display: flex;
      justify-content: center;
      margin: 0.25rem 0 0.75rem;
      min-height: 65px;
    }
    .turnstile-wrap[data-skip="1"] {
      display: none;
      min-height: 0;
      margin: 0;
    }

    /* buttons.css .btn-primary'yi siyah hap butona zorluyor; auth butonu kendi sınıfında */
    .btn-auth {
      width: 100%;
      padding: 0.75rem 1rem;
      border: 1px solid rgba(192, 132, 252, 0.35);
      border-radius: var(--radius-sm);
      background: linear-gradient(180deg, var(--accent) 0%, var(--accent-deep) 100%);
      color: #fff;
      font-family: var(--font);
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: var(--transition);
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.18) inset,
        0 6px 20px rgba(139, 92, 246, 0.3);
    }
    .btn-auth:hover {
      filter: brightness(1.1);
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.22) inset,
        0 8px 28px rgba(139, 92, 246, 0.45);
    }
    .btn-auth:active { transform: scale(0.99); }
    .btn-auth:disabled {
      opacity: 0.55;
      cursor: not-allowed;
      filter: none;
      transform: none !important;
      box-shadow: none !important;
    }

    .divider {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      margin: 1.1rem 0;
      color: var(--muted);
      font-size: 10.5px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .divider::before,
    .divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border);
    }

    .btn-google {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      padding: 0.68rem 1rem;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border);
      background: var(--bg);
      color: var(--text);
      font-family: var(--font);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: var(--transition);
    }
    .btn-google:hover { border-color: rgba(139, 92, 246, 0.55); }
    .btn-google:active { transform: scale(0.99); }
    .btn-google svg { width: 17px; height: 17px; flex-shrink: 0; }
    .btn-google:disabled {
      opacity: 0.55;
      cursor: not-allowed;
      transform: none !important;
    }

    .terms-text {
      text-align: center;
      font-size: 12px;
      color: var(--text2);
      margin-top: 1rem;
    }
    .terms-text a {
      color: var(--accent2);
      text-decoration: none;
      font-weight: 500;
      transition: color 0.2s;
    }
    .terms-text a:hover { color: #fff; }

    .auth-switch {
      margin-top: 1.25rem;
      text-align: center;
      font-size: 13px;
      color: var(--text2);
    }
    .auth-switch a {
      margin-left: 4px;
      color: var(--accent2);
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 3px;
      text-decoration-color: rgba(192, 132, 252, 0.4);
      transition: color 0.2s;
    }
    .auth-switch a:hover { color: #fff; }

    /* Sağ panel: dağ görseli + kısa mesaj */
    .auth-visual {
      position: relative;
      overflow: hidden;
      border-left: 1px solid var(--border);
      background:
        linear-gradient(180deg, #000 0%, rgba(0, 0, 0, 0) 38%),
        linear-gradient(0deg, #000 0%, rgba(0, 0, 0, 0) 14%),
        url("/images/brand/hero-peak.webp") 50% 100% / auto 74% no-repeat,
        #000;
    }
    .auth-visual::after {
      content: '';
      position: absolute;
      left: 50%;
      bottom: 18%;
      width: 520px;
      height: 360px;
      transform: translateX(-50%);
      background: radial-gradient(ellipse, rgba(139, 92, 246, 0.16) 0%, transparent 70%);
      pointer-events: none;
    }
    .auth-visual-copy {
      position: relative;
      z-index: 1;
      padding: clamp(3rem, 9vh, 5.5rem) 2.5rem 0;
      text-align: center;
    }
    .auth-visual-copy h2 {
      font-size: clamp(1.6rem, 2.6vw, 2.25rem);
      font-weight: 600;
      line-height: 1.18;
      letter-spacing: -0.025em;
      color: var(--text);
    }
    .auth-visual-copy h2 .vl2 {
      display: block;
      background: linear-gradient(90deg, #8e8ea0 0%, var(--accent2) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .auth-points {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
      margin-top: 1.4rem;
    }
    .auth-points li {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 11px;
      border: 1px solid rgba(139, 92, 246, 0.3);
      border-radius: 999px;
      background: rgba(0, 0, 0, 0.6);
      color: var(--label);
      font-size: 12px;
      font-weight: 500;
    }
    .auth-points li::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 8px var(--accent);
    }

    .toast-container {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      z-index: 999999;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      max-width: 380px;
      width: 100%;
      pointer-events: none;
    }
    .toast {
      pointer-events: all;
      padding: 0.85rem 1.25rem;
      border-radius: var(--radius-sm);
      font-family: var(--font);
      font-size: 13.5px;
      font-weight: 500;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 12px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
      animation: toastIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) both;
      border: 1px solid rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
    }
    .toast.error { background: rgba(239, 68, 68, 0.95); border-color: rgba(239, 68, 68, 0.35); }
    .toast.success { background: rgba(34, 197, 94, 0.95); border-color: rgba(34, 197, 94, 0.35); }
    .toast.info { background: rgba(139, 92, 246, 0.95); border-color: rgba(139, 92, 246, 0.35); }
    .toast .toast-icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .toast .toast-message { flex: 1; line-height: 1.4; word-break: break-word; }
    .toast .toast-close {
      background: none;
      border: none;
      color: rgba(255, 255, 255, 0.6);
      cursor: pointer;
      font-size: 18px;
      line-height: 1;
      padding: 0 4px;
      margin-left: 6px;
      transition: color 0.2s;
    }
    .toast .toast-close:hover { color: #fff; }
    @keyframes toastIn {
      from { opacity: 0; transform: translateY(12px) scale(0.95); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    .toast.hide { animation: toastOut 0.3s ease both; }
    @keyframes toastOut {
      from { opacity: 1; transform: translateY(0) scale(1); }
      to { opacity: 0; transform: translateY(12px) scale(0.95); }
    }

    /* Fallback if ww-toast is triggered */
    .ww-toast {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      z-index: 999999;
      padding: 0.85rem 1.25rem;
      border-radius: var(--radius-sm);
      font-family: var(--font);
      font-size: 13.5px;
      font-weight: 500;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 12px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
      background: #000;
      border: 1px solid var(--border2);
      backdrop-filter: blur(20px);
      opacity: 1 !important;
      transform: none !important;
      transition: all 0.3s ease;
    }
    .ww-toast--error { background: rgba(239, 68, 68, 0.95) !important; border-color: rgba(239, 68, 68, 0.35) !important; }
    .ww-toast--success { background: rgba(34, 197, 94, 0.95) !important; border-color: rgba(34, 197, 94, 0.35) !important; }

    /* Tablet ve altı: tek sütun, görsel gizli */
    @media (max-width: 900px) {
      #app-scroll-container { padding: 0 !important; justify-content: flex-start !important; }
      .auth-shell {
        grid-template-columns: 1fr;
        min-height: 100dvh;
        border: none;
        border-radius: 0;
        box-shadow: none;
      }
      .auth-visual { display: none; }
      .auth-side { padding: 1.25rem 1.25rem 2rem; }
      .auth-form { padding-top: 2.5rem; margin: 0 auto; }
    }
    @media (max-width: 600px) {
      .brand-logo .brand-mark { width: 30px; height: 20px; }
      .auth-title { font-size: 1.5rem; }
      .field input {
        padding: 0.75rem 0.9rem;
        font-size: 16px !important; /* iOS safari auto-zoom onleme */
      }
      .input-wrap input { padding-right: 2.75rem; }
      .btn-google,
      .btn-auth { min-height: 44px; }
      .turnstile-wrap { max-width: 100%; overflow: hidden; }
      .toast-container {
        bottom: 1rem;
        right: 1rem;
        left: 1rem;
        max-width: calc(100% - 2rem);
      }
    }
    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    /* Şifre sıfırlama sayfaları: mesajlar, güç göstergesi, yükleniyor */
    .error-msg,
    .success-msg {
      display: none;
      padding: 0.7rem 0.9rem;
      border-radius: var(--radius-sm);
      font-size: 13px;
      line-height: 1.45;
      margin: 0 0 1rem;
    }
    .error-msg {
      color: #fca5a5;
      background: rgba(239, 68, 68, 0.08);
      border: 1px solid rgba(239, 68, 68, 0.25);
    }
    .success-msg {
      color: #86efac;
      background: rgba(34, 197, 94, 0.08);
      border: 1px solid rgba(34, 197, 94, 0.25);
    }
    .error-msg.show,
    .success-msg.show { display: block; }

    .pw-strength {
      display: flex;
      gap: 4px;
      height: 3px;
      margin-top: 0.5rem;
    }
    .pw-strength-bar {
      flex: 1;
      border-radius: 99px;
      background: rgba(255, 255, 255, 0.08);
      transition: background 0.2s;
    }
    .pw-strength-bar.weak { background: #ef4444; }
    .pw-strength-bar.medium { background: #facc15; }
    .pw-strength-bar.strong { background: #22c55e; }
    .pw-strength-label {
      min-height: 14px;
      margin-top: 0.3rem;
      font-size: 11px;
      color: var(--muted);
    }

    #loading-state {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.7rem;
      padding: 1.5rem 0;
      color: var(--text2);
      font-size: 13px;
    }
    #loading-state .spinner {
      width: 28px;
      height: 28px;
      border: 2.5px solid rgba(255, 255, 255, 0.1);
      border-top-color: var(--accent);
      border-radius: 50%;
      animation: spin 0.6s linear infinite;
    }
  </style>

  <link rel="preload" href="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.117.3" as="script" />
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.117.3" is:inline defer></script>
  <script src="/config.js" is:inline defer></script>
  <script src="/auth-i18n.js?v=1" is:inline></script>
  <script type="module" src="/src/bundle.js" is:inline defer></script>
</Fragment>
  <div class="auth-shell">
    <section class="auth-side" data-at-title="update.doc_title">
      <a href="/" class="brand-logo" aria-label="Wawe Journal Home" data-at-aria="common.home_aria">
        <img class="brand-mark" src="/images/brand/logo-mark.png" srcset="/images/brand/logo-mark.png 1x, /images/brand/logo-mark@2x.png 2x" alt="" width="36" height="24" />
      </a>

      <div class="auth-form">
        <h1 class="auth-title" data-at="update.title">Set a new password</h1>
        <p class="auth-sub" data-at="update.sub">Choose a new password for your account.</p>

        <div id="loading-state">
          <div class="spinner"></div>
          <span data-at="update.verifying">Verifying your reset link...</span>
        </div>

        <div id="form-container" style="display:none;">
          <div class="field">
            <label for="password" data-at="update.new_label">New password</label>
            <div class="input-wrap">
              <input type="password" id="password" placeholder="At least 6 characters" data-at-ph="register.password_ph" autocomplete="new-password" oninput="checkStrength(this.value)" />
              <button type="button" class="pw-toggle" data-pw-toggle="password" aria-label="Show password" data-at-aria="common.show_pw" aria-pressed="false">
                <svg class="eye-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg class="eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
              </button>
            </div>
            <div class="pw-strength">
              <div class="pw-strength-bar" id="bar1"></div>
              <div class="pw-strength-bar" id="bar2"></div>
              <div class="pw-strength-bar" id="bar3"></div>
              <div class="pw-strength-bar" id="bar4"></div>
            </div>
            <div class="pw-strength-label" id="pw-strength-label"></div>
          </div>

          <div class="field">
            <label for="password2" data-at="register.confirm_label">Confirm password</label>
            <div class="input-wrap">
              <input type="password" id="password2" placeholder="Re-enter password" data-at-ph="register.confirm_ph" autocomplete="new-password" />
              <button type="button" class="pw-toggle" data-pw-toggle="password2" aria-label="Show password" data-at-aria="common.show_pw" aria-pressed="false">
                <svg class="eye-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg class="eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
              </button>
            </div>
          </div>

          <p class="error-msg" id="err"></p>
          <div class="success-msg" id="success-msg" data-at="update.updated">Password updated successfully! Redirecting to login...</div>

          <button type="button" class="btn-auth" id="update-btn" data-at="update.submit">Update Password</button>
          <p class="auth-switch"><a href="login.html" data-at="common.back_login">Back to login</a></p>
        </div>
      </div>
    </section>

    <aside class="auth-visual" aria-hidden="true">
      <div class="auth-visual-copy">
        <h2><span data-at="common.visual_1">Track every trade.</span><span class="vl2" data-at="common.visual_2">Master your discipline.</span></h2>
        <ul class="auth-points">
          <li data-at="common.pt_journal">Trade journal</li>
          <li data-at="common.pt_analytics">Analytics</li>
          <li data-at="common.pt_backtest">Backtesting</li>
        </ul>
      </div>
    </aside>
  </div>

  <div class="toast-container" id="toast-container"></div>

  <script is:inline>
    // Metinleri seçili dile çevir (markup'tan hemen sonra, ilk boyamadan önce)
    wwAuthI18n.apply();

    // Şifre göster / gizle
    document.querySelectorAll('[data-pw-toggle]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var input = document.getElementById(btn.getAttribute('data-pw-toggle'));
        if (!input) return;
        var show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        btn.setAttribute('aria-pressed', show ? 'true' : 'false');
        btn.setAttribute('aria-label', show ? authT('common.hide_pw') : authT('common.show_pw'));
      });
    });
  </script>

