  <!-- 4. ⭐ SAYFA BAŞLATICI -->
  <script is:inline>
    // showToast zaten script.js'den window'a atanıyor

    function checkStrength(password) {
      const bars = [
        document.getElementById('bar1'),
        document.getElementById('bar2'),
        document.getElementById('bar3'),
        document.getElementById('bar4')
      ];
      const label = document.getElementById('pw-strength-label');

      let score = 0;
      if (password.length >= 6) score++;
      if (password.length >= 10) score++;
      if (/[A-Z]/.test(password) && /[a-z]/.test(password)) score++;
      if (/\d/.test(password) && /[^A-Za-z0-9]/.test(password)) score++;

      bars.forEach((bar, i) => {
        bar.className = 'pw-strength-bar';
        if (i < score) {
          if (score <= 2) bar.classList.add('weak');
          else if (score === 3) bar.classList.add('medium');
          else bar.classList.add('strong');
        }
      });

      const labels = ['', authT('update.weak'), authT('update.weak'), authT('update.medium'), authT('update.strong')];
      label.textContent = password.length > 0 ? labels[score] : '';
    }

    const updateBtn = document.getElementById('update-btn');
    const passwordInput = document.getElementById('password');
    const password2Input = document.getElementById('password2');
    const errEl = document.getElementById('err');
    const successEl = document.getElementById('success-msg');
    const loadingState = document.getElementById('loading-state');
    const formContainer = document.getElementById('form-container');

    let isVerified = false;

    async function handlePasswordReset() {
      try {
        const { data: { session } } = await sb.auth.getSession();

        if (session) {
          wwLog.log('✅ Session active');
          isVerified = true;
          loadingState.style.display = 'none';
          formContainer.style.display = 'block';
          return;
        }

        const hash = window.location.hash;
        if (hash && hash.includes('access_token')) {
          const params = new URLSearchParams(hash.substring(1));
          const accessToken = params.get('access_token');
          const refreshToken = params.get('refresh_token');

          if (accessToken && refreshToken) {
            const { data, error } = await sb.auth.setSession({
              access_token: accessToken,
              refresh_token: refreshToken
            });

            if (error) {
              console.error('❌ Session error:', error);
              errEl.textContent = authT('update.link_expired');
              errEl.classList.add('show');
              loadingState.style.display = 'none';
              formContainer.style.display = 'block';
              updateBtn.disabled = true;
              return;
            }

            wwLog.log('✅ Session created from token');
            isVerified = true;
            loadingState.style.display = 'none';
            formContainer.style.display = 'block';
          } else {
            errEl.textContent = authT('update.link_invalid');
            errEl.classList.add('show');
            loadingState.style.display = 'none';
            formContainer.style.display = 'block';
            updateBtn.disabled = true;
          }
        } else {
          wwLog.log('ℹ️ No token in URL');
          loadingState.style.display = 'none';
          formContainer.style.display = 'block';
          errEl.textContent = authT('update.link_missing');
          errEl.classList.add('show');
          updateBtn.disabled = true;
        }
      } catch (err) {
        console.error('❌ Password reset error:', err);
        errEl.textContent = authT('err.generic');
        errEl.classList.add('show');
        loadingState.style.display = 'none';
        formContainer.style.display = 'block';
      }
    }

    document.addEventListener('DOMContentLoaded', handlePasswordReset);

    updateBtn.addEventListener('click', async () => {
      const password = passwordInput.value;
      const password2 = password2Input.value;
      errEl.classList.remove('show');
      successEl.classList.remove('show');

      if (!isVerified) {
        errEl.textContent = authT('update.use_link');
        errEl.classList.add('show');
        return;
      }

      if (!password || password.length < 6) {
        errEl.textContent = authT('err.password_short');
        errEl.classList.add('show');
        return;
      }

      if (password !== password2) {
        errEl.textContent = authT('err.password_mismatch');
        errEl.classList.add('show');
        return;
      }

      updateBtn.disabled = true;
      updateBtn.textContent = authT('update.submitting');

      try {
        const { data, error } = await sb.auth.updateUser({
          password: password
        });

        if (error) {
          errEl.textContent = error.message;
          errEl.classList.add('show');
          updateBtn.disabled = false;
          updateBtn.textContent = authT('update.submit');
          return;
        }

        successEl.classList.add('show');
        passwordInput.value = '';
        password2Input.value = '';
        updateBtn.disabled = false;
        updateBtn.textContent = authT('update.submit');

        setTimeout(() => {
          window.location.href = 'login.html';
        }, 3000);

      } catch (err) {
        errEl.textContent = authT('err.unexpected');
        errEl.classList.add('show');
        updateBtn.disabled = false;
        updateBtn.textContent = authT('update.submit');
      }
    });

    document.addEventListener('keydown', e => {
      if (e.key === 'Enter') updateBtn.click();
    });
  </script>
</Layout>
