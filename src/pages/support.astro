  <style is:global>
    .sp-search{position:relative;max-width:560px;margin:30px auto 0}
    .sp-search svg{position:absolute;left:18px;top:50%;width:18px;height:18px;transform:translateY(-50%);fill:none;stroke:var(--muted);stroke-width:2;stroke-linecap:round}
    .sp-search input{width:100%;height:54px;padding:0 18px 0 48px;border:1px solid var(--line2,rgba(255,255,255,.14));border-radius:999px;background:var(--card);color:var(--ink);font:inherit;font-size:16px;transition:border-color .15s}
    .sp-search input:focus{outline:none;border-color:var(--accent)}
    .sp-search input:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
    .sp-count{min-height:20px;margin-top:10px;font-size:13px;color:var(--faint)}
    .sp-cats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;max-width:980px;margin:clamp(32px,4vw,48px) auto 0}
    .sp-cat{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:12px;padding:16px;border:1px solid var(--line);border-radius:var(--r);background:var(--card);transition:border-color .15s,transform .15s}
    .sp-cat:hover{border-color:var(--accent);transform:translateY(-1px)}
    .sp-cat:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
    .sp-cat-t{display:flex;flex-direction:column;gap:2px;min-width:0}
    .sp-cat-t b{font-size:15px;font-weight:500;color:var(--ink)}
    .sp-cat-t small{font-size:12.5px;line-height:1.35;color:var(--muted)}
    .sp-n{font-family:var(--mono);font-size:11px;color:var(--faint)}
    .sp-ic{display:inline-grid;place-items:center;width:34px;height:34px;flex-shrink:0;border-radius:10px;background:rgba(139,123,255,.12);color:var(--accent);font-size:16px;line-height:1}
    .sp-ic svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
    .sp-sec{scroll-margin-top:96px}
    .sp-sec > h2{display:flex;align-items:center;gap:14px;font-size:clamp(22px,2.6vw,30px)}
    .sp-sec details{scroll-margin-top:96px}
    .sp-sec details:target summary{color:var(--accent)}
    .sp-empty{max-width:980px;margin:48px auto 0;padding:22px;border:1px solid var(--line);border-radius:var(--r);text-align:center;color:var(--muted)}
    .sp-empty a{color:var(--accent);text-decoration:underline;text-underline-offset:3px}
    #contact-support .gl-card h3{overflow-wrap:anywhere}
    @media (max-width:900px){.sp-cats{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media (max-width:560px){.sp-cats{grid-template-columns:minmax(0,1fr)}.sp-cat{padding:13px 14px}.sp-cat-t small{display:none}}
  </style>

  <script is:inline>
  // Yardım merkezi: arama (soru + cevap metninde, tüm kelimeler), adres çubuğundaki #soru açılır
  (function () {
    'use strict';
    function norm(s) { return String(s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, ''); }
    function boot() {
      var input = document.getElementById('sp-q');
      var qs = Array.prototype.slice.call(document.querySelectorAll('[data-q]'));
      var secs = Array.prototype.slice.call(document.querySelectorAll('[data-sec]'));
      var cats = document.getElementById('sp-cats');
      var empty = document.getElementById('sp-empty');
      var count = document.getElementById('sp-count');
      var text = qs.map(function (d) { return norm(d.textContent); });
      function apply() {
        var words = norm(input.value).split(/\s+/).filter(Boolean);
        if (!words.length) {
          qs.forEach(function (d) { d.hidden = false; d.open = false; });
          secs.forEach(function (s) { s.hidden = false; });
          cats.hidden = false; empty.hidden = true; count.textContent = '';
          openHash();
          return;
        }
        var hits = 0;
        qs.forEach(function (d, i) {
          var ok = words.every(function (w) { return text[i].indexOf(w) !== -1; });
          d.hidden = !ok; d.open = ok; if (ok) hits++;
        });
        secs.forEach(function (s) { s.hidden = !s.querySelector('[data-q]:not([hidden])'); });
        cats.hidden = true;
        empty.hidden = hits > 0;
        count.textContent = hits ? hits + (hits === 1 ? ' answer' : ' answers') : '';
      }
      function openHash() {
        var id = decodeURIComponent(location.hash.slice(1));
        var el = id && document.getElementById(id);
        if (el && el.tagName === 'DETAILS') { el.open = true; }
      }
      var t = 0;
      input.addEventListener('input', function () { clearTimeout(t); t = setTimeout(apply, 80); });
      window.addEventListener('hashchange', openHash);
      openHash();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
  })();
  </script>
</PageLayout>
