---
import Layout from '../layouts/Layout.astro';
---
<Layout lang="en" showNavbar={false}>
<Fragment slot="head">
  <title>Login – Wawe Journal</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700;800&family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  <!-- Cloudflare Turnstile -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer is:inline></script>

  <style>
    /* ═══════════════════════════════════════════════════════════════
       WAWE JOURNAL — TANITIM SAYFASI RENK PALETİ (index.css)
       ═══════════════════════════════════════════════════════════════ */
    :root {
      --bg: #07070c;
      --bg2: #0d0d14;
      --surface: #0e0e16;
      --surface2: #161622;
      --border: rgba(139, 92, 246, 0.15);
      --border2: rgba(139, 92, 246, 0.25);
      --text: #f1f1f5;
      --text2: #9494a8;
      --muted: #8e8ea0;
      --accent: #8b5cf6;
      --accent2: #c084fc;
      --accent-glow: rgba(139, 92, 246, 0.35);
      --green: #22c55e;
      --green-bg: rgba(34, 197, 94, 0.12);
      --red: #ef4444;
      --red-bg: rgba(239, 68, 68, 0.12);
      --radius: 14px;
      --radius-sm: 8px;
      --shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
      --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      --font: 'Space Grotesk', 'DM Sans', sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
      --font-display: 'Space Grotesk', sans-serif;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body {
      height: 100%;
      min-height: 100vh;
      margin: 0;
      padding: 0;
      background: var(--bg);
      color: var(--text);
      font-family: var(--font);
      overflow-x: hidden;
      color-scheme: dark;
    }

    #navbar-container { display: none !important; }

    /* ⭐ KUSURSUZ MERKEZLEME (Formu Ekranın Ortasına Sabitleme) */
    #app-scroll-container {
      min-height: 100vh !important;
      height: 100% !important;
      width: 100% !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: center !important;
      align-items: center !important;
      padding: clamp(1.5rem, 4vh, 3rem) 1.25rem !important;
      box-sizing: border-box !important;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      z-index: -1;
      background:
        radial-gradient(ellipse 80% 60% at 20% 80%, rgba(139, 92, 246, 0.12), transparent 60%),
        radial-gradient(ellipse 70% 50% at 80% 20%, rgba(192, 132, 252, 0.08), transparent 50%),
        radial-gradient(ellipse 60% 40% at 50% 50%, rgba(139, 92, 246, 0.04), transparent 50%),
        var(--bg);
      animation: breath 8s ease-in-out infinite alternate;
    }
    @keyframes breath {
      0% { opacity: 0.7; transform: scale(1); }
      100% { opacity: 1; transform: scale(1.03); }
    }
    body::after {
      content: '';
      position: fixed;
      inset: 0;
      z-index: -1;
      background:
        radial-gradient(ellipse 40% 30% at 30% 30%, rgba(139, 92, 246, 0.06), transparent 50%),
        radial-gradient(ellipse 40% 30% at 70% 70%, rgba(192, 132, 252, 0.04), transparent 50%);
      pointer-events: none;
      animation: pulseGlow 12s ease-in-out infinite alternate;
    }
    @keyframes pulseGlow {
      0% { opacity: 0.4; }
      100% { opacity: 1; }
    }

    .brand-logo {
      position: fixed;
      top: 1.5rem;
      left: 1.5rem;
      z-index: 10;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      transition: transform 0.25s ease;
    }
    .brand-logo:hover { transform: translateY(-1px); }
    .brand-logo .logo-icon {
      width: 36px;
      height: 36px;
      background: rgba(139, 92, 246, 0.08);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: var(--transition);
    }
    .brand-logo:hover .logo-icon {
      border-color: var(--accent);
      background: rgba(139, 92, 246, 0.16);
      box-shadow: 0 0 20px var(--accent-glow);
    }
    .brand-logo .logo-icon svg {
      width: 20px;
      height: 20px;
      stroke: var(--accent);
      transition: stroke 0.3s ease;
    }
    .brand-logo:hover .logo-icon svg { stroke: var(--accent2); }
    .brand-logo .brand-text {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 16px;
      font-weight: 700;
      color: var(--text);
      letter-spacing: 0.2px;
    }
    .brand-logo .brand-text .logo-accent {
      color: var(--accent);
    }

    /* ⭐ KUTU BOYUTU TAMAMEN AYNI KORUNUYOR */
    .auth-wrap {
      width: 100%;
      max-width: 400px;
      margin: auto !important;
      position: relative;
      z-index: 2;
      animation: formIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }
    @keyframes formIn {
      from { opacity: 0; transform: translateY(20px) scale(0.96); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .auth-box {
      background: var(--surface);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 2.25rem 2rem;
      box-shadow:
        0 24px 80px rgba(0, 0, 0, 0.5),
        0 0 0 1px rgba(139, 92, 246, 0.06) inset,
        0 0 40px rgba(139, 92, 246, 0.04);
      transition: var(--transition);
    }
    .auth-box:hover {
      border-color: rgba(192, 132, 252, 0.28);
      box-shadow:
        0 30px 90px rgba(0, 0, 0, 0.6),
        0 0 0 1px rgba(139, 92, 246, 0.1) inset,
        0 0 50px rgba(139, 92, 246, 0.08);
    }

    .auth-title {
      font-family: var(--font-display);
      font-size: 1.7rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 0.25rem;
      letter-spacing: -0.02em;
    }
    .auth-sub {
      color: var(--text2);
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
      font-family: 'DM Sans', sans-serif;
    }
    .auth-sub a {
      color: var(--accent2);
      text-decoration: none;
      font-weight: 600;
      transition: color 0.2s;
    }
    .auth-sub a:hover { color: var(--accent); }

    .divider {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin: 1.25rem 0;
      color: var(--text2);
      font-size: 12px;
      font-family: 'DM Sans', sans-serif;
      opacity: 0.75;
    }
    .divider::before,
    .divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border);
    }

    .btn-google {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      padding: 0.75rem 1rem;
      border-radius: 40px;
      border: 1px solid var(--border);
      background: var(--surface2);
      color: var(--text);
      font-family: var(--font);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: var(--transition);
    }
    .btn-google:hover {
      border-color: var(--accent2);
      background: rgba(139, 92, 246, 0.08);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(139, 92, 246, 0.12);
    }
    .btn-google:active { transform: scale(0.98); }
    .btn-google svg { width: 20px; height: 20px; flex-shrink: 0; }
    .btn-google svg path { fill: var(--accent) !important; }
    .btn-google:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none !important;
      box-shadow: none !important;
    }

    .field { margin-bottom: 1rem; }
    .field label {
      display: block;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text2);
      margin-bottom: 0.4rem;
      font-family: var(--font-mono);
    }
    .field input {
      width: 100%;
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 0.7rem 0.9rem;
      color: var(--text);
      font-family: 'DM Sans', sans-serif;
      font-size: 14px;
      outline: none;
      transition: var(--transition);
    }
    .field input::placeholder { color: var(--muted); opacity: 0.5; }
    .field input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-glow), 0 0 16px rgba(139, 92, 246, 0.12);
      background: var(--surface);
    }
    .field input:hover { border-color: rgba(139, 92, 246, 0.3); }

    .forgot-link {
      display: block;
      text-align: right;
      margin-top: -0.25rem;
      margin-bottom: 0.75rem;
      color: var(--text2);
      font-size: 12px;
      font-family: 'DM Sans', sans-serif;
      text-decoration: none;
      transition: var(--transition);
    }
    .forgot-link:hover { color: var(--accent2); }

    /* ⭐ TURNSTILE WIDGET */
    .turnstile-wrap {
      display: flex;
      justify-content: center;
      margin: 1rem 0 0.5rem;
      min-height: 65px;
    }
    .turnstile-wrap[data-skip="1"] {
      display: none;
      min-height: 0;
      margin: 0;
    }

    .btn-primary {
      width: 100%;
      padding: 0.8rem 1rem;
      border: none;
      border-radius: 40px;
      background: linear-gradient(135deg, var(--accent), #7c3aed);
      color: #fff;
      font-family: var(--font);
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      transition: var(--transition);
      box-shadow: 0 4px 24px rgba(139, 92, 246, 0.35);
      letter-spacing: 0.02em;
    }
    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 36px rgba(139, 92, 246, 0.5);
      background: linear-gradient(135deg, var(--accent2), var(--accent));
    }
    .btn-primary:active { transform: scale(0.98); }
    .btn-primary:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none !important;
      box-shadow: none !important;
    }

    .toast-container {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      max-width: 360px;
      width: 100%;
      pointer-events: none;
    }
    .toast {
      pointer-events: all;
      padding: 0.8rem 1.2rem;
      border-radius: var(--radius-sm);
      font-family: 'DM Sans', sans-serif;
      font-size: 13px;
      font-weight: 500;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 10px;
      box-shadow: 0 8px 40px rgba(0, 0, 0, 0.4);
      animation: toastIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both;
      border: 1px solid rgba(255, 255, 255, 0.06);
      backdrop-filter: blur(16px);
    }
    .toast.error { background: rgba(239, 68, 68, 0.92); border-color: rgba(239, 68, 68, 0.2); }
    .toast.success { background: rgba(34, 197, 94, 0.92); border-color: rgba(34, 197, 94, 0.2); }
    .toast.info { background: rgba(139, 92, 246, 0.92); border-color: rgba(139, 92, 246, 0.3); }
    .toast .toast-icon { font-size: 17px; flex-shrink: 0; }
    .toast .toast-close {
      background: none;
      border: none;
      color: rgba(255, 255, 255, 0.4);
      cursor: pointer;
      font-size: 15px;
      padding: 0 4px;
      margin-left: auto;
      transition: color 0.2s;
    }
    .toast .toast-close:hover { color: #fff; }
    @keyframes toastIn {
      from { opacity: 0; transform: translateX(30px) scale(0.95); }
      to { opacity: 1; transform: translateX(0) scale(1); }
    }
    .toast.hide { animation: toastOut 0.3s ease both; }
    @keyframes toastOut {
      from { opacity: 1; transform: translateX(0) scale(1); }
      to { opacity: 0; transform: translateX(30px) scale(0.95); }
    }

    @media (max-width: 600px) {
      .auth-box { padding: 1.75rem 1.5rem; }
      .auth-title { font-size: 1.4rem; }
      .auth-sub { font-size: 0.85rem; }
      .brand-logo { top: 1rem; left: 1rem; }
      .brand-logo .logo-icon { width: 32px; height: 32px; }
      .brand-logo .logo-icon svg { width: 16px; height: 16px; }
      .auth-wrap { max-width: 100%; }
      .field input { padding: 0.65rem 0.85rem; font-size: 13px; }
      .btn-google { padding: 0.65rem 0.9rem; font-size: 13px; }
      .btn-primary { padding: 0.7rem 0.9rem; font-size: 14px; }
      .toast-container { bottom: 1rem; right: 1rem; max-width: calc(100% - 2rem); }
    }
    @media (max-width: 480px) {
      .brand-logo .brand-text { display: none; }
    }
    @media (max-width: 400px) {
      .auth-box { padding: 1.5rem 1.15rem; }
      .auth-title { font-size: 1.2rem; }
      .btn-google { font-size: 12px; padding: 0.6rem 0.8rem; }
      .btn-primary { font-size: 13px; padding: 0.65rem 0.8rem; }
      .brand-logo { top: 0.75rem; left: 0.75rem; }
      .brand-logo .logo-icon { width: 28px; height: 28px; }
      .brand-logo .logo-icon svg { width: 14px; height: 14px; }
    }
    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
  </style>
</Fragment>

  <a href="/" class="brand-logo" aria-label="Wawe Journal Home">
    <div class="logo-icon">
      <svg width="20" height="20" viewBox="0 0 22 22" fill="none">
        <polyline points="2,16 7,9 12,13 19,4" stroke="#8b5cf6" stroke-width="2.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
    <span class="brand-text">Wawe<span class="logo-accent">Journal</span></span>
  </a>

  <div class="auth-wrap">
    <div class="auth-box">
      <h1 class="auth-title">Welcome Back</h1>
      <p class="auth-sub">Don't have an account? <a href="register.html">Sign up</a></p>

      <button class="btn-google" id="google-login-btn">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#8b5cf6"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#8b5cf6"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#8b5cf6"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#8b5cf6"/>
        </svg>
        Continue with Google
      </button>

      <div class="divider">or continue with email</div>

      <div class="field">
        <label>Email</label>
        <input type="email" id="email" placeholder="trader@example.com" autocomplete="email" />
      </div>

      <div class="field">
        <label>Password</label>
        <input type="password" id="password" placeholder="Your password" autocomplete="current-password" />
      </div>

      <a href="forgot-password.html" class="forgot-link">Forgot password?</a>

      <!-- Turnstile widget -->
      <div class="turnstile-wrap" id="turnstile-container"></div>

      <button class="btn-primary" id="login-btn">Login</button>
    </div>
  </div>

  <div class="toast-container" id="toast-container"></div>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" is:inline></script>
  <script src="/config.js" is:inline></script>
  <script type="module" src="/src/script.js" is:inline></script>

  <script is:inline>
    // ─── Turnstile init ─────────────────────────────────────
    var turnstileWidgetId = null;

    window.onTurnstileSuccess = function () {};
    window.onTurnstileExpired = function () {};

    (function initTurnstile() {
      function tryRender() {
        var cfg = window.WW_CONFIG || {};
        var siteKey = cfg.TURNSTILE_SITE_KEY || '';
        var container = document.getElementById('turnstile-container');
        if (!container) return;

        // Konfigüre edilmemişse widget'ı gizle
        if (!siteKey || siteKey.indexOf('REPLACE') === 0) {
          container.setAttribute('data-skip', '1');
          wwLog && wwLog.warn && wwLog.warn('⚠️ Turnstile site key not configured');
          return;
        }

        if (typeof window.turnstile === 'undefined' || typeof window.turnstile.render !== 'function') {
          setTimeout(tryRender, 150);
          return;
        }

        try {
          turnstileWidgetId = window.turnstile.render(container, {
            sitekey: siteKey,
            theme: 'dark',
            size: 'flexible',
            callback: window.onTurnstileSuccess,
            'expired-callback': window.onTurnstileExpired,
            'error-callback': window.onTurnstileExpired,
          });
        } catch (e) {
          wwLog && wwLog.warn && wwLog.warn('Turnstile render error:', e);
        }
      }
      tryRender();
    })();

    function getTurnstileToken() {
      try {
        if (window.turnstile && turnstileWidgetId !== null && window.turnstile.getResponse) {
          return window.turnstile.getResponse(turnstileWidgetId) || '';
        }
      } catch (e) {}
      return '';
    }

    function resetTurnstile() {
      try {
        if (window.turnstile && turnstileWidgetId !== null) {
          window.turnstile.reset(turnstileWidgetId);
        }
      } catch (e) {}
    }

    function isTurnstileRequired() {
      return typeof window.isTurnstileConfigured === 'function' && window.isTurnstileConfigured();
    }

    // ─── Yardımcılar ────────────────────────────────────────
    function hasTurkishChars(str) {
      return /[ığüşöçİĞÜŞÖÇ]/.test(str);
    }

    async function signInWithGoogle() {
      const btn = document.getElementById('google-login-btn');
      btn.disabled = true;
      btn.innerHTML = `
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:20px;height:20px;flex-shrink:0;animation:spin 1s linear infinite;">
          <circle cx="12" cy="12" r="10" stroke="#8b5cf6" stroke-width="2" stroke-dasharray="31.4 31.4" fill="none"/>
        </svg>
        Redirecting to Google...
      `;
      try {
        const { error } = await sb.auth.signInWithOAuth({
          provider: 'google',
          options: {
            redirectTo: window.location.origin + '/dashboard.html',
            queryParams: { access_type: 'offline', prompt: 'consent' }
          }
        });
        if (error) {
          window.showToast('Google login failed. Please try again.', 'error');
          btn.disabled = false;
          btn.innerHTML = `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:20px;height:20px;flex-shrink:0;"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#8b5cf6"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#8b5cf6"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#8b5cf6"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#8b5cf6"/></svg>Continue with Google`;
        }
      } catch (err) {
        window.showToast('An unexpected error occurred. Please try again.', 'error');
        btn.disabled = false;
        btn.innerHTML = `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:20px;height:20px;flex-shrink:0;"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#8b5cf6"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#8b5cf6"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#8b5cf6"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#8b5cf6"/></svg>Continue with Google`;
      }
    }

    document.getElementById('google-login-btn').addEventListener('click', signInWithGoogle);

    (async () => {
      const { data: { session } } = await sb.auth.getSession();
      if (session) window.location.href = 'dashboard.html';
    })();

    document.getElementById('login-btn').addEventListener('click', async () => {
      let email = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;

      email = email.toLowerCase();

      if (!email || !password) {
        window.showToast('Email and password are required.', 'error');
        return;
      }
      if (hasTurkishChars(email)) {
        window.showToast('Email cannot contain Turkish characters.', 'error');
        return;
      }
      if (!window.isValidEmail(email)) {
        window.showToast('Please enter a valid email address.', 'error');
        return;
      }

      // Turnstile token
      var turnstileToken = getTurnstileToken();
      if (isTurnstileRequired() && !turnstileToken) {
        window.showToast('Please complete the verification.', 'error');
        return;
      }

      const btn = document.getElementById('login-btn');
      btn.disabled = true;
      btn.textContent = 'Logging in…';

      try {
        const res = await fetch(
          window.WW_CONFIG.SUPABASE_URL + '/functions/v1/verify-auth',
          {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'apikey': window.WW_CONFIG.SUPABASE_ANON_KEY,
            },
            body: JSON.stringify({ action: 'login', email, password, turnstileToken }),
          }
        );

        const result = await res.json().catch(() => ({}));

        if (!res.ok) {
          if (res.status === 429) {
            window.showToast('Too many attempts. Please try again in 15 minutes.', 'error');
          } else if (res.status === 401) {
            window.showToast('Invalid email or password.', 'error');
          } else if (res.status === 403) {
            window.showToast('Your account has been deactivated.', 'error');
          } else if (res.status === 400 && result.error && result.error.indexOf('Verification') !== -1) {
            window.showToast('Verification failed. Please try again.', 'error');
          } else {
            window.showToast(result.error || 'Login failed. Please try again.', 'error');
          }
          resetTurnstile();
          btn.disabled = false;
          btn.textContent = 'Login';
          return;
        }

        // Session'ı client'a yükle
        await sb.auth.setSession({
          access_token: result.access_token,
          refresh_token: result.refresh_token,
        });

        window.showToast('Welcome back! 🎉', 'success');
        setTimeout(() => { window.location.href = 'dashboard.html'; }, 700);

      } catch (err) {
        console.error('Login error:', err);
        window.showToast('Network error. Please try again.', 'error');
        resetTurnstile();
        btn.disabled = false;
        btn.textContent = 'Login';
      }
    });

    document.addEventListener('keydown', e => {
      if (e.key === 'Enter') document.getElementById('login-btn').click();
    });
  </script>
</Layout>
