---
// src/components/BaseHead.astro
// Her sayfada tekrar eden ortak <head> içeriği burada.
// Sayfaya özel CSS/script'ler sayfanın kendi <head> slot'unda kalır.

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noIndex?: boolean;
  isAppPage?: boolean;
}

const {
  title,
  description = 'Log your trades, visualize your performance, and discover the strategies that actually work.',
  canonical,
  ogImage = 'https://wawejournal.com/og-image.jpg',
  noIndex = false,
  isAppPage = true,
} = Astro.props;
---

<!-- ⭐ GLOBAL LOGGER — production'da debug log'ları susturur -->
<!-- Kullanım: wwLog.log(...) / wwLog.warn(...) / wwLog.error(...) -->
<!-- Debug'ı açmak için tarayıcıda: localStorage.setItem('ww_debug', 'true') + yenile -->
<script is:inline>
(function() {
  var WW_DEBUG = false;
  try {
    WW_DEBUG = localStorage.getItem('ww_debug') === 'true';
  } catch (e) {}

  var noop = function() {};
  window.wwLog = {
    log:   WW_DEBUG ? console.log.bind(console)   : noop,
    warn:  WW_DEBUG ? console.warn.bind(console)  : noop,
    info:  WW_DEBUG ? console.info.bind(console)  : noop,
    debug: WW_DEBUG ? console.debug.bind(console) : noop,
    // Hatalar her zaman gösterilir — hata ayıklama için kritik
    error: console.error.bind(console)
  };
})();
</script>

<!-- ⭐ SAYFA YAŞAM DÖNGÜSÜ (wwPage) — SPA geçişlerinde sayfa script'lerinin temizliği -->
<!-- Sayfa script'i başta `var PAGE = wwPage.current();` alır ve global dinleyicilerini -->
<!-- PAGE.on(window|document, ...) ile ekler. SPA ile başka sayfaya geçilince PAGE.alive -->
<!-- false olur, dinleyiciler kaldırılır ve PAGE.onLeave(fn) ile kaydedilenler çalışır. -->
<!-- Normal (tam) sayfa yüklemesinde sayfa zaten tamamen yenilendiği için hiçbir etkisi yok. -->
<script is:inline>
(function() {
  function PageScope() {
    this.alive = true;
    this._cleanups = [];
  }
  PageScope.prototype.onLeave = function(fn) {
    if (this.alive) {
      this._cleanups.push(fn);
    } else {
      try { fn(); } catch (e) {}
    }
  };
  PageScope.prototype.on = function(target, type, fn, opts) {
    if (!this.alive) return;
    target.addEventListener(type, fn, opts);
    this.onLeave(function() { target.removeEventListener(type, fn, opts); });
  };
  // window'a fonksiyon açar; sayfadan çıkınca (başkası üzerine yazmadıysa) kaldırır.
  // Örn. quick-add kayıttan sonra window.loadTrades / window.refresh'i çağırıyor.
  PageScope.prototype.expose = function(name, value) {
    window[name] = value;
    this.onLeave(function() {
      if (window[name] === value) delete window[name];
    });
  };
  PageScope.prototype.onI18nChange = function(fn) {
    var self = this;
    var i18n = window.i18n;
    if (!this.alive || !i18n || typeof i18n.onChange !== 'function') return;
    var guarded = function() {
      if (self.alive) return fn.apply(this, arguments);
    };
    i18n.onChange(guarded);
    this.onLeave(function() {
      var list = i18n.listeners;
      var idx = list ? list.indexOf(guarded) : -1;
      if (idx !== -1) list.splice(idx, 1);
    });
  };
  PageScope.prototype._leave = function() {
    if (!this.alive) return;
    this.alive = false;
    var cleanups = this._cleanups;
    this._cleanups = [];
    for (var i = cleanups.length - 1; i >= 0; i--) {
      try { cleanups[i](); } catch (e) { console.error('[wwPage] cleanup hatası:', e); }
    }
  };

  var current = new PageScope();
  window.wwPage = {
    current: function() { return current; },
    // Sadece SPA router çağırır: mevcut sayfayı kapatır, yenisini başlatır
    _next: function() {
      current._leave();
      current = new PageScope();
      return current;
    }
  };
})();
</script>

<!-- CHARSET & VIEWPORT -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

<!-- TITLE & SEO -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content="wawe journal, wawejournal, trading journal, crypto trading journal, forex journal, stock trading log, trading analytics" />
{noIndex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}
{canonical && <link rel="canonical" href={canonical} />}

<!-- FAVICON -->
<link rel="icon" type="image/svg+xml" href="/resim.svg" />

<!-- OPEN GRAPH -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Wawe Journal" />
{canonical && <meta property="og:url" content={canonical} />}

<!-- TWITTER CARD -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- PWA & THEME -->
<meta name="theme-color" content="#7c6dfa" />
<!-- ⭐ FIX: Chrome, apple-mobile-web-app-capable'ı deprecated olarak işaretliyor.
     Standardize edilmiş mobile-web-app-capable ile birlikte kullanılmalı. -->
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="Wawe Journal" />
<link rel="manifest" href="/site.webmanifest" />

<!-- FONTS & CDNS -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://odasapyhtdopbnlfhwde.supabase.co" crossorigin />
<link rel="dns-prefetch" href="https://odasapyhtdopbnlfhwde.supabase.co" />
{isAppPage ? (
  <>
    <!-- APP FONTS: render-blocking with display=block to eliminate FOUT / layout shift -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400..800&family=Geist+Mono:wght@400..700&family=Syne:wght@600..800&display=block" />

    <!-- CORE CSS FOR APP -->
    <link rel="stylesheet" href="/styles.css?v=1792800100" />
    <link rel="stylesheet" href="/components/navbar/navbar.css?v=1793610000" />

    <!-- CLIENT SWR CACHE ('trades' / 'trades_<sayfa>' = yalnızca canlı satır; kapsamlı listeler 'trades@all') -->
    <script src="/cache.js?v=1792700000" is:inline></script>

    <!-- SAAT & GÜN AYARLARI (saat dilimi, gün başlangıcı, import saati; Ayarlar > Görünüm) -->
    <script src="/interface/shared/time-settings.js" is:inline></script>

    <!-- ORTAK İŞLEM METRİKLERİ (PnL, win rate, kapalı işlem tanımı, gün anahtarı) -->
    <script src="/interface/shared/trade-metrics.js?v=1791642000" is:inline></script>

    <!-- İŞLEM KAYNAĞI KAPSAMI (WwTrades: canlı / backtest / tümü; canlı istatistikler backtest'i ASLA içermez) -->
    <script src="/interface/shared/trades-source.js?v=1792700000" is:inline></script>

    <!-- ORTAK GRAFİK GÖRÜNÜMÜ (font, eksen yazıları, ızgara, tooltip; tüm grafikler aynı) -->
    <link rel="stylesheet" href="/interface/shared/chart-theme.css?v=6" />
    <script src="/interface/shared/chart-theme.js?v=2" is:inline></script>
    <script src="/interface/shared/chart-viewer.js?v=3" is:inline></script>

    <!-- HESAP İŞARETİ (renk noktası; prop firma / broker bağlıysa onun logosu) -->
    <script src="/interface/shared/journal-mark.js?v=1791743200" is:inline></script>

    <!-- TARİH SEÇİCİ (tarayıcının beyaz takvimi yerine temaya uyan takvim; WwDatePicker.attach(input)) -->
    <script src="/interface/shared/ww-date-picker.js?v=1" is:inline></script>

    <!-- LUCIDE ICONS (Sadece panel sayfalarında) -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preload" href="https://cdn.jsdelivr.net/npm/lucide@0.441.0/dist/umd/lucide.min.js" as="script" />
    <script src="https://cdn.jsdelivr.net/npm/lucide@0.441.0/dist/umd/lucide.min.js" is:inline defer></script>
  </>
) : (
  <!-- PUBLIC MARKETING & AUTH FONTS: non-render-blocking, display=swap -->
  <>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400..800&family=Geist+Mono:wght@400..700&family=Syne:wght@600..800&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400..800&family=Geist+Mono:wght@400..700&family=Syne:wght@600..800&display=swap" />
    </noscript>
  </>
)}

<!-- SHARED BUTTON STYLE (black fill, purple outline) -->
<link rel="stylesheet" href="/buttons.css?v=4" />

<!-- ⭐ ZERO-FLASH TEMA & AMBİYANS ÖN YÜKLEME — Sayfa render olmadan önce senkron çalışır -->
<script is:inline>
(function() {
  try {
    var root = document.documentElement;

    // 1. Tema (Açık / Koyu)
    var savedTheme = localStorage.getItem('ww_theme');
    if (savedTheme === 'light') {
      root.classList.add('light-theme');
      root.classList.add('light-theme-pending');
    } else {
      root.classList.remove('light-theme');
    }

    // 2. Özel Tema Renkleri (--bg, --surface, --accent vs.)
    var customTheme = localStorage.getItem('ww_custom_theme');
    if (savedTheme !== 'light' && customTheme) {
      try {
        var theme = JSON.parse(customTheme);
        if (theme.accent)  root.style.setProperty('--accent', theme.accent);
        if (theme.accent2) root.style.setProperty('--accent2', theme.accent2);
        if (theme.bg)      root.style.setProperty('--bg', theme.bg);
        if (theme.surface) {
          root.style.setProperty('--surface', theme.surface);
          root.style.setProperty('--surface2', theme.surface);
        }
        if (theme.border)  root.style.setProperty('--border', theme.border);
        if (theme.textColor) root.style.setProperty('--text', theme.textColor);
      } catch(e) {}
    }

    // 3. Ambiyans Arka Plan Durumu (Mor parlamayı/flash'ı tamamen engeller)
    var ambientMode = localStorage.getItem('ww_ambient_mode') || 'dynamic';
    if (ambientMode === 'off') {
      root.classList.add('ambient-disabled');
      root.classList.remove('ambient-enabled');
    } else {
      root.classList.add('ambient-enabled');
      root.classList.remove('ambient-disabled');

      // Önce doğrudan kayıtlı state var mı bak (en hızlı yol)
      var savedState = localStorage.getItem('ww_ambient_state');
      if (savedState && ['profit', 'loss', 'neutral'].includes(savedState)) {
        root.setAttribute('data-ambient-state', savedState);
      } else if (ambientMode === 'dynamic') {
        var cachedPnl = localStorage.getItem('ww_cached_pnl');
        var pnl = cachedPnl !== null ? parseFloat(cachedPnl) : 0;
        var dynState = (!isNaN(pnl) && pnl > 0) ? 'profit' : ((!isNaN(pnl) && pnl < 0) ? 'loss' : 'neutral');
        root.setAttribute('data-ambient-state', dynState);
      } else {
        root.setAttribute('data-ambient-state', 'neutral');
      }
    }

    // 4. Font Boyutu
    var savedFontSize = localStorage.getItem('ww_font_size');
    if (savedFontSize) {
      root.style.fontSize = savedFontSize + 'px';
    }

    // 5. Plan Durumu (Pro vs Free — Upgrade butonlarını 0ms gizler)
    var userPlan = localStorage.getItem('ww_user_plan') || sessionStorage.getItem('ww_user_plan');
    if (userPlan === 'premium') {
      root.classList.add('is-pro');
    } else {
      root.classList.remove('is-pro');
    }
  } catch(e) {}

  // DOMContentLoaded olduğunda body ile senkronize et
  document.addEventListener('DOMContentLoaded', function() {
    try {
      var root = document.documentElement;
      var body = document.body;
      if (!body) return;

      if (root.classList.contains('is-pro')) {
        body.classList.add('is-pro');
      } else {
        body.classList.remove('is-pro');
      }

      if (root.classList.contains('light-theme')) {
        body.classList.add('light-theme');
        root.classList.remove('light-theme-pending');
      } else {
        body.classList.remove('light-theme');
      }

      if (root.classList.contains('ambient-disabled')) {
        body.classList.add('ambient-disabled');
        body.classList.remove('ambient-enabled');
      } else {
        body.classList.add('ambient-enabled');
        body.classList.remove('ambient-disabled');
      }

      var ambState = root.getAttribute('data-ambient-state');
      if (ambState) {
        body.setAttribute('data-ambient-state', ambState);
      }
    } catch(e) {}
  });
})();
</script>

<!-- DİL ÖN YÜKLEME -->
<script is:inline>
(function() {
  var savedLang = localStorage.getItem('ww_language');
  if (savedLang && ['en', 'tr', 'de'].includes(savedLang)) {
    document.documentElement.setAttribute('data-lang', savedLang);
    document.documentElement.lang = savedLang;
  } else {
    localStorage.setItem('ww_language', 'en');
    document.documentElement.setAttribute('data-lang', 'en');
    document.documentElement.lang = 'en';
  }
})();
</script>


<!-- SERVICE WORKER REGISTRATION (Force Update on Navigation) -->
<script is:inline>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', function() {
      navigator.serviceWorker.register('/sw.js').then(function(registration) {
        registration.update();
      }).catch(function(error) {
        console.error('SW Registration failed:', error);
      });
    });
  }
</script>
