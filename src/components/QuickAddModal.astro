---
import Navbar from '../components/Navbar.astro';
import BaseHead from '../components/BaseHead.astro';
import QuickAddModal from '../components/QuickAddModal.astro';

export interface Props {
  lang?: string;
  bodyClass?: string;
  bodyStyle?: string;
  title?: string;
  description?: string;
  canonical?: string;
  noIndex?: boolean;
  showQuickAdd?: boolean;
}

const {
  lang = 'en',
  bodyClass,
  bodyStyle,
  title = 'Wawe Journal',
  description,
  canonical,
  noIndex,
  showQuickAdd = false,
} = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <BaseHead title={title} description={description} canonical={canonical} noIndex={noIndex} />
  <slot name="head" />
</head>
<body class={bodyClass} style={bodyStyle}>
  <div id="navbar-container">
    <Navbar />
  </div>
  <slot />
  {showQuickAdd && <QuickAddModal />}
</body>
</html>