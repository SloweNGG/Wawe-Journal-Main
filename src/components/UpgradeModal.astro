---
// UpgradeModal.astro — Pro Paywall & Limit Exceeded Modal
---
<div id="ww-upgrade-modal-backdrop" class="ww-up-backdrop" aria-hidden="true" style="display:none;">
  <div class="ww-up-modal" role="dialog" aria-modal="true" aria-labelledby="ww-up-notice-title">
    
    <!-- Top Bar: Logo & Close Button -->
    <div class="ww-up-topbar">
      <div class="ww-up-logo" aria-label="Wawe Journal">
        <!-- Wawe Journal Signature Purple Logo -->
        <svg class="ww-up-logo-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
          <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
          <polyline points="17 6 23 6 23 12"></polyline>
        </svg>
      </div>
      <button type="button" class="ww-up-close-btn" id="ww-up-close-btn" aria-label="Kapat">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Hero Visual: Real Analiz Screenshot Preview -->
    <div class="ww-up-preview-card">
      <img 
        src="/images/landing/analytics.webp" 
        alt="Wawe Journal Analiz" 
        class="ww-up-preview-img" 
        loading="eager"
      />
      <!-- Subtle bottom gradient vignette -->
      <div class="ww-up-preview-fade"></div>
    </div>

    <!-- Plan Name & Pricing Row -->
    <div class="ww-up-plan-header">
      <div class="ww-up-plan-name" id="ww-up-plan-name">Pro</div>
      <div class="ww-up-plan-price-wrap">
        <div class="ww-up-plan-price">
          <span class="ww-up-price-num" id="ww-up-price-num">$12</span>
          <span class="ww-up-price-period" id="ww-up-price-period">/ay</span>
        </div>
        <div class="ww-up-price-subnote" id="ww-up-price-subnote" style="display:none;"></div>
      </div>
    </div>

    <!-- Plan Features Checklist (2 columns) -->
    <div class="ww-up-features-grid">
      <div class="ww-up-feat-item">
        <svg class="ww-up-check-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        <span data-i18n-key="feat_unlimited_trades">Journal Unlimited Trades</span>
      </div>
      <div class="ww-up-feat-item">
        <svg class="ww-up-check-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        <span id="ww-up-feat-accounts">Up to 3 Trading Accounts</span>
      </div>
      <div class="ww-up-feat-item">
        <svg class="ww-up-check-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        <span id="ww-up-feat-strategies">Up to 3 Trading Strategies</span>
      </div>
      <div class="ww-up-feat-item">
        <svg class="ww-up-check-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        <span data-i18n-key="feat_full_analytics">Full Analytics & Statistics</span>
      </div>
      <div class="ww-up-feat-item">
        <svg class="ww-up-check-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        <span data-i18n-key="feat_auto_sync">Auto Sync Trades / Import CSVs</span>
      </div>
      <div class="ww-up-feat-item">
        <svg class="ww-up-check-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        <span data-i18n-key="feat_calendar_view">P&L Calendar View</span>
      </div>
    </div>

    <!-- Segmented Control 1: Tier Selector (Basic / Pro) -->
    <div class="ww-up-pill-group" id="ww-up-tier-switch" role="tablist">
      <button type="button" class="ww-up-pill-btn" data-tier="basic" role="tab" aria-selected="false">Basic</button>
      <button type="button" class="ww-up-pill-btn active" data-tier="pro" role="tab" aria-selected="true">Pro</button>
    </div>

    <!-- Segmented Control 2: Billing Period Selector (Monthly / Yearly) -->
    <div class="ww-up-pill-group" id="ww-up-period-switch" role="tablist">
      <button type="button" class="ww-up-pill-btn active" data-period="monthly" role="tab" aria-selected="true" data-i18n-key="period_monthly">Aylık</button>
      <button type="button" class="ww-up-pill-btn" data-period="yearly" role="tab" aria-selected="false" data-i18n-key="period_yearly">Yıllık</button>
    </div>

    <!-- Feature Not Included / Limit Warning Notice Box -->
    <div class="ww-up-notice-card">
      <h3 class="ww-up-notice-title" id="ww-up-notice-title">Feature not included</h3>
      <p class="ww-up-notice-desc" id="ww-up-notice-desc">Auto Sync Trades / Import CSVs is not included in your Free plan.</p>
      <p class="ww-up-notice-sub" id="ww-up-notice-sub">Choose a plan above to continue with a higher limit or unlock this feature.</p>
    </div>

    <!-- Action Buttons -->
    <div class="ww-up-action-row">
      <button type="button" class="ww-up-btn-primary" id="ww-up-btn-upgrade" data-i18n-key="btn_upgrade">Upgrade</button>
      <button type="button" class="ww-up-btn-secondary" id="ww-up-btn-compare">
        <span data-i18n-key="btn_compare">Compare Plans</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </button>
    </div>

  </div>
</div>

<style>
  /* ============================================================
     UPGRADE / PAYWALL MODAL STYLING
     Pixel-perfect dark luxury trading SaaS aesthetic
     ============================================================ */

  .ww-up-backdrop {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: rgba(3, 4, 8, 0.78);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.24s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.24s ease;
  }

  .ww-up-backdrop.active {
    opacity: 1;
    visibility: visible;
  }

  .ww-up-modal {
    position: relative;
    width: 100%;
    max-width: 480px;
    max-height: 92vh;
    overflow-y: auto;
    overflow-x: hidden;
    background: #0b0c10;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    padding: 20px 22px 24px;
    box-shadow: 
      0 32px 80px -16px rgba(0, 0, 0, 0.85),
      0 0 0 1px rgba(255, 255, 255, 0.04),
      0 0 45px -10px rgba(139, 92, 246, 0.12);
    color: #f1f2f6;
    font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    transform: scale(0.94) translateY(12px);
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.15) transparent;
  }

  .ww-up-backdrop.active .ww-up-modal {
    transform: scale(1) translateY(0);
  }

  .ww-up-modal::-webkit-scrollbar {
    width: 5px;
  }
  .ww-up-modal::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 99px;
  }

  /* Top Bar */
  .ww-up-topbar {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    margin-bottom: 14px;
  }

  .ww-up-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.22), rgba(124, 58, 237, 0.08));
    border: 1px solid rgba(139, 92, 246, 0.38);
    box-shadow: 0 0 18px rgba(139, 92, 246, 0.32);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .ww-up-logo:hover {
    transform: scale(1.05);
    box-shadow: 0 0 24px rgba(139, 92, 246, 0.5);
  }

  .ww-up-logo-svg {
    width: 20px;
    height: 20px;
    color: #a78bfa;
    stroke: #a78bfa;
    filter: drop-shadow(0 0 6px rgba(139, 92, 246, 0.55));
  }

  .ww-up-close-btn {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    color: #8b8e9f;
    cursor: pointer;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
  }

  .ww-up-close-btn:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
  }

  /* Hero Dashboard Preview */
  .ww-up-preview-card {
    position: relative;
    background: #090a10;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 0;
    margin-bottom: 18px;
    overflow: hidden;
    height: 175px;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.6);
  }

  .ww-up-preview-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    user-select: none;
    pointer-events: none;
  }

  /* Bottom fade vignette */
  .ww-up-preview-fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 50px;
    background: linear-gradient(180deg, transparent 0%, rgba(11, 12, 16, 0.98) 100%);
    pointer-events: none;
  }

  /* Plan Name & Price */
  .ww-up-plan-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .ww-up-plan-name {
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.02em;
  }

  .ww-up-plan-price-wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }

  .ww-up-plan-price {
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.02em;
    display: flex;
    align-items: baseline;
    gap: 2px;
  }

  .ww-up-price-period {
    font-size: 0.95rem;
    font-weight: 500;
    color: #8b8e9f;
  }

  .ww-up-price-subnote {
    font-size: 11.5px;
    font-weight: 500;
    color: #8b8e9f;
    letter-spacing: -0.01em;
  }

  /* Features Grid */
  .ww-up-features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px 12px;
    margin-bottom: 18px;
  }

  .ww-up-feat-item {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 11.5px;
    color: #9ea1b5;
    line-height: 1.35;
  }

  .ww-up-check-svg {
    color: #717488;
    flex-shrink: 0;
  }

  /* Segmented Pill Switchers */
  .ww-up-pill-group {
    display: flex;
    background: #121319;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 3px;
    margin-bottom: 8px;
    gap: 3px;
  }

  .ww-up-pill-btn {
    flex: 1;
    background: transparent;
    border: none;
    color: #7b7e92;
    font-family: inherit;
    font-size: 12.5px;
    font-weight: 600;
    padding: 8px 12px;
    border-radius: 9px;
    cursor: pointer;
    transition: all 0.18s ease;
    text-align: center;
  }

  .ww-up-pill-btn:hover {
    color: #c4c6d6;
  }

  .ww-up-pill-btn.active {
    background: #1e202a;
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
  }

  /* Notice Box */
  .ww-up-notice-card {
    text-align: center;
    margin: 22px 0 20px;
    padding: 0 10px;
  }

  .ww-up-notice-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.02em;
    margin: 0 0 10px 0;
  }

  .ww-up-notice-desc {
    font-size: 12.5px;
    color: #8b8e9f;
    line-height: 1.48;
    margin: 0 0 10px 0;
  }

  .ww-up-notice-sub {
    font-size: 12px;
    color: #717488;
    line-height: 1.48;
    margin: 0;
  }

  /* Action Buttons */
  .ww-up-action-row {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .ww-up-btn-primary {
    flex: 1;
    height: 44px;
    background: #ffffff;
    color: #0b0c10;
    border: none;
    border-radius: 10px;
    font-family: inherit;
    font-size: 13.5px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.18s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .ww-up-btn-primary:hover {
    background: #eaeaf2;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(255, 255, 255, 0.18);
  }

  .ww-up-btn-secondary {
    flex: 1;
    height: 44px;
    background: #14151c;
    color: #dfe1ee;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 10px;
    font-family: inherit;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.18s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
  }

  .ww-up-btn-secondary:hover {
    background: #1c1d27;
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.18);
  }

  @media (max-width: 480px) {
    .ww-up-modal {
      padding: 16px 16px 20px;
      border-radius: 20px;
    }
    .ww-up-features-grid {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .ww-up-action-row {
      flex-direction: column;
    }
    .ww-up-btn-primary, .ww-up-btn-secondary {
      width: 100%;
    }
  }

  /* Light Theme Support */
  body.light-theme .ww-up-modal,
  [data-theme="light"] .ww-up-modal {
    background: #ffffff;
    border-color: #e2e8f0;
    color: #0f172a;
    box-shadow: 0 32px 80px -16px rgba(0, 0, 0, 0.16), 0 0 35px -10px rgba(139, 92, 246, 0.12);
  }
  body.light-theme .ww-up-plan-name,
  [data-theme="light"] .ww-up-plan-name,
  body.light-theme .ww-up-plan-price,
  [data-theme="light"] .ww-up-plan-price,
  body.light-theme .ww-up-notice-title,
  [data-theme="light"] .ww-up-notice-title {
    color: #0f172a;
  }
  body.light-theme .ww-up-pill-group,
  [data-theme="light"] .ww-up-pill-group {
    background: #f1f5f9;
    border-color: #e2e8f0;
  }
  body.light-theme .ww-up-pill-btn,
  [data-theme="light"] .ww-up-pill-btn {
    color: #64748b;
  }
  body.light-theme .ww-up-pill-btn.active,
  [data-theme="light"] .ww-up-pill-btn.active {
    background: #ffffff;
    color: #0f172a;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }
  body.light-theme .ww-up-btn-primary,
  [data-theme="light"] .ww-up-btn-primary {
    background: #7c3aed;
    color: #ffffff;
  }
  body.light-theme .ww-up-btn-primary:hover,
  [data-theme="light"] .ww-up-btn-primary:hover {
    background: #6d28d9;
    box-shadow: 0 6px 18px rgba(124, 58, 237, 0.3);
  }
  body.light-theme .ww-up-btn-secondary,
  [data-theme="light"] .ww-up-btn-secondary {
    background: #f8fafc;
    color: #334155;
    border-color: #cbd5e1;
  }
  body.light-theme .ww-up-btn-secondary:hover,
  [data-theme="light"] .ww-up-btn-secondary:hover {
    background: #f1f5f9;
    color: #0f172a;
  }
  body.light-theme .ww-up-preview-card,
  [data-theme="light"] .ww-up-preview-card {
    border-color: #e2e8f0;
  }
</style>

