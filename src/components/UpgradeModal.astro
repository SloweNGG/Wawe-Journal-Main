---
// UpgradeModal.astro — Pro Paywall & Limit Exceeded Modal
// Yalnızca uygulama sayfalarında render edilir (Layout.astro: isAppPage). İşaretleme sunucuda kalır (smoke testleri,
// backtest anyModalOpen ve navbar "N" kısayolu #ww-upgrade-modal-backdrop'u DOM'da arar).
//   - Stiller: public/components/upgrade-modal/upgrade-modal.css (Layout head'inde). Kapsam [data-ww-up] özniteliği:
//     ww-up-* sınıflı her elemanda olmalı (yeni eleman eklerken unutmayın; yoksa stiller uygulanmaz).
//   - Mantık: public/components/upgrade-modal/upgrade-modal.js (window.openUpgradeModal / closeUpgradeModal).
---
<div id="ww-upgrade-modal-backdrop" data-ww-up class="ww-up-backdrop" aria-hidden="true" style="display:none;">
  <div data-ww-up class="ww-up-modal" role="dialog" aria-modal="true" aria-labelledby="ww-up-notice-title">
    
    <!-- Top Bar: Logo & Close Button -->
    <div data-ww-up class="ww-up-topbar">
      <div data-ww-up class="ww-up-logo">
        <img data-ww-up class="ww-up-logo-img" src="/images/brand/logo-mark-48.webp" srcset="/images/brand/logo-mark-48.webp 1x, /images/brand/logo-mark-96.webp 2x" alt="Wawe Journal" width="40" height="27" />
      </div>
      <button type="button" data-ww-up class="ww-up-close-btn" id="ww-up-close-btn" aria-label="Kapat">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Hero Visual: Real Analiz Screenshot Preview -->
    <div data-ww-up class="ww-up-preview-card">
      <!-- the Pro view of the feature that opened the modal (PREVIEW_BY_FEATURE) -->
      {/* srcset: pencere en fazla ~450 px geniş; 1800 px'lik asıl görsel (79 KB) yerine ekrana uygun boyut iner (14-38 KB).
           Görsel değişince upgrade-modal.js srcset'i de değiştirir (PREVIEW_SRCSET). */}
      <img
        src="/images/landing/screen-analytics.webp"
        srcset="/images/landing/screen-analytics-600w.webp 600w, /images/landing/screen-analytics-900w.webp 900w, /images/landing/screen-analytics-1200w.webp 1200w, /images/landing/screen-analytics.webp 1800w"
        sizes="(max-width: 520px) 92vw, 450px"
        alt="Wawe Journal Pro"
        data-ww-up class="ww-up-preview-img"
        id="ww-up-preview-img"
        width="1800"
        height="947"
        loading="lazy"
        decoding="async"
      />
      <!-- Subtle bottom gradient vignette -->
      <div data-ww-up class="ww-up-preview-fade"></div>
    </div>

    <!-- Plan Name & Pricing Row -->
    <div data-ww-up class="ww-up-plan-header">
      <div data-ww-up class="ww-up-plan-name" id="ww-up-plan-name">Pro</div>
      <div data-ww-up class="ww-up-plan-price-wrap">
        <div data-ww-up class="ww-up-plan-price">
          <span data-ww-up class="ww-up-price-num" id="ww-up-price-num">$12</span>
          <span data-ww-up class="ww-up-price-period" id="ww-up-price-period">/ay</span>
        </div>
        <div data-ww-up class="ww-up-price-subnote" id="ww-up-price-subnote" style="display:none;"></div>
      </div>
    </div>

    <!-- Plan Features Checklist (2 columns): filled by updateModalUI for the selected tier (FEATURES_BY_TIER) -->
    <div data-ww-up class="ww-up-features-grid" id="ww-up-features"></div>

    <!-- Segmented Control 1: Tier Selector (Free / Pro): shows what each plan includes -->
    <div data-ww-up class="ww-up-pill-group" id="ww-up-tier-switch" role="tablist">
      <button type="button" data-ww-up class="ww-up-pill-btn" data-tier="free" role="tab" aria-selected="false" data-i18n-key="tier_free">Ücretsiz</button>
      <button type="button" data-ww-up class="ww-up-pill-btn active" data-tier="pro" role="tab" aria-selected="true">Pro</button>
    </div>

    <!-- Segmented Control 2: Billing Period Selector (Monthly / Yearly) -->
    <div data-ww-up class="ww-up-pill-group" id="ww-up-period-switch" role="tablist">
      <button type="button" data-ww-up class="ww-up-pill-btn active" data-period="monthly" role="tab" aria-selected="true" data-i18n-key="period_monthly">Aylık</button>
      <button type="button" data-ww-up class="ww-up-pill-btn" data-period="yearly" role="tab" aria-selected="false" data-i18n-key="period_yearly">Yıllık</button>
    </div>

    <!-- Feature Not Included / Limit Warning Notice Box -->
    <div data-ww-up class="ww-up-notice-card">
      <h3 data-ww-up class="ww-up-notice-title" id="ww-up-notice-title">Feature not included</h3>
      <p data-ww-up class="ww-up-notice-desc" id="ww-up-notice-desc">Auto Sync Trades / Import CSVs is not included in your Free plan.</p>
      <p data-ww-up class="ww-up-notice-sub" id="ww-up-notice-sub">Choose a plan above to continue with a higher limit or unlock this feature.</p>
    </div>

    <!-- Action Buttons -->
    <div data-ww-up class="ww-up-action-row">
      <button type="button" data-ww-up class="ww-up-btn-primary" id="ww-up-btn-upgrade">Upgrade</button>
      <button type="button" data-ww-up class="ww-up-btn-secondary" id="ww-up-btn-compare">
        <span data-i18n-key="btn_compare">Compare Plans</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </button>
    </div>

  </div>
</div>

{/* Parser-blocking (defer'siz), eski satır içi script'in yerinde: ayrıştırma bitince openUpgradeModal tanımlı olur,
    DOMContentLoaded bağlamaları eskisi gibi çalışır */}
<script src="/components/upgrade-modal/upgrade-modal.js" is:inline></script>
