    <a href="/dashboard.html" data-page="dashboard" class={`loaded ${isActive('dashboard') ? 'active' : ''}`}><span data-i18n="nav.dashboard">Dashboard</span></a>
    <a href="/trades.html" data-page="trades" class={`loaded ${isActive('trades') ? 'active' : ''}`}><span data-i18n="nav.trades">İşlemler</span></a>
    <a href="/strategies.html" data-page="strategies" class={`loaded ${isActive('strategies') ? 'active' : ''}`}><span data-i18n="nav.strategies">Stratejiler</span></a>
