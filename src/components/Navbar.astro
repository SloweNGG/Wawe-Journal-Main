---
// Server-rendered static Navbar for instant 0ms load without client-side layout shift
const pathname = Astro.url.pathname || '';
const isActive = (page: string) => {
  if (page === 'dashboard' && (pathname === '/dashboard.html' || pathname === '/dashboard' || pathname === '/' || pathname === '')) return true;
  if (page === 'trades' && (pathname.includes('/trades') || pathname.includes('/add-trade'))) return true;
  if (page === 'strategies' && pathname.includes('/strategies')) return true;
  if (page === 'calendar' && pathname.includes('/calendar')) return true;
  if (page === 'backtest' && pathname.includes('/backtest')) return true;
  if (page === 'journals' && pathname.includes('/journals')) return true;
  if (page === 'settings' && pathname.includes('/settings')) return true;
  if (page === 'report-bug' && pathname.includes('/report-bug')) return true;
  if (page === 'analytics' && pathname.includes('/analytics')) return true;
  if (page === 'my-earnings' && pathname.includes('/my-earnings')) return true;
  if (page === 'admin' && pathname.includes('/admin')) return true;
  return false;
};
---
<nav class="nav">
  <a href="/dashboard.html" class="nav-logo" title="Wawe Journal - Dashboard">
    <img class="nav-logo-mark" src="/resim.svg" alt="Wawe Journal" width="26" height="26" />
  </a>

  <div class="nav-journal-switcher" id="nav-journal-switcher">
    <button class="journal-switch-btn" aria-haspopup="true" aria-expanded="false" onclick="window.wwToggleJournal && window.wwToggleJournal(event, this)">
      <span class="journal-icon ww-mark-host"><span class="ww-mark ww-mark--dot" style="--mk-size:9px;--mk:#7c6dfa;--mk-ring:#7c6dfa40"><span class="ww-mark-dot"></span></span></span>
      <span class="journal-name">Ana Hesap</span>
      <svg class="journal-arrow" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
    </button>
    <div class="journal-dropdown" id="journal-dropdown"></div>
    <script is:inline>
      // ⚡ 0ms INSTANT PRE-HYDRATION: Sayfa parse edildiği an FTMO/Prop firm rozetini ve hesap adını gecikmesiz bas
      (function() {
        try {
          var jName = localStorage.getItem('ww_active_journal_name');
          var pBadge = localStorage.getItem('ww_active_prop_badge_html');
          var ctDot = localStorage.getItem('ww_active_ctrader_dot_html');
          var jIcon = localStorage.getItem('ww_active_journal_icon_html');
          var sw = document.getElementById('nav-journal-switcher');
          if (!sw) return;
          var nameEl = sw.querySelector('.journal-name');
          var iconEl = sw.querySelector('.journal-icon');
          if (nameEl && jName) {
            nameEl.textContent = jName;
            nameEl.title = jName;
          }
          if (nameEl && nameEl.parentNode) {
            if (ctDot && !sw.querySelector('.ctrader-status-dot')) {
              var dWrap = document.createElement('span');
              dWrap.innerHTML = ctDot;
              if (dWrap.firstElementChild) nameEl.parentNode.insertBefore(dWrap.firstElementChild, nameEl);
            }
            if (pBadge && !sw.querySelector('.nav-prop-tag')) {
              var bWrap = document.createElement('span');
              bWrap.innerHTML = pBadge;
              if (bWrap.firstElementChild) nameEl.parentNode.insertBefore(bWrap.firstElementChild, nameEl.nextSibling);
            }
          }
          if (iconEl && jIcon) {
            iconEl.innerHTML = jIcon;
          }
        } catch(e) {}
      })();
    </script>
  </div>

