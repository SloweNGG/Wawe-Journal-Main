---
// Herkese açık sayfaların (ana sayfa + PageLayout) navbar sağ tarafı.
// Ziyaretçi: "Giriş yap" + "Ücretsiz başla". Oturum açık: avatar + "Dashboard".
// Oturum, Supabase'in localStorage'a yazdığı oturumdan İLK BOYAMADAN ÖNCE okunur, düğmeler hiç yanıp sönmez.
// Supabase SDK'sı bu sayfalarda ya hiç yüklenmez ya da geç yüklenir, o yüzden SDK beklenmez.
// Not: anahtar adı supabase-js'in varsayılanıdır (sb-<proje ref>-auth-token); config.js'teki proje değişirse burası da değişmeli.
---
<script is:inline>
  (function () {
    try {
      var raw = localStorage.getItem('sb-odasapyhtdopbnlfhwde-auth-token');
      var s = raw && JSON.parse(raw);
      if (s && s.refresh_token) {
        document.documentElement.classList.add('ww-authed');
        window.__wwNavSession = s;
      }
    } catch (e) {}
  })();
</script>
<a href="/login" class="navsignin nav-guest" data-i18n="lp.nav.signin">Sign in</a>
<a href="/register" class="b bp bs nav-guest" data-i18n="lp.nav.start">Start for free</a>
<a href="/settings" class="nav-avatar nav-authed" id="nav-pub-avatar" aria-label="Account settings" title="Account settings"></a>
<a href="/dashboard" class="b bp bs nav-authed" data-i18n="lp.nav.dashboard">Dashboard</a>
<script is:inline>
  (function () {
    var s = window.__wwNavSession;
    var av = document.getElementById('nav-pub-avatar');
    if (!s || !av) return;
    var email = (s.user && s.user.email) || '';
    var name = '';
    var url = '';
    try {
      name = localStorage.getItem('ww_user_display_name') || '';
      url = localStorage.getItem('ww_avatar_url') || '';
    } catch (e) {}
    if (!name) name = (s.user && s.user.user_metadata && (s.user.user_metadata.full_name || s.user.user_metadata.name)) || email;
    if (/^https:\/\//.test(url)) {
      var img = document.createElement('img');
      img.src = url;
      img.alt = '';
      img.onerror = function () { img.remove(); av.textContent = initials(); };
      av.appendChild(img);
    } else {
      av.textContent = initials();
    }
    if (email) av.title = email;
    function initials() {
      var n = (name.indexOf('@') > 0 ? name.split('@')[0] : name).trim();
      return (n.slice(0, 2) || '?').toUpperCase();
    }
    // Sayfa içindeki "Ücretsiz başla" tarzı kayıt bağlantıları giriş yapmış kullanıcıyı uygulamaya götürür
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('a[href="/register"]:not(.nav-guest), a[href="/register.html"]:not(.nav-guest)').forEach(function (a) {
        a.setAttribute('href', '/dashboard');
      });
      if (window.i18n) av.setAttribute('aria-label', window.i18n.t('lp.nav.account'));
    });
  })();
</script>
<style is:global>
  html.ww-authed .nav-guest,
  html:not(.ww-authed) .nav-authed { display: none !important; }
  .nav-avatar {
    flex: none;
    width: 34px; height: 34px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    overflow: hidden;
    font-size: 13px; font-weight: 600; letter-spacing: .02em; color: #fff; text-decoration: none;
    background: linear-gradient(135deg, rgba(139, 92, 246, .55), rgba(99, 102, 241, .35));
    border: 1px solid rgba(255, 255, 255, .18);
    transition: border-color .2s, transform .2s;
  }
  .nav-avatar:hover { border-color: rgba(255, 255, 255, .45); transform: translateY(-1px); }
  .nav-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .navbar.is-compact .nav-avatar { width: 30px; height: 30px; font-size: 12px; }
</style>
