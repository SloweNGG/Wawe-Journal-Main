---
import Navbar from '../components/Navbar.astro';
import BaseHead from '../components/BaseHead.astro';

export interface Props {
  lang?: string;
  bodyClass?: string;
  bodyStyle?: string;
  title?: string;
  description?: string;
  canonical?: string;
  noIndex?: boolean;
  showNavbar?: boolean;
  isAppPage?: boolean;
}

const {
  lang = 'tr',
  bodyClass,
  bodyStyle,
  title = 'Wawe Journal',
  description,
  canonical,
  noIndex,
  showNavbar = true,
  isAppPage = showNavbar,
} = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <BaseHead title={title} description={description} canonical={canonical} noIndex={noIndex} isAppPage={isAppPage} />
  <slot name="head" />
  {isAppPage && (
    <link rel="stylesheet" href="/interface/dashboard/css/onboarding.css?v=1791381400" />
    <script src="/src/core/prop-templates.js?v=1791480000" is:inline defer></script>
    <script src="/src/utils/prop-calculator.js?v=1791480000" is:inline defer></script>
    <script src="/src/services/prop-service.js?v=1791480000" is:inline defer></script>
  )}
</head>
<body class={bodyClass} style={bodyStyle}>
  <div class="wj-ambient-backdrop" id="wj-ambient-backdrop" aria-hidden="true">
    <div class="wj-ambient-mesh"></div>
    <div class="wj-ambient-orb wj-ambient-orb-1"></div>
    <div class="wj-ambient-orb wj-ambient-orb-2"></div>
  </div>
  <div id="app-scroll-container">
    {showNavbar && (
      <div id="navbar-container">
        <Navbar />
      </div>
    )}
    <slot />
  </div>

  {isAppPage && (
    <script src="/interface/dashboard/js/onboarding.js?v=1791381400" is:inline defer></script>
  )}
  {showNavbar && (
    <script src="/components/navbar/navbar.js?v=1791480020" is:inline defer></script>
    <script src="/components/navbar/page-transition.js?v=1791480020" is:inline defer></script>
  )}
</body>
</html>