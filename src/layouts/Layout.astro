---
import Navbar from '../components/Navbar.astro';
import BaseHead from '../components/BaseHead.astro';

export interface Props {
  lang?: string;
  bodyClass?: string;
  bodyStyle?: string;
  title?: string;
  description?: string;
  canonical?: string;
  noIndex?: boolean;
  showNavbar?: boolean;
}

const {
  lang = 'en',
  bodyClass,
  bodyStyle,
  title = 'Wawe Journal',
  description,
  canonical,
  noIndex,
  showNavbar = true,
} = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <BaseHead title={title} description={description} canonical={canonical} noIndex={noIndex} />
  <slot name="head" />
</head>
<body class={bodyClass} style={bodyStyle}>
  <div id="app-scroll-container">
    {showNavbar && (
      <div id="navbar-container">
        <Navbar />
      </div>
    )}
    <slot />
  </div>
</body>
</html>