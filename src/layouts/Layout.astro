---
import Navbar from '../components/Navbar.astro';
import BaseHead from '../components/BaseHead.astro';
import UpgradeModal from '../components/UpgradeModal.astro';
import SpaRouter from '../components/SpaRouter.astro';

export interface Props {
  lang?: string;
  bodyClass?: string;
  bodyStyle?: string;
  title?: string;
  description?: string;
  canonical?: string;
  noIndex?: boolean;
  showNavbar?: boolean;
  isAppPage?: boolean;
  /** Sayfa yenilemeden geçiş (bkz. SpaRouter.astro — sayfa SPA_PATHS'e de eklenmeli) */
  spa?: boolean;
  /** Sayfa quick-add (FAB) kullanıyor mu — SPA'da buton buna göre gösterilir */
  showQuickAdd?: boolean;
  /** Dil sürümleri (hreflang). <head>'in EN BAŞINA yazılır: BaseHead'deki dil ön yükleme script'i bunları okur. */
  alternates?: { hreflang: string; href: string }[];
  /** Dili URL'den gelen sayfa (/tr/..., /de/...): <html data-locale-page>. index-i18n ve BaseHead bu dili kullanır. */
  localePage?: string;
}

const {
  lang = 'tr',
  bodyClass,
  bodyStyle,
  title = 'Wawe Journal',
  description,
  canonical,
  showNavbar = true,
  isAppPage = showNavbar,
  // Giriş gerektiren uygulama sayfaları arama sonuçlarına girmesin (marka sayfasını sulandırır)
  noIndex = isAppPage,
  spa = false,
  showQuickAdd = false,
  alternates = [],
  localePage,
} = Astro.props;
---
<!DOCTYPE html>
<html lang={lang} data-locale-page={localePage}>
<head>
  {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
  <BaseHead title={title} description={description} canonical={canonical} noIndex={noIndex} isAppPage={isAppPage} />
  <slot name="head" />
  {/* Uygulama kabuğu. Burada OLMAYANLAR (ihtiyaç olunca yüklenir):
      - onboarding.css/.js → onboarding-gate.js (body sonu) gerekiyorsa yükler
      - note-tools.css/.js → add-trade.astro head'i ve quick-add-boot.js (Hızlı Ekle açılınca)
      - prop-montecarlo.js → yalnızca dashboard.astro
      upgrade-modal.css head'deki SON stil dosyası kalmalı (eskiden /_astro/Layout.*.css oradaydı; kaskad sırası) */}
  {isAppPage && (
    <link rel="stylesheet" href="/components/ai-coach/ai-coach.css" />
    <link rel="stylesheet" href="/components/econ-calendar/econ-calendar.css" />
    <link rel="stylesheet" href="/components/upgrade-modal/upgrade-modal.css" />
    <script src="/src/core/prop-templates.js" is:inline defer></script>
    <script src="/src/utils/prop-calculator.js" is:inline defer></script>
    <script src="/src/services/prop-service.js" is:inline defer></script>
  )}
  {spa && <SpaRouter />}
</head>
<body class={bodyClass} style={bodyStyle} data-page-class={bodyClass} data-quick-add={showQuickAdd ? '' : undefined}>
  {/* SPA: sunucudan gelen head elemanlarını işaretle (runtime'da eklenenlerden ayırmak için).
      Body'nin başında çalışır; Astro'nun head sonuna eklediği CSS/script'ler de dahil olsun. */}
  {/* data-runtime: head okunurken script'in eklediği eleman (ör. hesap işareti stili) — sunucudan gelmez, işaretlenmez */}
  {spa && <script is:inline>for(var c=document.head.children,i=0;i<c.length;i++)if(!c[i].hasAttribute('data-runtime'))c[i].setAttribute('data-ssr','')</script>}
  {/* Arka plan katmanları (Ayarlar > Görünüm > Arka plan): public/components/ambient/ambient.js + ambient.css */}
  <div class="wj-ambient-backdrop" id="wj-ambient-backdrop" aria-hidden="true">
    <div class="wj-bg-base"></div>
    <div class="wj-bg-scene"></div>
    <div class="wj-bg-scrim"></div>
    <div class="wj-ambient-orb wj-ambient-orb-1"></div>
    <div class="wj-ambient-orb wj-ambient-orb-2"></div>
    <div class="wj-ambient-orb wj-ambient-orb-3"></div>
    <div class="wj-ambient-mesh"></div>
    <div class="wj-ambient-aurora"></div>
  </div>
  <div id="app-scroll-container">
    {showNavbar && (
      <div id="navbar-container">
        <Navbar />
      </div>
    )}
    <slot />
  </div>

  {/* Yükseltme penceresi yalnızca uygulama sayfalarında: herkese açık sayfalarda çağıran yok (eskiden her sayfada ~25 KB
      işaretleme + satır içi script; /support'taki analiz ekran görüntüsü linki de yanlışlıkla pencereyi açıyordu) */}
  {isAppPage && <UpgradeModal />}

  {isAppPage && (
    <script src="/interface/dashboard/js/onboarding-gate.js" is:inline defer></script>
    <script src="/components/ai-coach/ai-coach.js" is:inline defer></script>
  )}
  {showNavbar && (
    <script src="/interface/shared/ctrader-sync.js" is:inline defer></script>
    <script src="/components/navbar/navbar.js" is:inline defer></script>
    <script src="/components/econ-calendar/econ-calendar.js" is:inline defer></script>
    <script src="/components/navbar/page-transition.js" is:inline defer></script>
  )}
</body>
</html>