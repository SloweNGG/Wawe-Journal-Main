---
import Navbar from '../components/Navbar.astro';
import BaseHead from '../components/BaseHead.astro';
import UpgradeModal from '../components/UpgradeModal.astro';
import SpaRouter from '../components/SpaRouter.astro';

export interface Props {
  lang?: string;
  bodyClass?: string;
  bodyStyle?: string;
  title?: string;
  description?: string;
  canonical?: string;
  noIndex?: boolean;
  showNavbar?: boolean;
  isAppPage?: boolean;
  /** Sayfa yenilemeden geçiş (bkz. SpaRouter.astro — sayfa SPA_PATHS'e de eklenmeli) */
  spa?: boolean;
  /** Sayfa quick-add (FAB) kullanıyor mu — SPA'da buton buna göre gösterilir */
  showQuickAdd?: boolean;
}

const {
  lang = 'tr',
  bodyClass,
  bodyStyle,
  title = 'Wawe Journal',
  description,
  canonical,
  showNavbar = true,
  isAppPage = showNavbar,
  // Giriş gerektiren uygulama sayfaları arama sonuçlarına girmesin (marka sayfasını sulandırır)
  noIndex = isAppPage,
  spa = false,
  showQuickAdd = false,
} = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <BaseHead title={title} description={description} canonical={canonical} noIndex={noIndex} isAppPage={isAppPage} />
  <slot name="head" />
  {isAppPage && (
    <link rel="stylesheet" href="/interface/dashboard/css/onboarding.css" />
    <link rel="stylesheet" href="/components/ai-coach/ai-coach.css" />
    <link rel="stylesheet" href="/components/note-tools/note-tools.css" />
    <script src="/src/core/prop-templates.js" is:inline defer></script>
    <script src="/src/utils/prop-calculator.js" is:inline defer></script>
    <script src="/src/utils/prop-montecarlo.js" is:inline defer></script>
    <script src="/src/services/prop-service.js" is:inline defer></script>
  )}
  {spa && <SpaRouter />}
</head>
<body class={bodyClass} style={bodyStyle} data-page-class={bodyClass} data-quick-add={showQuickAdd ? '' : undefined}>
  {/* SPA: sunucudan gelen head elemanlarını işaretle (runtime'da eklenenlerden ayırmak için).
      Body'nin başında çalışır; Astro'nun head sonuna eklediği CSS/script'ler de dahil olsun. */}
  {/* data-runtime: head okunurken script'in eklediği eleman (ör. hesap işareti stili) — sunucudan gelmez, işaretlenmez */}
  {spa && <script is:inline>for(var c=document.head.children,i=0;i<c.length;i++)if(!c[i].hasAttribute('data-runtime'))c[i].setAttribute('data-ssr','')</script>}
  <div class="wj-ambient-backdrop" id="wj-ambient-backdrop" aria-hidden="true">
    <div class="wj-ambient-mesh"></div>
    <div class="wj-ambient-orb wj-ambient-orb-1"></div>
    <div class="wj-ambient-orb wj-ambient-orb-2"></div>
  </div>
  <div id="app-scroll-container">
    {showNavbar && (
      <div id="navbar-container">
        <Navbar />
      </div>
    )}
    <slot />
  </div>

  <UpgradeModal />

  {isAppPage && (
    <script src="/interface/dashboard/js/onboarding.js" is:inline defer></script>
    <script src="/components/ai-coach/ai-coach.js" is:inline defer></script>
    <script src="/components/note-tools/note-tools.js" is:inline defer></script>
  )}
  {showNavbar && (
    <script src="/interface/shared/ctrader-sync.js" is:inline defer></script>
    <script src="/components/navbar/navbar.js" is:inline defer></script>
    <script src="/components/navbar/page-transition.js" is:inline defer></script>
  )}
</body>
</html>