---
import Layout from './Layout.astro';
import LegalDisclosures from '../components/LegalDisclosures.astro';

export interface Props {
  title: string;
  lang?: string;
  description?: string;
  noIndex?: boolean;
}

const { title, lang = 'en', description = 'Wawe Journal - Professional Trading Journal', noIndex = false } = Astro.props;
// Cloudflare "/about.html" adresini "/about"a yönlendirdiği için canonical temiz adres olmalı
const cleanPath = Astro.url.pathname.replace(/(^|\/)index\.html$/, '/').replace(/\.html$/, '');
const canonical = new URL(cleanPath, 'https://wawejournal.com').href;
---
<Layout lang={lang} showNavbar={false} title={title} description={description} canonical={canonical} noIndex={noIndex}>
<Fragment slot="head">
  <meta name="theme-color" content="#000000" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" />
  <link rel="stylesheet" href="/landing-preview.css?v=6" />
  <link rel="stylesheet" href="/pages.css?v=2" />
  <link rel="stylesheet" href="/page-chrome.css?v=1" />
  <style is:global>
    * { box-sizing: border-box; }
    html {
      overflow-y: auto !important;
      overflow-x: hidden !important;
      height: auto !important;
      scroll-behavior: smooth;
    }
    /* clip (not hidden) so body does not become a scroll container and the sticky navbar keeps working */
    body {
      overflow-y: visible !important;
      overflow-x: clip !important;
      height: auto !important;
      min-height: 100vh !important;
      max-width: 100%;
    }
    #navbar-container { display: none !important; }
    #app-scroll-container {
      overflow: visible !important;
      height: auto !important;
      min-height: 100vh !important;
      display: block !important;
      width: 100% !important;
    }
  </style>
</Fragment>

  <header class="lp-head">
    <div class="g navbar" id="navbar">
      <a href="/" class="brand" aria-label="Wawe Journal home">
        <img class="logo-glow" src="/images/brand/logo-mark.png" srcset="/images/brand/logo-mark.png 1x, /images/brand/logo-mark@2x.png 2x" alt="" width="30" height="20" />
        <span class="navword">Wawe <span class="brand-accent">Journal</span></span>
      </a>
      <nav class="navlinks" aria-label="Primary">
        <a href="/#journal" data-i18n="lp.nav.journal">Journal</a>
        <a href="/#analytics" data-i18n="lp.nav.analytics">Analytics</a>
        <a href="/#backtest" data-i18n="lp.nav.backtest">Backtest</a>
        <a href="/#pricing" data-i18n="lp.nav.pricing">Pricing</a>
        <a href="/#faq" data-i18n="lp.nav.faq">FAQ</a>
      </nav>
      <div class="grow"></div>
      <div class="lang-selector" id="lang-selector">
        <div class="lang-current mono" id="lang-current" role="button" tabindex="0" aria-label="Language"><span class="lang-current-flag">EN</span><span class="lang-current-arrow" aria-hidden="true">▾</span></div>
        <div class="g lang-dropdown" id="lang-dropdown">
          <div class="lang-option" data-lang="en" data-flag="EN"><span>English</span><span class="mono lang-code">EN</span></div>
          <div class="lang-option" data-lang="tr" data-flag="TR"><span>Türkçe</span><span class="mono lang-code">TR</span></div>
          <div class="lang-option" data-lang="de" data-flag="DE"><span>Deutsch</span><span class="mono lang-code">DE</span></div>
        </div>
      </div>
      <a href="/login" class="navsignin" data-i18n="lp.nav.signin">Sign in</a>
      <a href="/register" class="b bp bs" data-i18n="lp.nav.start">Start for free</a>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="lp-foot">
    <div class="foot-in">
      <div class="foot-top">
        <div class="foot-brand">
          <div class="foot-logo"><img class="logo-glow" src="/images/brand/logo-mark.png" srcset="/images/brand/logo-mark.png 1x, /images/brand/logo-mark@2x.png 2x" alt="" width="36" height="24" />Wawe Journal</div>
          <div class="foot-desc" data-i18n-html="lp.ft.desc_h">Trading journal, analytics and backtest replay. Part of the <a href="https://wawedev.com" target="_blank" rel="noopener">wawedev</a> brand.</div>
        </div>
        <div class="foot-col"><div class="mono foot-h" data-i18n="lp.ft.product">PRODUCT</div><a href="/#journal" data-i18n="lp.nav.journal">Journal</a><a href="/#analytics" data-i18n="lp.nav.analytics">Analytics</a><a href="/#backtest" data-i18n="lp.nav.backtest">Backtest</a><a href="/#pricing" data-i18n="lp.nav.pricing">Pricing</a></div>
        <div class="foot-col"><div class="mono foot-h" data-i18n="lp.ft.company">COMPANY</div><a href="/about" data-i18n="lp.ft.about">About</a><a href="/privacy" data-i18n="lp.ft.privacy">Privacy</a><a href="/terms" data-i18n="lp.ft.terms">Terms</a><a href="/contact" data-i18n="lp.ft.contact">Contact</a></div>
        <div class="foot-col"><div class="mono foot-h" data-i18n="lp.ft.social">SOCIAL</div><div class="foot-social"><a href="https://www.instagram.com/wawejournal/" target="_blank" rel="noopener" aria-label="Wawe Journal on Instagram" class="social-link"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="5.5"></rect><circle cx="12" cy="12" r="4.5"></circle><circle cx="17.6" cy="6.4" r="0.9" fill="currentColor" stroke="none"></circle></svg></a></div><a href="mailto:support@wawejournal.com">support@wawejournal.com</a></div>
      </div>
      <LegalDisclosures />
      <div class="copy"><span data-i18n="lp.ft.tm">MetaTrader, cTrader, TradingView, FTMO and other broker, platform and prop firm names are trademarks of their respective owners. Wawe Journal is not affiliated with or endorsed by them.</span><br />© 2026 Wawe Journal · wawedev</div>
    </div>
  </footer>

  <script src="/index-i18n.js?v=8" is:inline></script>
  <script is:inline>
  (function() {
    function setupPage() {
      // LANGUAGE SELECTOR
      var langCurrent = document.getElementById('lang-current');
      var langDropdown = document.getElementById('lang-dropdown');
      var langOptions = document.querySelectorAll('.lang-option');
      var langFlag = document.querySelector('.lang-current-flag');

      function updateLanguageUI(lang) {
        var sel = document.querySelector('.lang-option[data-lang="' + lang + '"]');
        if (!sel) return;
        if (langFlag) langFlag.textContent = sel.dataset.flag;
        langOptions.forEach(function(opt) { opt.classList.toggle('active', opt.dataset.lang === lang); });
      }

      if (typeof window.i18n !== 'undefined') {
        updateLanguageUI(window.i18n.getCurrentLanguage());
        window.i18n.onChange(function(l) { updateLanguageUI(l); });
      }

      function toggleDD() { if (langDropdown) langDropdown.classList.toggle('show'); }
      function closeDD() { if (langDropdown) langDropdown.classList.remove('show'); }

      if (langCurrent) {
        langCurrent.addEventListener('click', function(e) {
          e.stopPropagation();
          toggleDD();
        });
      }

      langOptions.forEach(function(opt) {
        opt.addEventListener('click', function(e) {
          e.stopPropagation();
          if (typeof window.i18n !== 'undefined') window.i18n.setLanguage(opt.dataset.lang);
          closeDD();
        });
      });

      document.addEventListener('click', function(e) {
        if (langCurrent && langDropdown && !langCurrent.contains(e.target) && !langDropdown.contains(e.target)) closeDD();
      });

      // NAV: compact the glass pill once the page is scrolled (same as the landing page)
      var nav = document.getElementById('navbar');
      if (nav) {
        var onScroll = function() { nav.classList.toggle('is-compact', (window.scrollY || document.documentElement.scrollTop || 0) > 80); };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      // REVEAL
      var obs = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) { if (e.isIntersecting) e.target.classList.add('visible'); });
      }, { threshold: 0.08 });
      document.querySelectorAll('.reveal').forEach(function(el) { obs.observe(el); });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupPage);
    } else {
      setupPage();
    }
  })();
  </script>
</Layout>
