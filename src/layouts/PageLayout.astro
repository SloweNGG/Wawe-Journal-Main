---
import Layout from './Layout.astro';
import LegalDisclosures from '../components/LegalDisclosures.astro';

export interface Props {
  title: string;
  lang?: string;
  description?: string;
  noIndex?: boolean;
}

const { title, lang = 'en', description = 'Wawe Journal - Professional Trading Journal', noIndex = false } = Astro.props;
// Cloudflare "/about.html" adresini "/about"a yönlendirdiği için canonical temiz adres olmalı
const cleanPath = Astro.url.pathname.replace(/(^|\/)index\.html$/, '/').replace(/\.html$/, '');
const canonical = new URL(cleanPath, 'https://wawejournal.com').href;
---
<Layout lang={lang} showNavbar={false} title={title} description={description} canonical={canonical} noIndex={noIndex}>
<Fragment slot="head">
  <meta name="theme-color" content="#000000" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" />
  <link rel="stylesheet" href="/landing-preview.css?v=5" />
  <link rel="stylesheet" href="/pages.css?v=2" />
  <style is:global>
    * { box-sizing: border-box; }
    html {
      overflow-y: auto !important;
      overflow-x: hidden !important;
      height: auto !important;
      scroll-behavior: smooth;
    }
    body {
      overflow-y: auto !important;
      overflow-x: hidden !important;
      height: auto !important;
      min-height: 100vh !important;
      max-width: 100%;
    }
    #navbar-container { display: none !important; }
    #app-scroll-container {
      overflow: visible !important;
      height: auto !important;
      min-height: 100vh !important;
      display: block !important;
      width: 100% !important;
    }
  </style>
</Fragment>

  <header class="nav">
    <div class="wrap nav-inner">
      <a href="/" class="nav-logo" aria-label="Wawe Journal">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true"><polyline points="2,16 7,9 12,13 19,4" stroke="currentColor" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>Wawe <span class="logo-accent">Journal</span></span>
      </a>
      <span class="nav-spacer"></span>
      <a href="/#pricing" class="nav-link" data-i18n="nav.pricing">Pricing</a>
      <div class="nav-actions">
        <a href="/login" class="btn btn-line" data-i18n="nav.login">Login</a>
        <a href="/register" class="btn btn-solid" data-i18n="nav.register">Sign Up →</a>
      </div>
      <div class="lang-selector" id="lang-selector">
        <div class="lang-current" id="lang-current" role="button" tabindex="0" aria-label="Language"><span class="lang-current-flag">EN</span><span class="lang-current-arrow">▼</span></div>
        <div class="lang-dropdown" id="lang-dropdown">
          <div class="lang-option" data-lang="tr" data-flag="TR"><span>Türkçe</span><span class="lang-option-check"></span></div>
          <div class="lang-option active" data-lang="en" data-flag="EN"><span>English</span><span class="lang-option-check">✓</span></div>
          <div class="lang-option" data-lang="de" data-flag="DE"><span>Deutsch</span><span class="lang-option-check"></span></div>
        </div>
      </div>
      <button class="hamburger" id="hamburger" aria-label="Menu"><span></span><span></span><span></span></button>
    </div>
  </header>
  <div class="mobile-menu" id="mobile-menu">
    <a href="/#pricing" data-i18n="nav.pricing">Pricing</a>
    <a href="/login" data-i18n="nav.login">Login</a>
    <a href="/register" class="btn btn-accent" data-i18n="nav.register">Sign Up →</a>
  </div>
  <div class="menu-overlay" id="menu-overlay"></div>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-top">
        <div class="footer-col">
          <div class="footer-logo"><svg width="20" height="20" viewBox="0 0 22 22" fill="none" aria-hidden="true"><polyline points="2,16 7,9 12,13 19,4" stroke="currentColor" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Wawe Journal</span></div>
          <p class="footer-desc" data-i18n="footer.desc">A modern trading journal built for professional traders.</p>
        </div>
        <div class="footer-col"><h4 data-i18n="footer.links">Links</h4><ul>
          <li><a href="/" data-i18n="nav.home">Home</a></li><li><a href="/#pricing" data-i18n="nav.pricing">Pricing</a></li><li><a href="/login" data-i18n="nav.login">Login</a></li><li><a href="/register" data-i18n="nav.register">Sign Up</a></li></ul></div>
        <div class="footer-col"><h4 data-i18n="footer.corporate">Corporate</h4><ul>
          <li><a href="/about" data-i18n="footer.about">About</a></li><li><a href="/privacy" data-i18n="footer.privacy">Privacy</a></li><li><a href="/terms" data-i18n="footer.terms">Terms</a></li><li><a href="/contact" data-i18n="footer.contact">Contact</a></li></ul></div>
        <div class="footer-col"><h4 data-i18n="footer.contact_title">Contact</h4><ul>
          <li><a href="mailto:support@wawejournal.com">support@wawejournal.com</a></li><li><span>İstanbul, Türkiye</span></li><li><span>Wawe Journal</span></li></ul></div>
      </div>
      <div class="footer-bottom">
        <p>© 2026 <span data-i18n-html="footer.credit">WaweJournal is a part of <a href="https://wawedev.com" target="_blank" rel="noopener" class="wawedev-link">wawedev</a> brand.</span> <span data-i18n="footer.rights">All rights reserved.</span></p>
        <div class="footer-social">
          <a href="https://www.instagram.com/wawejournal/" target="_blank" rel="noopener" aria-label="Instagram"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><line x1="17" y1="7" x2="17.01" y2="7"/></svg></a>
          <a href="mailto:support@wawejournal.com" aria-label="Email"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></a>
        </div>
      </div>

      <LegalDisclosures />
    </div>
  </footer>

  <script src="/index-i18n.js?v=8" is:inline></script>
  <script is:inline>
  (function() {
    function setupPage() {
      // LANGUAGE SELECTOR
      var langCurrent = document.getElementById('lang-current');
      var langDropdown = document.getElementById('lang-dropdown');
      var langOptions = document.querySelectorAll('.lang-option');
      var langFlag = document.querySelector('.lang-current-flag');

      function updateLanguageUI(lang) {
        langOptions.forEach(function(opt) {
          var check = opt.querySelector('.lang-option-check');
          if (opt.dataset.lang === lang) {
            opt.classList.add('active');
            if (check) check.textContent = '✓';
            if (langFlag) langFlag.textContent = opt.dataset.flag;
          } else {
            opt.classList.remove('active');
            if (check) check.textContent = '';
          }
        });
      }

      if (typeof window.i18n !== 'undefined') {
        updateLanguageUI(window.i18n.getCurrentLanguage());
        window.i18n.onChange(function(l) { updateLanguageUI(l); });
      }

      function toggleDD() { if (langDropdown) langDropdown.classList.toggle('show'); }
      function closeDD() { if (langDropdown) langDropdown.classList.remove('show'); }

      if (langCurrent) {
        langCurrent.addEventListener('click', function(e) {
          e.stopPropagation();
          toggleDD();
        });
      }

      langOptions.forEach(function(opt) {
        opt.addEventListener('click', function(e) {
          e.stopPropagation();
          if (typeof window.i18n !== 'undefined') window.i18n.setLanguage(opt.dataset.lang);
          closeDD();
        });
      });

      document.addEventListener('click', function(e) {
        if (langCurrent && langDropdown && !langCurrent.contains(e.target) && !langDropdown.contains(e.target)) closeDD();
      });

      // MOBILE MENU
      var hamburger = document.getElementById('hamburger');
      var mobileMenu = document.getElementById('mobile-menu');
      var overlay = document.getElementById('menu-overlay');
      function toggleMenu() {
        if (!hamburger || !mobileMenu) return;
        hamburger.classList.toggle('active');
        mobileMenu.classList.toggle('active');
        if (overlay) overlay.classList.toggle('active');
        document.body.style.overflow = mobileMenu.classList.contains('active') ? 'hidden' : '';
      }
      if (hamburger) hamburger.addEventListener('click', toggleMenu);
      if (overlay) overlay.addEventListener('click', toggleMenu);
      document.querySelectorAll('.mobile-menu a').forEach(function(l) {
        l.addEventListener('click', toggleMenu);
      });

      // REVEAL
      var obs = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) { if (e.isIntersecting) e.target.classList.add('visible'); });
      }, { threshold: 0.08 });
      document.querySelectorAll('.reveal').forEach(function(el) { obs.observe(el); });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupPage);
    } else {
      setupPage();
    }
  })();
  </script>
</Layout>
